	end)()

	local capabilitySummary = Theme.label("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Extra.Muted,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	capabilitySummary.Name = "Summary"
	capabilitySummary.Size = UDim2.new(1, 0, 0, 0)
	capabilitySummary.AutomaticSize = Enum.AutomaticSize.Y
	capabilitySummary.Parent = capabilityBody

	local capabilityList = Instance.new("Frame")
	capabilityList.Name = "List"
	capabilityList.Size = UDim2.new(1, 0, 0, 0)
	capabilityList.AutomaticSize = Enum.AutomaticSize.Y
	capabilityList.BackgroundTransparency = 1
	Theme.passThrough(capabilityList)
	capabilityList.Parent = capabilityBody
	Theme.listLayout(3).Parent = capabilityList

	local function verdictColor(verdict: string): Color3
		if verdict == "Supported" then
			return Theme.Colors.Success
		elseif verdict == "Unsupported" then
			return Theme.Colors.Error
		end
		return Theme.Extra.Muted
	end

	local function renderCapabilities(report: any)
		for _, child in capabilityList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		if not report then
			capabilitySummary.Text = "No provider selected."
			return
		end

		local counts = CapabilityInspector.summary(report)
		capabilitySummary.Text = string.format(
			"Model: %s · Context %s (%s) · Max output %s (%s)\n%d supported · %d unsupported · %d unknown",
			if report.modelId ~= "" then report.modelId else "(not set)",
			Time.formatNumber(report.contextWindow),
			report.contextWindowSource,
			Time.formatNumber(report.maxOutputTokens),
			report.maxOutputTokensSource,
			counts.Supported,
			counts.Unsupported,
			counts.Unknown
		)

		for index, rowData in report.rows do
			local row = Instance.new("Frame")
			row.Name = "Capability_" .. rowData.id
			row.LayoutOrder = index
			row.Size = UDim2.new(1, 0, 0, 0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			row.BackgroundColor3 = Theme.Extra.SurfaceRaised
			row.BorderSizePixel = 0
			row.Parent = capabilityList
			Theme.corner(Theme.Metrics.RadiusSmall).Parent = row

			local inner = Instance.new("Frame")
			inner.Size = UDim2.new(1, -16, 0, 0)
			inner.AutomaticSize = Enum.AutomaticSize.Y
			inner.BackgroundTransparency = 1
			Theme.passThrough(inner)
			inner.Position = UDim2.fromOffset(8, 6)
			inner.Parent = row
			Theme.listLayout(2).Parent = inner

			local top = Instance.new("Frame")
			top.Size = UDim2.new(1, 0, 0, 16)
			top.BackgroundTransparency = 1
			Theme.passThrough(top)
			top.Parent = inner

			-- Name and verdict share the row. Left at their default Position
			-- they both start at x=0 and paint over one another, because a
			-- percentage width does not move the origin.
			local topLayout = Instance.new("UIListLayout")
			topLayout.FillDirection = Enum.FillDirection.Horizontal
			topLayout.SortOrder = Enum.SortOrder.LayoutOrder
			topLayout.VerticalAlignment = Enum.VerticalAlignment.Center
			topLayout.Parent = top

			local nameLabel = Theme.label(rowData.label, {
				size = Theme.TextSizes.Caption,
				font = Theme.Fonts.Medium,
				truncate = true,
			})
			nameLabel.Size = UDim2.new(1, -104, 1, 0)
			nameLabel.LayoutOrder = 1
			nameLabel.Parent = top
			-- The flex item belongs on the LABEL, inside this fixed-height row.
			-- On the row itself it would be a Fill child of an auto-sized
			-- vertical list, which makes it grow to the full canvas height.
			Theme.flexItem(nameLabel, 1)

			local statusLabel = Theme.label(rowData.verdict, {
				size = Theme.TextSizes.Caption,
				color = verdictColor(rowData.verdict),
				font = Theme.Fonts.Bold,
				alignX = Enum.TextXAlignment.Right,
			})
			statusLabel.Size = UDim2.fromOffset(96, 16)
			statusLabel.LayoutOrder = 2
			statusLabel.TextXAlignment = Enum.TextXAlignment.Right
			statusLabel.Parent = top

			local metaLabel = Theme.label(
				string.format(
					"%s%s%s",
					rowData.source,
					if rowData.overridden then " · override" else "",
					if rowData.checkedAt then string.format(" · %.0fs ago", os.clock() - rowData.checkedAt) else ""
				),
				{ size = 10, color = Theme.Extra.Muted, alignY = Enum.TextYAlignment.Top, wrap = true }
			)
			metaLabel.Size = UDim2.new(1, 0, 0, 0)
			metaLabel.AutomaticSize = Enum.AutomaticSize.Y
			metaLabel.Parent = inner

			local noteLabel = Theme.label(rowData.note, {
				size = 10,
				color = Theme.Extra.Muted,
				alignY = Enum.TextYAlignment.Top,
				wrap = true,
			})
			noteLabel.Size = UDim2.new(1, 0, 0, 0)
			noteLabel.AutomaticSize = Enum.AutomaticSize.Y
			noteLabel.Parent = inner

			if rowData.probeable then
				local probeRow = Instance.new("TextButton")
				probeRow.Name = "Probe"
				probeRow.Size = UDim2.new(1, 0, 0, 0)
				probeRow.AutomaticSize = Enum.AutomaticSize.Y
				probeRow.BackgroundTransparency = 1
				Theme.passThrough(probeRow)
				Icons.setButton(probeRow, "Warning", "Test with a real request (may cost tokens)")
				probeRow.TextXAlignment = Enum.TextXAlignment.Left
				probeRow.TextColor3 = Theme.Extra.Muted
				probeRow.TextSize = 10
				probeRow.TextWrapped = true
				probeRow.Font = Theme.Fonts.Medium
				probeRow.Parent = inner
				probeRow.MouseButton1Click:Connect(function()
					if not busy and runCapabilityProbe then runCapabilityProbe() end
				end)
			else
				local note = Theme.label("Not probeable: " .. rowData.probeNote, {
					size = 10,
					color = Theme.Extra.Muted,
					alignY = Enum.TextYAlignment.Top,
					wrap = true,
				})
				note.Size = UDim2.new(1, 0, 0, 0)
				note.AutomaticSize = Enum.AutomaticSize.Y
				note.Parent = inner
			end
		end
	end

	--=========================================================================
	-- BEHAVIOUR
	--=========================================================================

	local function setBusy(value: boolean)
		probeBusy = value
		busy = value or StateManager.isBusy()
		if busy then Components.closeMenus() end
		for _, control in view:GetDescendants() do
			if control:IsA("GuiButton") then control.Interactable = not busy
			elseif control:IsA("TextBox") then control.TextEditable = not busy end
		end
		testButton.Interactable = if probeBusy then not (operation and operation.cancelled) else not busy
	end

	local function restoreTestControls()
		testButton.Text = "Test connection"
		testChatButton.Text = "Test chat"
		testStreamButton.Text = "Test streaming"
		testToolButton.Text = "Test tool calling"
		capabilityButton.Text = "Detect capabilities"
		detectButton.Text = "Detect API protocol"
		refreshModelsButton.Text = "Refresh models"
		setBusy(false)
	end

	local function finishStopped(token: any)
		if operation ~= token then return end
		operation = nil
		if destroyed then return end
		restoreTestControls()
		testResult.TextColor3 = Theme.Extra.Warning
		testResult.Text = if token.timedOut then "Test timed out after 60 seconds. Check the URL and provider, then try again." else "Provider test stopped."
	end

	local function stopOperation(timedOut: boolean?)
		local token = operation
		if not token then return end
		token.cancelled = true
		token.timedOut = timedOut == true
		if not destroyed then
			testButton.Text = "Stopping…"
			testButton.Interactable = false
		end
		-- HTTP calls and stream loops poll the token and clean up themselves.
		-- A misbehaving callback cannot hold the settings controls forever.
		task.delay(1, function()
			if operation ~= token then return end
			if token.worker then pcall(task.cancel, token.worker) end
			finishStopped(token)
		end)
	end

	-- Defer work so Studio can draw the busy state before starting requests.
	-- Diagnostics use one attempt, short requests and a whole-operation deadline.
	local function runBackground(work: (any, () -> boolean) -> ())
		local token = { cancelled = false, timedOut = false, deadline = os.clock() + 60, worker = nil :: thread? }
		operation = token
		local profile = table.clone(draft)
		profile.timeoutMs = math.min(profile.timeoutMs or 120000, 15000)
		profile.retryOverrides = { enabled = false, maxRetries = 0, rateLimitScheduler = false }
		local function shouldCancel(): boolean
			return destroyed or token.cancelled or operation ~= token or os.clock() >= token.deadline
		end
		testButton.Text = "Stop test"
		testButton.Interactable = true
		token.worker = task.defer(function()
			if shouldCancel() then finishStopped(token); return end
			local ok, cause = pcall(work, profile, shouldCancel)
			if destroyed or operation ~= token then return end
			if shouldCancel() then
				token.timedOut = token.timedOut or os.clock() >= token.deadline
				finishStopped(token)
			else
				operation = nil
				restoreTestControls()
				if not ok then
					testResult.TextColor3 = Theme.Colors.Error
					testResult.Text = "The provider test failed. Check the activity log for details."
					Logger.error("AI Provider", "Provider operation failed.", { detail = tostring(cause) })
				end
			end
		end)
		task.delay(60, function()
			if operation == token then stopOperation(true) end
		end)
	end

	local function requireApiKey(): (string?, string?)
		if busy then return nil, "A task or provider test is already running." end
		if #StringUtil.trim(draft.baseUrl) == 0 then
			return nil, "Set an API Base URL first."
		end
		if #StringUtil.trim(draft.modelId) == 0 then
			return nil, "Set a Model ID first. Any model your provider exposes can be entered manually."
		end
		local ok, errors = commit(true)
		if not ok then
			local first = errors and errors[1]
			return nil, if first then (first.field .. ": " .. first.message) else "The provider is not valid yet."
		end
		local key = CredentialStore.get(draft.id)
		if draft.authStyle ~= "none" and not draft.viaRouter and not key then
			return nil, "Enter an API key in Connection before running a test."
		end
		return key, nil
	end

	addPreset = function(presetId: string)
		local created, err
		if presetId == "custom" or presetId == "rest" then
			created, err = CustomProviderManager.createDraft(presetId)
		else
			created, err = CustomProviderManager.create(presetId)
		end
		if not created then
			EventBus.emit(EventBus.Events.Toast, { kind = "error", message = tostring(err) })
			return
		end
		RetryLogger.providerSelected(created)
		showEditor(created)
	end
	profileActions["Use for chat"] = function()
		if not commit(true) then return end
		SettingsManager.setActiveProvider(draft.id)
		configureIfActive()
		RetryLogger.providerSelected(draft)
		refresh()
		EventBus.emit(EventBus.Events.Toast, { kind = "success", message = "Provider selected for chat." })
	end
	profileActions["Duplicate profile"] = function()
		local copy, err = CustomProviderManager.duplicate(draft.id)
		if not copy then
			EventBus.emit(EventBus.Events.Toast, { kind = "error", message = tostring(err) })
			return
		end
		showEditor(copy)
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Profile duplicated. Enter a new API key for the copy." })
	end
	profileActions["Remove profile"] = function()
		CredentialStore.clear(draft.id)
		CustomProviderManager.remove(draft.id)
		showOverview()
		renderProfileList()
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Provider profile removed." })
	end
	profileActions["Disconnect key"] = function()
		CredentialStore.clear(draft.id)
		CustomProviderManager.disconnect(draft.id)
		refresh()
		ContextManager.configure(SettingsManager.getActiveProvider())
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Session API key removed. The profile is kept." })
	end

	saveButton.MouseButton1Click:Connect(function()
		local ok, errors = commit(true)
		if ok then
			EventBus.emit(EventBus.Events.Toast, { kind = "success", message = "Provider saved." })
			renderProfileList()
		else
			local first = errors and errors[1]
			EventBus.emit(EventBus.Events.Toast, {
				kind = "error",
				message = if first then (first.field .. ": " .. first.message) else "The provider could not be saved.",
			})
		end
	end)

	testButton.MouseButton1Click:Connect(function()
		if probeBusy then stopOperation(); return end
		local _, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		setBusy(true)
		testButton.Text = "Stop test"
		testResult.TextColor3 = Theme.Extra.Muted
		testResult.Text = "Contacting the provider…"

		runBackground(function(profile, shouldCancel)
			local apiKey = CredentialStore.get(draft.id)
			local result = ProviderService.testConnection(profile, apiKey, {
				shouldCancel = shouldCancel,
				onProgress = function(note)
					testResult.Text = note
				end,
			})

			if shouldCancel() then return end
			testButton.Text = "Test connection"
			setBusy(false)

			if result.ok then
				testResult.TextColor3 = Theme.Colors.Success
			else
				testResult.TextColor3 = Theme.Colors.Error
			end
			testResult.Text = string.format(
				"%s in %.0f ms.\n%s",
				if result.ok then "Connected" else "Failed",
				result.latencyMs or 0,
				result.message or ""
			)
			if result.remedy then
				testResult.Text ..= "\n" .. result.remedy
			end
			testResult.Text ..= "\nEndpoint: " .. result.endpoint

			EventBus.emit(EventBus.Events.Toast, {
				kind = if result.ok then "success" else "error",
				message = if result.ok then "Connection succeeded." else result.message,
			})
		end)
	end)

	testChatButton.MouseButton1Click:Connect(function()
		local apiKey, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		setBusy(true)
		testChatButton.Text = "Testing…"
		runBackground(function(profile, shouldCancel)
			local result = ProviderService.complete(profile, {
				messages = { { role = "user", content = "Reply with the single word: ok" } },
				model = draft.modelId,
				maxOutputTokens = 32,
				streaming = false,
				jsonMode = false,
				toolChoice = "none",
			}, apiKey, { operationId = "probe-chat-" .. tostring(os.clock()), shouldCancel = shouldCancel })

			if shouldCancel() then return end
			testChatButton.Text = "Test chat"
			setBusy(false)

			if result.ok and result.response then
				testResult.TextColor3 = Theme.Colors.Success
				testResult.Text = string.format(
					"Chat works. Reply: \"%s\"",
					string.sub(string.gsub(result.response.text or "", "%s+", " "), 1, 80)
				)
			else
				testResult.TextColor3 = Theme.Colors.Error
				testResult.Text = result.error and result.error.message or "Chat test failed."
			end
		end)
	end)

	testStreamButton.MouseButton1Click:Connect(function()
		local apiKey, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		local status = StreamingManager.streamingStatus(draft)
		setBusy(true)
		testStreamButton.Text = "Testing…"
		runBackground(function(profile, shouldCancel)
			local chunks = 0
			local finished = false
			local failure: any = nil

			ProviderService.stream(profile, {
				messages = { { role = "user", content = "Count to three." } },
				model = draft.modelId,
				maxOutputTokens = 32,
				streaming = true,
				jsonMode = false,
				toolChoice = "none",
			}, apiKey, {
				shouldCancel = shouldCancel,
				onText = function()
					if shouldCancel() then return end
					chunks += 1
					testResult.Text = string.format("Receiving… %d chunk(s) so far.", chunks)
				end,
				onDone = function()
					finished = true
				end,
				onError = function(normalised)
					failure = normalised
				end,
			})

			local waited = 0
			while not finished and not failure and waited < 30 and not shouldCancel() do
				task.wait(0.1)
				waited += 0.1
			end

			if shouldCancel() then return end
			testStreamButton.Text = "Test streaming"
			setBusy(false)

			if failure then
				testResult.TextColor3 = Theme.Colors.Error
				testResult.Text = string.format("Streaming failed: %s", failure.message or "unknown error")
			elseif chunks > 1 then
				testResult.TextColor3 = Theme.Colors.Success
				testResult.Text = string.format("Streaming works. %d chunks received.", chunks)
			else
				testResult.TextColor3 = Theme.Extra.Warning
				testResult.Text = "The request completed, but only one chunk arrived. Streaming may be unsupported here."
			end
		end)
	end)

	testToolButton.MouseButton1Click:Connect(function()
		local apiKey, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		setBusy(true)
		testToolButton.Text = "Testing…"
		runBackground(function(profile, shouldCancel)
			local result = ProviderService.complete(profile, {
				messages = { { role = "user", content = "Call the probe_tool function exactly once." } },
				model = draft.modelId,
				maxOutputTokens = 128,
				streaming = false,
				jsonMode = false,
				toolChoice = "required",
				tools = {
					{
						name = "probe_tool",
						description = "Returns a constant.",
						parameters = { type = "object", properties = {}, additionalProperties = false },
					},
				},
			}, apiKey, { operationId = "probe-tool-" .. tostring(os.clock()), shouldCancel = shouldCancel })

			if shouldCancel() then return end
			testToolButton.Text = "Test tool calling"
			setBusy(false)

			local toolCalls = if result.ok and result.response then result.response.toolCalls else nil
			if toolCalls and #toolCalls > 0 then
				testResult.TextColor3 = Theme.Colors.Success
				testResult.Text = string.format("Tool calling works. The model requested `%s`.", toolCalls[1].name)
			elseif result.ok then
				testResult.TextColor3 = Theme.Extra.Warning
				testResult.Text = "The request succeeded but no tool call came back. This model may not support tools."
			else
				testResult.TextColor3 = Theme.Colors.Error
				testResult.Text = result.error and result.error.message or "Tool test failed."
			end
		end)
	end)

	runCapabilityProbe = function()
		local _, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		setBusy(true)
		capabilityButton.Text = "Probing…"
		EventBus.emit(EventBus.Events.Toast, {
			kind = "warning",
			message = "Capability probes send real requests and may cost tokens.",
		})
		runBackground(function(profile, shouldCancel)
			local report = CapabilityInspector.probe(profile, {
				shouldCancel = shouldCancel,
				onProgress = function()
					renderCapabilities(CapabilityInspector.buildReport(draft))
				end,
			})
			if shouldCancel() then return end
			capabilityButton.Text = "Detect capabilities"
			setBusy(false)
			configureIfActive(report)
			renderCapabilities(report)
			EventBus.emit(EventBus.Events.Toast, {
				kind = "success",
				message = "Capability probes finished.",
			})
		end)
	end
	capabilityButton.MouseButton1Click:Connect(runCapabilityProbe)

	detectButton.MouseButton1Click:Connect(function()
		local _, err = requireApiKey()
		if err then
			EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = err })
			return
		end
		setBusy(true)
		detectButton.Text = "Detecting…"
		detectNote.Text = "Probing protocols. These are real, billable requests."
		EventBus.emit(EventBus.Events.Toast, {
			kind = "warning",
			message = "Protocol detection sends real requests and may cost tokens.",
		})

		runBackground(function(profile, shouldCancel)
			local report = ProtocolDetector.detect(profile, {
				shouldCancel = shouldCancel,
				maxProbes = 3,
				onProgress = function(candidates, note)
					detectNote.Text = note
					_ = candidates
				end,
			})

			if shouldCancel() then return end
			detectButton.Text = "Detect API protocol"
			setBusy(false)

			if report.best then
				draft.protocol = report.best.protocolId
				draft.endpointPathCustom = false
				local label = labelOf(PROTOCOL_OPTIONS, report.best.protocolId) or report.best.protocolId
				commit()
				refresh()
				RetryLogger.protocolConfirmed(draft, report.best.protocolId, report.best.source)
				detectNote.Text = string.format(
					"Best match: %s (%s, confidence %.2f). %s",
					label,
					report.best.source,
					report.best.confidence,
					report.best.note
				)
			else
				detectNote.Text = "No protocol could be confirmed. Choose one manually, or check the Base URL."
			end
		end)
	end)

	refreshModelsButton.MouseButton1Click:Connect(function()
		if busy then return end
		local ok, errors = commit(true)
		if not ok then
			local first = errors and errors[1]
			EventBus.emit(EventBus.Events.Toast, {
				kind = "error",
				message = if first then (first.field .. ": " .. first.message) else "Save the provider first.",
			})
			return
		end

		setBusy(true)
		refreshModelsButton.Text = "Loading…"
		runBackground(function(profile, shouldCancel)
			local ids, err = ProviderService.listModels(profile, CredentialStore.get(profile.id), shouldCancel)
			if shouldCancel() then return end
			refreshModelsButton.Text = "Refresh models"
			setBusy(false)

			for _, child in modelListHolder:GetChildren() do
				if child:IsA("GuiObject") and child ~= refreshModelsButton then child:Destroy() end
			end

			if not ids then
				EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = tostring(err) })
				return
			end

			local dropdown = Components.dropdown(
				string.format("Available models (%d)", #ids),
				ids,
				function(selected)
					draft.modelId = selected
					modelBox.Text = selected
					commit()
					CapabilityInspector.buildReport(draft)
					renderProfileList()
				end
			)
			dropdown.LayoutOrder = 1
			dropdown.Parent = modelListHolder

			EventBus.emit(EventBus.Events.Toast, {
				kind = "success",
				message = string.format("%d model ids loaded.", #ids),
			})
		end)
	end)

	providerNameRow.Parent = endpointBody
	providerNameRow.LayoutOrder = 0
	typeField.Parent = endpointBody
	typeField.LayoutOrder = 1
	protocolField.LayoutOrder = 2
	detectHolder.LayoutOrder = 3
	endpointPathRow.LayoutOrder = 4
	modeField.LayoutOrder = 5
	baseUrlRow.Parent = identityBody
	baseUrlRow.LayoutOrder = 4
	displayNameRow.LayoutOrder = 0
	keyRow.Parent = identityBody
	keyRow.LayoutOrder = 1
	keyRow.Visible = draft.authStyle ~= "none"
	modelRow.Parent = identityBody
	modelRow.LayoutOrder = 2
	modelListHolder.Parent = identityBody
	modelListHolder.LayoutOrder = 3
	Theme.listLayout(6).Parent = modelListHolder
	refreshModelsButton.Parent = modelListHolder
	refreshModelsButton.LayoutOrder = 0
	contextAutoRow.LayoutOrder = 0
	contextRow.LayoutOrder = 1
	outputAutoRow.LayoutOrder = 2
	outputRow.LayoutOrder = 3
	timeoutRow.Parent = endpointBody
	timeoutRow.LayoutOrder = 6
	headersRow.Parent = credentialBody
	headersRow.LayoutOrder = 5
	streamingRow.LayoutOrder = 4
	toolRow.LayoutOrder = 5
	jsonRow.LayoutOrder = 6
	retryRow.LayoutOrder = 7
	local limitsSummary = Theme.autoText("", { size = Theme.TextSizes.Caption, color = Theme.Extra.Muted })
	limitsSummary.Name = "LimitsSummary"
	limitsSummary.LayoutOrder = 4
	limitsSummary.Parent = modelBody
	syncLimits = function()
		contextRow.Visible = draft.contextWindowMode == "manual"
		outputRow.Visible = draft.maxOutputTokensMode == "manual"
		local report = CapabilityInspector.buildReport(draft)
		limitsSummary.Text = string.format("Context: %s tokens · Output: %s tokens", Time.formatNumber(report.contextWindow), Time.formatNumber(report.maxOutputTokens))
	end

	--=========================================================================
	-- SYNC
	--=========================================================================

	refresh = function()
		displayNameBox.Text = draft.displayName or ""
		providerNameBox.Text = draft.providerName or ""
		baseUrlBox.Text = draft.baseUrl or ""
		endpointPathBox.Text = if draft.endpointPathCustom then (draft.endpointPath or "") else CustomProviderManager.suggestEndpointPath(draft.protocol)
		modelBox.Text = draft.modelId or ""
		contextBox.Text = tostring(draft.contextWindow or 128000)
		outputBox.Text = tostring(draft.maxOutputTokens or 8192)
		temperatureBox.Text = tostring(draft.temperature or 0.7)
		topPBox.Text = tostring(draft.topP or 1.0)
		timeoutBox.Text = tostring(draft.timeoutMs or 120000)
		headerNameBox.Text = draft.authHeaderName or ""
		headerPrefixBox.Text = draft.authHeaderPrefix or ""
		queryParamBox.Text = draft.authQueryParam or ""
		headersBox.Text = CustomProviderManager.formatHeaders(draft.extraHeaders)
		setType(labelOf(PROVIDER_TYPE_OPTIONS, draft.providerType))
		setProtocol(labelOf(PROTOCOL_OPTIONS, draft.protocol))
		setAuth(labelOf(AUTH_OPTIONS, draft.authStyle))
		setURLMode(if draft.urlMode == "full" then "Full Endpoint URL" else "Base URL")
		setContextAuto(draft.contextWindowMode ~= "manual")
		setOutputAuto(draft.maxOutputTokensMode ~= "manual")
		setStreaming(draft.streaming ~= false)
		setTools(draft.toolCalling ~= false)
		setJSON(draft.jsonMode == true)
		setEffort(if draft.reasoningEffort and #draft.reasoningEffort > 0 then draft.reasoningEffort else "(not sent)")
		revealed = false
		revealButton.Text = "Show"
		keyBox.Text = ""
		refreshKeyMask()
		requestSchemaBox.Text = HttpService:JSONEncode(draft.schemaMapping and draft.schemaMapping.request or {})
		responseSchemaBox.Text = HttpService:JSONEncode(draft.schemaMapping and draft.schemaMapping.response or {})

		keyRow.Visible = draft.authStyle ~= "none"
        local keyLabel = keyRow:FindFirstChild("Label")
        if keyLabel and keyLabel:IsA("TextLabel") then keyLabel.Text = if draft.viaRouter then "9Router API key" else "API Key" end
        keyBox.PlaceholderText = if draft.viaRouter then "9Router client key, if required" else "Enter API key"
        routerCard.Visible = draft.viaRouter == true
        login.Interactable = not busy; statusButton.Interactable = not busy; statusButton.Text = "Refresh connection"
        login.Text = if draft.hasOAuth then "Sign in / Log in" else "Connect in 9Router"
        routerNote.Text = if draft.viaRouter then "Account credentials stay in 9Router. Finish sign in there, refresh connection, then select a model." else ""
		headerNameRow.Visible = draft.authStyle == "header" or draft.authStyle == "custom"
		headerPrefixRow.Visible = draft.authStyle == "custom"
		queryParamRow.Visible = draft.authStyle == "query"
		schemaCard.Visible = draft.protocol == "custom_rest"
		editorTitle.Text = draft.displayName or "Provider"
		setActionLabel("More")
		syncLimits()
		refreshKeyStatus()
		syncFooterStatus()
		refreshRetryNote()
		refreshPreview()
		renderProfileList()
		renderCapabilities(CapabilityInspector.buildReport(draft))
	end

	showEditor = function(profile: any)
		if busy or not profile then return end
		Components.closeMenus()
		loginGeneration += 1
		draft = table.clone(profile)
		editorTab = "Connection"
		selectTab(editorTab)
		for name, page in pages do
			page.Visible = name == editorTab
			page.CanvasPosition = Vector2.new(0, 0)
		end
		for _, child in modelListHolder:GetChildren() do
			if child:IsA("GuiObject") and child ~= refreshModelsButton then child:Destroy() end
		end
		testResult.Text = ""
		overview.Visible = false
		editor.Visible = true
		refresh()
	end
	local unsubscribeProviders = EventBus.on(EventBus.Events.ProvidersChanged, function(payload)
		renderProfileList()
		if payload.reason == "reset" or not SettingsManager.getProvider(draft.id) then showOverview() end
	end)
	local unsubscribeActive = EventBus.on(EventBus.Events.ActiveProviderChanged, function()
		renderProfileList()
		syncFooterStatus()
	end)
	local unsubscribeState = EventBus.on(EventBus.Events.StateChanged, function() setBusy(probeBusy) end)
	setBusy(false)
	local function destroy()
		if destroyed then return end
		destroyed = true
		stopOperation()
		unsubscribeProviders()
		unsubscribeActive()
		unsubscribeState()
		Components.closeMenus()
	end
	view.Destroying:Connect(destroy)
	refresh()
	renderCatalog()
	return view, {
		showOverview = showOverview,
		editProfile = function(id: string) showEditor(SettingsManager.getProvider(id)) end,
		getTab = function() return editorTab end,
		refresh = refresh,
		destroy = destroy,
	}
end

return ProviderView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">QuestionCard</string>
          <string name="Source">--!strict
--[[
	ForgePilot / UI / QuestionCard
	Renders an interactive question inside the chat.

	Supports single choice, multiple choice, text, number, yes/no and
	confirmation, plus Custom Answer, Let AI Decide, Cancel and Submit.
]]

local Icons = require(script.Parent.Parent.Utilities.Icons)
local QuestionManager = require(script.Parent.Parent.AI.QuestionManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Theme = require(script.Parent.Parent.Utilities.Theme)

local QuestionCard = {}

local colourFor = {
	single = Theme.Colors.Highlight,
	multiple = Theme.Colors.Highlight,
	text = Theme.Extra.Info,
	number = Theme.Extra.Info,
	boolean = Theme.Extra.Info,
	confirm = Theme.Extra.Warning,
}

--- Live input listeners, keyed by the card that owns them.
---
--- Roblox Instances reject new members ("cleanup is not a valid member of
--- Frame"), so the teardown hook cannot hang off the card itself. A weak table
--- lets `markAnswered` reach it later without threading an api table through
--- every caller.
local liveListeners: { [Frame]: any } = setmetatable({}, { __mode = "k" })

local function releaseListener(card: Frame)
	local listener = liveListeners[card]
	if listener then
		listener:Disconnect()
		liveListeners[card] = nil
	end
end

--- Builds the card. `question` comes from the QuestionAsked event.
function QuestionCard.build(question: any): (Frame, { [string]: any })
	local card = Instance.new("Frame")
	card.Name = "Question_" .. question.id
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Theme.Extra.Surface
	card.BorderSizePixel = 0
	card.LayoutOrder = 20
	card.ClipsDescendants = false
	Theme.corner(Theme.Metrics.Radius).Parent = card

	local accent = colourFor[question.kind] or Theme.Colors.Highlight
	local stroke = Theme.stroke(Theme.withAlpha(accent, 0.45))
	stroke.Parent = card

	Theme.padding(12).Parent = card

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.new(1, 0, 0, 0)
	content.AutomaticSize = Enum.AutomaticSize.Y
	content.BackgroundTransparency = 1
	content.Parent = card
	Theme.listLayout(8).Parent = content

	-- Header -------------------------------------------------------------
	local headerRow = Instance.new("Frame")
	headerRow.Name = "Header"
	headerRow.Size = UDim2.new(1, 0, 0, 18)
	headerRow.BackgroundTransparency = 1
	headerRow.Parent = content

	local icon = Icons.glyph("Lightbulb", 13, accent)
	icon.Name = "Icon"
	icon.Size = UDim2.fromOffset(15, 15)
	icon.Parent = headerRow

	local kindLabel = Theme.label("Question · " .. tostring(question.kind):upper(), {
		size = Theme.TextSizes.Caption,
		font = Theme.Fonts.Bold,
		color = accent,
	})
	kindLabel.Name = "Kind"
	kindLabel.Position = UDim2.fromOffset(20, 0)
	kindLabel.Size = UDim2.new(1, -20, 1, 0)
	kindLabel.Parent = headerRow

	local promptLabel = Theme.label(question.prompt, {
		size = Theme.TextSizes.Body,
		font = Theme.Fonts.Medium,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	promptLabel.Name = "Prompt"
	promptLabel.Size = UDim2.new(1, 0, 0, 0)
	promptLabel.AutomaticSize = Enum.AutomaticSize.Y
	promptLabel.Parent = content

	local detailLabel: TextLabel? = nil
	if question.detail and #question.detail &gt; 0 then
		detailLabel = Theme.label(question.detail, {
			size = Theme.TextSizes.Small,
			color = Theme.Colors.SecondaryText,
			alignY = Enum.TextYAlignment.Top,
			wrap = true,
		})
		detailLabel.Name = "Detail"
		detailLabel.Size = UDim2.new(1, 0, 0, 0)
		detailLabel.AutomaticSize = Enum.AutomaticSize.Y
		detailLabel.Parent = content
	end

	-- Selection state -----------------------------------------------------
	local selected: { [string]: boolean } = {}
	local optionButtons: { [string]: TextButton } = {}
	local customInput: TextBox? = nil
	local numberInput: TextBox? = nil
	local textInput: TextBox? = nil
	local submitted = false

	local function lock()
		if submitted then
			return
		end
		submitted = true
		card.BackgroundTransparency = 0.45
		for _, child in content:GetDescendants() do
			if child:IsA("TextButton") then
				child.Active = false
				child.AutoButtonColor = false
				child.BackgroundTransparency = 1
			elseif child:IsA("TextBox") then
				child.TextEditable = false
				child.BackgroundTransparency = 1
			end
		end
	end

	local function pill(text: string, isPrimary: boolean, order: number, callback: any): TextButton
		local button = Instance.new("TextButton")
		button.Name = text:gsub("%s+", "")
		button.LayoutOrder = order
		button.Size = UDim2.fromOffset(0, 28)
		button.AutomaticSize = Enum.AutomaticSize.X
		button.BackgroundColor3 = if isPrimary then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
		button.BorderSizePixel = 0
		button.Text = text
		button.TextColor3 = if isPrimary then Theme.Colors.Background else Theme.Colors.MainText
		button.TextSize = Theme.TextSizes.Small
		button.Font = if isPrimary then Theme.Fonts.Bold else Theme.Fonts.Medium
		button.Parent = content
		Theme.corner(Theme.Metrics.RadiusSmall).Parent = button
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 14)
		pad.PaddingRight = UDim.new(0, 14)
		pad.Parent = button

		local base = button.BackgroundColor3
		local hover = Theme.lighten(base, 0.12)
		button.MouseEnter:Connect(function()
			Theme.tween(button, { BackgroundColor3 = hover }, Theme.Motion.Fast):Play()
		end)
		button.MouseLeave:Connect(function()
			Theme.tween(button, { BackgroundColor3 = base }, Theme.Motion.Fast):Play()
		end)
		button.MouseButton1Click:Connect(callback)
		return button
	end

	-- Option list ---------------------------------------------------------
	if question.kind == "single" or question.kind == "multiple" then
		local list = Instance.new("Frame")
		list.Name = "Options"
		list.Size = UDim2.new(1, 0, 0, 0)
		list.AutomaticSize = Enum.AutomaticSize.Y
		list.BackgroundTransparency = 1
		list.Parent = content
		Theme.listLayout(5).Parent = list

		for index, option in (question.options or {}) do
			local optionButton = Instance.new("TextButton")
			optionButton.Name = "Option_" .. option.id
			optionButton.LayoutOrder = index
			optionButton.Size = UDim2.new(1, 0, 0, 0)
			optionButton.AutomaticSize = Enum.AutomaticSize.Y
			optionButton.BackgroundColor3 = Theme.Extra.SurfaceRaised
			optionButton.BorderSizePixel = 0
			optionButton.Text = ""
			optionButton.TextXAlignment = Enum.TextXAlignment.Left
			optionButton.Parent = list
			Theme.corner(Theme.Metrics.RadiusSmall).Parent = optionButton
			local optStroke = Theme.stroke(Theme.Extra.Border)
			optStroke.Parent = optionButton
			Theme.padding(9).Parent = optionButton

			local marker = Theme.label(question.kind == "multiple" and "☐" or "○", {
				size = Theme.TextSizes.Body,
				color = Theme.Extra.Muted,
			})
			marker.Name = "Marker"
			marker.Size = UDim2.fromOffset(16, 16)
			marker.Position = UDim2.fromOffset(9, 8)
			marker.Parent = optionButton

			local label = Theme.label(option.label, {
				size = Theme.TextSizes.Small,
				alignY = Enum.TextYAlignment.Top,
				wrap = true,
			})
			label.Name = "Label"
			label.Position = UDim2.fromOffset(30, 7)
			label.Size = UDim2.new(1, -40, 0, 0)
			label.AutomaticSize = Enum.AutomaticSize.Y
			label.Parent = optionButton

			if option.description and #option.description &gt; 0 then
				local desc = Theme.label(option.description, {
					size = Theme.TextSizes.Caption,
					color = Theme.Extra.Muted,
					alignY = Enum.TextYAlignment.Top,
					wrap = true,
				})
				desc.Name = "Description"
				desc.Position = UDim2.fromOffset(30, 23)
				desc.Size = UDim2.new(1, -40, 0, 0)
				desc.AutomaticSize = Enum.AutomaticSize.Y
				desc.Parent = optionButton
			end

			optionButtons[option.id] = optionButton

			optionButton.MouseButton1Click:Connect(function()
				if question.kind == "single" then
					selected = {}
					for id, other in optionButtons do
						local otherMarker = other:FindFirstChild("Marker") :: TextLabel?
						if otherMarker then
							otherMarker.Text = if id == option.id then "●" else "○"
							otherMarker.TextColor3 = if id == option.id then accent else Theme.Extra.Muted
						end
						Theme.tween(other, {
							BackgroundColor3 = if id == option.id then Theme.withAlpha(accent, 0.16) else Theme.Extra.SurfaceRaised,
						}, Theme.Motion.Fast):Play()
					end
				else
					selected[option.id] = not (selected[option.id] or false)
					marker.Text = if selected[option.id] then "☑" else "☐"
					marker.TextColor3 = if selected[option.id] then accent else Theme.Extra.Muted
					Theme.tween(optionButton, {
						BackgroundColor3 = if selected[option.id] then Theme.withAlpha(accent, 0.16) else Theme.Extra.SurfaceRaised,
					}, Theme.Motion.Fast):Play()
				end
			end)

			optionButton.MouseEnter:Connect(function()
				Theme.tween(optionButton, { BackgroundColor3 = Theme.Extra.SurfaceHover }, Theme.Motion.Fast):Play()
			end)
			optionButton.MouseLeave:Connect(function()
				if question.kind == "single" then
					local isPicked = false
					for id in pairs(optionButtons) do
						if id == option.id and next(selected) ~= nil then
							-- fall through; the marker already reflects state
						end
					end
					_ = isPicked
				end
				Theme.tween(optionButton, {
					BackgroundColor3 = Theme.Extra.SurfaceRaised,
				}, Theme.Motion.Fast):Play()
			end)
		end
	end

	-- Free-text inputs ----------------------------------------------------
	local function makeInput(placeholder: string, numeric: boolean?): TextBox
		local box = Theme.input(placeholder, { multiLine = not numeric })
		box.Name = "Input"
		box.Size = UDim2.new(1, 0, 0, if numeric then Theme.Metrics.InputHeight else 64)
		box.AutomaticSize = if numeric then Enum.AutomaticSize.None else Enum.AutomaticSize.None
		box.TextYAlignment = if numeric then Enum.TextYAlignment.Center else Enum.TextYAlignment.Top
		box.Parent = content
		return box
	end

	if question.kind == "text" then
		textInput = makeInput(question.placeholder or "Type your answer")
	elseif question.kind == "number" then
		numberInput = makeInput("Enter a number", true)
	elseif question.kind == "boolean" or question.kind == "confirm" then
		local row = Instance.new("Frame")
		row.Name = "YesNo"
		row.Size = UDim2.new(1, 0, 0, 30)
		row.BackgroundTransparency = 1
		row.Parent = content
		local rowLayout = Instance.new("UIListLayout")
		rowLayout.FillDirection = Enum.FillDirection.Horizontal
		rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		rowLayout.Padding = UDim.new(0, 8)
		rowLayout.Parent = row

		local yesButton = pill("Yes", true, 1, function()
			selected = { yes = true }
			lock()
			QuestionManager.submit(true)
		end)
		yesButton.Parent = row

		local noButton = pill("No", false, 2, function()
			selected = { yes = false }
			lock()
			QuestionManager.submit(false)
		end)
		noButton.Parent = row
	end

	-- Custom answer -------------------------------------------------------
	if question.allowCustom and question.kind ~= "text" and question.kind ~= "number" then
		local toggle = Instance.new("TextButton")
		toggle.Name = "CustomToggle"
		toggle.Size = UDim2.new(1, 0, 0, 24)
		toggle.BackgroundTransparency = 1
		Icons.setButton(toggle, "Edit", "Custom answer")
		toggle.TextXAlignment = Enum.TextXAlignment.Left
		toggle.TextColor3 = Theme.Extra.Muted
		toggle.TextSize = Theme.TextSizes.Caption
		toggle.Font = Theme.Fonts.Medium
		toggle.Parent = content

		toggle.MouseButton1Click:Connect(function()
			if customInput then
				customInput:Destroy()
				customInput = nil
				Icons.setButton(toggle, "Edit", "Custom answer")
				return
			end
			local box = Theme.input("Type your own answer", { multiLine = true })
			box.Name = "CustomInput"
			box.Size = UDim2.new(1, 0, 0, 56)
			box.LayoutOrder = 99
			box.Parent = content
			customInput = box
			Icons.setButton(toggle, "Close", "Cancel custom answer")
			box:CaptureFocus()
		end)
	end

	-- Action row ----------------------------------------------------------
	local actions = Instance.new("Frame")
	actions.Name = "Actions"
	actions.Size = UDim2.new(1, 0, 0, 28)
	actions.BackgroundTransparency = 1
	actions.Parent = content

	local actionLayout = Instance.new("UIListLayout")
	actionLayout.FillDirection = Enum.FillDirection.Horizontal
	actionLayout.SortOrder = Enum.SortOrder.LayoutOrder
	actionLayout.Padding = UDim.new(0, 6)
	actionLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	actionLayout.Parent = actions

	local function submitCurrent()
		local value: any = nil

		if customInput and #StringUtil.trim(customInput.Text) &gt; 0 then
			value = "__custom__"
		elseif question.kind == "text" then
			value = textInput and textInput.Text or ""
		elseif question.kind == "number" then
			value = numberInput and tonumber(numberInput.Text) or ""
		elseif question.kind == "multiple" then
			local chosen = {}
			for id, isSelected in selected do
				if isSelected then
					chosen[#chosen + 1] = id
				end
			end
			value = chosen
		else
			for id in pairs(selected) do
				value = id
				break
			end
		end

		-- Custom free text replaces the sentinel the validator expects.
		if value == "__custom__" and customInput then
			value = "__custom__"
		end

		local cleaned = QuestionManager.validate(question, value)
		if cleaned == nil then
			local hint = Instance.new("TextLabel")
			hint.Name = "ValidationHint"
			hint.Size = UDim2.new(1, 0, 0, 18)
			hint.BackgroundTransparency = 1
			hint.TextColor3 = Theme.Colors.Error
			hint.TextSize = Theme.TextSizes.Caption
			hint.Text = question.required and "Choose or enter an answer first." or "That value is not valid."
			hint.Parent = actions
			hint.LayoutOrder = 90
			task.delay(3, function()
				if hint.Parent then
					hint:Destroy()
				end
			end)
			return
		end

		-- Free-form custom text is carried through explicitly.
		if question.kind == "single" and value == "__custom__" and customInput then
			cleaned = StringUtil.trim(customInput.Text)
		elseif question.kind == "multiple" and customInput and #StringUtil.trim(customInput.Text) &gt; 0 then
			cleaned = { StringUtil.trim(customInput.Text) }
		end

		lock()
		QuestionManager.submit(cleaned)
	end

	local order = 0
	order += 1
	local submitButton = pill("Submit answer", true, order, submitCurrent)
	submitButton.Parent = actions

	if question.kind ~= "boolean" and question.kind ~= "confirm" then
		order += 1
		local cancelButton = pill("Cancel", false, order, function()
			lock()
			QuestionManager.cancel("The user cancelled the question.")
		end)
		cancelButton.Parent = actions
	end

	if question.allowAiDecide then
		order += 1
		local decideButton = pill("Let AI decide", false, order, function()
			lock()
			QuestionManager.letAiDecide()
		end)
		decideButton.Parent = actions
	end

	-- Enter submits for text/number questions.
	local listener
	if textInput then
		listener = textInput.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				submitCurrent()
			end
		end)
	elseif numberInput then
		listener = numberInput.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				submitCurrent()
			end
		end)
	end

	liveListeners[card] = listener

	return card, {
		cleanup = function()
			releaseListener(card)
		end,
	}
end

--- Renders the answered state into an existing card.
function QuestionCard.markAnswered(card: Frame, answer: any)
	-- The card is no longer editable, so drop its input listener first.
	releaseListener(card)

	local promptLabel = card:FindFirstChild("Content") and (card.Content:FindFirstChild("Prompt") :: TextLabel?)
	if not promptLabel then
		return
	end
	promptLabel.Text ..= string.format("\n\nAnswer: %s", QuestionManager.formatAnswer(answer))

	local actions = card.Content:FindFirstChild("Actions")
	if actions then
		for _, child in actions:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
	end

	local options = card.Content:FindFirstChild("Options")
	if options then
		options.Visible = false
	end

	card.BackgroundTransparency = 0.4
end

return QuestionCard</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">RetryStatusUI</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / RetryStatusUI
	The retry card shown in the chat while ForgePilot waits on a provider.

	Displays real values only: the live countdown, the real attempt counter and
	the provider's own reason. "Retry Now" still respects a mandatory cooldown.
]]

local Components = require(script.Parent.Components)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local ProviderErrorNormalizer = require(script.Parent.Parent.AI.ProviderErrorNormalizer)
local ProviderRateLimitScheduler = require(script.Parent.Parent.AI.ProviderRateLimitScheduler)
local RetryDelayCalculator = require(script.Parent.Parent.AI.RetryDelayCalculator)
local SmartAutoRetryManager = require(script.Parent.Parent.AI.SmartAutoRetryManager)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)

local RetryStatusUI = {}

local CATEGORY_COLOR: { [string]: Color3 } = {
	RATE_LIMITED = Theme.Extra.Warning,
	CONCURRENCY_LIMITED = Theme.Extra.Warning,
	QUOTA_WINDOW_EXHAUSTED = Theme.Extra.Warning,
	DAILY_QUOTA_EXHAUSTED = Theme.Colors.Error,
	INSUFFICIENT_CREDITS = Theme.Colors.Error,
	PROVIDER_OVERLOADED = Theme.Extra.Warning,
	SERVER_ERROR = Theme.Extra.Warning,
	TIMEOUT = Theme.Extra.Warning,
	NETWORK_ERROR = Theme.Extra.Warning,
	STREAM_INTERRUPTED = Theme.Extra.Warning,
	INVALID_API_KEY = Theme.Colors.Error,
	INVALID_MODEL = Theme.Colors.Error,
	INVALID_ENDPOINT = Theme.Colors.Error,
}

local HEADLINE: { [string]: string } = {
	RATE_LIMITED = "Provider Rate Limited",
	CONCURRENCY_LIMITED = "Too Many Concurrent Requests",
	PROVIDER_OVERLOADED = "Provider Overloaded",
	QUOTA_WINDOW_EXHAUSTED = "Quota Window Exhausted",
	DAILY_QUOTA_EXHAUSTED = "Daily Quota Exhausted",
	INSUFFICIENT_CREDITS = "Insufficient Credits",
	INVALID_API_KEY = "Invalid API Key",
	INVALID_MODEL = "Invalid Model",
	INVALID_ENDPOINT = "Invalid Endpoint",
	CONTEXT_LENGTH_EXCEEDED = "Context Window Exceeded",
	CONTENT_FILTERED = "Blocked By Content Filter",
	SERVER_ERROR = "Provider Server Error",
	TIMEOUT = "Request Timed Out",
	NETWORK_ERROR = "Network Error",
	STREAM_INTERRUPTED = "Stream Interrupted",
}

--- Builds the card and returns (frame, api).
function RetryStatusUI.build(options: {
	operationId: string,
	providerName: string,
	model: string,
	category: string,
	reason: string,
	maxRetries: number,
	providerId: string?,
	endpoint: string?,
	attempt: number,
	delaySeconds: number,
	paused: boolean,
	pauseReason: string?,
	onCancel: (() -> ())?,
}): (Frame, any)
	local card = Instance.new("Frame")
	card.Name = "RetryCard"
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Theme.Extra.Surface
	card.BorderSizePixel = 0
	card.LayoutOrder = 900
	card.ClipsDescendants = false
	Theme.corner(Theme.Metrics.Radius).Parent = card

	local colour = CATEGORY_COLOR[options.category] or Theme.Extra.Warning
	Theme.stroke(Theme.withAlpha(colour, 0.5)).Parent = card
	Theme.padding(12).Parent = card

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = card

	-- Header ------------------------------------------------------------
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 20)
	header.BackgroundTransparency = 1
	header.LayoutOrder = 1
	header.Parent = card

	local icon = Icons.glyph("Warning", 14, colour)
	icon.Name = "Icon"
	icon.Size = UDim2.fromOffset(17, 17)
	icon.Position = UDim2.fromOffset(0, 1)
	icon.Parent = header

	local headline = Theme.label(
		HEADLINE[options.category] or "Provider Error",
		{ size = Theme.TextSizes.Body, font = Theme.Fonts.Bold, color = colour }
	)
	headline.Name = "Headline"
	headline.Position = UDim2.fromOffset(22, 0)
	headline.Size = UDim2.new(1, -22, 1, 0)
	headline.TextTruncate = Enum.TextTruncate.AtEnd
	headline.Parent = header

	-- Facts ---------------------------------------------------------------
	local facts = Theme.label("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Colors.SecondaryText,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	facts.Name = "Facts"
	facts.Size = UDim2.new(1, 0, 0, 0)
	facts.AutomaticSize = Enum.AutomaticSize.Y
	facts.LayoutOrder = 2
	facts.Parent = card

	local countdownLabel = Theme.label("", {
		size = Theme.TextSizes.Body,
		font = Theme.Fonts.Bold,
		color = colour,
	})
	countdownLabel.Name = "Countdown"
	countdownLabel.Size = UDim2.new(1, 0, 0, 0)
	countdownLabel.AutomaticSize = Enum.AutomaticSize.Y
	countdownLabel.LayoutOrder = 3
	countdownLabel.Parent = card

	local statusLabel = Theme.label("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Extra.Muted,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	statusLabel.Name = "Status"
	statusLabel.Size = UDim2.new(1, 0, 0, 0)
	statusLabel.AutomaticSize = Enum.AutomaticSize.Y
	statusLabel.LayoutOrder = 4
	statusLabel.Parent = card

	-- Progress bar --------------------------------------------------------
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.new(1, 0, 0, 5)
	track.LayoutOrder = 5
	track.BackgroundColor3 = Theme.Extra.SurfaceRaised
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.Parent = card
	Theme.corner(3).Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = colour
	fill.BorderSizePixel = 0
	fill.Parent = track

	-- Details ------------------------------------------------------------
	local details = Theme.label("", {
		size = 10,
		color = Theme.Extra.Muted,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	details.Name = "Details"
	details.Size = UDim2.new(1, 0, 0, 0)
	details.AutomaticSize = Enum.AutomaticSize.Y
	details.Visible = false
	details.LayoutOrder = 6
	details.Parent = card

	-- Actions ------------------------------------------------------------
	local actions = Instance.new("Frame")
	actions.Name = "Actions"
	actions.Size = UDim2.new(1, 0, 0, 28)
	actions.BackgroundTransparency = 1
	actions.LayoutOrder = 7
	actions.Parent = card
	local actionLayout = Instance.new("UIListLayout")
	actionLayout.FillDirection = Enum.FillDirection.Horizontal
	actionLayout.SortOrder = Enum.SortOrder.LayoutOrder
	actionLayout.Padding = UDim.new(0, 6)
	actionLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	actionLayout.Parent = actions

	local retryNowButton = Components.textButton("Retry Now", { order = 1 })
	retryNowButton.Size = UDim2.fromOffset(88, 26)
	retryNowButton.Parent = actions

	local cancelButton = Components.textButton("Cancel Retry", { order = 2 })
	cancelButton.Size = UDim2.fromOffset(96, 26)
	cancelButton.Parent = actions

	local detailsButton = Components.textButton("Show Details", { order = 3 })
	detailsButton.Size = UDim2.fromOffset(100, 26)
	detailsButton.Parent = actions
	for _, button in { retryNowButton, cancelButton, detailsButton } do
		Theme.flexItem(button, 1, 1)
		button.TextSize = 11
		button.TextTruncate = Enum.TextTruncate.AtEnd
	end

	--=============================================================================
	-- STATE
	--=============================================================================

	local state = {
		attempt = options.attempt,
		maxRetries = options.maxRetries,
		delaySeconds = options.delaySeconds,
		deadline = if options.delaySeconds > 0 then os.clock() + options.delaySeconds else nil,
		paused = options.paused,
		pauseReason = options.pauseReason,
		finished = false,
	}

	local function renderFacts()
		local lines: { string } = {
			string.format("Provider: %s", options.providerName),
			string.format("Model: %s", options.model ~= "" and options.model or "(not set)"),
		}
		if options.reason and #options.reason > 0 then
			lines[#lines + 1] = string.format("Reason: %s", options.reason)
		end
		facts.Text = table.concat(lines, "\n")
	end

	local function renderStatus()
		if state.finished then
			statusLabel.Text = "No more automatic retries."
			statusLabel.TextColor3 = Theme.Colors.Error
			return
		end
		if state.paused then
			statusLabel.Text = string.format(
				"Paused. %s",
				state.pauseReason or "The provider requires a longer wait than the automatic limit."
			)
			statusLabel.TextColor3 = Theme.Extra.Warning
			return
		end
		statusLabel.Text = string.format("Retry: %d / %d", state.attempt, state.maxRetries)
		statusLabel.TextColor3 = Theme.Extra.Muted
	end

	local heartbeat: thread? = nil
	local generation = 0
	local destroyed = false

	local function stopHeartbeat()
		generation += 1
		if heartbeat then
			pcall(task.cancel, heartbeat)
			heartbeat = nil
		end
	end

	local function paintCountdown()
		if state.paused or state.finished or not state.deadline then
			countdownLabel.Text = if state.paused then "Waiting for the provider" else ""
			Theme.tween(fill, { Size = UDim2.fromScale(1, 1) }, Theme.Motion.Normal):Play()
			return
		end

		local remaining = math.max(0, state.deadline - os.clock())
		local total = math.max(0.001, state.delaySeconds)
		local ratio = math.clamp(1 - remaining / total, 0, 1)

		countdownLabel.Text = if remaining > 0.05
			then string.format("Next Attempt: %s", Time.formatDuration(remaining))
			else "Next Attempt: now"
		Theme.tween(fill, { Size = UDim2.fromScale(ratio, 1) }, 0.15):Play()

	end

	local function renderCountdown()
		stopHeartbeat()
		if destroyed then return end
		paintCountdown()
		if state.paused or state.finished or not state.deadline then return end
		local current = generation
		-- Painting never schedules another worker. One deferred ticker yields
		-- between updates and is replaced only when a new attempt is scheduled.
		heartbeat = task.defer(function()
			while not destroyed and generation == current and card.Parent and not state.finished and not state.paused and state.deadline do
				paintCountdown()
				if state.deadline - os.clock() <= 0.05 then break end
				task.wait(0.25)
			end
			if generation == current then heartbeat = nil end
		end)
	end

	local function renderDetails()
		local operation = SmartAutoRetryManager.getOperation(options.operationId)
		local lines: { string } = {
			string.format("Operation: %s", options.operationId),
			string.format("Category: %s", options.category),
		}
		if operation then
			lines[#lines + 1] = string.format("Attempts made: %d", operation.attemptsMade)
			lines[#lines + 1] = string.format("Elapsed: %.1fs", operation.totalElapsedSeconds)
			if operation.upstreamRetryNotices > 0 then
				lines[#lines + 1] = string.format(
					"Upstream retries reported: %d (not issued by ForgePilot)",
					operation.upstreamRetryNotices
				)
			end
			for _, attempt in operation.attempts do
				lines[#lines + 1] = string.format(
					"#%d  %s  %s  delay %s (%s)",
					attempt.index,
					if attempt.ok then "ok" else "failed",
					tostring(attempt.status or attempt.category or "-"),
					string.format("%.1fs", attempt.delaySeconds),
					attempt.delaySource
				)
			end
		end
		if options.providerId then
			lines[#lines + 1] = ProviderRateLimitScheduler.describe(options.providerId, options.model, options.endpoint)
		end
		details.Text = table.concat(lines, "\n")
	end

	--=============================================================================
	-- ACTIONS
	--=============================================================================

	detailsButton.MouseButton1Click:Connect(function()
		details.Visible = not details.Visible
		detailsButton.Text = if details.Visible then "Hide Details" else "Show Details"
		if details.Visible then
			renderDetails()
		end
	end)

	cancelButton.MouseButton1Click:Connect(function()
		if destroyed or state.finished then return end
		state.finished = true
		stopHeartbeat()
		SmartAutoRetryManager.cancel(options.operationId, "Cancelled by the user from the retry card.")
		if options.onCancel then
			options.onCancel()
		end
		card.BackgroundTransparency = 0.5
		countdownLabel.Text = "Retry cancelled."
		renderStatus()
		retryNowButton.Active = false
		cancelButton.Active = false
		retryNowButton.Interactable = false
		cancelButton.Interactable = false
	end)

	retryNowButton.MouseButton1Click:Connect(function()
		if destroyed or state.finished then return end
		-- A mandatory provider cooldown is never overridden by this button.
		if options.providerId then
			local cooldown = ProviderRateLimitScheduler.getCooldown(options.providerId, options.model, options.endpoint)
			if cooldown.active then
				EventBus.emit(EventBus.Events.Toast, {
					kind = "warning",
					message = string.format(
						"The provider requires another %.0fs. ForgePilot will not send the request early.",
						cooldown.remainingSeconds
					),
				})
				return
			end
		end
		if state.deadline then
			-- The retry controller owns this deadline; keep the real countdown.
			EventBus.emit(EventBus.Events.Toast, {
				kind = "info",
				message = string.format("The next attempt is scheduled in %.0fs.", math.max(0, state.deadline - os.clock())),
			})
			return
		end
		retryNowButton.Text = "Waiting…"
		retryNowButton.Active = false
		task.delay(0.5, function()
			if retryNowButton.Parent then
				retryNowButton.Text = "Retry Now"
				retryNowButton.Active = true
			end
		end)
	end)

	--=============================================================================
	-- EVENTS
	--=============================================================================

	local unsubs: { () -> () } = {}

	unsubs[#unsubs + 1] = EventBus.on(SmartAutoRetryManager.STATE_EVENT, function(payload)
		if payload.operationId ~= options.operationId then
			return
		end

		if payload.state == "RETRY_SCHEDULED" then
			state.attempt = tonumber(payload.attempt) or state.attempt
			state.delaySeconds = tonumber(payload.delaySeconds) or state.delaySeconds
			state.deadline = if state.delaySeconds > 0 then os.clock() + state.delaySeconds else nil
			state.paused = false
			renderStatus()
			renderCountdown()
		elseif payload.state == "RETRYING" then
			stopHeartbeat()
			state.deadline = nil
			countdownLabel.Text = string.format(
				"Retrying request · Attempt %d / %d",
				state.attempt,
				state.maxRetries
			)
			renderStatus()
		elseif payload.state == "WAITING_FOR_QUOTA" or payload.state == "RATE_LIMIT_DETECTED" then
			stopHeartbeat()
			state.deadline = nil
			state.paused = payload.paused == true
			state.pauseReason = payload.pauseReason
			countdownLabel.Text = ""
			renderStatus()
		elseif payload.state == "PROVIDER_RECOVERED" then
			state.finished = true
			stopHeartbeat()
			headline.Text = "Provider Recovered"
			headline.TextColor3 = Theme.Colors.Success
			countdownLabel.Text = "Continuing task."
			statusLabel.TextColor3 = Theme.Colors.Success
			Theme.tween(card, { BackgroundTransparency = 0.4 }, Theme.Motion.Slow):Play()
		elseif payload.state == "RETRIES_EXHAUSTED" then
			state.finished = true
			stopHeartbeat()
			headline.Text = "Retries Exhausted"
			headline.TextColor3 = Theme.Colors.Error
			countdownLabel.Text = payload.reason or "No further automatic attempts."
			renderStatus()
			if details.Visible then
				renderDetails()
			end
		elseif payload.state == "RETRY_CANCELLED" then
			state.finished = true
			stopHeartbeat()
			headline.Text = "Retry Cancelled"
			countdownLabel.Text = payload.reason or "Cancelled."
			renderStatus()
		end
	end)

	--=============================================================================
	-- INIT
	--=============================================================================
	card.Destroying:Connect(function()
		destroyed = true
		stopHeartbeat()
		for _, unsubscribe in unsubs do unsubscribe() end
	end)

	renderFacts()
	renderStatus()
	if not state.paused then
		renderCountdown()
	end

	return card, {
		destroy = function()
			destroyed = true
			stopHeartbeat()
			for _, unsubscribe in unsubs do
				unsubscribe()
			end
			if card.Parent then
				card:Destroy()
			end
		end,
		setAttempt = function(attempt: number, delaySeconds: number)
			if destroyed or state.finished then return end
			state.attempt = attempt
			state.delaySeconds = delaySeconds
			state.deadline = if delaySeconds > 0 then os.clock() + delaySeconds else nil
			renderStatus()
			renderCountdown()
		end,
		headline = headline,
		setCategory = function(category: string, reason: string)
			headline.Text = HEADLINE[category] or "Provider Error"
			options.category = category
			options.reason = reason
			renderFacts()
			renderDetails()
		end,
		remedy = function()
			return ProviderErrorNormalizer.remedy(options.category)
		end,
		RetryDelayCalculator = RetryDelayCalculator,
	}
end

return RetryStatusUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">SettingsView</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / SettingsView
	General, AI, Agent and Data sections. The provider manager lives in its own
	tab inside this view so the settings screen stays navigable.
]]

local Components = require(script.Parent.Components)
local ContextManager = require(script.Parent.Parent.AI.ContextManager)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local ProviderView = require(script.Parent.ProviderView)
local SessionManager = require(script.Parent.Parent.Core.SessionManager)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local SmartRetry = require(script.Parent.Parent.Core.SmartRetrySettings)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local ToolValidator = require(script.Parent.Parent.Roblox.ToolValidator)

local AgentAccessView = require(script.Parent.AgentAccessView)
local SettingsView = {}

local SECTIONS = { "General", "AI & Provider", "Agent Access", "Agent", "Retry", "Data" }

function SettingsView.build(parent: GuiObject): (Frame, any)
	local view = Instance.new("Frame")
	view.Name = "SettingsView"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	Theme.passThrough(view)
	view.Parent = parent

	local header = Instance.new("Frame")
	header.Name = "SettingsHeader"
	header.Size = UDim2.new(1, 0, 0, 50)
	Theme.passThrough(header)
	header.Parent = view
	local breadcrumb = Theme.label("Settings", { size = Theme.TextSizes.Caption, color = Theme.Extra.Muted })
	breadcrumb.Name = "Breadcrumb"
	breadcrumb.Size = UDim2.new(1, 0, 0, 16)
	breadcrumb.Parent = header
	local pageTitle = Theme.label("General", { size = Theme.TextSizes.Heading, font = Theme.Fonts.Medium, truncate = true })
	pageTitle.Name = "PageTitle"
	pageTitle.Position = UDim2.fromOffset(0, 19)
	pageTitle.Size = UDim2.new(1, 0, 0, 26)
	pageTitle.Parent = header

	local sectionRow = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	sectionRow.Name = "SettingsNavigation"
	sectionRow.BackgroundTransparency = 1
	sectionRow.ScrollingDirection = Enum.ScrollingDirection.Y
	sectionRow.Parent = view
	Theme.listLayout(4).Parent = sectionRow

	local pageHolder = Instance.new("Frame")
	pageHolder.Name = "Page"
	Theme.passThrough(pageHolder)
	pageHolder.ClipsDescendants = true
	pageHolder.Parent = view

	local sectionButtons: { [string]: TextButton } = {}
	local sectionLabels: { [string]: TextLabel } = {}
	local sectionIcons: { [string]: TextLabel } = {}
	local sectionMarks: { [string]: Frame } = {}
	local compactPicker: Frame? = nil
	local setCompactSelection: any = nil
	local currentSection = SECTIONS[1]
	local function layoutShell()
		local wide = view.AbsoluteSize.X >= 620
		breadcrumb.Visible = wide
		pageTitle.Text = if wide then currentSection else "Settings"
		pageTitle.Position = UDim2.fromOffset(0, if wide then 19 else 0)
		sectionRow.Visible = wide
		if compactPicker then
			compactPicker.Visible = not wide
			compactPicker.Position = UDim2.fromOffset(0, 34)
		end
		if wide then
			sectionRow.Position = UDim2.fromOffset(0, 56)
			sectionRow.Size = UDim2.new(0, 140, 1, -56)
			pageHolder.Position = UDim2.fromOffset(154, 56)
			pageHolder.Size = UDim2.new(1, -154, 1, -56)
		else
			pageHolder.Position = UDim2.fromOffset(0, 70)
			pageHolder.Size = UDim2.new(1, 0, 1, -70)
		end
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutShell)

	--=========================================================================
	-- GENERAL
	--=========================================================================

	local function buildGeneral(): ScrollingFrame
		local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
		scroll.BackgroundTransparency = 1
		Theme.passThrough(scroll)
		Theme.padding(6).Parent = scroll
		Theme.listLayout(10).Parent = scroll

		local _, body = (function()
			local card, cardBody = Components.section("Assistant", { order = 1 })
			card.Parent = scroll
			return card, cardBody
		end)()

		local nameRow, nameHolder = Components.field("AI Display Name", {
			hint = "Shown in the chat and window title. Independent of the provider name.",
		})
		nameRow.Parent = body

		local nameBox = Theme.input(SettingsManager.getValue("assistantName"))
		nameBox.Name = "AssistantName"
		nameBox.Text = SettingsManager.getValue("assistantName")
		nameBox.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
		nameBox.Parent = nameHolder

		nameBox.FocusLost:Connect(function()
			if nameBox.Text ~= SettingsManager.getValue("assistantName") then
				SettingsManager.setAssistantName(nameBox.Text)
				nameBox.Text = SettingsManager.getValue("assistantName")
				EventBus.emit(EventBus.Events.Toast, {
					kind = "success",
					message = string.format('Assistant renamed to "%s".', SettingsManager.getValue("assistantName")),
				})
			end
		end)

		local themeRow = Components.field("Theme")
		local themeHolder = themeRow:FindFirstChild("Value")
		if themeHolder then themeHolder:Destroy() end
		themeRow.Parent = body
		local themeNote = Theme.label(
			"A dark theme with a purple accent and comfortable contrast.",
			{ size = Theme.TextSizes.Caption, color = Theme.Extra.Muted, alignY = Enum.TextYAlignment.Top, wrap = true }
		)
		themeNote.Size = UDim2.new(1, 0, 0, 0)
		themeNote.AutomaticSize = Enum.AutomaticSize.Y
		themeNote.LayoutOrder = 2
		themeNote.Parent = themeRow

		local languageRow = Components.field("Language")
		local languageHolder = languageRow:FindFirstChild("Value")
		if languageHolder then languageHolder:Destroy() end
		languageRow.Parent = body
		local languageNote = Theme.label(
			"The interface is English only right now. The model itself answers in whatever language you ask for.",
			{ size = Theme.TextSizes.Caption, color = Theme.Extra.Muted, alignY = Enum.TextYAlignment.Top, wrap = true }
		)
		languageNote.Size = UDim2.new(1, 0, 0, 0)
		languageNote.AutomaticSize = Enum.AutomaticSize.Y
		languageNote.LayoutOrder = 2
		languageNote.Parent = languageRow

		local animationsRow = Components.toggle("Animations", SettingsManager.getValue("animations"), function(value)
			SettingsManager.setValue("animations", value)
		end, { hint = "Hover fades, toasts and panel transitions." })
		animationsRow.Parent = body

		local reducedRow = Components.toggle("Reduce motion", SettingsManager.getValue("reducedMotion"), function(value)
			SettingsManager.setValue("reducedMotion", value)
		end, { hint = "Disables non-essential animation." })
		reducedRow.Parent = body

		local confirmRow = Components.toggle(
			"Confirm tool calls",
			SettingsManager.getValue("confirmToolCalls"),
			function(value)
				SettingsManager.setValue("confirmToolCalls", value)
			end,
			{ hint = "Ask before running any write tool." }
		)
		confirmRow.Parent = body

		local destructiveRow = Components.toggle(
			"Confirm destructive actions",
			SettingsManager.getValue("confirmDestructive"),
			function(value)
				SettingsManager.setValue("confirmDestructive", value)
			end,
			{ hint = "Always ask before deletions, script replacement and terrain fills." }
		)
		destructiveRow.Parent = body

		return scroll
	end

	--=========================================================================
	-- AGENT
	--=========================================================================

	local function buildAgent(): ScrollingFrame
		local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
		scroll.BackgroundTransparency = 1
		Theme.passThrough(scroll)
		Theme.padding(6).Parent = scroll
		Theme.listLayout(10).Parent = scroll

		local card1, body1 = Components.section("Behaviour", { order = 1 })
		card1.Parent = scroll

		local modeField, _, _, selectMode = Components.dropdown(
			"Default mode",
			{ "Plan", "Build" },
			function(selected)
				SettingsManager.setValue("defaultMode", if selected == "Build" then "build" else "plan")
			end
		)
		modeField.Parent = body1
		selectMode(if SettingsManager.getValue("defaultMode") == "build" then "Build" else "Plan")

		local autoAskRow = Components.toggle("Auto-ask", SettingsManager.getValue("autoAsk"), function(value)
			SettingsManager.setValue("autoAsk", value)
		end, { hint = "Let the assistant pause and ask when a decision materially changes the result." })
		autoAskRow.Parent = body1

		local aiDecideRow = Components.toggle(
			"Let AI Decide",
			SettingsManager.getValue("letAiDecide"),
			function(value)
				SettingsManager.setValue("letAiDecide", value)
			end,
			{ hint = "Show the \"Let AI decide\" button on questions. Consequential actions still require approval." }
		)
		aiDecideRow.Parent = body1

		local readOnlyRow = Components.toggle(
			"Auto-approve read-only tools",
			SettingsManager.getValue("autoApproveReadOnly"),
			function(value)
				SettingsManager.setValue("autoApproveReadOnly", value)
			end
		)
		readOnlyRow.Parent = body1

		local card2, body2 = Components.section("Limits", { order = 2 })
		card2.Parent = scroll

		local maxToolsRow, maxToolsHolder = Components.field("Maximum tool calls per task", {
			hint = "The agent stops and reports when the limit is reached.",
		})
		maxToolsRow.Parent = body2
		local maxToolsBox = Theme.input(tostring(SettingsManager.getValue("maxToolCalls")))
		maxToolsBox.Size = UDim2.fromOffset(100, Theme.Metrics.InputHeight)
		maxToolsBox.Parent = maxToolsHolder
		maxToolsBox.FocusLost:Connect(function(enterPressed)
			local parsed = tonumber(maxToolsBox.Text)
			if parsed and enterPressed then
				SettingsManager.setValue("maxToolCalls", math.clamp(math.floor(parsed), 1, 500))
				maxToolsBox.Text = tostring(SettingsManager.getValue("maxToolCalls"))
			end
		end)

		local maxActionsRow, maxActionsHolder = Components.field("Maximum build actions per task")
		maxActionsRow.Parent = body2
		local maxActionsBox = Theme.input(tostring(SettingsManager.getValue("maxBuildActions")))
		maxActionsBox.Size = UDim2.fromOffset(100, Theme.Metrics.InputHeight)
		maxActionsBox.Parent = maxActionsHolder
		maxActionsBox.FocusLost:Connect(function(enterPressed)
			local parsed = tonumber(maxActionsBox.Text)
			if parsed and enterPressed then
				SettingsManager.setValue("maxBuildActions", math.clamp(math.floor(parsed), 1, 5000))
				maxActionsBox.Text = tostring(SettingsManager.getValue("maxBuildActions"))
			end
		end)

		local card3, body3 = Components.section("Tool permissions", {
			subtitle = "Disable a tool to block it entirely. Write tools are additionally gated by mode.",
			order = 3,
		})
		card3.Parent = scroll

		local permissionsBody = Instance.new("Frame")
		permissionsBody.Name = "Permissions"
		permissionsBody.Size = UDim2.new(1, 0, 0, 0)
		permissionsBody.AutomaticSize = Enum.AutomaticSize.Y
		permissionsBody.BackgroundTransparency = 1
		Theme.passThrough(permissionsBody)
		permissionsBody.Parent = body3
		Theme.listLayout(4).Parent = permissionsBody

		for index, tool in ToolValidator.ordered do
			local permissions = SettingsManager.getValue("toolPermissions")
			local allowed = permissions[tool.name] ~= false

			local chip = Theme.textButton(
				string.format("%s %s", if allowed then "✓" else "✕", tool.name),
				{ height = 22 }
			)
			chip.Name = tool.name
			chip.LayoutOrder = index
			chip.TextSize = Theme.TextSizes.Caption
			chip.TextXAlignment = Enum.TextXAlignment.Left
			chip.BackgroundColor3 = if allowed then Theme.withAlpha(Theme.Colors.Success, 0.16) else Theme.Extra.SurfaceRaised
			chip.TextColor3 = if allowed then Theme.Colors.Success else Theme.Extra.Muted
			chip.Parent = permissionsBody

			chip.MouseButton1Click:Connect(function()
				local current = SettingsManager.getValue("toolPermissions")
				local next = current[tool.name] ~= false
				current[tool.name] = next
				SettingsManager.setValue("toolPermissions", current)
				chip.Text = string.format("%s %s", if next then "✓" else "✕", tool.name)
				chip.BackgroundColor3 = if next then Theme.withAlpha(Theme.Colors.Success, 0.16) else Theme.Extra.SurfaceRaised
				chip.TextColor3 = if next then Theme.Colors.Success else Theme.Extra.Muted
			end)
		end

		return scroll
	end

	--=========================================================================
	-- SMART AUTO RETRY
	--=========================================================================

	local function numberRow(parent: Instance, label: string, value: number, hint: string?, order: number): (TextBox, (number) -> ())
		local row, holder = Components.field(label, { hint = hint })
		row.LayoutOrder = order
		local box = Theme.input(tostring(value))
		box.Name = "Input"
		box.Size = UDim2.fromOffset(110, Theme.Metrics.InputHeight)
		box.Parent = holder

		local function commit()
			local parsed = tonumber(box.Text)
			if parsed then
				SmartRetry.set(label, math.clamp(parsed, 0, 3600))
				box.Text = tostring(SmartRetry.get(label))
			else
				box.Text = tostring(SmartRetry.get(label))
			end
		end

		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				commit()
			end
		end)

		row.Parent = parent
		return box, commit
	end

	local function buildRetry(): ScrollingFrame
		-- Declared up front: the strategy dropdown updates the schedule preview.
		local schedulePreview = Theme.label("", {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
			alignY = Enum.TextYAlignment.Top,
			wrap = true,
		})

		local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
		scroll.BackgroundTransparency = 1
		Theme.passThrough(scroll)
		Theme.padding(6).Parent = scroll
		Theme.listLayout(10).Parent = scroll

		local card1, body1 = Components.section("Smart Auto Retry", {
			subtitle = "One retry controller runs per operation, so retry loops can never nest.",
			order = 1,
		})
		card1.Parent = scroll

		local enabledRow = Components.toggle(
			"Enable Auto Retry",
			SmartRetry.get("enabled") == true,
			function(value)
				SmartRetry.set("enabled", value)
			end,
			{ hint = "When off, a provider failure is reported immediately with no automatic retry." }
		)
		enabledRow.Parent = body1

		local strategyField = Components.dropdown(
			"Retry Strategy",
			{ "Adaptive Smart Retry", "Exponential", "Linear", "Custom sequence" },
			function(selected)
				local key = if selected == "Adaptive Smart Retry"
					then "adaptive"
					elseif selected == "Linear" then "linear" elseif selected == "Custom sequence" then "custom" else "exponential"
				SmartRetry.set("strategy", key)
				schedulePreview.Text = SmartRetry.describe()
			end
		)
		strategyField.Parent = body1

		numberRow(body1, "Maximum Retries", SmartRetry.get("maxRetries") or 5, "Additional attempts after the first request.", 3)
		numberRow(body1, "Initial Delay (s)", SmartRetry.get("initialDelaySeconds") or 2, nil, 4)
		numberRow(body1, "Backoff Multiplier", SmartRetry.get("multiplier") or 2, "Exponential growth per retry.", 5)
		numberRow(body1, "Linear Step (s)", SmartRetry.get("linearStepSeconds") or 3, "Used by the Linear strategy.", 6)
		numberRow(body1, "Maximum Delay (s)", SmartRetry.get("maxDelaySeconds") or 120, nil, 7)
		numberRow(body1, "Maximum Automatic Wait (s)", SmartRetry.get("maxAutoWaitSeconds") or 120,
			"Past this, retries PAUSE rather than violating a provider cooldown.", 8)
		numberRow(body1, "Jitter (%)", SmartRetry.get("jitterPercent") or 25,
			"Randomised spread applied to non-mandatory waits.", 9)

		local customRow, customHolder = Components.field("Custom Delay Sequence", {
			hint = "Comma-separated seconds, used when the Custom strategy is selected. Example: 3, 6, 12, 30, 60",
		})
		customRow.Parent = body1

		local customBox = Theme.input("3, 6, 12, 30, 60")
		customBox.Name = "CustomSequence"
		customBox.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
		customBox.Parent = customHolder
		customBox.FocusLost:Connect(function(enterPressed)
			if not enterPressed then
				return
			end
			local sequence: { number } = {}
			for token in string.gmatch(customBox.Text, "[^,%s]+") do
				local value = tonumber(token)
				if value then
					sequence[#sequence + 1] = value
				end
			end
			SmartRetry.set("customSequence", if #sequence > 0 then sequence else nil)
			schedulePreview.Text = SmartRetry.describe()
		end)

		local behaviourRow = Components.toggle(
			"Respect Retry-After",
			SmartRetry.get("respectRetryAfter") ~= false,
			function(value)
				SmartRetry.set("respectRetryAfter", value)
			end,
			{ hint = "Honours Retry-After seconds, HTTP-date forms and retry-after-ms." }
		)
		behaviourRow.Parent = body1

		local cooldownRow = Components.toggle(
			"Dynamic Provider Cooldown",
			SmartRetry.get("dynamicCooldown") ~= false,
			function(value)
				SmartRetry.set("dynamicCooldown", value)
			end,
			{ hint = "After a rate-limit error, hold requests until the window clears." }
		)
		cooldownRow.Parent = body1

		local schedulerRow = Components.toggle(
			"Rate Limit Scheduler",
			SmartRetry.get("rateLimitScheduler") ~= false,
			function(value)
				SmartRetry.set("rateLimitScheduler", value)
				local ProviderRateLimitScheduler = require(script.Parent.Parent.AI.ProviderRateLimitScheduler)
				ProviderRateLimitScheduler.setEnabled(value)
			end,
			{ hint = "Sliding-window admission control and a FIFO queue per provider." }
		)
		schedulerRow.Parent = body1

		local multilingualRow = Components.toggle(
			"Multilingual Error Detection",
			SmartRetry.get("multilingualErrors") ~= false,
			function(value)
				SmartRetry.set("multilingualErrors", value)
			end,
			{ hint = "Classifies English, Simplified/Traditional Chinese, Japanese, Korean, Indonesian and Spanish provider messages." }
		)
		multilingualRow.Parent = body1

		local countdownRow = Components.toggle(
			"Show Retry Countdown",
			SmartRetry.get("showCountdown") ~= false,
			function(value)
				SmartRetry.set("showCountdown", value)
			end,
			{ hint = "Renders the live countdown card in the chat." }
		)
		countdownRow.Parent = body1

		local logsRow = Components.toggle(
			"Show Retry Logs",
			SmartRetry.get("showRetryLogs") ~= false,
			function(value)
				SmartRetry.set("showRetryLogs", value)
			end,
			{ hint = "Writes retry, cooldown and rate-limit events to the Logs tab." }
		)
		logsRow.Parent = body1

		-- Preview ------------------------------------------------------------
		local card2, body2 = Components.section("Schedule preview", {
			subtitle = "The exact delays the current settings produce, before any jitter.",
			order = 2,
		})
		card2.Parent = scroll

		schedulePreview.Name = "Preview"
		schedulePreview.Size = UDim2.new(1, 0, 0, 0)
		schedulePreview.AutomaticSize = Enum.AutomaticSize.Y
		schedulePreview.Parent = body2

		local refreshRow, addRefreshButton = Components.buttonRow({ columns = 2 })
		refreshRow.Parent = body2
		local refreshButton = addRefreshButton("Recalculate", { order = 1 })
		local resetButton = addRefreshButton("Reset Defaults", { order = 2 })

		local RetryDelayCalculator = require(script.Parent.Parent.AI.RetryDelayCalculator)

		local function recalculate()
			local config = RetryDelayCalculator.fromSettings(SmartRetry.get())
			local lines: { string } = {}
			for attempt = 1, math.min(5, config.maxRetries) do
				local seconds: number
				local source: string
				if config.strategy == "linear" then
					seconds = RetryDelayCalculator.linear(attempt, config)
					source = "linear"
				elseif config.strategy == "custom" then
					seconds = RetryDelayCalculator.custom(attempt, config)
					source = "custom"
				else
					seconds = RetryDelayCalculator.exponential(attempt, config)
					source = "exponential"
				end
				lines[#lines + 1] = string.format("Retry %d: %.0fs (%s)", attempt, seconds, source)
			end
			if #lines == 0 then
				lines[1] = "Automatic retry is disabled."
			end
			schedulePreview.Text = table.concat(lines, "\n")
				.. string.format(
					"\n\nJitter: %.0f%% · Mandatory provider waits are never shortened by jitter.",
					config.jitterPercent
				)
		end

		refreshButton.MouseButton1Click:Connect(recalculate)
		resetButton.MouseButton1Click:Connect(function()
			SmartRetry.resetDefaults()
			recalculate()
			EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "retryReset" })
			EventBus.emit(EventBus.Events.Toast, { kind = "success", message = "Retry settings reset to defaults." })
		end)

		recalculate()

		-- Current scheduler state ---------------------------------------------
		local card3, body3 = Components.section("Current rate-limit state", { order = 3 })
		card3.Parent = scroll

		local stateLabel = Theme.label("", {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
			alignY = Enum.TextYAlignment.Top,
			wrap = true,
		})
		stateLabel.Name = "SchedulerState"
		stateLabel.Size = UDim2.new(1, 0, 0, 0)
		stateLabel.AutomaticSize = Enum.AutomaticSize.Y
		stateLabel.Parent = body3

		local function refreshScheduler()
			local profile = SettingsManager.getActiveProvider()
			if not profile then
				stateLabel.Text = "No provider selected."
				return
			end
			local ProviderRateLimitScheduler = require(script.Parent.Parent.AI.ProviderRateLimitScheduler)
			stateLabel.Text = ProviderRateLimitScheduler.describe(profile.id, profile.modelId, profile.baseUrl)
				.. "\n\nForgePilot only sees requests it sent itself. Requests from other apps using the same account are invisible, so learned cooldowns are conservative and labelled as estimates."
		end

		local schedulerRefresh = Components.textButton("Refresh", { order = 1 })
		schedulerRefresh.Parent = body3
		schedulerRefresh.MouseButton1Click:Connect(refreshScheduler)

		local clearCooldown = Components.textButton("Clear Cooldown", { order = 2 })
		clearCooldown.Parent = body3
		clearCooldown.MouseButton1Click:Connect(function()
			local profile = SettingsManager.getActiveProvider()
			if profile then
				local ProviderRateLimitScheduler = require(script.Parent.Parent.AI.ProviderRateLimitScheduler)
				ProviderRateLimitScheduler.clearCooldown(profile.id, profile.modelId, profile.baseUrl)
				ProviderRateLimitScheduler.cancelQueue(profile.id, profile.modelId, profile.baseUrl, "Cleared by the user.")
				refreshScheduler()
			end
		end)

		refreshScheduler()

		-- Per-provider overrides ---------------------------------------------
		local card4, body4 = Components.section("Per-provider overrides", {
			subtitle = "One provider can behave differently without affecting the others.",
			order = 4,
		})
		card4.Parent = scroll

		local overrideBody = Instance.new("Frame")
		overrideBody.Name = "Overrides"
		overrideBody.Size = UDim2.new(1, 0, 0, 0)
		overrideBody.AutomaticSize = Enum.AutomaticSize.Y
		overrideBody.BackgroundTransparency = 1
		Theme.passThrough(overrideBody)
		overrideBody.Parent = body4
		Theme.listLayout(6).Parent = overrideBody

		local function renderOverrides()
			for _, child in overrideBody:GetChildren() do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end

			local overrides = SmartRetry.get("providerOverrides") or {}
			local providers = SettingsManager.getValue("providers") or {}
			if #providers == 0 then
				local empty = Theme.label("No provider profiles yet.", {
					size = Theme.TextSizes.Caption,
					color = Theme.Extra.Muted,
				})
				empty.Size = UDim2.new(1, 0, 0, 18)
				empty.Parent = overrideBody
				return
			end

			for index, profile in providers do
				local providerOverride = overrides[profile.id] or {}
				local retries = tonumber(providerOverride.maxRetries) or SmartRetry.get("maxRetries") or 5

				local row = Instance.new("Frame")
				row.Name = "Override_" .. profile.id
				row.LayoutOrder = index
				row.Size = UDim2.new(1, 0, 0, 30)
				row.BackgroundTransparency = 1
				Theme.passThrough(row)
				row.Parent = overrideBody

				local label = Theme.label(profile.displayName, { size = Theme.TextSizes.Caption, truncate = true })
				label.Name = "Label"
				label.Size = UDim2.new(0.5, -60, 1, 0)
				label.Position = UDim2.fromOffset(0, 0)
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.Parent = row

				local box = Theme.input(tostring(retries))
				box.Name = "MaxRetries"
				box.AnchorPoint = Vector2.new(1, 0)
				box.Position = UDim2.new(1, -76, 0, 2)
				box.Size = UDim2.fromOffset(56, 26)
				box.Parent = row

				local clearButton = Components.textButton("Reset", { order = 1 })
				clearButton.Name = "Reset"
				clearButton.AnchorPoint = Vector2.new(1, 0)
				clearButton.Position = UDim2.new(1, 0, 0, 2)
				clearButton.Size = UDim2.fromOffset(64, 26)
				clearButton.Parent = row

				box.FocusLost:Connect(function(enterPressed)
					if not enterPressed then
						return
					end
					local parsed = tonumber(box.Text)
					if parsed then
						SmartRetry.setProviderOverride(profile.id, { maxRetries = math.clamp(math.floor(parsed), 0, 20) })
					end
					box.Text = tostring(SmartRetry.getProviderOverride(profile.id).maxRetries or SmartRetry.get("maxRetries"))
				end)

				clearButton.MouseButton1Click:Connect(function()
					SmartRetry.setProviderOverride(profile.id, nil)
					renderOverrides()
				end)
			end
		end

		renderOverrides()

		return scroll
	end

	--=========================================================================
	-- DATA
	--=========================================================================

	local function buildData(): ScrollingFrame
		local function requireIdle(): boolean
			if not StateManager.isBusy() then return true end
			EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Finish or stop the task before changing conversation data." })
			return false
		end
		local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
		scroll.BackgroundTransparency = 1
		Theme.passThrough(scroll)
		Theme.padding(6).Parent = scroll
		Theme.listLayout(10).Parent = scroll

		local card1, body1 = Components.section("Local data", {
			subtitle = "Conversations are stored through Plugin:SetSetting in your Studio profile. Secrets are not.",
			order = 1,
		})
		card1.Parent = scroll

		local statsLabel = Theme.label("", {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
			alignY = Enum.TextYAlignment.Top,
			wrap = true,
		})
		statsLabel.Name = "Stats"
		statsLabel.Size = UDim2.new(1, 0, 0, 0)
		statsLabel.AutomaticSize = Enum.AutomaticSize.Y
		statsLabel.Parent = body1

		local function refreshStats()
			local conversations = SessionManager.getConversations()
			local messages = 0
			for _, conversation in conversations do
				messages += #conversation.messages
			end
			statsLabel.Text = string.format(
				"%d conversation(s) · %d message(s) · %d log entr(ies) · %d session credential(s)",
				#conversations,
				messages,
				#Logger.getEntries(),
				CredentialStore.count()
			)
		end

		local row1, addDataButton = Components.buttonRow({ columns = 2 })
		row1.Parent = body1
		local newChatButton = addDataButton("New chat", { order = 1 })
		local clearContextButton = addDataButton("Clear context", { order = 2 })
		local clearLogsButton = addDataButton("Clear logs", { order = 3 })

		newChatButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			SessionManager.createConversation()
			EventBus.emit(EventBus.Events.Toast, { kind = "success", message = "New conversation started." })
			refreshStats()
		end)

		clearContextButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			local conversation = SessionManager.getActive()
			if conversation then
				conversation.messages = {}
				conversation.summary = nil
				conversation.editorContext = nil
				conversation.summarisedUpTo = 0
				SessionManager.persist()
				EventBus.emit(EventBus.Events.ConversationChanged, { conversationId = conversation.id })
			end
			ContextManager.reset()
			EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Context cleared for this conversation." })
		end)

		clearLogsButton.MouseButton1Click:Connect(function()
			Logger.clear()
			EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Activity log cleared." })
			refreshStats()
		end)

		local card2, body2 = Components.section("Credentials & profile", { order = 2 })
		card2.Parent = scroll

		local forgetRow, addForgetButton = Components.buttonRow({ columns = 2 })
		forgetRow.Parent = body2
		local forgetButton = addForgetButton("Forget keys", { order = 1 })
		local forgetProfileButton = addForgetButton("Reset settings", { order = 2 })

		forgetButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			CredentialStore.clearAll()
			Logger.warn("Data", "Session credentials cleared.")
			EventBus.emit(EventBus.Events.Toast, {
				kind = "info",
				message = "All session API keys were removed from memory.",
			})
			refreshStats()
		end)

		forgetProfileButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			SettingsManager.resetAll()
			CredentialStore.clearAll()
			ContextManager.configure(nil)
			Logger.warn("Data", "Settings reset to defaults.")
			EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Settings reset to defaults." })
			refreshStats()
		end)

		local card3, body3 = Components.section("Reset", { subtitle = "These cannot be undone.", order = 3 })
		card3.Parent = scroll

		local row3, addHistoryButton = Components.buttonRow()
		row3.Parent = body3
		local clearHistoryButton = addHistoryButton("Clear conversation history", { order = 1 })

		clearHistoryButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			if not SessionManager.clearAll() then return end
			ContextManager.reset()
			Logger.warn("Data", "Conversation history cleared.")
			EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "All conversation history cleared." })
			EventBus.emit(EventBus.Events.Navigate, { section = "chat" })
		end)

		-- Self tests ---------------------------------------------------------
		local card4, body4 = Components.section("Self tests", {
			subtitle = "Checks chat rendering and controls locally. Results appear in the activity log.",
			order = 4,
		})
		card4.Parent = scroll

		local testRow4, addTestButton = Components.buttonRow()
		testRow4.Parent = body4
		local runTestsButton = addTestButton("Check UI", { accent = true, order = 1 })

		runTestsButton.MouseButton1Click:Connect(function()
			if not requireIdle() then return end
			local report = require(script.Parent.Parent.Utilities.UIHealthCheck).run()
			local message = string.format("UI checks: %d/%d passed.", report.passed, report.total)
			if #report.errors == 0 then Logger.success("UI checks", message)
			else Logger.error("UI checks", message, { detail = table.concat(report.errors, "\n") }) end
			EventBus.emit(EventBus.Events.Toast, { kind = if #report.errors == 0 then "success" else "error", message = message })
		end)

		refreshStats()
		return scroll
	end

	--=========================================================================
	-- NAVIGATION
	--=========================================================================

	local pages: { [string]: Instance } = {}

	local function paintNavigation()
		for _, section in SECTIONS do
			local active = currentSection == section
			local button = sectionButtons[section]
			if button then
				button.BackgroundColor3 = if active then Theme.Extra.HighlightSoft else Theme.Colors.Background
				sectionLabels[section].TextColor3 = if active then Theme.Colors.MainText else Theme.Extra.Muted
				sectionIcons[section].TextColor3 = if active then Theme.Colors.Highlight else Theme.Extra.Muted
				sectionMarks[section].Visible = active
			end
		end
	end
	local function setSection(name: string)
		if not table.find(SECTIONS, name) then return end
		Components.closeMenus()
		currentSection = name
		pageTitle.Text = name
		layoutShell()
		if setCompactSelection then setCompactSelection(name) end
		for section, page in pages do page.Visible = section == name end
		paintNavigation()
	end
	local iconKeys = { General = "Settings", ["AI & Provider"] = "Sparkle", ["Agent Access"] = "Builder", Agent = "Builder", Retry = "Refresh", Data = "Doc" }
	for index, section in SECTIONS do
		local button = Theme.textButton("", { height = 34, radius = Theme.Metrics.RadiusSmall, color = Theme.Colors.Background })
		button.Name = "Section_" .. section
		button.LayoutOrder = index
		button.Size = UDim2.new(1, -6, 0, 34)
		button.Parent = sectionRow
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Transparency = 1 end
		local icon = Icons.glyph(iconKeys[section], 13)
		icon.Size = UDim2.fromOffset(18, 18)
		icon.Position = UDim2.fromOffset(8, 8)
		icon.Parent = button
		sectionIcons[section] = icon
		local label = Theme.label(section, { size = Theme.TextSizes.Small, font = Theme.Fonts.Medium, truncate = true })
		label.Name = "Label"
		label.Position = UDim2.fromOffset(32, 0)
		label.Size = UDim2.new(1, -38, 1, 0)
		label.Parent = button
		sectionLabels[section] = label
		local mark = Instance.new("Frame")
		mark.Name = "Selected"
		mark.BorderSizePixel = 0
		mark.BackgroundColor3 = Theme.Colors.Highlight
		mark.Size = UDim2.new(0, 2, 1, -12)
		mark.Position = UDim2.fromOffset(0, 6)
		mark.Parent = button
		sectionMarks[section] = mark
		sectionButtons[section] = button
		button.MouseButton1Click:Connect(function() setSection(section) end)
		button.MouseLeave:Connect(paintNavigation)
	end
	local picker, _, _, selectSection = Components.dropdown("Settings section", SECTIONS, setSection)
	picker.Name = "SettingsSectionPicker"
	local pickerLabel = picker:FindFirstChild("Label")
	if pickerLabel then pickerLabel:Destroy() end
	picker.AutomaticSize = Enum.AutomaticSize.None
	picker.Position = UDim2.fromOffset(0, 52)
	picker.Size = UDim2.new(1, 0, 0, 30)
	picker.Parent = view
	compactPicker = picker
	setCompactSelection = selectSection
	layoutShell()

	-- General
	local generalPage = buildGeneral()
	generalPage.Parent = pageHolder
	pages["General"] = generalPage

	-- AI & Provider (delegates to ProviderView)
	local providerHolder = Instance.new("Frame")
	providerHolder.Name = "ProviderPage"
	providerHolder.Size = UDim2.fromScale(1, 1)
	providerHolder.BackgroundTransparency = 1
	Theme.passThrough(providerHolder)
	providerHolder.Visible = false
	providerHolder.Parent = pageHolder
	local providerPage, providerApi = ProviderView.build(providerHolder)
	-- The page table drives visibility. It must reference the HOLDER, not the
	-- inner view: toggling the inner view left the holder invisible, so the
	-- whole AI & Provider screen rendered as an empty frame.
	pages["AI & Provider"] = providerHolder
	_ = providerPage

	local accessPage, accessApi = AgentAccessView.build()
	accessPage.Parent = pageHolder
	pages["Agent Access"] = accessPage

	-- Agent
	local agentPage = buildAgent()
	agentPage.Parent = pageHolder
	pages["Agent"] = agentPage

	-- Smart Auto Retry
	local retryPage = buildRetry()
	retryPage.Parent = pageHolder
	pages["Retry"] = retryPage

	-- Data
	local dataPage = buildData()
	dataPage.Parent = pageHolder
	pages["Data"] = dataPage

	local disconnect = EventBus.on(EventBus.Events.Navigate, function(payload)
		if payload.section == "settings" then
			if payload.tab then setSection(payload.tab) end
		end
	end)

	setSection("General")

	-- Roblox Instances reject new members, so the API is a plain table returned
	-- alongside the frame rather than fields hung off the Frame itself.
	-- ProviderView owns its own teardown (it rebuilds in place rather than
	-- being destroyed), so there is no providerPage hook to call here.
	local api: { [string]: any } = {
		showSection = setSection,
		getSection = function()
			return currentSection
		end,
		destroy = function()
			disconnect()
			if providerApi then providerApi.destroy() end
			accessApi.destroy()
		end,
	}

	return view, api
end

return SettingsView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">ThinkingIndicator</string>
          <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local RetryStateManager = require(script.Parent.Parent.AI.RetryStateManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local ThinkingIndicator = {}

function ThinkingIndicator.build(): (Frame, any)
	local frame = Instance.new("Frame")
	frame.Name = "ThinkingIndicator"
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	Theme.passThrough(frame)
	frame.Visible = false
	Theme.padding4(4, 10, 4, 10).Parent = frame
	Theme.listLayout(4).Parent = frame
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.Size = UDim2.new(1, 0, 0, 24)
	Theme.passThrough(row)
	row.LayoutOrder = 1
	row.Parent = frame
	local dot = Icons.glyph("Thinking", 14, Theme.Colors.Highlight)
	dot.Name = "Dot"
	dot.Size = UDim2.fromOffset(18, 24)
	dot.Parent = row
	local label = Theme.label("Thinking…", { size = 12, color = Theme.Colors.SecondaryText })
	label.Name = "Label"
	label.Size = UDim2.new(1, -90, 1, 0)
	label.Position = UDim2.fromOffset(26, 0)
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = row
	local timer = Theme.label("0.0s", { size = 11, color = Theme.Extra.Muted, alignX = Enum.TextXAlignment.Right })
	timer.Name = "Timer"
	timer.AnchorPoint = Vector2.new(1, 0)
	timer.Position = UDim2.new(1, -22, 0, 0)
	timer.Size = UDim2.fromOffset(44, 24)
	timer.Parent = row
	local toggle = Theme.textButton("", { height = 24, width = UDim2.fromOffset(18, 24) })
	Icons.setButton(toggle, "ChevronRight")
	toggle.Name = "Toggle"
	toggle.BackgroundTransparency = 1
	toggle.AnchorPoint = Vector2.new(1, 0)
	toggle.Position = UDim2.fromScale(1, 0)
	toggle.Parent = row
	local details = Theme.autoText("", { size = 11 })
	details.Name = "Details"
	details.LayoutOrder = 2
	details.Visible = false
	details.Parent = frame
	toggle.MouseButton1Click:Connect(function() details.Visible = not details.Visible; Icons.setButton(toggle, if details.Visible then "ChevronDown" else "ChevronRight") end)
	local startedAt = 0
	local generation = 0
	local destroyed = false
	local spinner: any = nil
	local activity: string? = nil
	local notes: { string } = {}
	local function refresh()
		if destroyed then return end
		local state = StateManager.get()
		local key = if state == "BUILDING" or state == "ANALYZING" then "Tool" elseif state == "CONNECTING" then "ProviderCustom" else "Thinking"
		Icons.setGlyph(dot, key)
		label.Text = RetryStateManager.shortText() or activity or StateManager.getActivity() or StateManager.displayLabel[state] or "Thinking…"
		timer.Text = string.format("%.1fs", math.max(0, os.clock() - startedAt))
		dot.TextColor3 = if state == "FAILED" then Theme.Colors.Error elseif state == "AWAITING_APPROVAL" or state == "AWAITING_USER_ANSWER" then Theme.Extra.Warning else Theme.Colors.Highlight
		details.Text = table.concat(notes, "\n")
	end
	local unsubs = {
		EventBus.on(EventBus.Events.StateChanged, function() activity = nil; refresh() end),
		EventBus.on(EventBus.Events.ActivityChanged, function(payload) activity = payload.activity; refresh() end),
		EventBus.on(EventBus.Events.MessageDelta, function(payload) activity = if payload.channel == "reasoning" then "Thinking…" else "Writing…"; refresh() end),
		EventBus.on(EventBus.Events.BuildProgress, function(payload)
			if payload.phase == "toolResult" then
				notes[#notes + 1] = tostring(payload.toolName) .. (if payload.verified then " · verified" else " · completed")
				while #notes > 4 do table.remove(notes, 1) end
				refresh()
			end
		end),
	}
	return frame, {
		frame = frame,
		show = function()
			generation += 1
			local current = generation
			startedAt = os.clock()
			activity = nil
			notes = {}
            if spinner then spinner:Cancel(); spinner = nil end
            dot.Rotation = -8
            if Theme.motionEnabled then
                spinner = TweenService:Create(dot, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 8 })
                spinner:Play()
            end
			frame.Visible = true
			details.Visible = false
			refresh()
			task.spawn(function()
				while not destroyed and generation == current and frame.Visible do
					refresh()
					task.wait(0.15)
				end
			end)
		end,
		stop = function() generation += 1; frame.Visible = false; if spinner then spinner:Cancel(); spinner = nil end end,
		setActivity = function(value: string?) activity = value; refresh() end,
		addNote = function(value: string) notes[#notes + 1] = value; refresh() end,
		destroy = function() destroyed = true; generation += 1; if spinner then spinner:Cancel(); spinner = nil end; for _, unsubscribe in unsubs do unsubscribe() end end,
	}
end
return ThinkingIndicator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">TokenMeter</string>
          <string name="Source"><![CDATA[--!strict
local ContextManager = require(script.Parent.Parent.AI.ContextManager)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)
local TokenMeter = {}
function TokenMeter.build(): (Frame, any)
	local frame = Instance.new("Frame")
	frame.Name = "TokenMeter"
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	Theme.passThrough(frame)
	Theme.padding4(0, 10, 0, 10).Parent = frame
	Theme.listLayout(4).Parent = frame
	local header = Theme.textButton("", { height = 20 })
	header.Name = "ContextSummary"
	header.Size = UDim2.new(1, 0, 0, 20)
	header.BackgroundTransparency = 1
	header.Text = ""
	header.LayoutOrder = 1
	header.Parent = frame
	local label = Theme.label("Context", { size = 10, color = Theme.Extra.Muted })
	label.Name = "ContextLabel"
	label.Size = UDim2.new(1, -42, 1, 0)
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = header
	local usage = Theme.label("", { size = 10, color = Theme.Extra.Muted, alignX = Enum.TextXAlignment.Right })
	usage.Name = "Usage"
	usage.Size = UDim2.fromOffset(38, 20)
	usage.AnchorPoint = Vector2.new(1, 0)
	usage.Position = UDim2.fromScale(1, 0)
	usage.Parent = header
	local details = Theme.autoText("", { size = 11 })
	details.Name = "LastRequest"
	details.LayoutOrder = 2
	details.Visible = false
	details.Parent = frame
	header.MouseButton1Click:Connect(function() if details.Text ~= "" then details.Visible = not details.Visible end end)
	local function refresh()
		local snapshot = ContextManager.getSnapshot()
		if snapshot.contextWindow <= 0 then
			label.Text = "Connect an AI provider to begin"
			usage.Text = ""
			details.Text = ""
			details.Visible = false
			return
		end
		label.Text = string.format("Context %s%s / %s", if snapshot.usedIsEstimate then "~" else "", Time.formatNumber(snapshot.used), Time.formatNumber(snapshot.contextWindow))
		usage.Text = string.format("%.0f%%", snapshot.percent)
		usage.TextColor3 = if snapshot.percent >= 85 then Theme.Colors.Error elseif snapshot.percent >= 60 then Theme.Extra.Warning else Theme.Extra.Muted
		local request = snapshot.lastRequest
		if request then
			local prefix = if request.estimated then "~" else ""
			details.Text = string.format("Last request · %s%s in / %s%s out · %.1fs", prefix, Time.formatNumber(request.input), prefix, Time.formatNumber(request.output), request.requestMs / 1000)
			if request.estimatedCost then details.Text ..= "\nEstimated cost · " .. (ContextManager.formatCost(request.estimatedCost) or "—") end
		else
			details.Text = "Token counts are estimated until the provider returns usage."
		end
	end
	local unsubscribe = EventBus.on(EventBus.Events.TokenUsageChanged, refresh)
	refresh()
	return frame, { refresh = refresh, destroy = unsubscribe }
end
return TokenMeter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">WelcomeDialog</string>
          <string name="Source">--!strict
--[[
	ForgePilot / UI / WelcomeDialog
	First-run naming prompt. Optional: skipping keeps the default assistant name
	and does NOT require a provider to be configured.
]]

local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Theme = require(script.Parent.Parent.Utilities.Theme)

local WelcomeDialog = {}

export type Result = { named: boolean, name: string }

--- Shows the welcome prompt. Resolves with `{ named, name }`.
function WelcomeDialog.show(parent: GuiObject): any
	local promise = promise.create()

	local settled = false
	local overlay: Frame = nil :: any

	local overlayInstance = Instance.new("Frame")
	overlayInstance.Name = "WelcomeOverlay"
	overlayInstance.Size = UDim2.fromScale(1, 1)
	overlayInstance.BackgroundColor3 = Theme.Extra.Overlay
	overlayInstance.BackgroundTransparency = 0.15
	overlayInstance.BorderSizePixel = 0
	overlayInstance.ZIndex = 90
	overlayInstance.Parent = parent
	overlay = overlayInstance

	Theme.tween(overlayInstance, { BackgroundTransparency = 0.35 }, Theme.Motion.Slow):Play()

	local card = Instance.new("Frame")
	card.Name = "WelcomeCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.45)
	card.Size = UDim2.new(1, -40, 0, 224)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Theme.Colors.Secondary
	card.BorderSizePixel = 0
	card.ZIndex = 91
	card.Parent = overlay
	Theme.corner(Theme.Metrics.RadiusLarge).Parent = card
	local stroke = Theme.stroke(Theme.Extra.BorderStrong)
	stroke.Parent = card
	Theme.padding(18).Parent = card

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
	layout.Parent = card

	local mark = Instance.new("Frame")
	mark.Name = "Mark"
	mark.Size = UDim2.fromOffset(34, 34)
	mark.BackgroundTransparency = 1
	mark.LayoutOrder = 1
	mark.Parent = card

	local Title = Theme.label("Welcome to ForgePilot", {
		size = 19,
		font = Theme.Fonts.Bold,
		alignX = Enum.TextXAlignment.Center,
	})
	Title.Name = "Title"
	Title.Size = UDim2.new(1, 0, 0, 26)
	Title.LayoutOrder = 2
	Title.Parent = card

	local subtitle = Theme.label("What would you like to call your AI assistant?", {
		size = Theme.TextSizes.Body,
		color = Theme.Colors.SecondaryText,
		alignX = Enum.TextXAlignment.Center,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	subtitle.Name = "Subtitle"
	subtitle.Size = UDim2.new(1, 0, 0, 36)
	subtitle.LayoutOrder = 3
	subtitle.Parent = card

	local inputHolder = Instance.new("Frame")
	inputHolder.Name = "Input"
	inputHolder.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
	inputHolder.LayoutOrder = 4
	inputHolder.BackgroundTransparency = 1
	inputHolder.Parent = card

	local box = Theme.input("ForgePilot Assistant")
	box.Name = "NameBox"
	box.Text = SettingsManager.getValue("assistantName")
	box.Size = UDim2.fromScale(1, 1)
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.Parent = inputHolder

	local hint = Theme.label(
		"You can change this any time in Settings → General. No AI provider is required yet.",
		{ size = Theme.TextSizes.Caption, color = Theme.Extra.Muted, alignX = Enum.TextXAlignment.Center, wrap = true }
	)
	hint.Name = "Hint"
	hint.Size = UDim2.new(1, 0, 0, 28)
	hint.LayoutOrder = 5
	hint.Parent = card

	local buttons = Instance.new("Frame")
	buttons.Name = "Buttons"
	buttons.Size = UDim2.new(1, 0, 0, 32)
	buttons.LayoutOrder = 6
	buttons.BackgroundTransparency = 1
	buttons.Parent = card
	local buttonLayout = Instance.new("UIListLayout")
	buttonLayout.FillDirection = Enum.FillDirection.Horizontal
	buttonLayout.SortOrder = Enum.SortOrder.LayoutOrder
	buttonLayout.Padding = UDim.new(0, 8)
	buttonLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	buttonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	buttonLayout.Parent = buttons

	local function makeButton(text: string, accent: boolean, order: number): TextButton
		local button = Instance.new("TextButton")
		button.Name = text
		button.LayoutOrder = order
		button.Size = UDim2.fromOffset(0, 30)
		button.AutomaticSize = Enum.AutomaticSize.X
		button.BackgroundColor3 = if accent then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
		button.BorderSizePixel = 0
		button.Text = text
		button.TextColor3 = if accent then Theme.Colors.Background else Theme.Colors.MainText
		button.TextSize = Theme.TextSizes.Body
		button.Font = if accent then Theme.Fonts.Bold else Theme.Fonts.Medium
		button.Parent = buttons
		Theme.corner(Theme.Metrics.RadiusSmall).Parent = button
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 18)
		pad.PaddingRight = UDim.new(0, 18)
		pad.Parent = button

		local base = button.BackgroundColor3
		local hover = Theme.lighten(base, 0.12)
		button.MouseEnter:Connect(function()
			Theme.tween(button, { BackgroundColor3 = hover }, Theme.Motion.Fast):Play()
		end)
		button.MouseLeave:Connect(function()
			Theme.tween(button, { BackgroundColor3 = base }, Theme.Motion.Fast):Play()
		end)
		return button
	end

	local startButton = makeButton("Start building", true, 1)
	local skipButton = makeButton("Skip", false, 2)

	local function finish(name: string, named: boolean)
		if settled then
			return
		end
		settled = true
		local fade = Theme.tween(overlay, { BackgroundTransparency = 1 }, Theme.Motion.Normal)
		overlay.BackgroundTransparency = 1
		fade:Play()
		task.delay(0.18, function()
			if overlay.Parent then
				overlay:Destroy()
			end
		end)
		promise:resolve({ named = named, name = name })
	end

	startButton.MouseButton1Click:Connect(function()
		local name = StringUtil.trim(box.Text)
		if #name == 0 then
			name = "ForgePilot Assistant"
		end
		SettingsManager.setAssistantName(name)
		finish(name, true)
	end)

	skipButton.MouseButton1Click:Connect(function()
		finish(SettingsManager.getValue("assistantName"), false)
	end)

	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			startButton:Activate()
		end
	end)

	task.defer(function()
		box:CaptureFocus()
	end)

	return promise:await()
end

return WelcomeDialog</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="76">
      <Properties>
        <string name="Name">Utilities</string>
      </Properties>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">Base64</string>
          <string name="Source">--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Utilities / Base64
	Pure-Luau base64 encoder/decoder for binary payloads.

	Roblox does not expose a base64 helper to plugins, and `HttpService:Base64Encode`
	only accepts strings (which cannot hold arbitrary binary safely), so the codec
	below operates on byte buffers directly. Data passed to the provider is always
	converted to a latin-1 string first, which is a lossless byte-&gt;codeunit mapping.
]]

local Base64 = {}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local PAD = "="

-- Precomputed decode table: byte value -&gt; 6-bit value, or nil when invalid.
local DECODE: { [number]: number } = {}
for index = 1, #ALPHABET do
	DECODE[string.byte(ALPHABET, index)] = index - 1
end

--- Converts a latin-1 (byte-per-codeunit) string into a buffer.
function Base64.stringToBuffer(data: string): buffer
	local buffer_ = buffer.create(#data)
	if #data == 0 then
		return buffer_
	end
	if typeof(buffer.write) == "function" then
		buffer.write(buffer_, 0, data)
	else
		-- Older/embedded runtimes expose only the u8 accessors.
		for index = 1, #data do
			buffer.writeu8(buffer_, index - 1, string.byte(data, index))
		end
	end
	return buffer_
end

--- Converts a buffer into a latin-1 string. Lossless for any byte value.
function Base64.bufferToString(buf: buffer): string
	local length = buffer.len(buf)
	if length == 0 then
		return ""
	end
	if typeof(buffer.read) == "function" then
		return string.char(buffer.read(buf, 0, length))
	end
	-- Fallback for runtimes that only expose the u8 accessors.
	local out = table.create(length)
	for index = 0, length - 1 do
		out[index + 1] = string.char(buffer.readu8(buf, index))
	end
	return table.concat(out)
end

--- Reads a Roblox `File` into a buffer via its binary contents (latin-1 string).
function Base64.fileToBuffer(file: Instance): (buffer?, string?)
	local ok, contents = pcall(function()
		return (file :: any):GetBinaryContents()
	end)
	if not ok or type(contents) ~= "string" then
		return nil, "File could not be read as binary content."
	end
	return Base64.stringToBuffer(contents), nil
end

--=============================================================================
-- ENCODE
--=============================================================================

--- Encodes a buffer as standard (padded) base64.
function Base64.encodeBuffer(buf: buffer): string
	local length = buffer.len(buf)
	if length == 0 then
		return ""
	end

	local pieces: { string } = {}
	local chunk: { [number]: number } = table.create(2048)
	local chunkCount = 0
	local out = table.create(math.ceil(length / 3) * 4)

	local i = 0
	while i &lt; length do
		local b0 = buffer.readu8(buf, i)
		local b1: number = if i + 1 &lt; length then buffer.readu8(buf, i + 1) else 0
		local b2: number = if i + 2 &lt; length then buffer.readu8(buf, i + 2) else 0

		local n = b0 * 65536 + b1 * 256 + b2

		chunkCount += 1
		chunk[chunkCount] = string.byte(ALPHABET, math.floor(n / 262144) % 64 + 1)
		chunkCount += 1
		chunk[chunkCount] = string.byte(ALPHABET, math.floor(n / 4096) % 64 + 1)
		chunkCount += 1
		chunk[chunkCount] = if i + 1 &lt; length
			then string.byte(ALPHABET, math.floor(n / 64) % 64 + 1)
			else string.byte(PAD)
		chunkCount += 1
		chunk[chunkCount] = if i + 2 &lt; length
			then string.byte(ALPHABET, n % 64 + 1)
			else string.byte(PAD)

		if chunkCount &gt;= 2048 then
			out[#out + 1] = string.char(table.unpack(chunk, 1, chunkCount))
			chunkCount = 0
		end

		i += 3
	end

	if chunkCount &gt; 0 then
		out[#out + 1] = string.char(table.unpack(chunk, 1, chunkCount))
	end
	return table.concat(out)
end

--- Encodes a latin-1 string as base64.
function Base64.encode(data: string): string
	return Base64.encodeBuffer(Base64.stringToBuffer(data))
end

--=============================================================================
-- DECODE
--=============================================================================

--- Decodes base64 (padded or unpadded, whitespace tolerated) into a buffer.
--- Returns `nil` plus a message when the input contains invalid characters.
function Base64.decodeToBuffer(data: string): (buffer?, string?)
	local clean = data:gsub("[%s\r\n\t]", "")

	-- Split off trailing padding so the group walker knows which bytes are real.
	local padding = 0
	while #clean &gt; 0 and string.byte(clean, #clean) == string.byte(PAD) do
		clean = string.sub(clean, 1, -2)
		padding += 1
	end
	if padding &gt; 2 then
		return nil, "Invalid base64: too much padding."
	end

	local remainder = #clean % 4
	if remainder == 1 then
		return nil, "Invalid base64: truncated group."
	end

	local groupCount = math.floor(#clean / 4)
	local tail = string.sub(clean, groupCount * 4 + 1)

	local capacity = groupCount * 3
	if #tail &gt; 0 then
		capacity += if #tail &gt;= 4 then 3 elseif #tail &gt;= 3 then 2 else 1
	end

	local out = buffer.create(capacity)
	local outIndex = 0

	local function writeByte(value: number)
		buffer.writeu8(out, outIndex, value)
		outIndex += 1
	end

	for group = 0, groupCount - 1 do
		local offset = group * 4
		local a = DECODE[string.byte(clean, offset + 1)]
		local b = DECODE[string.byte(clean, offset + 2)]
		local c = DECODE[string.byte(clean, offset + 3)]
		local d = DECODE[string.byte(clean, offset + 4)]
		if a == nil or b == nil or c == nil or d == nil then
			return nil, "Invalid base64: unexpected character in payload."
		end
		local n = a * 262144 + b * 4096 + c * 64 + d
		writeByte(math.floor(n / 65536) % 256)
		writeByte(math.floor(n / 256) % 256)
		writeByte(n % 256)
	end

	-- Final partial group: how many real characters it holds decides how many
	-- bytes were actually encoded.
	if #tail &gt; 0 then
		local a = #tail &gt;= 1 and DECODE[string.byte(tail, 1)] or 0
		local b = #tail &gt;= 2 and DECODE[string.byte(tail, 2)] or 0
		local c = #tail &gt;= 3 and DECODE[string.byte(tail, 3)] or 0
		if a == nil or b == nil or c == nil then
			return nil, "Invalid base64: unexpected character in payload."
		end
		local n = a * 262144 + b * 4096 + c * 64
		writeByte(math.floor(n / 65536) % 256)
		if #tail &gt;= 3 then
			writeByte(math.floor(n / 256) % 256)
		end
		if #tail == 4 then
			writeByte(n % 256)
		end
	end

	return out, nil
end

--- Decodes base64 into a latin-1 string.
function Base64.decode(data: string): (string?, string?)
	local buf, err = Base64.decodeToBuffer(data)
	if not buf then
		return nil, err
	end
	return Base64.bufferToString(buf), nil
end

--=============================================================================
-- DATA URL
--=============================================================================

local MIME_BY_EXTENSION: { [string]: string } = {
	png = "image/png",
	jpg = "image/jpeg",
	jpeg = "image/jpeg",
	webp = "image/webp",
	gif = "image/gif",
	bmp = "image/bmp",
	txt = "text/plain",
	md = "text/markdown",
	csv = "text/csv",
	json = "application/json",
	xml = "application/xml",
	html = "text/html",
	css = "text/css",
	js = "text/javascript",
	ts = "text/plain",
	py = "text/x-python",
	lua = "text/plain",
	luau = "text/plain",
	pdf = "application/pdf",
	mp3 = "audio/mpeg",
	wav = "audio/wav",
	ogg = "audio/ogg",
	flac = "audio/flac",
	m4a = "audio/mp4",
	mp4 = "video/mp4",
	webm = "video/webm",
	avi = "video/x-msvideo",
	mov = "video/quicktime",
}

function Base64.mimeTypeFor(fileName: string): string
	local extension = string.match(string.lower(fileName), "%.([%w]+)$")
	if not extension then
		return "application/octet-stream"
	end
	return MIME_BY_EXTENSION[extension] or "application/octet-stream"
end

--- Builds a `data:` URL for providers that accept inline media.
function Base64.dataUrl(fileName: string, buf: buffer): string
	return string.format("data:%s;base64,%s", Base64.mimeTypeFor(fileName), Base64.encodeBuffer(buf))
end

return Base64</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">Clipboard</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Utilities / Clipboard
	Thin, safe wrapper around the Studio clipboard.

	Tries Studio's privileged copy method, then presents selectable native text
	when the method is unavailable to a local plugin. Clipboard reads are not
	exposed to plugins.
]]

local StudioService = game:GetService("StudioService")

local Clipboard = {}

--- Copies `text` to the Studio clipboard. Returns (ok, reason).
function Clipboard.copy(text: string): (boolean, string?, boolean?)
	local copied, err = pcall(function()
		StudioService:CopyToClipboard(tostring(text))
	end)
	if copied then
		return true
	end
	-- CopyToClipboard is RobloxScriptSecurity on many Studio builds. Local
	-- plugins cannot call it there, so offer a native, selected text box for
	-- Ctrl+C / Cmd+C rather than making every Copy button fail silently.
	local shown = pcall(function()
		local Theme = require(script.Parent.Theme)
		local DockWidget = require(script.Parent.Parent.UI.DockWidget)
		local root = DockWidget.content
		if not root then error("No plugin window") end
		local host = Theme.overlayHost(root)
		local existing = host:FindFirstChild("CopyDialog")
		if existing then existing:Destroy() end
		local modal = Instance.new("TextButton")
		modal.Name = "CopyDialog"
		modal.Size = UDim2.fromScale(1, 1)
		modal.Text = ""
		modal.AutoButtonColor = false
		modal.BackgroundColor3 = Theme.Extra.Overlay
		modal.BackgroundTransparency = 0.2
		modal.ZIndex = Theme.OverlayZIndex + 20
		modal.Parent = host
		local card = Instance.new("Frame")
		card.Name = "Card"
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(1, -24, 1, -24)
		card.BackgroundColor3 = Theme.Extra.SurfaceRaised
		card.BorderSizePixel = 0
		card.Active = true
		card.Parent = modal
		Theme.corner(12).Parent = card
		Theme.padding(12).Parent = card
		local title = Theme.label("Copy text", { size = 14, font = Theme.Fonts.Bold })
		title.Size = UDim2.new(1, -30, 0, 24)
		title.Parent = card
		local close = Theme.textButton("×", { height = 24, width = UDim2.fromOffset(26, 24) })
		close.AnchorPoint = Vector2.new(1, 0)
		close.Position = UDim2.fromScale(1, 0)
		close.Parent = card
		close.MouseButton1Click:Connect(function() modal:Destroy() end)
		local box = Theme.input("", { multiLine = true })
		box.Name = "CopyText"
		box.Text = text
		box.TextEditable = false
		box.TextWrapped = false
		box.Font = Theme.Fonts.Code
		box.TextSize = 12
		box.Size = UDim2.new(1, 0, 1, -66)
		box.Position = UDim2.fromOffset(0, 30)
		box.Parent = card
		local hint = Theme.autoText("Press Ctrl+C (Windows) or Cmd+C (Mac) to copy the selected text.", { size = 11 })
		hint.Size = UDim2.new(1, 0, 0, 28)
		hint.AutomaticSize = Enum.AutomaticSize.None
		hint.AnchorPoint = Vector2.new(0, 1)
		hint.Position = UDim2.fromScale(0, 1)
		hint.Parent = card
		modal.MouseButton1Click:Connect(function() modal:Destroy() end)
		task.defer(function()
			if not box.Parent then return end
			box:CaptureFocus()
			box.CursorPosition = 1
			box.SelectionStart = #text + 1
		end)
	end)
	return false, if shown then "Press Ctrl+C / Cmd+C in the selected text." else "Could not open the copy dialog: " .. tostring(err), shown
end

--- Studio has no clipboard read API for plugins.
--- Returns (false, reason) so callers surface an honest message.
function Clipboard.read(): (boolean, string?)
	return false, "Studio does not expose a clipboard read API to plugins."
end

return Clipboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">ErrorHandler</string>
          <string name="Source">--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Utilities / ErrorHandler
	Normalises errors thrown by pcall/HTTP providers into user-presentable text,
	and classifies provider HTTP failures into actionable messages.
]]

local Redact = require(script.Parent.Redact)

local ErrorHandler = {}

--=============================================================================
-- GENERIC NORMALISATION
--=============================================================================

local NETWORK_HINTS = {
	["not enabled"] = "HTTP requests are disabled for this experience. Enable `Allow HTTP Requests` in Game Settings, then reopen the plugin.",
	["http requests are not enabled"] = "HTTP requests are disabled for this experience. Enable `Allow HTTP Requests` in Game Settings, then reopen the plugin.",
	["blocked by client"] = "Roblox blocked this request. Check that the domain is on the HTTP allowlist and that the URL uses HTTPS.",
	["dns"] = "The host name could not be resolved. Check the base URL spelling.",
	["timed out"] = "The provider did not respond in time. Increase Request Timeout or try again.",
	["timeout"] = "The provider did not respond in time. Increase Request Timeout or try again.",
	["ssl"] = "TLS negotiation failed. The endpoint may not support HTTPS properly.",
	["connection reset"] = "The connection was closed before the response completed.",
	["too many requests"] = "The provider is rate limiting this key. Wait a moment before retrying.",
	["service unavailable"] = "The provider is temporarily unavailable.",
}

local STATUS_HINTS: { [number]: string } = {
	[400] = "The provider rejected the request body. Check the Base URL, Model ID and protocol.",
	[401] = "Authentication failed. The API Key is missing, malformed, or not valid for this endpoint.",
	[403] = "Access denied. The key may lack permission for this model, region, or the domain may be restricted.",
	[404] = "Endpoint or model not found. Verify the API Base URL and Model ID.",
	[405] = "The endpoint does not accept this HTTP method. The provider protocol may be mismatched.",
	[408] = "The provider timed out while reading the request.",
	[413] = "The payload was too large. Reduce attachments or max output tokens.",
	[422] = "The provider could not process the request parameters. Check model capabilities for this input.",
	[429] = "Rate limited or out of quota. Check the provider billing status and retry later.",
	[500] = "The provider had an internal error. Retrying may succeed.",
	[501] = "The provider does not implement this endpoint. The chosen protocol may be unsupported.",
	[502] = "Bad gateway from the provider. Retry shortly.",
	[503] = "The provider is overloaded or in maintenance. Retry later.",
	[529] = "The provider is overloaded. Retry later.",
}

--- Converts any error value into a single clean line.
function ErrorHandler.describe(err: any): string
	if err == nil then
		return "Unknown error."
	end
	local text = if type(err) == "string" then err else tostring(err)
	text = Redact.scrubText(text)
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	if #text == 0 then
		return "Unknown error."
	end
	return text
end

--- Adds a network-specific hint when the message matches a known failure mode.
function ErrorHandler.hint(err: any): string?
	local text = string.lower(ErrorHandler.describe(err))
	for needle, hint in NETWORK_HINTS do
		if string.find(text, needle, 1, true) then
			return hint
		end
	end
	return nil
end

--- Full user-facing text for an error, including any actionable hint.
function ErrorHandler.explain(err: any): string
	local base = ErrorHandler.describe(err)
	local hint = ErrorHandler.hint(err)
	if hint and not string.find(base, hint, 1, true) then
		return base .. "  —  " .. hint
	end
	return base
end

--=============================================================================
-- PROVIDER HTTP FAILURES
--=============================================================================

export type HttpFailure = {
	statusCode: number?,
	body: string?,
	headers: { [string]: string }?,
	success: boolean,
	timeoutMs: number?,
}

--- Extracts a provider error message from a JSON error body when possible.
function ErrorHandler.providerMessage(failure: HttpFailure): string?
	if type(failure.body) ~= "string" or #failure.body == 0 then
		return nil
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, failure.body)
	if not ok or type(decoded) ~= "table" then
		return nil
	end
	local err = decoded.error or decoded
	if type(err) == "table" then
		if type(err.message) == "string" then
			return Redact.scrubText(err.message)
		end
		if type(err[1]) == "table" and type(err[1].message) == "string" then
			return Redact.scrubText((err[1] :: any).message)
		end
	end
	return nil
end

--- Builds the message shown to the user for a failed provider request.
function ErrorHandler.fromHttp(failure: HttpFailure, providerLabel: string): string
	local providerMessage = ErrorHandler.providerMessage(failure)
	local status = failure.statusCode

	if failure.success == false and status == nil then
		return string.format(
			"%s: request failed before a response was received. %s",
			providerLabel,
			ErrorHandler.hint("network error") or "Check network connectivity and the Base URL."
		)
	end

	if status and STATUS_HINTS[status] then
		local parts = { string.format("%s returned HTTP %d.", providerLabel, status) }
		if providerMessage then
			parts[#parts + 1] = providerMessage
		end
		parts[#parts + 1] = STATUS_HINTS[status]
		return Redact.scrubText(table.concat(parts, " "))
	end

	if providerMessage then
		return string.format("%s: %s", providerLabel, providerMessage)
	end

	local bodyPreview = if type(failure.body) == "string" and #failure.body &gt; 0
		then string.sub(failure.body, 1, 400)
		else "(empty response body)"

	return string.format(
		"%s returned an unexpected response (HTTP %s).\n%s",
		providerLabel,
		tostring(status),
		Redact.scrubText(bodyPreview)
	)
end

--=============================================================================
-- PLATFORM LIMITATIONS
--=============================================================================

--- Explains a capability that Roblox Studio does not allow, without inventing a
--- workaround. Used so unsupported features are reported honestly in the UI.
function ErrorHandler.platformLimitation(feature: string, reason: string): string
	return string.format("%s is unavailable in Roblox Studio plugins: %s", feature, reason)
end

return ErrorHandler</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Utilities / Icons
	Icon definitions and builder helpers.

	Every displayed icon uses native line segments. No font glyphs or external
	assets are required; the brand mark also uses native Roblox primitives.

	Every non-ASCII codepoint is written as a \u{...} escape on purpose: the file
	is UTF-8, but escapes keep the glyph table readable and immune to any editor
	or console that would mangle the literal characters.
]]

local Theme = require(script.Parent.Parent.Utilities.Theme)
local TextService = game:GetService("TextService")

local Icons = {}

--=============================================================================
-- GLYPH MAP
--=============================================================================
-- Legacy text candidates for plain-text compatibility. Displayed controls use
-- the native builders below; resolve only selects an ASCII fallback.

Icons.Glyphs = {
	Chat = { "\u{1F4AC}", "\u{1F4AC}", "[#]", "#" },
	Builder = { "\u{1F9F1}", "\u{1F6E0}", "[+]", "+" },
	History = { "\u{1F504}", "\u{1F504}", "[~]", "~" },
	Logs = { "\u{1F4C4}", "\u{25A4}", "[=]", "=" },
	Settings = { "\u{2699}", "\u{2699}", "[*]", "*" },
	Send = { "\u{27A4}", "\u{25B6}", "\u{25B6}", ">" },
	Stop = { "\u{25A0}", "\u{25A0}", "[#]", "#" },
	Play = { "\u{25B6}", "\u{25B6}", "[>]", ">" },
	Plus = { "+", "+", "+", "+" },
	Close = { "\u{2715}", "\u{2715}", "[x]", "x" },
	Search = { "\u{1F50D}", "\u{1F50D}", "[/]", "/" },
	Check = { "\u{2713}", "\u{2713}", "[v]", "v" },
	Warning = { "\u{26A0}", "\u{26A0}", "[!]", "!" },
	Error = { "\u{2716}", "\u{2716}", "[x]", "x" },
	Info = { "\u{24D8}", "i", "[i]", "i" },
	ChevronDown = { "\u{25BE}", "\u{25BE}", "[v]", "v" },
	ChevronRight = { "\u{25B8}", "\u{25B8}", "[>]", ">" },
	Spinner = { "\u{25D0}", "\u{25D0}", "~", "~" },
	Copy = { "\u{29C9}", "\u{29C9}", "[c]", "c" },
	Refresh = { "\u{27F3}", "\u{27F3}", "[r]", "r" },
	Trash = { "\u{1F5D1}", "\u{1F5D1}", "[x]", "x" },
	Edit = { "\u{270E}", "\u{270E}", "[e]", "e" },
	Lock = { "\u{1F512}", "\u{26BF}", "[L]", "L" },
	Unlock = { "\u{1F513}", "\u{26BF}", "[U]", "U" },
	Eye = { "\u{1F441}", "\u{25CE}", "[o]", "o" },
	EyeOff = { "\u{1F576}", "\u{25CF}", "[x]", "x" },
	Attach = { "\u{1F4CE}", "\u{1F4CE}", "[f]", "f" },
	Image = { "\u{1F5BC}", "\u{25A8}", "[i]", "i" },
	Doc = { "\u{1F4C4}", "\u{25A4}", "[d]", "d" },
	Code = { "{ }", "{}", "<>", "<>" },
	Lightbulb = { "\u{1F4A1}", "\u{25C7}", "[i]", "i" },
	Shield = { "\u{1F6E1}", "\u{25C6}", "[s]", "s" },
	Sparkle = { "\u{2728}", "\u{2728}", "*", "*" },
	Robot = { "\u{1F916}", "\u{25CE}", "[a]", "a" },
	Thinking = { "[t]" }, ProviderCustom = { "[p]" }, Tool = { "[+]" },
	Globe = { "[w]" }, Terminal = { ">_" }, ChevronUp = { "^" },
}

--=============================================================================
-- RESOLUTION
--=============================================================================

--- ASCII compatibility fallback for callers that need plain text.
function Icons.resolve(key: string): string
 local candidates = Icons.Glyphs[key]
 if candidates then
  for _, candidate in candidates do
   if candidate:match("^[%w%p ]+$") then return candidate end
  end
 end
 return "?"
end

--=============================================================================
-- BUILDERS
--=============================================================================

-- Native line segments keep every icon independent of font glyph coverage.
local function drawLineIcon(label: TextLabel, key: string): boolean
	local paths: { { { number } } } = {}
	local function circle(x: number, y: number, radius: number, first: number?, last: number?): { { number } }
		local points = {}
		for index = 0, 20 do
			local angle = math.rad((first or 0) + ((last or 360) - (first or 0)) * index / 20)
			points[#points + 1] = { x + math.cos(angle) * radius, y + math.sin(angle) * radius }
		end
		return points
	end
	if key == "Chat" then
		paths = { { { .14, .18 }, { .86, .18 }, { .86, .70 }, { .48, .70 }, { .28, .88 }, { .28, .70 }, { .14, .70 }, { .14, .18 } } }
	elseif key == "Builder" or key == "Code" then
		paths = { { { .34, .22 }, { .12, .50 }, { .34, .78 } }, { { .66, .22 }, { .88, .50 }, { .66, .78 } } }
	elseif key == "Logs" or key == "Doc" then
		paths = {
			{ { .20, .10 }, { .68, .10 }, { .82, .25 }, { .82, .90 }, { .20, .90 }, { .20, .10 } },
			{ { .34, .39 }, { .68, .39 } }, { { .34, .55 }, { .68, .55 } }, { { .34, .71 }, { .59, .71 } },
		}
	elseif key == "Sparkle" then
		paths = { { { .5, .08 }, { .62, .38 }, { .92, .5 }, { .62, .62 }, { .5, .92 }, { .38, .62 }, { .08, .5 }, { .38, .38 }, { .5, .08 } } }
	elseif key == "ChevronDown" then
		paths = { { { .22, .38 }, { .5, .66 }, { .78, .38 } } }
	elseif key == "ChevronRight" then
		paths = { { { .38, .22 }, { .66, .5 }, { .38, .78 } } }
	elseif key == "ChevronUp" then
		paths = { { { .22, .62 }, { .5, .34 }, { .78, .62 } } }
	elseif key == "Thinking" then
		paths = { { { .5, .15 }, { .35, .10 }, { .20, .20 }, { .20, .34 }, { .10, .43 }, { .14, .65 }, { .25, .69 }, { .24, .81 }, { .38, .90 }, { .5, .83 }, { .5, .15 } }, { { .5, .15 }, { .65, .10 }, { .80, .20 }, { .80, .34 }, { .90, .43 }, { .86, .65 }, { .75, .69 }, { .76, .81 }, { .62, .90 }, { .5, .83 } }, { { .23, .36 }, { .38, .42 }, { .33, .57 } }, { { .77, .36 }, { .62, .42 }, { .67, .57 } } }
	elseif key == "ProviderCustom" then
		paths = { circle(.27, .26, .11), circle(.76, .5, .11), circle(.27, .76, .11), { { .38, .26 }, { .65, .5 }, { .38, .76 } }, { { .27, .38 }, { .27, .65 } } }
	elseif key == "Tool" then
		paths = { { { .72, .10 }, { .62, .30 }, { .77, .43 }, { .93, .27 }, { .90, .50 }, { .73, .62 }, { .60, .60 }, { .24, .93 }, { .09, .79 }, { .44, .43 }, { .42, .30 }, { .52, .14 }, { .72, .10 } } }
	elseif key == "Globe" then
		paths = { circle(.5, .5, .40), { { .1, .5 }, { .9, .5 } }, { { .5, .1 }, { .32, .32 }, { .28, .5 }, { .32, .68 }, { .5, .9 }, { .68, .68 }, { .72, .5 }, { .68, .32 }, { .5, .1 } } }
	elseif key == "Terminal" then
		paths = { { { .08, .18 }, { .92, .18 }, { .92, .82 }, { .08, .82 }, { .08, .18 } }, { { .23, .35 }, { .40, .5 }, { .23, .65 } }, { { .52, .65 }, { .76, .65 } } }
	elseif key == "Refresh" or key == "History" then
		local arc = {}
		for index = 0, 16 do
			local angle = math.rad(-50 + index * 300 / 16)
			arc[#arc + 1] = { .5 + math.cos(angle) * .34, .5 + math.sin(angle) * .34 }
		end
		paths = { arc, { { .58, .12 }, { .73, .24 }, { .86, .10 } } }
	elseif key == "Settings" then
		local outer, inner = {}, {}
		for index = 0, 24 do
			local angle = index * math.pi / 12
			local radius = if index % 3 == 0 then .42 else .34
			outer[#outer + 1] = { .5 + math.cos(angle) * radius, .5 + math.sin(angle) * radius }
		end
		for index = 0, 12 do
			local angle = index * math.pi / 6
			inner[#inner + 1] = { .5 + math.cos(angle) * .13, .5 + math.sin(angle) * .13 }
		end
		paths = { outer, inner }
	elseif key == "Send" then
		paths = { { { .18, .45 }, { .5, .12 }, { .82, .45 } }, { { .5, .12 }, { .5, .88 } } }
	elseif key == "Stop" then
		paths = { { { .23, .23 }, { .77, .23 }, { .77, .77 }, { .23, .77 }, { .23, .23 } } }
	elseif key == "Play" then
		paths = { { { .28, .17 }, { .82, .5 }, { .28, .83 }, { .28, .17 } } }
	elseif key == "Plus" then
		paths = { { { .18, .5 }, { .82, .5 } }, { { .5, .18 }, { .5, .82 } } }
	elseif key == "Close" or key == "Error" then
		paths = { { { .24, .24 }, { .76, .76 } }, { { .76, .24 }, { .24, .76 } } }
	elseif key == "Search" then
		paths = { circle(.42, .42, .28), { { .63, .63 }, { .87, .87 } } }
	elseif key == "Check" then
		paths = { { { .16, .5 }, { .4, .75 }, { .84, .24 } } }
	elseif key == "Warning" then
		paths = { { { .5, .12 }, { .91, .85 }, { .09, .85 }, { .5, .12 } }, { { .5, .38 }, { .5, .60 } }, { { .5, .71 }, { .5, .73 } } }
	elseif key == "Info" then
		paths = { circle(.5, .5, .4), { { .5, .45 }, { .5, .75 } }, { { .5, .25 }, { .5, .28 } } }
	elseif key == "Spinner" then
		paths = { circle(.5, .5, .34, -70, 220) }
	elseif key == "Copy" then
		paths = { { { .36, .3 }, { .83, .3 }, { .83, .87 }, { .36, .87 }, { .36, .3 } }, { { .64, .3 }, { .64, .12 }, { .17, .12 }, { .17, .70 }, { .36, .70 } } }
	elseif key == "Trash" then
		paths = { { { .15, .25 }, { .85, .25 } }, { { .35, .25 }, { .35, .12 }, { .65, .12 }, { .65, .25 } }, { { .25, .25 }, { .3, .87 }, { .7, .87 }, { .75, .25 } }, { { .43, .4 }, { .43, .7 } }, { { .57, .4 }, { .57, .7 } } }
	elseif key == "Edit" then
		paths = { { { .15, .85 }, { .22, .6 }, { .7, .12 }, { .87, .29 }, { .39, .77 }, { .15, .85 } }, { { .61, .21 }, { .78, .38 } } }
	elseif key == "Lock" or key == "Unlock" then
		paths = { { { .2, .45 }, { .8, .45 }, { .8, .87 }, { .2, .87 }, { .2, .45 } }, circle(.5, .37, .22, -180, 0), { { .5, .6 }, { .5, .72 } } }
		if key == "Unlock" then paths[2] = circle(.68, .37, .22, -180, -20) end
	elseif key == "Eye" or key == "EyeOff" then
		paths = { { { .08, .5 }, { .27, .29 }, { .5, .22 }, { .73, .29 }, { .92, .5 }, { .73, .71 }, { .5, .78 }, { .27, .71 }, { .08, .5 } }, circle(.5, .5, .15) }
		if key == "EyeOff" then paths[#paths + 1] = { { .12, .12 }, { .88, .88 } } end
	elseif key == "Attach" then
		paths = { { { .68, .23 }, { .31, .60 }, { .31, .73 }, { .42, .79 }, { .52, .73 }, { .82, .43 }, { .82, .23 }, { .7, .11 }, { .54, .11 }, { .17, .48 }, { .17, .75 }, { .33, .9 }, { .57, .9 }, { .77, .7 } } }
	elseif key == "Image" then
		paths = { { { .12, .15 }, { .88, .15 }, { .88, .85 }, { .12, .85 }, { .12, .15 } }, { { .15, .74 }, { .4, .49 }, { .57, .66 }, { .71, .52 }, { .86, .68 } }, circle(.67, .35, .08) }
	elseif key == "Lightbulb" then
		paths = { circle(.5, .36, .25, -210, 30), { { .28, .49 }, { .38, .66 }, { .62, .66 }, { .72, .49 } }, { { .38, .76 }, { .62, .76 } }, { { .43, .86 }, { .57, .86 } } }
	elseif key == "Shield" then
		paths = { { { .5, .1 }, { .83, .24 }, { .79, .6 }, { .67, .79 }, { .5, .9 }, { .33, .79 }, { .21, .6 }, { .17, .24 }, { .5, .1 } } }
	elseif key == "Robot" then
		paths = { { { .18, .28 }, { .82, .28 }, { .82, .8 }, { .18, .8 }, { .18, .28 } }, { { .5, .28 }, { .5, .1 } }, { { .3, .46 }, { .34, .46 } }, { { .66, .46 }, { .7, .46 } }, { { .34, .65 }, { .66, .65 } } }
	else
		return false
	end
	label.Text = ""
	local drawing = Instance.new("Frame")
	drawing.Name = "Drawing"
	drawing.AnchorPoint = Vector2.new(.5, .5)
	drawing.Position = UDim2.fromScale(.5, .5)
	drawing.Size = UDim2.fromOffset(label.TextSize, label.TextSize)
	Theme.passThrough(drawing)
	drawing.Parent = label
	for _, path in paths do
		for index = 2, #path do
			local a, b = path[index - 1], path[index]
			local dx, dy = b[1] - a[1], b[2] - a[2]
			local segment = Instance.new("Frame")
			segment.Name = "IconStroke"
			segment.AnchorPoint = Vector2.new(.5, .5)
			segment.Position = UDim2.fromScale((a[1] + b[1]) / 2, (a[2] + b[2]) / 2)
			segment.Size = UDim2.new(math.sqrt(dx * dx + dy * dy), 0, 0, 1.4)
			segment.Rotation = math.deg(math.atan2(dy, dx))
			segment.BackgroundColor3 = label.TextColor3
			segment.BorderSizePixel = 0
			segment.Parent = drawing
		end
	end
	return true
end

function Icons.setGlyph(label: TextLabel, key: string)
	if label:GetAttribute("IconKey") == key then return end
	local old = label:FindFirstChild("Drawing")
	if old then old:Destroy() end
	label:SetAttribute("IconKey", key)
	label.Text = ""
	if not drawLineIcon(label, key) then label.Text = "?" end
end

--- Creates a square icon host containing native strokes; no font is needed.
function Icons.glyph(key: string, size: number?, color: Color3?): (TextLabel, string)
	local fontSize = size or Theme.TextSizes.BodyLarge
	local text = ""
	local label = Theme.label("", {
		size = fontSize,
		color = color or Theme.Colors.SecondaryText,
		font = Theme.Fonts.Medium,
		alignX = Enum.TextXAlignment.Center,
	})
	label.Name = key .. "Icon"
	label.TextTransparency = 0
	label.Size = UDim2.fromOffset(fontSize, fontSize)
	Icons.setGlyph(label, key)
	label:GetPropertyChangedSignal("TextColor3"):Connect(function()
		local drawing = label:FindFirstChild("Drawing")
		if drawing then
			for _, segment in drawing:GetChildren() do (segment :: Frame).BackgroundColor3 = label.TextColor3 end
		end
	end)
	return label, text
end

--- Keep icon and caption in one measured row, centred inside the button.
function Icons.setButton(button: TextButton, key: string, caption: string?)
	button.Text = caption or ""
	button.TextTransparency = 1
	local content = button:FindFirstChild("ButtonContent") :: Frame?
	if not content then
		for _, child in button:GetChildren() do if child:IsA("UIPadding") then child:Destroy() end end
		content = Instance.new("Frame")
		content.Name = "ButtonContent"
		content.Size = UDim2.fromScale(1, 1)
		Theme.passThrough(content)
		content.Parent = button
		local layout = Theme.listLayout(6, Enum.FillDirection.Horizontal)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Parent = content
		local icon = Icons.glyph(key, 14, button.TextColor3)
		icon.Name = "ButtonIcon"
		icon.LayoutOrder = 1
		icon.Parent = content
		local text = Theme.label("", { size = button.TextSize })
		text.Name = "Caption"
		text.LayoutOrder = 2
		text.TextTruncate = Enum.TextTruncate.AtEnd
		text.Parent = content
		local function refresh()
			if not content or not content.Parent then return end
			icon.TextColor3 = button.TextColor3
			text.Text = button.Text
			text.TextSize = button.TextSize
			text.Font = button.Font
			text.TextColor3 = button.TextColor3
			text.Visible = button.Text ~= ""
			layout.Padding = UDim.new(0, if text.Visible then 6 else 0)
			layout.HorizontalAlignment = if button.TextXAlignment == Enum.TextXAlignment.Left then Enum.HorizontalAlignment.Left else Enum.HorizontalAlignment.Center
			local bounds = TextService:GetTextSize(button.Text, button.TextSize, button.Font, Vector2.new(10000, 1000))
			text.Size = UDim2.fromOffset(math.min(bounds.X, math.max(0, button.AbsoluteSize.X - 28)), math.max(16, button.TextSize + 3))
		end
		for _, property in { "Text", "TextColor3", "TextSize", "Font", "TextXAlignment", "AbsoluteSize" } do button:GetPropertyChangedSignal(property):Connect(refresh) end
		refresh()
	end
	Icons.setGlyph(content:FindFirstChild("ButtonIcon") :: TextLabel, key)
end

--=============================================================================
-- BRAND MARK
--=============================================================================
-- A minimalist forge anvil / geometric hammer drawn with primitives so the
-- toolbar and header share one crisp identity.

local BRAND_COLOR = Theme.Colors.Highlight

function Icons.brandMark(size: number): Frame
	local s = size or 24
	local root = Instance.new("Frame")
	root.Name = "ForgePilotMark"
	root.Size = UDim2.fromOffset(s, s)
	root.BackgroundTransparency = 1
	root.ClipsDescendants = false

	local function piece(props: { [string]: any }): Frame
		local f = Theme.create("Frame", {
			BackgroundColor3 = BRAND_COLOR,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
		})
		for k, v in props do
			(f :: any)[k] = v
		end
		Theme.corner(math.max(1, math.floor(s * 0.08))).Parent = f
		f.Parent = root
		return f
	end

	-- Anvil top plate
	piece({
		Position = UDim2.fromScale(0.5, 0.34),
		Size = UDim2.fromScale(0.82, 0.22),
		Rotation = -12,
	})
	-- Anvil waist
	piece({
		Position = UDim2.fromScale(0.46, 0.58),
		Size = UDim2.fromScale(0.30, 0.16),
		Rotation = -12,
	})
	-- Anvil base
	piece({
		Position = UDim2.fromScale(0.5, 0.80),
		Size = UDim2.fromScale(0.66, 0.16),
	})
	-- Spark highlight, offset for depth
	local spark = piece({
		Position = UDim2.fromScale(0.76, 0.20),
		Size = UDim2.fromScale(0.14, 0.14),
		Rotation = 45,
	})
	spark.BackgroundColor3 = BRAND_COLOR:Lerp(Color3.new(1, 1, 1), 0.45)

	return root
end

return Icons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">JSONValidator</string>
          <string name="Source"><![CDATA[--!strict
local StringUtil = require(script.Parent.StringUtil)

local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Utilities / JSONValidator
	Parsing helpers plus structural validation for AI-produced action payloads.

	The plugin never executes text produced by a model. It parses JSON, then runs
	the result through an explicit schema validator before anything touches the
	DataModel.
]]

local JSONValidator = {}
local objectTables: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

--- Empty Luau tables otherwise become JSON arrays. Keep their intended shape.
function JSONValidator.object(value: any?): any
	local object = value or {}
	assert(type(object) == "table", "JSON object must be a table.")
	objectTables[object] = true
	return object
end

--- Copy JSON Schema dictionaries, preserving arrays such as required/anyOf.
function JSONValidator.toolParameters(value: any): any
	local function schema(node: any): any
		if type(node) ~= "table" then return node end
		local out = JSONValidator.object({})
		for key, child in node do
			if key == "properties" or key == "patternProperties" or key == "$defs" or key == "definitions" or key == "dependentSchemas" then
				local map = JSONValidator.object({})
				for name, definition in child do map[name] = schema(definition) end
				out[key] = map
			elseif key == "allOf" or key == "anyOf" or key == "oneOf" or key == "prefixItems" then
				local list = {}
				for index, definition in child do list[index] = schema(definition) end
				out[key] = list
			elseif key == "items" or key == "additionalProperties" or key == "contains" or key == "not" or key == "if" or key == "then" or key == "else" or key == "propertyNames" then
				out[key] = schema(child)
			else
				out[key] = child
			end
		end
		return out
	end
	return schema(value)
end

--=============================================================================
-- PARSING
--=============================================================================

--- Decodes a JSON string. Returns `nil, message` instead of raising.
function JSONValidator.decode(text: string): (any?, string?)
	if type(text) ~= "string" or string.len(text) == 0 then
		return nil, "Empty JSON payload."
	end
	local ok, result = pcall(HttpService.JSONDecode, HttpService, text)
	if not ok then
		return nil, tostring(result)
	end
	return result, nil
end

--- Encodes a value, returning `nil, message` on failure (non-finite numbers).
function JSONValidator.encode(value: any): (string?, string?)
	local active: { [any]: boolean } = {}
	local function encode(node: any, depth: number): string
		assert(depth <= 64, "JSON nesting exceeds 64 levels.")
		local kind = type(node)
		if kind ~= "table" then
			if node == nil then return "null" end
			assert(kind == "string" or kind == "number" or kind == "boolean", "Unsupported JSON value.")
			if kind == "number" then assert(node == node and math.abs(node) ~= math.huge, "Non-finite JSON number.") end
			local primitive = HttpService:JSONEncode(node)
			assert(type(primitive) == "string" and primitive ~= "", "Could not encode JSON value.")
			return primitive
		end
		assert(not active[node], "Cyclic JSON table.")
		active[node] = true
		local count, array = 0, not objectTables[node]
		for key in node do
			count += 1
			if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then array = false end
		end
		if array then assert(count == #node, "JSON array must have contiguous indexes.") end
		local parts = {}
		if array then
			for index = 1, #node do parts[#parts + 1] = encode(node[index], depth + 1) end
		else
			local keys = {}
			for key in node do assert(type(key) == "string", "JSON object keys must be strings."); keys[#keys + 1] = key end
			table.sort(keys)
			for _, key in keys do parts[#parts + 1] = encode(key, depth + 1) .. ":" .. encode(node[key], depth + 1) end
		end
		active[node] = nil
		return (if array then "[" else "{") .. table.concat(parts, ",") .. (if array then "]" else "}")
	end
	local ok, result = pcall(encode, value, 0)
	if not ok then
		return nil, tostring(result)
	end
	return result, nil
end

function JSONValidator.encodeObject(value: any): (string?, string?)
	if type(value) ~= "table" then return nil, "JSON object must be a table." end
	return JSONValidator.encode(JSONValidator.object(value))
end

--- Extracts the first balanced JSON object from free-form model output.
--- Handles ```json fenced blocks and stray prose around the payload.
function JSONValidator.extractObject(text: string): (any?, string?)
	if type(text) ~= "string" then
		return nil, "No text to parse."
	end

	-- Prefer a fenced code block when present.
	for fence in text:gmatch("```[%a]*\n(.-)```") do
		local decoded = JSONValidator.decode(fence)
		if decoded and type(decoded) == "table" then
			return decoded, nil
		end
	end

	local decoded = JSONValidator.decode(text)
	if decoded and type(decoded) == "table" then
		return decoded, nil
	end

	-- Balanced brace scan, ignoring braces inside strings.
	-- `}` must be escaped inside a character set as `%}`.
	local start = text:find("[{%}]")
	if not start then
		return nil, "No JSON object found in model output."
	end

	local openChar = string.sub(text, start, start)
	local closeChar = if openChar == "{" then "}" else "]"
	local depth = 0
	local inString = false
	local escaped = false

	for index = start, #text do
		local char = string.sub(text, index, index)
		if inString then
			if escaped then
				escaped = false
			elseif char == "\\" then
				escaped = true
			elseif char == '"' then
				inString = false
			end
		elseif char == '"' then
			inString = true
		elseif char == openChar then
			depth += 1
		elseif char == closeChar then
			depth -= 1
			if depth == 0 then
				return JSONValidator.decode(string.sub(text, start, index))
			end
		end
	end

	return nil, "JSON object was not balanced."
end

--=============================================================================
-- TYPE CHECKS
--=============================================================================

function JSONValidator.isString(value: any): boolean
	return type(value) == "string"
end

function JSONValidator.isNonEmptyString(value: any): boolean
	return type(value) == "string" and string.len(StringUtil.trim(value)) > 0
end

function JSONValidator.isNumber(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

function JSONValidator.isBoolean(value: any): boolean
	return type(value) == "boolean"
end

function JSONValidator.isArray(value: any): boolean
	if type(value) ~= "table" then
		return false
	end
	local count = 0
	for _ in value do
		count += 1
	end
	return count == #value
end

--=============================================================================
-- SCHEMA VALIDATION
--=============================================================================

export type Rule = {
	name: string,
	typeName: string?,
	required: boolean?,
	min: number?,
	max: number?,
	pattern: string?,
	oneOf: { any }?,
	default: any?,
	description: string?,
	items: { [string]: any }?,
	validate: ((value: any) -> (boolean, string?))?,
}

export type Schema = { [string]: Rule }

export type Result = {
	ok: boolean,
	value: { [string]: any },
	errors: { string },
}

local function matchesType(value: any, typeName: string): boolean
	if typeName == "string" then
		return type(value) == "string"
	elseif typeName == "number" then
		return JSONValidator.isNumber(value)
	elseif typeName == "boolean" then
		return type(value) == "boolean"
	elseif typeName == "table" then
		return type(value) == "table"
	elseif typeName == "array" then
		return JSONValidator.isArray(value)
	elseif typeName == "any" then
		return true
	end
	return false
end

--- Validates `payload` against `schema`.
--- Unknown keys are preserved so free-form tool arguments survive round-trips,
--- but every documented rule is enforced before the caller uses the value.
function JSONValidator.validate(payload: any, schema: Schema): Result
	local errors: { string } = {}
	local out: { [string]: any } = {}

	if type(payload) ~= "table" then
		return { ok = false, value = {}, errors = { "Payload must be a JSON object." } }
	end

	for key, rule in schema do
		local label = rule.name or key
		local raw = (payload :: any)[key]
		local value = if raw == nil then rule.default else raw

		if value == nil then
			if rule.required then
				errors[#errors + 1] = string.format("`%s` is required.", label)
			end
			continue
		end

		if rule.typeName and not matchesType(value, rule.typeName) then
			errors[#errors + 1] = string.format("`%s` must be %s.", label, rule.typeName)
			continue
		end

		if rule.oneOf then
			local found = false
			for _, allowed in rule.oneOf do
				if allowed == value then
					found = true
					break
				end
			end
			if not found then
				local names = {}
				for _, allowed in rule.oneOf do
					names[#names + 1] = tostring(allowed)
				end
				errors[#errors + 1] =
					string.format("`%s` must be one of: %s.", label, table.concat(names, ", "))
				continue
			end
		end

		-- min/max mean "value range" for numbers and "character count" for strings.
		if rule.typeName == "string" then
			local length = #value
			if rule.min and length < rule.min then
				errors[#errors + 1] = string.format("`%s` must be at least %d characters.", label, rule.min)
				continue
			end
			if rule.max and length > rule.max then
				errors[#errors + 1] = string.format("`%s` must be at most %d characters.", label, rule.max)
				continue
			end
		elseif rule.min and value < rule.min then
			errors[#errors + 1] = string.format("`%s` must be >= %s.", label, tostring(rule.min))
			continue
		elseif rule.max and value > rule.max then
			errors[#errors + 1] = string.format("`%s` must be <= %s.", label, tostring(rule.max))
			continue
		end

		if rule.pattern and type(value) == "string" then
			local matched = string.match(value, rule.pattern) ~= nil
			if not matched then
				errors[#errors + 1] = string.format("`%s` has an invalid format.", label)
				continue
			end
		end

		if rule.validate then
			local valid, message = rule.validate(value)
			if not valid then
				errors[#errors + 1] = string.format("`%s` %s", label, message or "is invalid.")
				continue
			end
		end

		out[key] = value
	end

	return { ok = #errors == 0, value = out, errors = errors }
end

return JSONValidator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">Logger</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Utilities / Logger
	Central activity log. Every entry produced here describes something that
	actually happened; nothing is synthesised for display purposes.
]]

local Redact = require(script.Parent.Redact)

local Logger = {}

export type Level = "INFO" | "SUCCESS" | "WARN" | "ERROR" | "CONNECT" | "AGENT" | "PLAN" | "QUESTION" | "TOOL" | "DEBUG"

export type Entry = {
	id: number,
	--- Wall-clock seconds since the Unix epoch. Used for display.
	timestamp: number,
	--- os.clock() at the time of the event. Used for ordering and durations.
	monotonic: number,
	level: Level,
	category: string,
	message: string,
	detail: string?,
	toolName: string?,
	taskId: string?,
	durationMs: number?,
}

local MAX_ENTRIES = 3000
local listeners: { { [any]: (...any) -&gt; () } } = {}

local levelWeights: { [Level]: number } = {
	DEBUG = 10,
	INFO = 20,
	CONNECT = 20,
	AGENT = 20,
	PLAN = 20,
	QUESTION = 20,
	TOOL = 20,
	SUCCESS = 20,
	WARN = 30,
	ERROR = 40,
}

Logger.levels = levelWeights

local levelColors: { [Level]: Color3 } = {
	DEBUG = Color3.fromHex("#6B6377"),
	INFO = Color3.fromHex("#A7A0B2"),
	CONNECT = Color3.fromHex("#6FA8DC"),
	AGENT = Color3.fromHex("#9879E8"),
	PLAN = Color3.fromHex("#9879E8"),
	QUESTION = Color3.fromHex("#E8B661"),
	TOOL = Color3.fromHex("#F4F1F8"),
	SUCCESS = Color3.fromHex("#49C591"),
	WARN = Color3.fromHex("#E8B661"),
	ERROR = Color3.fromHex("#F16E7A"),
}

Logger.levelColor = levelColors

local allEntries: { Entry } = {}
local nextId = 1
local minimumLevel: number = Logger.levels.INFO

--=============================================================================
-- SUBSCRIPTION
--=============================================================================

--- Subscribes to the log stream. Returns a function that unsubscribes.
function Logger.subscribe(callback: (Entry) -&gt; ()): () -&gt; ()
	local holder = { callback = callback }
	table.insert(listeners, holder)
	return function()
		for index, entry in listeners do
			if entry == holder then
				table.remove(listeners, index)
				return
			end
		end
	end
end

function Logger.unsubscribe(callback: (Entry) -&gt; ())
	for index, holder in listeners do
		if holder.callback == callback then
			table.remove(listeners, index)
			return
		end
	end
end

local function dispatch(entry: Entry)
	for _, holder in listeners do
		local ok, err = pcall(holder.callback, entry)
		if not ok then
			warn("[ForgePilot] log listener error: " .. tostring(err))
		end
	end
end

--=============================================================================
-- EMIT
--=============================================================================

local function normaliseLevel(level: any): Level
	local resolved = tostring(level):upper()
	if Logger.levels[resolved] then
		return resolved
	end
	return "INFO"
end

function Logger.log(level: any, category: string, message: string, options: {
	detail: string?,
	toolName: string?,
	taskId: string?,
	durationMs: number?,
}?)
	local resolvedLevel = normaliseLevel(level)
	if Logger.levels[resolvedLevel] &lt; minimumLevel then
		return nil
	end

	local entry: Entry = {
		id = nextId,
		timestamp = os.time(),
		monotonic = os.clock(),
		level = resolvedLevel,
		category = Redact.scrubText(category),
		message = Redact.scrubText(message),
		detail = if options and options.detail then Redact.scrubText(options.detail) else nil,
		toolName = options and options.toolName or nil,
		taskId = options and options.taskId or nil,
		durationMs = options and options.durationMs or nil,
	}
	nextId += 1

	allEntries[#allEntries + 1] = entry
	if #allEntries &gt; MAX_ENTRIES then
		table.remove(allEntries, 1)
	end

	dispatch(entry)
	return entry
end

-- Convenience wrappers -------------------------------------------------

function Logger.info(category: string, message: string, options: { detail: string?, toolName: string?, taskId: string?, durationMs: number? }?)
	return Logger.log("INFO", category, message, options)
end

function Logger.success(category: string, message: string, options: { detail: string?, toolName: string?, taskId: string?, durationMs: number? }?)
	return Logger.log("SUCCESS", category, message, options)
end

function Logger.warn(category: string, message: string, options: { detail: string?, toolName: string?, taskId: string?, durationMs: number? }?)
	return Logger.log("WARN", category, message, options)
end

function Logger.error(category: string, message: string, options: { detail: string?, toolName: string?, taskId: string?, durationMs: number? }?)
	return Logger.log("ERROR", category, message, options)
end

function Logger.debug(category: string, message: string, options: { detail: string?, toolName: string?, taskId: string?, durationMs: number? }?)
	return Logger.log("DEBUG", category, message, options)
end

--=============================================================================
-- LEVEL CONTROL
--=============================================================================

function Logger.setLevel(level: Level)
	minimumLevel = Logger.levels[level] or Logger.levels.INFO
end

function Logger.getLevel(): Level
	for name, value in Logger.levels do
		if value == minimumLevel then
			return name
		end
	end
	return "INFO"
end

--=============================================================================
-- RETRIEVAL
--=============================================================================

function Logger.getEntries(): { Entry }
	local copy = table.clone(allEntries)
	return copy
end

function Logger.getCategoryList(): { string }
	local seen: { [string]: boolean } = {}
	local list: { string } = {}
	for _, entry in allEntries do
		if not seen[entry.category] then
			seen[entry.category] = true
			list[#list + 1] = entry.category
		end
	end
	table.sort(list)
	return list
end

function Logger.clear()
	allEntries = {}
end

--- Formats an entry the way the Logs panel renders it.
function Logger.format(entry: Entry, includeDetail: boolean?): string
	-- FormatLocalTime already renders in the viewer's local zone, so there is
	-- no ToLocal() step here. Calling it was both redundant and rejected by the
	-- real engine ("ToLocal is not a valid member of DateTime").
	local stamp = DateTime.fromUnixTimestampMillis(entry.timestamp * 1000)
		:FormatLocalTime("HH:mm:ss", "short")
	local line = string.format("[%s] [%s] %s", stamp, entry.level, entry.message)
	if entry.toolName then
		line ..= string.format("  «%s»", entry.toolName)
	end
	if includeDetail and entry.detail and #entry.detail &gt; 0 then
		line ..= "\n    " .. entry.detail:gsub("\n", "\n    ")
	end
	return Redact.scrubText(line)
end

function Logger.copyAll(): string
	local parts: { string } = {}
	for _, entry in allEntries do
		parts[#parts + 1] = Logger.format(entry, true)
	end
	return table.concat(parts, "\n")
end

return Logger</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">ProviderLogo</string>
          <string name="Source"><![CDATA[--!strict
local Theme = require(script.Parent.Theme)
local Data = require(script.Parent.ProviderLogoData)
local Icons = require(script.Parent.Icons)
local ProviderLogo = {}
-- Local PNGs load through rbxasset. A compact rendering of the same PNG keeps
-- logos visible on portable installations and after a Studio version update.
function ProviderLogo.build(id: string?, size: number): Frame
    local frame = Instance.new("Frame")
    frame.Name = "ProviderLogo"
    frame.Size = UDim2.fromOffset(size, size)
    Theme.passThrough(frame)
    local runs = if id then Data[id] else nil
    if not runs then
        local mark = Icons.glyph("ProviderCustom", size, Theme.Colors.Highlight)
        mark.Name = "Fallback"; mark.Size = UDim2.fromScale(1, 1); mark.Parent = frame
        return frame
    end
    local fallback = Instance.new("Frame")
    fallback.Name = "BundledLogo"; fallback.Size = UDim2.fromScale(1, 1); Theme.passThrough(fallback); fallback.Parent = frame
    for index, run in runs do
        local pixel = Instance.new("Frame")
        pixel.Name = "Run" .. index
        pixel.Position = UDim2.fromScale(run[1] / 20, run[2] / 20)
        pixel.Size = UDim2.fromScale(run[3] / 20, 1 / 20)
        pixel.BackgroundColor3 = Color3.fromRGB(run[4], run[5], run[6])
        pixel.BackgroundTransparency = 1 - run[7] / 255
        pixel.BorderSizePixel = 0; pixel.Active = false; pixel.Parent = fallback
    end
    local image = Instance.new("ImageLabel")
    image.Name = "PNG"; image.Size = UDim2.fromScale(1, 1); image.BackgroundTransparency = 1
    image.Image = "rbxasset://ForgePilot/providers/" .. id .. ".png"
    image.ScaleType = Enum.ScaleType.Fit; image.Visible = false; image.Parent = frame
    image:GetPropertyChangedSignal("IsLoaded"):Connect(function() image.Visible = image.IsLoaded; fallback.Visible = not image.IsLoaded end)
    image.Visible = image.IsLoaded; fallback.Visible = not image.IsLoaded
    return frame
end
return ProviderLogo
]]></string>
        </Properties>
      </Item>
