      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AccessAdvisor</string>
          <string name="Source"><![CDATA[--!strict
local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local AccessAdvisor = {}
AccessAdvisor.setupUrl = "https://github.com/AlFarrizi-Studio/ForgePilot"
function AccessAdvisor.notice(text: string, report: any?): string?
	local input = text:lower()
	if not BridgeClient.isConnected() then
		for _, term in { "search", "web", "internet", "browse", "cari referensi", "download", "unduh", "local file", "file lokal", "https://", "http://" } do
			if input:find(term, 1, true) then
				return "Web dan file lokal belum tersedia karena bridge belum terhubung. Panduan: " .. AccessAdvisor.setupUrl .. ". Hubungkan lewat Settings > Agent Access."
			end
		end
	end
	if input:find("vision", 1, true) or input:find("lihat gambar", 1, true) or input:find("lihat foto", 1, true) then
		local vision = report and report.capabilities and report.capabilities.vision
		if not vision or vision.status ~= "supported" then return "Vision model ini belum didukung atau belum terverifikasi. Pilih model dan adapter yang menerima gambar; bridge saja tidak menambahkan vision ke model." end
	end
	return nil
end
return AccessAdvisor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">AdapterTypes</string>
          <string name="Source">--!strict
--[[
	ForgePilot / AI / AdapterTypes
	Shared shapes every protocol adapter produces and consumes.

	Adapters are intentionally pure: they translate between the plugin's internal
	representation and a provider's wire format. They never perform I/O, never
	touch the DataModel, and never log message bodies.
]]

local AdapterTypes = {}

export type ContentPart =
	| { kind: "text", text: string }
	| { kind: "image", mime: string, data: string, fileName: string? }
	| { kind: "document", mime: string, data: string, fileName: string?, kind2: string? }
	| { kind: "audio", mime: string, data: string, fileName: string? }
	| { kind: "video", mime: string, data: string, fileName: string? }

export type ChatMessage = {
	role: "system" | "user" | "assistant" | "tool",
	content: string?,
	parts: { ContentPart }?,
	toolCallId: string?,
	toolCalls: { { id: string, name: string, arguments: any } }?,
	toolResult: string?,
}

export type ToolDefinition = {
	name: string,
	description: string,
	-- JSON Schema object describing `arguments`.
	parameters: { [string]: any },
}

export type RequestSpec = {
	messages: { ChatMessage },
	system: string?,
	tools: { ToolDefinition }?,
	toolChoice: "auto" | "none" | "required",
	model: string,
	temperature: number?,
	topP: number?,
	maxOutputTokens: number?,
	streaming: boolean,
	jsonMode: boolean,
	reasoningEffort: string?,
	reasoningSummary: boolean?,
	responseFormatName: string?,
	stopSequences: { string }?,
	cacheKey: string?,
	safetySettings: { any }?,
}

export type Usage = {
	inputTokens: number?,
	outputTokens: number?,
	reasoningTokens: number?,
	cachedTokens: number?,
	source: "provider" | "estimated" | "none",
}

export type ToolCall = {
	id: string,
	name: string,
	arguments: any,
	rawArguments: string?,
}

export type ResponseChunk = {
	kind: "text" | "reasoning" | "tool_call_delta" | "usage" | "done" | "error" | "raw",
	text: string?,
	reasoning: string?,
	toolCall: ToolCall?,
	usage: Usage?,
	message: string?,
	raw: any?,
}

export type CompleteResponse = {
	text: string,
	reasoning: string?,
	toolCalls: { ToolCall },
	usage: Usage,
	stopReason: string?,
	raw: any?,
}

export type TestOutcome = {
	ok: boolean,
	statusCode: number?,
	message: string,
	latencyMs: number,
	usage: Usage?,
	model: string?,
	body: any?,
}

return AdapterTypes</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="5">
        <Properties>
          <string name="Name">Adapters</string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">AnthropicAdapter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / Adapters / AnthropicAdapter
	Implements the Anthropic Messages API wire format (POST /v1/messages).

	Auth differs from OpenAI: the key goes in `x-api-key`, and `anthropic-version`
	is mandatory. The system prompt is a top-level `system` field (not a message).
	Content is a block array. Tool results are `tool_result` blocks inside a
	user message, not standalone messages.

	STREAMING EVENTS (real):
	    event: content_block_delta
	    data: {"type":"content_block_delta","index":0,
	           "delta":{"type":"text_delta","text":"Hi"}}
	    event: content_block_delta  (thinking -> delta.thinking)
	    event: content_block_start   (tool_use -> {"content_block":{"type":"tool_use",...}})
	    event: content_block_delta   (input_json_delta -> {"delta":{"partial_json":"{\""}})
	    event: message_delta / message_stop
]]

local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)
local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local Base64 = require(script.Parent.Parent.Parent.Utilities.Base64)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)
type RequestSpec = AdapterTypes.RequestSpec
type CompleteResponse = AdapterTypes.CompleteResponse
type Usage = AdapterTypes.Usage
type ToolCall = AdapterTypes.ToolCall

--=============================================================================
-- REQUEST
--=============================================================================

local function buildBlocks(parts: { any }): { { [string]: any } }
	local out = {}
	for _, part in parts do
		if part.kind == "text" then
			out[#out + 1] = { type = "text", text = part.text }
		elseif part.kind == "image" then
			-- Anthropic takes raw base64, never data URLs, and only accepts
			-- image/jpeg, image/png, image/gif, image/webp.
			out[#out + 1] = {
				type = "image",
				source = { type = "base64", media_type = part.mime, data = part.data },
			}
		elseif part.kind == "document" then
			if part.mime == "text/plain" or part.mime == "text/markdown" then
				out[#out + 1] = {
					type = "text",
					text = string.format("Contents of `%s`:\n\n%s", part.fileName, part.data),
				}
			end
		end
	end
	return out
end

local function buildMessage(message: AdapterTypes.ChatMessage): { [string]: any }?
	if message.role == "tool" then
		return {
			role = "user",
			content = {
				{
					type = "tool_result",
					tool_use_id = message.toolCallId,
					content = message.toolResult or message.content or "",
				},
			},
		}
	end

	local content: { { [string]: any } } = {}

	for _, call in (message.toolCalls or {}) do
		content[#content + 1] = {
			type = "tool_use",
			id = call.id,
			name = call.name,
			input = JSONValidator.object(call.arguments or {}),
		}
	end

	if message.parts and #message.parts > 0 then
		for _, block in buildBlocks(message.parts) do
			content[#content + 1] = block
		end
	elseif message.content and #message.content > 0 then
		content[#content + 1] = { type = "text", text = message.content }
	end

	if #content == 0 then
		return nil
	end

	return { role = if message.role == "assistant" then "assistant" else "user", content = content }
end

function Adapter.buildRequest(profile: any, spec: RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = false })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = {
		model = spec.model,
		messages = {},
		max_tokens = spec.maxOutputTokens or 4096,
	}

	local systemBlocks: { string } = {}
	for _, message in spec.messages do
		if message.role == "system" then
			systemBlocks[#systemBlocks + 1] = message.content or ""
		else
			local payload = buildMessage(message)
			if payload then
				table.insert(body.messages :: { any }, payload)
			end
		end
	end
	if spec.system and #StringUtil.trim(spec.system) > 0 then
		systemBlocks[#systemBlocks + 1] = spec.system
	end
	if #systemBlocks > 0 then
		body.system = table.concat(systemBlocks, "\n\n")
	end

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.stopSequences and #spec.stopSequences > 0 then
		body.stop_sequences = spec.stopSequences
	end
	if spec.streaming and includeStream then
		body.stream = true
	end

	if spec.tools and #spec.tools > 0 then
		local tools = {}
		for _, tool in spec.tools do
			tools[#tools + 1] = {
				name = tool.name,
				description = tool.description,
				input_schema = JSONValidator.toolParameters(tool.parameters),
			}
		end
		body.tools = tools
		if spec.toolChoice == "none" then
			body.tool_choice = { type = "none" }
		elseif spec.toolChoice == "required" then
			body.tool_choice = { type = "any" }
		end
	end

	local encoded, encodeErr = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeErr)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
	local headers: { [string]: string } = {
		["Content-Type"] = "application/json",
		["anthropic-version"] = protocol.defaultHeaders["anthropic-version"] or "2023-06-01",
	}
	if apiKey then
		headers["x-api-key"] = apiKey
	end
	for key, value in (profile.extraHeaders or {}) do
		if type(key) == "string" and type(value) == "string" then
			headers[key] = value
		end
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

local function parseUsage(raw: any): Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	return {
		inputTokens = tonumber(raw.input_tokens),
		outputTokens = tonumber(raw.output_tokens),
		reasoningTokens = nil,
		cachedTokens = tonumber(raw.cache_read_input_tokens),
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end
	if type(decoded) ~= "table" then
		return nil, "Provider returned an unexpected payload shape."
	end
	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.type or "error") .. ": " .. tostring(decoded.error.message or "Provider error.")
	end

	local text: { string } = {}
	local thinking: { string } = {}
	local toolCalls: { ToolCall } = {}

	local content = decoded.content
	if type(content) ~= "table" then
		return nil, "Anthropic response contained no content blocks."
	end

	for _, block in content do
		if type(block) ~= "table" then
			continue
		end
		if block.type == "text" and type(block.text) == "string" then
			text[#text + 1] = block.text
		elseif block.type == "thinking" and type(block.thinking) == "string" then
			thinking[#thinking + 1] = block.thinking
		elseif block.type == "tool_use" then
			table.insert(toolCalls, {
				id = block.id or ("call_" .. tostring(#toolCalls + 1)),
				name = tostring(block.name or ""),
				arguments = type(block.input) == "table" and block.input or {},
			})
		end
	end

	return {
		text = table.concat(text, "\n"),
		reasoning = if #thinking > 0 then table.concat(thinking, "\n") else nil,
		toolCalls = toolCalls,
		usage = parseUsage(decoded.usage),
		stopReason = decoded.stop_reason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", text = {}, thinking = {}, tools = {}, usage = nil, stopReason = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		local data = nil
		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			if string.sub(line, 1, 6) == "data: " then
				data = (data or "") .. string.sub(line, 7)
			end
		end
		if not data or data == "[DONE]" then
			continue
		end

		local decoded = JSONValidator.decode(data)
		if not decoded or type(decoded) ~= "table" then
			continue
		end

		local eventType = decoded.type

		if eventType == "content_block_start" and type(decoded.content_block) == "table" then
			local block = decoded.content_block
			local index = decoded.index or 0
			if block.type == "tool_use" then
				state.tools[index] = { id = block.id, name = block.name, args = "" }
			end
		elseif eventType == "content_block_delta" and type(decoded.delta) == "table" then
			local delta = decoded.delta
			local index = decoded.index or 0
			if delta.type == "text_delta" and type(delta.text) == "string" then
				state.text[#state.text + 1] = delta.text
				events[#events + 1] = { kind = "text", text = delta.text }
			elseif delta.type == "thinking_delta" and type(delta.thinking) == "string" then
				state.thinking[#state.thinking + 1] = delta.thinking
				events[#events + 1] = { kind = "reasoning", reasoning = delta.thinking }
			elseif delta.type == "input_json_delta" and type(delta.partial_json) == "string" then
				local slot = state.tools[index]
				if slot then
					slot.args ..= delta.partial_json
				end
			end
		elseif eventType == "message_delta" then
			-- Anthropic reports cumulative output tokens in the event's own
			-- `usage` object; only the stop reason lives inside `delta`.
			local delta = decoded.delta
			if type(delta) == "table" and delta.stop_reason then
				state.stopReason = delta.stop_reason
			end
			if type(decoded.usage) == "table" then
				local merged = state.usage or {}
				local incoming = parseUsage(decoded.usage)
				state.usage = {
					inputTokens = incoming.inputTokens or merged.inputTokens,
					outputTokens = incoming.outputTokens or merged.outputTokens,
					cachedTokens = incoming.cachedTokens or merged.cachedTokens,
					source = "provider",
				}
			elseif type(delta) == "table" and type(delta.usage) == "table" then
				state.usage = parseUsage(delta.usage)
			end
		elseif eventType == "message_stop" then
			events[#events + 1] = { kind = "usage", usage = state.usage }
			events[#events + 1] = { kind = "done" }
		elseif eventType == "error" then
			local err = decoded.error or {}
			events[#events + 1] = {
				kind = "error",
				message = tostring(err.message or "Anthropic stream error."),
			}
		end
	end

	return events
end

function Adapter.finalizeStream(state: any): { ToolCall }
	local calls: { ToolCall } = {}
	local indices = {}
	for index in pairs(state.tools) do
		indices[#indices + 1] = index
	end
	table.sort(indices)
	for _, index in indices do
		local slot = state.tools[index]
		local parsed = JSONValidator.decode(slot.args)
		table.insert(calls, {
			id = slot.id or ("call_" .. tostring(#calls + 1)),
			name = slot.name,
			arguments = if parsed then parsed else {},
			rawArguments = slot.args,
		})
	end
	return calls
end

function Adapter.streamStateUsage(state: any): Usage?
	return state.usage
end

return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">CustomJSONAdapter</string>
            <string name="Source">--!strict
--[[
	ForgePilot / AI / Adapters / CustomJSONAdapter
	A REST endpoint that is NOT OpenAI-compatible, driven by an explicit schema
	mapping the user configures.

	The mapping is deliberately literal — no guessing. Every request and response
	field is named by the user with a dotted path:

	  schemaMapping = {
	    request = {
	      prompt     = "input.text",        -- where to put the prompt
	      model     = "parameters.model",  -- where to put the model id
	      system    = "input.system",       -- optional
	      stream    = "parameters.stream",  -- optional boolean
	      tools     = "tools",              -- optional array
	    },
	    response = {
	      text      = "output.answer",     -- where the reply lives
	      reasoning = "output.thoughts",    -- optional
	      finish    = "meta.finish_reason", -- optional
	      usage = { input = "usage.prompt", output = "usage.completion" },
	    },
	  }

	Without a mapping the adapter refuses to build a request and says exactly what
	is missing. Arbitrary REST is never assumed to be OpenAI-compatible.
]]

local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)

--=============================================================================
-- PATH HELPERS
--=============================================================================

--- Reads a dotted path out of a decoded table. Returns nil when absent.
local function readPath(root: any, path: any): any
	if type(path) ~= "string" or #path == 0 or type(root) ~= "table" then
		return nil
	end
	local cursor = root
	for segment in string.gmatch(path, "[^%.]+") do
		if type(cursor) ~= "table" then
			return nil
		end
		cursor = cursor[segment]
		if cursor == nil then
			return nil
		end
	end
	return cursor
end

--- Writes a value at a dotted path, creating intermediate tables.
local function writePath(root: { [string]: any }, path: any, value: any): boolean
	if type(path) ~= "string" or #path == 0 then
		return false
	end
	local segments: { string } = {}
	for segment in string.gmatch(path, "[^%.]+") do
		segments[#segments + 1] = segment
	end
	if #segments == 0 then
		return false
	end

	local cursor: any = root
	for index = 1, #segments - 1 do
		local key = segments[index]
		if type(cursor[key]) ~= "table" then
			cursor[key] = {}
		end
		cursor = cursor[key]
	end
	cursor[segments[#segments]] = value
	return true
end

Adapter.readPath = readPath
Adapter.writePath = writePath

--=============================================================================
-- REQUEST
--=============================================================================

function Adapter.buildRequest(profile: any, spec: AdapterTypes.RequestSpec, includeStream: boolean): (any?, string?)
	local mapping = profile.schemaMapping
	if type(mapping) ~= "table" or type(mapping.request) ~= "table" then
		return nil,
			"Custom REST providers need a Request Schema Mapping. Add one in Advanced Settings, for example prompt → \"input.text\"."
	end

	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = includeStream })
	if not url then
		return nil, urlError
	end

	local requestMapping = mapping.request
	local body: { [string]: any } = {}

	-- The system prompt and conversation are combined into ONE text block unless
	-- the user mapped a separate `system` destination. An unset `system` path
	-- therefore leaves no key in the body at all.
	local systemText = if spec.system and #StringUtil.trim(spec.system) &gt; 0 then spec.system else nil

	local promptParts: { string } = {}
	if systemText then
		promptParts[#promptParts + 1] = systemText
	end
	for _, message in spec.messages do
		local text = message.content
		if (not text or #text == 0) and message.parts then
			local pieces = {}
			for _, part in message.parts do
				if part.kind == "text" then
					pieces[#pieces + 1] = part.text
				end
			end
			text = table.concat(pieces, "\n")
		end
		if text and #text &gt; 0 then
			promptParts[#promptParts + 1] = text
		end
	end
	local prompt = table.concat(promptParts, "\n\n")

	if not writePath(body, requestMapping.prompt, prompt) then
		return nil, "Request Schema Mapping is missing a `prompt` destination path."
	end
	if requestMapping.model and not writePath(body, requestMapping.model, spec.model) then
		return nil, "Request Schema Mapping has an invalid `model` destination path."
	end
	if requestMapping.system and systemText then
		writePath(body, requestMapping.system, systemText)
	end
	if requestMapping.temperature and spec.temperature ~= nil then
		writePath(body, requestMapping.temperature, spec.temperature)
	end
	if requestMapping.maxOutputTokens and spec.maxOutputTokens then
		writePath(body, requestMapping.maxOutputTokens, spec.maxOutputTokens)
	end
	if requestMapping.stream then
		writePath(body, requestMapping.stream, includeStream and spec.streaming == true)
	end
	if requestMapping.tools and spec.tools and #spec.tools &gt; 0 then
		writePath(body, requestMapping.tools, spec.tools)
	end

	-- Any static fields the user declared verbatim.
	if type(mapping.staticFields) == "table" then
		for path, value in mapping.staticFields do
			writePath(body, path, value)
		end
	end

	local encoded, encodeError = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeError)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }

	local authHeaders = UniversalProviderRegistry.buildAuthHeaders({
		style = profile.authStyle or "bearer",
		headerName = profile.authHeaderName,
		headerPrefix = profile.authHeaderPrefix,
		queryParam = profile.authQueryParam,
	}, apiKey)
	for key, value in authHeaders do
		headers[key] = value
	end

	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

function Adapter.parseResponse(body: string, profile: any?): (AdapterTypes.CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded or type(decoded) ~= "table" then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end

	local mapping = if profile then profile.schemaMapping else nil
	local responseMapping = if type(mapping) == "table" then mapping.response else nil

	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.message or "Provider reported an error.")
	end

	if type(responseMapping) ~= "table" then
		return nil,
			"Custom REST providers need a Response Schema Mapping. Add one in Advanced Settings so ForgePilot knows where the reply lives."
	end

	local text = readPath(decoded, responseMapping.text)
	if text == nil then
		return nil, string.format(
			"No text found at the mapped response path `%s`. The provider may have changed its shape.",
			tostring(responseMapping.text)
		)
	end
	if type(text) ~= "string" then
		return nil, string.format("The value at `%s` is a %s, not a string.", tostring(responseMapping.text), type(text))
	end

	local reasoning = readPath(decoded, responseMapping.reasoning)
	if type(reasoning) ~= "string" then
		reasoning = nil
	end

	local finishReason = readPath(decoded, responseMapping.finish)

	local inputTokens: number? = nil
	local outputTokens: number? = nil
	local usageMapping = responseMapping.usage
	if type(usageMapping) == "table" then
		inputTokens = tonumber(readPath(decoded, usageMapping.input))
		outputTokens = tonumber(readPath(decoded, usageMapping.output))
	end

	return {
		text = text,
		reasoning = reasoning,
		toolCalls = {},
		usage = {
			inputTokens = inputTokens,
			outputTokens = outputTokens,
			source = if inputTokens or outputTokens then "provider" else "none",
		},
		stopReason = if type(finishReason) == "string" then finishReason else nil,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================
-- A custom endpoint is non-streaming unless the user declares a chunk path.

function Adapter.newStreamState()
	return { buffer = "" }
end

function Adapter.parseStreamChunk(_state: any, _chunk: string): { AdapterTypes.ResponseChunk }
	-- No streaming contract without an explicit mapping, so nothing is emitted.
	return {}
end

function Adapter.finalizeStream(_state: any): { AdapterTypes.ToolCall }
	return {}
end

function Adapter.streamStateUsage(_state: any): AdapterTypes.Usage?
	return nil
end

return Adapter</string>
