            <string name="Name">GeminiAdapter</string>
            <string name="Source">--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / AI / Adapters / GeminiAdapter
	Implements the Google Gemini native generateContent wire format.

	Auth uses the x-goog-api-key header. The model id is part of the path.
	`contents[].parts[]` is the universal shape. Multimodal data is inline base64
	with a declared mimeType. Function calling uses `functionDeclarations`.
	System instructions live in `systemInstruction`. Usage lives in
	`usageMetadata` with `thoughtsTokenCount` for reasoning models.

	STREAMING (SSE, requires ?alt=sse on the stream URL):
	    data: {"candidates":[{"content":{"parts":[{"text":"Hi"}]}}],
	           "usageMetadata":{"promptTokenCount":12,...}}
]]

local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)
local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)
type RequestSpec = AdapterTypes.RequestSpec
type CompleteResponse = AdapterTypes.CompleteResponse
type Usage = AdapterTypes.Usage
type ToolCall = AdapterTypes.ToolCall

--=============================================================================
-- REQUEST
--=============================================================================

local function buildParts(parts: { any }): { { [string]: any } }
	local out = {}
	for _, part in parts do
		if part.kind == "text" then
			out[#out + 1] = { text = part.text }
		elseif part.kind == "image" or part.kind == "document" or part.kind == "audio" or part.kind == "video" then
			-- Gemini is the one protocol here where images, documents, audio and
			-- video all use the same inlineData shape.
			out[#out + 1] = {
				inlineData = { mimeType = part.mime, data = part.data },
			}
		end
	end
	return out
end

local function buildContent(message: AdapterTypes.ChatMessage): { [string]: any }?
	if message.role == "tool" then
		return {
			role = "user",
			parts = {
				{
					functionResponse = {
						name = message.toolCallId,
						response = { result = message.toolResult or message.content or "" },
					},
				},
			},
		}
	end

	local parts: { { [string]: any } } = {}

	for _, call in (message.toolCalls or {}) do
		parts[#parts + 1] = {
			functionCall = { name = call.name, args = JSONValidator.object(call.arguments or {}) },
		}
	end

	if message.parts and #message.parts &gt; 0 then
		for _, block in buildParts(message.parts) do
			parts[#parts + 1] = block
		end
	elseif message.content and #message.content &gt; 0 then
		parts[#parts + 1] = { text = message.content }
	end

	if #parts == 0 then
		return nil
	end

	return {
		role = if message.role == "assistant" then "model" else "user",
		parts = parts,
	}
end

--- `#t` is only meaningful for sequences, so emptiness is counted explicitly.
local function countKeys(t: any): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function Adapter.buildRequest(profile: any, spec: RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = includeStream == true })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = { contents = {} }
	local systemParts: { { [string]: any } } = {}

	for _, message in spec.messages do
		if message.role == "system" then
			systemParts[#systemParts + 1] = { text = message.content or "" }
		else
			local content = buildContent(message)
			if content then
				table.insert(body.contents :: { any }, content)
			end
		end
	end

	if spec.system and #StringUtil.trim(spec.system) &gt; 0 then
		systemParts[#systemParts + 1] = { text = spec.system }
	end
	if #systemParts &gt; 0 then
		body.systemInstruction = { parts = systemParts }
	end

	local generationConfig: { [string]: any } = {}
	if spec.maxOutputTokens then
		generationConfig.maxOutputTokens = spec.maxOutputTokens
	end
	if spec.temperature ~= nil then
		generationConfig.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		generationConfig.topP = spec.topP
	end
	if spec.stopSequences and #spec.stopSequences &gt; 0 then
		generationConfig.stopSequences = spec.stopSequences
	end
	if spec.jsonMode then
		generationConfig.responseMimeType = "application/json"
	end
	if countKeys(generationConfig) &gt; 0 then
		body.generationConfig = generationConfig
	end

	if spec.tools and #spec.tools &gt; 0 then
		local declarations = {}
		for _, tool in spec.tools do
			declarations[#declarations + 1] = {
				name = tool.name,
				description = tool.description,
				parameters = JSONValidator.toolParameters(tool.parameters),
			}
		end
		body.tools = { { functionDeclarations = declarations } }
		if spec.toolChoice == "none" then
			body.toolConfig = { functionCallingConfig = { mode = "NONE" } }
		elseif spec.toolChoice == "required" then
			body.toolConfig = { functionCallingConfig = { mode = "ANY" } }
		end
	end

	if spec.safetySettings then
		body.safetySettings = spec.safetySettings
	end

	local encoded, encodeErr = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeErr)
	end

	-- Streaming requires the alt=sse query parameter on the native endpoint.
	if includeStream and spec.streaming then
		url ..= "?alt=sse"
	end

	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }
	if apiKey then
		headers["x-goog-api-key"] = apiKey
	end
	for key, value in (profile.extraHeaders or {}) do
		if type(key) == "string" and type(value) == "string" then
			headers[key] = value
		end
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

local function parseUsage(raw: any): Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	return {
		inputTokens = tonumber(raw.promptTokenCount),
		outputTokens = tonumber(raw.candidatesTokenCount),
		reasoningTokens = tonumber(raw.thoughtsTokenCount),
		cachedTokens = tonumber(raw.cachedContentTokenCount),
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end
	if type(decoded) ~= "table" then
		return nil, "Provider returned an unexpected payload shape."
	end
	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.message or "Gemini reported an error.")
	end

	local candidates = decoded.candidates
	if type(candidates) ~= "table" or #candidates == 0 then
		local blocked = decoded.promptFeedback
		if type(blocked) == "table" and type(blocked.blockReason) == "string" then
			return nil, "Prompt was blocked: " .. blocked.blockReason
		end
		return nil, "Gemini response contained no candidates."
	end

	local candidate = candidates[1]
	local text: { string } = {}
	local thoughtText: { string } = {}
	local toolCalls: { ToolCall } = {}

	if type(candidate.content) == "table" and type(candidate.content.parts) == "table" then
		for _, part in candidate.content.parts do
			if type(part) ~= "table" then
				continue
			end
			if type(part.text) == "string" then
				if part.thought == true then
					thoughtText[#thoughtText + 1] = part.text
				else
					text[#text + 1] = part.text
				end
			end
			if type(part.functionCall) == "table" then
				local call = part.functionCall
				table.insert(toolCalls, {
					id = call.id or ("call_" .. tostring(#toolCalls + 1)),
					name = tostring(call.name or ""),
					arguments = type(call.args) == "table" and call.args or {},
				})
			end
		end
	end

	return {
		text = table.concat(text),
		reasoning = if #thoughtText &gt; 0 then table.concat(thoughtText, "\n") else nil,
		toolCalls = toolCalls,
		usage = parseUsage(decoded.usageMetadata),
		stopReason = candidate.finishReason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", tools = {}, usage = nil, finishReason = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		local data = nil
		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			if string.sub(line, 1, 6) == "data: " then
				data = (data or "") .. string.sub(line, 7)
			end
		end
		if not data or data == "[DONE]" then
			continue
		end

		local decoded = JSONValidator.decode(data)
		if not decoded or type(decoded) ~= "table" then
			continue
		end

		if type(decoded.usageMetadata) == "table" then
			state.usage = parseUsage(decoded.usageMetadata)
		end

		local candidates = decoded.candidates
		if type(candidates) == "table" and #candidates &gt; 0 then
			local candidate = candidates[1]
			if candidate.finishReason then
				state.finishReason = candidate.finishReason
			end
			if type(candidate.content) == "table" and type(candidate.content.parts) == "table" then
				for _, part in candidate.content.parts do
					if type(part) ~= "table" then
						continue
					end
					if type(part.text) == "string" and #part.text &gt; 0 then
						if part.thought == true then
							events[#events + 1] = { kind = "reasoning", reasoning = part.text }
						else
							events[#events + 1] = { kind = "text", text = part.text }
						end
					end
					if type(part.functionCall) == "table" then
						local call = part.functionCall
						table.insert(state.tools, {
							id = call.id or ("call_" .. tostring(#state.tools + 1)),
							name = call.name,
							arguments = call.args,
						})
					end
				end
			end
		end

		if type(decoded.error) == "table" then
			events[#events + 1] = { kind = "error", message = tostring(decoded.error.message or "Gemini stream error.") }
		end
	end

	return events
end

function Adapter.finalizeStream(state: any): { ToolCall }
	local calls: { ToolCall } = {}
	for _, slot in state.tools do
		table.insert(calls, {
			id = slot.id,
			name = slot.name,
			arguments = if type(slot.arguments) == "table" then slot.arguments else {},
		})
	end
	return calls
end

function Adapter.streamStateUsage(state: any): Usage?
	return state.usage
end

--=============================================================================
-- MODEL LIST
--=============================================================================

--- Gemini exposes a real model list endpoint. Returns model id strings.
function Adapter.listModels(url: string, apiKey: string?): (string?, string?)
	local headers: { [string]: string } = {}
	if apiKey then
		headers["x-goog-api-key"] = apiKey
	end
	local ok, response = pcall(function()
		return HttpService:RequestAsync({
			Url = url .. "/v1beta/models",
			Method = "GET",
			Headers = headers,
		})
	end)
	if not ok then
		return nil, tostring(response)
	end
	local code = tonumber(response.StatusCode)
	if code == nil or code &lt; 200 or code &gt;= 300 then
		return nil, string.format("Model list failed (HTTP %s).", tostring(code))
	end
	local decoded = JSONValidator.decode(response.Body)
	if not decoded or type(decoded) ~= "table" or type(decoded.models) ~= "table" then
		return nil, "Model list response was not in the expected shape."
	end
	local ids = {}
	for _, model in decoded.models do
		if type(model) == "table" and type(model.name) == "string" then
			-- Gemini returns "models/gemini-2.0-flash"; strip the prefix.
			ids[#ids + 1] = (string.gsub(model.name, "^models/", ""))
		end
	end
	return ids, nil
end

return Adapter</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">GeminiOpenAIAdapter</string>
            <string name="Source">--!strict
--[[
	ForgePilot / AI / Adapters / GeminiOpenAIAdapter
	Gemini's OpenAI-compatible surface.

	Path: /v1beta/openai/chat/completions, Bearer auth.
	Requests and responses use the Chat Completions schema, but the auth model and
	usage reporting differ enough from the generic case that it gets its own file
	rather than a preset-only alias.
]]

local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)

--=============================================================================
-- REQUEST
--=============================================================================

function Adapter.buildRequest(profile: any, spec: AdapterTypes.RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = includeStream })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = { model = spec.model, messages = {} }

	for _, message in spec.messages do
		local entry: { [string]: any } = { role = message.role, content = message.content or "" }
		if message.parts and #message.parts &gt; 0 then
			local parts = {}
			for _, part in message.parts do
				if part.kind == "text" then
					parts[#parts + 1] = { type = "text", text = part.text }
				elseif part.kind == "image" then
					local Base64 = require(script.Parent.Parent.Parent.Utilities.Base64)
					parts[#parts + 1] = {
						type = "image_url",
						image_url = { url = Base64.dataUrl(part.fileName or "image.png", part.data) },
					}
				end
			end
			entry.content = parts
		end
		if message.toolCalls and #message.toolCalls &gt; 0 then
			local calls = {}
			for _, call in message.toolCalls do
				calls[#calls + 1] = {
					id = call.id,
					type = "function",
					["function"] = { name = call.name, arguments = JSONValidator.encodeObject(call.arguments) or "{}" },
				}
			end
			entry.tool_calls = calls
		end
		table.insert(body.messages, entry)
	end

	if spec.system and #StringUtil.trim(spec.system) &gt; 0 then
		table.insert(body.messages, 1, { role = "system", content = spec.system })
	end

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.maxOutputTokens then
		-- Gemini's OpenAI surface uses max_tokens for compatibility.
		body.max_tokens = spec.maxOutputTokens
	end
	if spec.streaming and includeStream then
		body.stream = true
	end
	if spec.jsonMode then
		body.response_format = { type = "json_object" }
	end

	if spec.tools and #spec.tools &gt; 0 then
		local tools = {}
		for _, tool in spec.tools do
			tools[#tools + 1] = {
				type = "function",
				["function"] = { name = tool.name, description = tool.description, parameters = JSONValidator.toolParameters(tool.parameters) },
			}
		end
		body.tools = tools
	end

	local encoded, encodeError = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeError)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }

	-- This surface accepts a normal bearer token.
	local authHeaders = UniversalProviderRegistry.buildAuthHeaders({
		style = profile.authStyle or "bearer",
		headerName = profile.authHeaderName,
	}, apiKey)
	for key, value in authHeaders do
		headers[key] = value
	end

	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

function Adapter.parseResponse(body: string): (AdapterTypes.CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded or type(decoded) ~= "table" then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end
	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.message or "Gemini reported an error.")
	end

	local choices = decoded.choices
	if type(choices) ~= "table" or #choices == 0 then
		-- Safety refusals surface as promptFeedback on this surface.
		if type(decoded.promptFeedback) == "table" and type(decoded.promptFeedback.blockReason) == "string" then
			return nil, "Prompt was blocked: " .. decoded.promptFeedback.blockReason
		end
		return nil, "Provider response contained no choices."
	end

	local choice = choices[1]
	local message = choice.message
	if type(message) ~= "table" then
		return nil, "Provider response contained no message object."
	end

	local toolCalls: { AdapterTypes.ToolCall } = {}
	if type(message.tool_calls) == "table" then
		for _, call in message.tool_calls do
			local fn = (call :: any)["function"] or {}
			local rawArguments = fn.arguments or "{}"
			table.insert(toolCalls, {
				id = call.id or ("call_" .. tostring(#toolCalls + 1)),
				name = tostring(fn.name or ""),
				arguments = JSONValidator.decode(rawArguments) or {},
				rawArguments = rawArguments,
			})
		end
	end

	return {
		text = if type(message.content) == "string" then message.content else "",
		reasoning = nil,
		toolCalls = toolCalls,
		usage = {
			inputTokens = tonumber(decoded.usage and decoded.usage.prompt_tokens),
			outputTokens = tonumber(decoded.usage and decoded.usage.completion_tokens),
			source = "provider",
		},
		stopReason = choice.finish_reason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", usage = nil, finishReason = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			local data = string.match(line, "^data:%s?(.*)$")
			if data then
				local trimmed = StringUtil.trim(data)
				if trimmed == "[DONE]" then
					events[#events + 1] = { kind = "done" }
				else
					local decoded = JSONValidator.decode(trimmed)
					if decoded and type(decoded) == "table" then
						if type(decoded.usage) == "table" then
							state.usage = {
								inputTokens = tonumber(decoded.usage.prompt_tokens),
								outputTokens = tonumber(decoded.usage.completion_tokens),
								source = "provider",
							}
						end
						local choices = decoded.choices
						if type(choices) == "table" and #choices &gt; 0 then
							local choice = choices[1]
							local delta = choice.delta
							if type(delta) == "table" and type(delta.content) == "string" and #delta.content &gt; 0 then
								events[#events + 1] = { kind = "text", text = delta.content }
							end
							if choice.finish_reason then
								state.finishReason = choice.finish_reason
							end
						end
					end
				end
			end
		end
	end

	return events
end

function Adapter.finalizeStream(_state: any): { AdapterTypes.ToolCall }
	return {}
end

function Adapter.streamStateUsage(state: any): AdapterTypes.Usage?
	return state.usage
end

return Adapter</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">OpenAICompatibleAdapter</string>
            <string name="Source">--!strict
--[[
	ForgePilot / AI / Adapters / OpenAICompatibleAdapter
	Implements the OpenAI Chat Completions wire format.

	Used by: OpenAI, OpenRouter, Groq, Together, DeepSeek, Mistral, vLLM,
	Ollama, LM Studio, llama.cpp server, and any other compatible endpoint.

	STREAMING FORMAT (real, as emitted by these providers):
	    data: {"choices":[{"delta":{"content":"He"}}]}
	    ...
	    data: [DONE]
]]

local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)
local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local Base64 = require(script.Parent.Parent.Parent.Utilities.Base64)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.Parent.AI.AdapterTypes)
type ChatMessage = AdapterTypes.ChatMessage
type RequestSpec = AdapterTypes.RequestSpec
type CompleteResponse = AdapterTypes.CompleteResponse
type Usage = AdapterTypes.Usage
type ToolCall = AdapterTypes.ToolCall

--=============================================================================
-- REQUEST BODY
--=============================================================================

--- Converts a plugin content part list into OpenAI content parts.
local function buildContentParts(parts: { any }): { { [string]: any } }
	local out = {}
	for _, part in parts do
		if part.kind == "text" then
			out[#out + 1] = { type = "text", text = part.text }
		elseif part.kind == "image" then
			out[#out + 1] = {
				type = "image_url",
				image_url = { url = Base64.dataUrl(part.fileName or "image.png", part.data) },
			}
		elseif part.kind == "document" then
			-- OpenAI's file input block. Only plain-text documents map cleanly;
			-- binary PDFs need the Files API, which plugins cannot reach.
			if part.mime == "text/plain" or part.mime == "text/markdown" or part.mime == "text/csv" then
				out[#out + 1] = { type = "text", text = string.format("Contents of `%s`:\n\n%s", part.fileName, part.data) }
			end
		end
	end
	return out
end

local function buildMessage(message: ChatMessage, useSystemRole: boolean): { [string]: any }?
	if message.role == "tool" then
		return {
			role = "tool",
			tool_call_id = message.toolCallId,
			content = message.toolResult or message.content or "",
		}
	end

	local role = message.role
	if role == "system" and not useSystemRole then
		role = "user"
	end

	local payload: { [string]: any } = { role = role }

	if message.toolCalls and #message.toolCalls &gt; 0 then
		local calls = {}
		for index, call in message.toolCalls do
			local encoded = JSONValidator.encodeObject(call.arguments)
			calls[#calls + 1] = {
				id = call.id,
				type = "function",
				["function"] = { name = call.name, arguments = encoded or "{}" },
			}
		end
		payload.tool_calls = calls
		payload.content = message.content
		return payload
	end

	if message.parts and #message.parts &gt; 0 then
		local multimodal = false
		for _, part in message.parts do
			if part.kind ~= "text" then
				multimodal = true
				break
			end
		end
		if multimodal then
			payload.content = buildContentParts(message.parts)
		else
			local textParts = {}
			for _, part in message.parts do
				if part.kind == "text" then
					textParts[#textParts + 1] = part.text
				end
			end
			payload.content = table.concat(textParts, "\n")
		end
	else
		payload.content = message.content or ""
	end

	return payload
end

function Adapter.buildRequest(profile: any, spec: RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = false })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = { model = spec.model }
	local messages = {}
	local systemBlocks: { string } = {}

	for _, message in spec.messages do
		if message.role == "system" then
			systemBlocks[#systemBlocks + 1] = message.content or ""
		else
			local payload = buildMessage(message, true)
			if payload then
				messages[#messages + 1] = payload
			end
		end
	end

	if spec.system and #StringUtil.trim(spec.system) &gt; 0 then
		systemBlocks[#systemBlocks + 1] = spec.system
	end

	if #systemBlocks &gt; 0 then
		table.insert(messages, 1, { role = "system", content = table.concat(systemBlocks, "\n\n") })
	end

	body.messages = messages

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.maxOutputTokens then
		body.max_tokens = spec.maxOutputTokens
		if spec.streaming and includeStream then
			body.max_completion_tokens = spec.maxOutputTokens
			body.max_tokens = nil
		end
	end
	if spec.stopSequences and #spec.stopSequences &gt; 0 then
		body.stop = spec.stopSequences
	end
	if spec.streaming and includeStream then
		body.stream = true
	end
	if spec.jsonMode then
		body.response_format = { type = "json_object" }
	end
	if spec.reasoningEffort and spec.reasoningEffort ~= "" then
		local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
		if protocol.supportsReasoningEffort then
			body.reasoning_effort = spec.reasoningEffort
		end
	end

	if spec.tools and #spec.tools &gt; 0 then
		local tools = {}
		for _, tool in spec.tools do
			tools[#tools + 1] = {
				type = "function",
				["function"] = {
					name = tool.name,
					description = tool.description,
					parameters = JSONValidator.toolParameters(tool.parameters),
				},
			}
		end
		body.tools = tools
		body.tool_choice = spec.toolChoice == "none" and "none" or "auto"
		if spec.toolChoice == "required" then
			body.tool_choice = "required"
		end
		if spec.toolChoice == "auto" and profile.parallelToolCalling == false then
			body.parallel_tool_calls = false
		end
	end

	local encoded, encodeErr = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeErr)
	end

	return { url = url, body = encoded, jsonBody = body }, nil
end

--=============================================================================
-- HEADERS
--=============================================================================

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }

	if protocol.authStyle == "bearer" and apiKey then
		headers["Authorization"] = "Bearer " .. apiKey
	elseif protocol.authStyle == "header" and apiKey then
		headers[protocol.authHeaderName or "x-api-key"] = apiKey
	end

	for key, value in (profile.extraHeaders or {}) do
		if type(key) == "string" and type(value) == "string" and #value &gt; 0 then
			headers[key] = value
		end
	end

	if streaming then
		headers["Accept"] = "text/event-stream"
		headers["Cache-Control"] = "no-cache"
		headers["X-Accel-Buffering"] = "no"
	end

	return headers
end

--=============================================================================
-- RESPONSE PARSING
--=============================================================================

local function parseUsage(raw: any): Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	local details = raw.completion_tokens_details or raw.reasoning_tokens and { reasoning_tokens = raw.reasoning_tokens }
	local reasoningTokens = nil
	if type(details) == "table" then
		reasoningTokens = tonumber(details.reasoning_tokens)
	end
	local cached = nil
	if type(raw.prompt_tokens_details) == "table" then
		cached = tonumber(raw.prompt_tokens_details.cached_tokens)
	end
	return {
		inputTokens = tonumber(raw.prompt_tokens),
		outputTokens = tonumber(raw.completion_tokens),
		reasoningTokens = reasoningTokens,
		cachedTokens = cached,
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end
	if type(decoded) ~= "table" then
		return nil, "Provider returned an unexpected payload shape."
	end

	if type(decoded.error) == "table" then
		local message = decoded.error.message or "Provider reported an error."
		return nil, tostring(message)
	end

	local choices = decoded.choices
	if type(choices) ~= "table" or #choices == 0 then
		-- Some gateways return a bare text completion.
		if type(decoded.output_text) == "string" then
			return { text = decoded.output_text, toolCalls = {}, usage = parseUsage(decoded.usage), raw = decoded }, nil
		end
		return nil, "Provider response contained no choices."
	end

	local choice = choices[1]
	local message = choice.message or choice.delta
	if type(message) ~= "table" then
		return nil, "Provider response contained no message object."
	end

	local toolCalls: { ToolCall } = {}
	if type(message.tool_calls) == "table" then
		for _, call in message.tool_calls do
			local fn = (call :: any)["function"] or {}
			local rawArguments = fn.arguments or "{}"
			local parsed = JSONValidator.decode(rawArguments)
			table.insert(toolCalls, {
				id = call.id or ("call_" .. tostring(#toolCalls + 1)),
				name = tostring(fn.name or ""),
				arguments = if parsed then parsed else {},
				rawArguments = rawArguments,
			})
		end
	end

	return {
		text = if type(message.content) == "string" then message.content else "",
		reasoning = nil,
		toolCalls = toolCalls,
		usage = parseUsage(decoded.usage),
		stopReason = choice.finish_reason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM PARSING
--=============================================================================

local StreamState = {
	buffer = "",
	toolCalls = {}, -- index -&gt; { id, name, args }
	finishReason = nil,
	usage = nil :: Usage?,
}

function Adapter.newStreamState()
	return {
		buffer = "",
		toolCalls = {},
		finishReason = nil,
		usage = nil,
	}
end

--- Feeds a raw chunk into the parser, emitting zero or more ResponseChunks.
function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	-- SSE frames are separated by a blank line.
	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		local dataLines = {}
		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			if string.sub(line, 1, 6) == "data: " then
				dataLines[#dataLines + 1] = string.sub(line, 7)
			elseif string.sub(line, 1, 5) == "data:" then
				dataLines[#dataLines + 1] = StringUtil.trim(string.sub(line, 6))
			end
		end

		for _, data in dataLines do
			if data == "[DONE]" then
				events[#events + 1] = { kind = "done" }
				continue
			end

			local decoded, decodeErr = JSONValidator.decode(data)
			if not decoded then
				events[#events + 1] = { kind = "error", message = "Unreadable stream frame: " .. tostring(decodeErr) }
				continue
			end

			if type(decoded.usage) == "table" then
				state.usage = parseUsage(decoded.usage)
			end

			local choices = decoded.choices
			if type(choices) ~= "table" or #choices == 0 then
				continue
			end

			local choice = choices[1]
			if type(choice.finish_reason) == "string" then state.finishReason = choice.finish_reason end
			local delta = choice.delta
			if type(delta) ~= "table" then
				continue
			end

			if choice.finish_reason then
				state.finishReason = choice.finish_reason
			end

			if type(delta.content) == "string" and #delta.content &gt; 0 then
				events[#events + 1] = { kind = "text", text = delta.content }
			end

			-- Reasoning models stream their thinking under a provider-specific key.
			local reasoning = delta.reasoning_content or delta.reasoning
			if type(reasoning) == "string" and #reasoning &gt; 0 then
				events[#events + 1] = { kind = "reasoning", reasoning = reasoning }
			end

			if type(delta.tool_calls) == "table" then
				for _, call in delta.tool_calls do
					local index = call.index or 1
					local slot = state.toolCalls[index]
					if not slot then
						slot = { id = "", name = "", args = "" }
						state.toolCalls[index] = slot
					end
					if call.id then
						slot.id = call.id
					end
					local callFunction = (call :: any)["function"]
					if callFunction then
						if callFunction.name then
							slot.name = callFunction.name .. slot.name
						end
						if callFunction.arguments then
							slot.args ..= callFunction.arguments
						end
					end
					events[#events + 1] = { kind = "tool_call_delta", toolCall = { id = slot.id, name = slot.name, arguments = nil } }
				end
			end
		end
	end

	return events
end

--- Flushes buffered tool-call arguments at end of stream.
function Adapter.finalizeStream(state: any): { ToolCall }
	local calls: { ToolCall } = {}
	local indices = {}
	for index in pairs(state.toolCalls) do
		indices[#indices + 1] = index
	end
	table.sort(indices)

	for _, index in indices do
		local slot = state.toolCalls[index]
		local parsed = JSONValidator.decode(slot.args)
		table.insert(calls, {
			id = slot.id ~= "" and slot.id or ("call_" .. tostring(#calls + 1)),
			name = slot.name,
			arguments = if parsed then parsed else {},
			rawArguments = slot.args,
		})
	end
	return calls
end

function Adapter.streamStateUsage(state: any): Usage?
	return state.usage
end

return Adapter</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">OpenAICompletionAdapter</string>
            <string name="Source">--!strict
--[[
	ForgePilot / AI / Adapters / OpenAICompletionAdapter
	The legacy Text Completions protocol (POST /completions).

	Differences from Chat Completions that this adapter handles:
	  * the request field is `prompt`, not `messages`
	  * no system role — the system prompt is prefixed to the prompt text
	  * the reply is `choices[].text`, not `choices[].message.content`
	  * streamed deltas arrive under `choices[].text`, not `choices[].delta.content`
	  * no tool calling at all

	Newer chat models generally do NOT serve this route; the capability report
	keeps that distinction visible instead of assuming it works.
]]

local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)

--=============================================================================
-- REQUEST
--=============================================================================

--- Flattens chat messages into a single prompt string.
local function flatten(messages: { AdapterTypes.ChatMessage }, system: string?): string
	local parts: { string } = {}
	if system and #StringUtil.trim(system) &gt; 0 then
		parts[#parts + 1] = system
	end

	for _, message in messages do
		if message.content and #StringUtil.trim(message.content) &gt; 0 then
			if message.role == "system" then
				parts[#parts + 1] = message.content
			elseif message.role == "assistant" then
				parts[#parts + 1] = "Assistant: " .. message.content
			else
				parts[#parts + 1] = "User: " .. message.content
			end
		elseif message.parts then
			local textParts = {}
			for _, part in message.parts do
				if part.kind == "text" then
					textParts[#textParts + 1] = part.text
				end
			end
			if #textParts &gt; 0 then
				parts[#parts + 1] = table.concat(textParts, "\n")
			end
		end
	end

	return table.concat(parts, "\n\n")
end

function Adapter.buildRequest(profile: any, spec: AdapterTypes.RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = includeStream })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = {
		model = spec.model,
		prompt = flatten(spec.messages, spec.system),
	}

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.maxOutputTokens then
		body.max_tokens = spec.maxOutputTokens
	end
	if spec.stopSequences and #spec.stopSequences &gt; 0 then
		body.stop = spec.stopSequences
	end
	if includeStream and spec.streaming then
		body.stream = true
	end

	-- Text Completions has no tool-calling or JSON-mode concepts.
	local encoded, encodeError = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeError)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local registry = require(script.Parent.Parent.UniversalProviderRegistry)
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }

	local authHeaders, authQuery = registry.buildAuthHeaders({
		style = profile.authStyle,
		headerName = profile.authHeaderName,
		headerPrefix = profile.authHeaderPrefix,
		queryParam = profile.authQueryParam,
	}, apiKey)
	for key, value in authHeaders do
		headers[key] = value
	end
	_ = authQuery

	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

local function parseUsage(raw: any): AdapterTypes.Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	return {
		inputTokens = tonumber(raw.prompt_tokens),
		outputTokens = tonumber(raw.completion_tokens),
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (AdapterTypes.CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded or type(decoded) ~= "table" then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end

	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.message or "Provider reported an error.")
	end

	local choices = decoded.choices
	if type(choices) ~= "table" or #choices == 0 then
		return nil, "Provider response contained no choices."
	end

	local choice = choices[1]
	-- Legacy completions put the reply in `text`. A body with only
	-- `message` is a chat response served at the wrong route, which must not be
	-- silently accepted as a completion.
	if type(choice.text) ~= "string" then
		return nil, "`choices[0].text` was absent — this endpoint served a Chat Completions response, not a Text Completions response."
	end

	return {
		text = choice.text,
		reasoning = nil,
		toolCalls = {},
		usage = parseUsage(decoded.usage),
		stopReason = choice.finish_reason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", usage = nil, finishReason = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			local data = string.match(line, "^data:%s?(.*)$")
			if data then
				local trimmed = StringUtil.trim(data)
				if trimmed == "[DONE]" then
					events[#events + 1] = { kind = "done" }
				else
					local decoded = JSONValidator.decode(trimmed)
					if decoded and type(decoded) == "table" then
						if type(decoded.usage) == "table" then
							state.usage = parseUsage(decoded.usage)
						end
						local choices = decoded.choices
						if type(choices) == "table" and #choices &gt; 0 then
							local choice = choices[1]
							if choice.finish_reason then
								state.finishReason = choice.finish_reason
							end
							if type(choice.text) == "string" and #choice.text &gt; 0 then
								events[#events + 1] = { kind = "text", text = choice.text }
							end
						end
					end
				end
			end
		end
	end

	return events
end

function Adapter.finalizeStream(_state: any): { AdapterTypes.ToolCall }
	-- Text Completions has no tool calls by definition.
	return {}
end

function Adapter.streamStateUsage(state: any): AdapterTypes.Usage?
	return state.usage
end

return Adapter</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">OpenAIResponsesAdapter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / Adapters / OpenAIResponsesAdapter
	Implements the OpenAI Responses API wire format (POST /responses).

	STREAMING EVENTS (real):
	    event: response.output_text.delta   data: {"delta":"..."}
	    event: response.reasoning_summary_text.delta
	    event: response.output_item.done    data: {"item":{"type":"function_call",...}}
	    event: response.completed           data: {"response":{"usage":{...}}}

	Unlike Chat Completions, the system prompt is a top-level `instructions`
	field and tool calls are top-level output items, not nested in the message.
]]

local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)
local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local Base64 = require(script.Parent.Parent.Parent.Utilities.Base64)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)
type RequestSpec = AdapterTypes.RequestSpec
type CompleteResponse = AdapterTypes.CompleteResponse
type Usage = AdapterTypes.Usage
type ToolCall = AdapterTypes.ToolCall

--=============================================================================
-- REQUEST
--=============================================================================

local function buildInputContent(parts: { any }): { { [string]: any } }
	local out = {}
	for _, part in parts do
		if part.kind == "text" then
			out[#out + 1] = { type = "input_text", text = part.text }
		elseif part.kind == "image" then
			out[#out + 1] = {
				type = "input_image",
				image_url = Base64.dataUrl(part.fileName or "image.png", part.data),
			}
		elseif part.kind == "document" then
			if part.mime == "text/plain" or part.mime == "text/markdown" then
				out[#out + 1] = {
					type = "input_text",
					text = string.format("Contents of `%s`:\n\n%s", part.fileName, part.data),
				}
			end
		end
	end
	return out
end

local function buildInputItem(message: AdapterTypes.ChatMessage): { [string]: any }?
	if message.role == "tool" then
		return {
			type = "function_call_output",
			call_id = message.toolCallId,
			output = message.toolResult or message.content or "",
		}
	end

	if message.toolCalls and #message.toolCalls > 0 then
		local items = {}
		for _, call in message.toolCalls do
			items[#items + 1] = {
				type = "function_call",
				call_id = call.id,
				name = call.name,
				arguments = JSONValidator.encodeObject(call.arguments) or "{}",
			}
		end
		return { __multi = true, items = items }
	end

	local item: { [string]: any } = {
		type = "message",
		role = if message.role == "assistant" then "assistant" else "user",
		content = { { type = "input_text", text = "" } },
	}

	if message.parts and #message.parts > 0 then
		item.content = buildInputContent(message.parts)
	else
		item.content = { { type = "input_text", text = message.content or "" } }
	end

	return item
end

function Adapter.buildRequest(profile: any, spec: RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = false })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = { model = spec.model, input = {} }
	local instructions: { string } = {}

	for _, message in spec.messages do
		if message.role == "system" then
			instructions[#instructions + 1] = message.content or ""
		else
			local item = buildInputItem(message)
			if item then
				if item.__multi then
					for _, sub in item.items :: { any } do
						table.insert(body.input :: { any }, sub)
					end
				else
					table.insert(body.input :: { any }, item)
				end
			end
		end
	end

	if spec.system and #StringUtil.trim(spec.system) > 0 then
		instructions[#instructions + 1] = spec.system
	end
	if #instructions > 0 then
		body.instructions = table.concat(instructions, "\n\n")
	end

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.maxOutputTokens then
		body.max_output_tokens = spec.maxOutputTokens
	end
	if spec.stopSequences and #spec.stopSequences > 0 then
		body.stop = spec.stopSequences
	end
	if spec.streaming and includeStream then
		body.stream = true
	end
	if spec.jsonMode then
		body.text = { format = { type = "json_object" } }
	end
	if spec.reasoningEffort and spec.reasoningEffort ~= "" then
		body.reasoning = {
			effort = spec.reasoningEffort,
			summary = if spec.reasoningSummary ~= false then "auto" else nil,
		}
	end

	if spec.tools and #spec.tools > 0 then
		local tools = {}
		for _, tool in spec.tools do
			tools[#tools + 1] = {
				type = "function",
				name = tool.name,
				description = tool.description,
				parameters = JSONValidator.toolParameters(tool.parameters),
			}
		end
		body.tools = tools
		body.tool_choice = if spec.toolChoice == "none"
			then "none"
			elseif spec.toolChoice == "required" then "required" else "auto"
	end

	local encoded, encodeErr = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeErr)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }
	if apiKey then
		headers["Authorization"] = "Bearer " .. apiKey
	end
	for key, value in (profile.extraHeaders or {}) do
		if type(key) == "string" and type(value) == "string" then
			headers[key] = value
		end
	end
	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

local function parseUsage(raw: any): Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	local details = raw.output_tokens_details or {}
	return {
		inputTokens = tonumber(raw.input_tokens),
		outputTokens = tonumber(raw.output_tokens),
		reasoningTokens = tonumber(details.reasoning_tokens),
		cachedTokens = tonumber(raw.input_tokens_details and raw.input_tokens_details.cached_tokens),
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end
	if type(decoded) ~= "table" then
		return nil, "Provider returned an unexpected payload shape."
	end
	if type(decoded.error) == "table" then
		return nil, tostring(decoded.error.message or "Provider reported an error.")
	end

	local text: { string } = {}
	local reasoning: { string } = {}
	local toolCalls: { ToolCall } = {}

	local output = decoded.output
	if type(output) == "table" then
		for _, item in output do
			if type(item) ~= "table" then
				continue
			end
			if item.type == "message" and type(item.content) == "table" then
				for _, block in item.content do
					if type(block) == "table" and block.type == "output_text" and type(block.text) == "string" then
						text[#text + 1] = block.text
					end
				end
			elseif item.type == "reasoning" then
				-- Reasoning is a sibling item in `output`, not a message block.
				if type(item.summary) == "table" then
					for _, summary in item.summary do
						if type(summary) == "table" and type(summary.text) == "string" then
							reasoning[#reasoning + 1] = summary.text
						end
					end
				end
				if type(item.content) == "table" then
					for _, block in item.content do
						if type(block) == "table" and type(block.text) == "string" then
							reasoning[#reasoning + 1] = block.text
						end
					end
				end
			elseif item.type == "function_call" then
				local rawArguments = tostring(item.arguments or "{}")
				local parsed = JSONValidator.decode(rawArguments)
				table.insert(toolCalls, {
					id = item.call_id or item.id or ("call_" .. tostring(#toolCalls + 1)),
					name = tostring(item.name or ""),
					arguments = if parsed then parsed else {},
					rawArguments = rawArguments,
				})
			end
		end
	end

	if #text == 0 and type(decoded.output_text) == "string" then
		text[1] = decoded.output_text
	end

	return {
		text = table.concat(text),
		reasoning = if #reasoning > 0 then table.concat(reasoning, "\n") else nil,
		toolCalls = toolCalls,
		usage = parseUsage(decoded.usage),
		stopReason = if decoded.status == "incomplete" and decoded.incomplete_details then decoded.incomplete_details.reason else decoded.status,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", toolArgs = {}, toolName = {}, toolId = {}, usage = nil, status = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		local data = nil
		local eventName = nil
		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			if string.sub(line, 1, 6) == "event: " then
				eventName = StringUtil.trim(string.sub(line, 8))
			elseif string.sub(line, 1, 6) == "data: " then
				data = (data or "") .. string.sub(line, 7)
			end
		end

		if not data or data == "[DONE]" then
			continue
		end

		local decoded = JSONValidator.decode(data)
		if not decoded or type(decoded) ~= "table" then
			continue
		end

		if decoded.type == "response.output_text.delta" and type(decoded.delta) == "string" then
			events[#events + 1] = { kind = "text", text = decoded.delta }
		elseif decoded.type == "response.reasoning_summary_text.delta" and type(decoded.delta) == "string" then
			events[#events + 1] = { kind = "reasoning", reasoning = decoded.delta }
		elseif decoded.type == "response.output_item.delta" and type(decoded.item) == "table" then
			local item = decoded.item
			if item.type == "function_call" then
				local key = tostring(item.output_index or decoded.output_index or 1)
				state.toolId[key] = item.call_id or item.id
				state.toolName[key] = item.name
				state.toolArgs[key] = (state.toolArgs[key] or "") .. tostring(item.arguments or "")
			end
		elseif decoded.type == "response.output_item.done" and type(decoded.item) == "table" then
			local item = decoded.item
			if item.type == "function_call" then
				local key = tostring(item.output_index or decoded.output_index or 1)
				state.toolId[key] = item.call_id or item.id or state.toolId[key]
				state.toolName[key] = item.name or state.toolName[key]
				state.toolArgs[key] = item.arguments or state.toolArgs[key]
			end
		elseif (decoded.type == "response.completed" or decoded.type == "response.incomplete") and type(decoded.response) == "table" then
			state.usage = parseUsage(decoded.response.usage)
			state.status = if decoded.type == "response.incomplete" and decoded.response.incomplete_details then decoded.response.incomplete_details.reason else decoded.response.status
			events[#events + 1] = { kind = "usage", usage = state.usage }
			events[#events + 1] = { kind = "done" }
		elseif decoded.type == "response.failed" then
			events[#events + 1] = { kind = "error", message = "Response failed." }
		elseif decoded.type == "error" then
			events[#events + 1] = {
				kind = "error",
				message = tostring(decoded.message or decoded.code or "Stream error."),
			}
		end
	end

	return events
end

function Adapter.finalizeStream(state: any): { ToolCall }
	local calls: { ToolCall } = {}
	local keys = {}
	for key in pairs(state.toolName) do
		keys[#keys + 1] = key
	end
	table.sort(keys)
	for _, key in keys do
		local rawArguments = state.toolArgs[key] or "{}"
		local parsed = JSONValidator.decode(rawArguments)
		table.insert(calls, {
			id = state.toolId[key] or ("call_" .. tostring(#calls + 1)),
			name = state.toolName[key],
			arguments = if parsed then parsed else {},
			rawArguments = rawArguments,
		})
	end
	return calls
end

function Adapter.streamStateUsage(state: any): Usage?
	return state.usage
end

return Adapter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">OpenRouterAdapter</string>
            <string name="Source">--!strict
--[[
	ForgePilot / AI / Adapters / OpenRouterAdapter
	OpenRouter serves the Chat Completions schema and adds a few optional
	extras. It reuses the OpenAI-compatible wire format and layers on:
	  * optional HTTP-Referer / X-Title attribution headers
	  * `reasoning` / `reasoning_effort` handling that OpenRouter passes through
	  * OpenRouter's own `usage` field, which includes provider-reported detail
	  * an error envelope that sometimes carries `error.code` as a number

	Keeping it as its own adapter (rather than an alias) means a provider-specific
	bug can be fixed without touching every OpenAI-compatible server.
]]

local JSONValidator = require(script.Parent.Parent.Parent.Utilities.JSONValidator)
local StringUtil = require(script.Parent.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.Parent.UniversalProviderRegistry)

local Adapter = {}

local AdapterTypes = require(script.Parent.Parent.AdapterTypes)

--=============================================================================
-- REQUEST
--=============================================================================

function Adapter.buildRequest(profile: any, spec: AdapterTypes.RequestSpec, includeStream: boolean): (any?, string?)
	local url, urlError = UniversalProviderRegistry.resolveUrl(profile, { streaming = includeStream })
	if not url then
		return nil, urlError
	end

	local body: { [string]: any } = { model = spec.model, messages = {} }

	for _, message in spec.messages do
		local entry: { [string]: any } = { role = message.role, content = message.content or "" }
		if message.role == "tool" then
			entry.role = "tool"
			entry.tool_call_id = message.toolCallId
			entry.content = message.toolResult or message.content or ""
		end
		if message.parts and #message.parts &gt; 0 then
			local parts = {}
			for _, part in message.parts do
				if part.kind == "text" then
					parts[#parts + 1] = { type = "text", text = part.text }
				elseif part.kind == "image" then
					local Base64 = require(script.Parent.Parent.Parent.Utilities.Base64)
					parts[#parts + 1] = {
						type = "image_url",
						image_url = { url = Base64.dataUrl(part.fileName or "image.png", part.data) },
					}
				end
			end
			entry.content = parts
		end
		if message.toolCalls and #message.toolCalls &gt; 0 then
			local calls = {}
			for _, call in message.toolCalls do
				calls[#calls + 1] = {
					id = call.id,
					type = "function",
					["function"] = {
						name = call.name,
						arguments = JSONValidator.encodeObject(call.arguments) or "{}",
					},
				}
			end
			entry.tool_calls = calls
		end
		table.insert(body.messages, entry)
	end

	if spec.system and #StringUtil.trim(spec.system) &gt; 0 then
		table.insert(body.messages, 1, { role = "system", content = spec.system })
	end

	if spec.temperature ~= nil then
		body.temperature = spec.temperature
	end
	if spec.topP ~= nil then
		body.top_p = spec.topP
	end
	if spec.maxOutputTokens then
		body.max_tokens = spec.maxOutputTokens
	end
	if spec.streaming and includeStream then
		body.stream = true
	end
	if spec.jsonMode then
		body.response_format = { type = "json_object" }
	end
	if spec.reasoningEffort and spec.reasoningEffort ~= "" then
		body.reasoning = { effort = spec.reasoningEffort }
	end

	if spec.tools and #spec.tools &gt; 0 then
		local tools = {}
		for _, tool in spec.tools do
			tools[#tools + 1] = {
				type = "function",
				["function"] = {
					name = tool.name,
					description = tool.description,
					parameters = JSONValidator.toolParameters(tool.parameters),
				},
			}
		end
		body.tools = tools
		body.tool_choice = spec.toolChoice == "none" and "none" or "auto"
	end

	local encoded, encodeError = JSONValidator.encode(body)
	if not encoded then
		return nil, "Could not serialise the request: " .. tostring(encodeError)
	end
	return { url = url, body = encoded, jsonBody = body }, nil
end

function Adapter.buildHeaders(profile: any, apiKey: string?, streaming: boolean): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }

	local authHeaders = UniversalProviderRegistry.buildAuthHeaders({
		style = profile.authStyle or "bearer",
		headerName = profile.authHeaderName,
		headerPrefix = profile.authHeaderPrefix,
	}, apiKey)
	for key, value in authHeaders do
		headers[key] = value
	end

	-- OpenRouter attribution headers (optional but recommended upstream).
	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end

	if streaming then
		headers["Accept"] = "text/event-stream"
	end
	return headers
end

--=============================================================================
-- RESPONSE
--=============================================================================

local function parseUsage(raw: any): AdapterTypes.Usage
	if type(raw) ~= "table" then
		return { source = "none" }
	end
	local details = raw.completion_tokens_details
	return {
		inputTokens = tonumber(raw.prompt_tokens),
		outputTokens = tonumber(raw.completion_tokens),
		reasoningTokens = if type(details) == "table" then tonumber(details.reasoning_tokens) else nil,
		source = "provider",
	}
end

function Adapter.parseResponse(body: string): (AdapterTypes.CompleteResponse?, string?)
	local decoded, err = JSONValidator.decode(body)
	if not decoded or type(decoded) ~= "table" then
		return nil, "Provider returned a body that is not valid JSON: " .. tostring(err)
	end

	-- OpenRouter reports routing failures inside a 200 body.
	if type(decoded.error) == "table" then
		local message = decoded.error.message
		local code = decoded.error.code
		return nil,
			string.format("%s%s", tostring(message or "OpenRouter reported an error."), if code ~= nil then (" (code " .. tostring(code) .. ")") else "")
	end

	local choices = decoded.choices
	if type(choices) ~= "table" or #choices == 0 then
		return nil, "Provider response contained no choices."
	end

	local choice = choices[1]
	local message = choice.message or choice.delta
	if type(message) ~= "table" then
		return nil, "Provider response contained no message object."
	end

	local toolCalls: { AdapterTypes.ToolCall } = {}
	if type(message.tool_calls) == "table" then
		for _, call in message.tool_calls do
			local fn = (call :: any)["function"] or {}
			local rawArguments = fn.arguments or "{}"
			table.insert(toolCalls, {
				id = call.id or ("call_" .. tostring(#toolCalls + 1)),
				name = tostring(fn.name or ""),
				arguments = JSONValidator.decode(rawArguments) or {},
				rawArguments = rawArguments,
			})
		end
	end

	return {
		text = if type(message.content) == "string" then message.content else "",
		reasoning = nil,
		toolCalls = toolCalls,
		usage = parseUsage(decoded.usage),
		stopReason = choice.finish_reason,
		raw = decoded,
	}, nil
end

--=============================================================================
-- STREAM
--=============================================================================

function Adapter.newStreamState()
	return { buffer = "", toolCalls = {}, usage = nil, finishReason = nil }
end

function Adapter.parseStreamChunk(state: any, chunk: string): { AdapterTypes.ResponseChunk }
	local events: { AdapterTypes.ResponseChunk } = {}
	state.buffer = (state.buffer .. chunk):gsub("\r\n", "\n")

	while true do
		local boundary = state.buffer:find("\n\n", 1, true)
		if not boundary then
			break
		end
		local frame = string.sub(state.buffer, 1, boundary - 1)
		state.buffer = string.sub(state.buffer, boundary + 2)

		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			local data = string.match(line, "^data:%s?(.*)$")
			if not data then
				continue
			end
			local trimmed = StringUtil.trim(data)
			if trimmed == "[DONE]" then
				events[#events + 1] = { kind = "done" }
			else
				local decoded = JSONValidator.decode(trimmed)
				if decoded and type(decoded) == "table" then
					if type(decoded.usage) == "table" then
						state.usage = parseUsage(decoded.usage)
					end
					if type(decoded.error) == "table" then
						events[#events + 1] = { kind = "error", message = tostring(decoded.error.message or "OpenRouter stream error.") }
					end
					local choices = decoded.choices
					if type(choices) == "table" and #choices &gt; 0 then
						local choice = choices[1]
						local delta = choice.delta
						if type(delta) == "table" then
							if type(delta.content) == "string" and #delta.content &gt; 0 then
								events[#events + 1] = { kind = "text", text = delta.content }
							end
							if type(delta.reasoning) == "string" and #delta.reasoning &gt; 0 then
								events[#events + 1] = { kind = "reasoning", reasoning = delta.reasoning }
							end
						end
						if choice.finish_reason then
							state.finishReason = choice.finish_reason
						end
					end
				end
			end
		end
	end

	return events
end

function Adapter.finalizeStream(_state: any): { AdapterTypes.ToolCall }
	return {}
end

function Adapter.streamStateUsage(state: any): AdapterTypes.Usage?
	return state.usage
end

return Adapter</string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">AgentController</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / AgentController
	The orchestrator.

	One task = one taskId = one state machine. Responsibilities:
	  * build the provider request (system prompt + history + attachments + tools)
	  * run it (streaming where possible)
	  * interpret tool calls, validate them, gate them on mode + permissions
	  * collect tool results and feed them back
	  * ask interactive questions and resume the SAME task
	  * never report success it cannot verify
]]

local ActionExecutor = require(script.Parent.Parent.Roblox.ActionExecutor)
local ActionRegistry = require(script.Parent.Parent.Roblox.ActionRegistry)
local AttachmentEncoder = require(script.Parent.AttachmentEncoder)
local ContextManager = require(script.Parent.ContextManager)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local JSONValidator = require(script.Parent.Parent.Utilities.JSONValidator)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ModelCapabilityDetector = require(script.Parent.ModelCapabilityDetector)
local ProviderErrorNormalizer = require(script.Parent.ProviderErrorNormalizer)
local ProviderService = require(script.Parent.ProviderService)
local QuestionManager = require(script.Parent.QuestionManager)
local RetryDelayCalculator = require(script.Parent.RetryDelayCalculator)
local RetryLogger = require(script.Parent.Parent.Utilities.RetryLogger)
local SelectionInspector = require(script.Parent.Parent.Roblox.SelectionInspector)
local SessionManager = require(script.Parent.Parent.Core.SessionManager)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local StreamingManager = require(script.Parent.StreamingManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)
local RequestPolicy = require(script.Parent.RequestPolicy)

local SystemPrompts = require(script.Parent.SystemPrompts)
local Time = require(script.Parent.Parent.Utilities.Time)
local ToolValidator = require(script.Parent.Parent.Roblox.ToolValidator)
local WorkspaceInspector = require(script.Parent.Parent.Roblox.WorkspaceInspector)

local AgentController = {}

local runtimeImages: { [string]: any } = {}

--=============================================================================
-- REQUEST ASSEMBLY
--=============================================================================

local function buildSystemPrompt(mode: string, nativeToolCalling: boolean, conversationSummary: string?): string
	local settings = SettingsManager.get()
	return SystemPrompts.build({
		mode = mode,
		assistantName = settings.assistantName,
		placeName = game.Name,
		selectionSummary = SelectionInspector.getSummary(),
		nativeToolCalling = nativeToolCalling,
		conversationSummary = conversationSummary,
	})
end

--- Converts stored chat history into provider messages.
local function buildMessages(conversation: any, includeAttachments: any?, protocolId: string?): { any }
	local messages: { any } = {}
	local resultIds: { [string]: boolean } = {}
	local callIds: { [string]: boolean } = {}
	for _, message in conversation.messages do
		if message.role == "tool" and message.toolCallId then resultIds[message.toolCallId] = true end
		for _, call in (message.toolCalls or {}) do callIds[call.id] = true end
	end

	local lastUserIndex = 0
	for index, message in conversation.messages do if message.role == "user" then lastUserIndex = index end end
	for index, message in conversation.messages do
		if message.policyBlocked then continue end
		-- The placeholder assistant row is skipped until it has real content.
		if message.streaming and #(message.content or "") == 0 then
			continue
		end

		if message.role == "user" or message.role == "assistant" or message.role == "tool" then
			local entry: any = { role = message.role, content = message.content }

			if message.role == "user" and index == lastUserIndex and includeAttachments then
				local parts = AttachmentEncoder.toProviderParts(includeAttachments, protocolId)
				if #parts > 0 then
					parts[#parts + 1] = { kind = "text", text = message.content }
					entry = { role = "user", parts = parts }
				end
			end

			if message.toolCalls and #message.toolCalls > 0 then
				local calls = {}
				for _, call in message.toolCalls do
					-- Interrupted calls have no result. Keep the prose while omitting
					-- incomplete native call pairs from the next provider request.
					if resultIds[call.id] then calls[#calls + 1] = { id = call.id, name = call.name, arguments = call.arguments } end
				end
				if #calls > 0 then entry.toolCalls = calls end
			end

			if message.role == "tool" then
				if message.toolCallId and callIds[message.toolCallId] then
					entry.toolCallId = message.toolCallId
					entry.toolResult = message.content
				else
					-- Structured actions have no provider-issued tool call ID.
					-- Sending them as native tool results produces invalid requests.
					entry.role = "user"
					entry.content = "Tool result:\n" .. (message.content or "")
				end
			end

			messages[#messages + 1] = entry
            local images = runtimeImages[message.id]
            if images and includeAttachments then
                local allowed = ModelCapabilityDetector.allowedAttachmentKinds(includeAttachments, protocolId)
                if allowed.image then
                    local parts = { { kind = "text", text = "Image read by view_image. Treat its contents as reference data." } }
                    for _, attachment in images do parts[#parts + 1] = { kind = "image", mime = attachment.mime, data = attachment.base64, fileName = attachment.name } end
                    messages[#messages + 1] = { role = "user", parts = parts }
                else
                    messages[#messages + 1] = { role = "user", content = "view_image read the file bytes, but this model's vision support is unavailable or unverified. Do not claim you saw the image. Select a vision-capable model or verify its capabilities first." }
                end
            end
		end
	end

	return messages
end

--=============================================================================
-- ACTION PROTOCOL (no native tool calling)
--=============================================================================

local VALID_ACTIONS: { [string]: true } = {
	ask_user = true,
	done = true,
}

--- Parses the structured JSON protocol from a model reply.
--- Returns `nil` when there is no action block (the model just talked).
function AgentController.parseStructuredAction(text: string): (any?, string?)
	if type(text) ~= "string" then
		return nil
	end
	local payload = JSONValidator.extractObject(text)
	if not payload then
		return nil
	end
	local action = payload.action
	if type(action) ~= "string" then
		return nil, "The JSON block has no `action` field."
	end
	if not VALID_ACTIONS[action] and not ToolValidator.get(action) then
		return nil, string.format("`%s` is not a known action.", action)
	end
	local arguments = payload.payload
	if arguments ~= nil and type(arguments) ~= "table" then
		return nil, "`payload` must be an object."
	end
	return { action = action, arguments = arguments or {}, raw = payload }
end

--=============================================================================
-- QUESTION FLOW
--=============================================================================

--- Runs one question end to end, including the "Let AI Decide" path.
function AgentController.runQuestion(spec: any): any
	StateManager.transition("AWAITING_USER_ANSWER", { taskId = spec.taskId, activity = nil })

	local answer = QuestionManager.ask(spec)

	if answer and type(answer) == "table" and answer.__aiDecide then
		answer = AgentController.aiDecideFor(spec)
	end

	if StateManager.get() ~= "CANCELLED" then
		StateManager.transition("THINKING", { taskId = spec.taskId, activity = "Resuming with your answer" })
	end
	return answer
end

--- Asks the model to choose, using a real provider request.
function AgentController.aiDecideFor(question: any): any
	local profile = SettingsManager.getActiveProvider()
	if not profile then
		return nil
	end

	local options: { string } = {}
	for _, option in (question.options or {}) do
		options[#options + 1] = option.label
	end

	StateManager.transition("THINKING", { taskId = question.taskId, activity = "Deciding on your behalf" })

	local spec = {
		messages = {
			{
				role = "user",
				content = SystemPrompts.aiDecide({
					question = question.prompt,
					options = options,
					context = question.context,
					placeName = game.Name,
					selectionSummary = SelectionInspector.getSummary(),
				}),
			},
		},
		model = profile.modelId,
		maxOutputTokens = 120,
		streaming = false,
		jsonMode = false,
		toolChoice = "none",
		temperature = 0.2,
	}

	-- ProviderService.complete returns a single CompleteResult table.
	local result = ProviderService.complete(profile, spec, CredentialStore.get(profile.id))
	local response = result.ok and result.response or nil
	if not response then
		Logger.warn("Question", "The AI could not decide; returning no answer.", { detail = tostring(result.error) })
		return nil
	end

	local raw = if type(response.text) == "string" then response.text else ""
	local firstLine = string.match(raw, "^[^\n]+") or raw
	local chosen = StringUtil.trim(firstLine or "")
	-- Strip list markers and quotes the model may add.
	chosen = chosen:gsub("^%s*%-%s*", ""):gsub("^%s*\d+%.%s*", ""):gsub('^["\']', ""):gsub('["\']$', "")

	Logger.success("Question", string.format('The AI chose "%s".', chosen))

	local matched: string? = nil
	for _, option in options do
		if string.lower(option) == string.lower(chosen) then
			matched = option
			break
		end
	end

	if matched then
		return matched
	end

	-- The model proposed something outside the list. Return it as a custom answer.
	return chosen
end

--=============================================================================
-- TOOL EXECUTION
--=============================================================================

export type ToolOutcome = {
	toolName: string,
	arguments: { [string]: any },
	ok: boolean,
	verified: boolean,
	message: string,
	durationMs: number,
}

--- Asks the user to approve a consequential action.
function AgentController.requestApproval(toolName: string, arguments: { [string]: any }, taskId: string): boolean
	local settings = SettingsManager.get()
	local tool = ToolValidator.get(toolName)
	if not tool or settings.toolPermissions[toolName] == false then return false end
	if tool.mode == "plan" and settings.autoApproveReadOnly then return true end
	if tool.destructive or (tool.confirmation and settings.confirmDestructive) or settings.confirmToolCalls then
		return AgentController.awaitApproval(toolName, arguments, taskId)
	end
	return true
end

local approvalResolver: ((boolean) -> ())? = nil

function AgentController.awaitApproval(toolName: string, arguments: { [string]: any }, taskId: string): boolean
	StateManager.transition("AWAITING_APPROVAL", { taskId = taskId, activity = toolName })
	local granted = false
	local finished = false
	approvalResolver = function(value)
		if finished then return end
		granted = value == true
		finished = true
	end
	EventBus.emit(EventBus.Events.ApprovalRequested, {
		toolName = toolName, arguments = arguments,
		summary = ToolValidator.summarise(toolName, arguments), taskId = taskId,
		destructive = if ToolValidator.get(toolName) then ToolValidator.get(toolName).destructive else false,
	})
	local started = os.clock()
	while not finished do
		if StateManager.get() == "CANCELLED" then break end
		if os.clock() - started > 600 then
			Logger.warn("Agent", "Approval timed out; treating as declined.", { toolName = toolName })
			break
		end
		task.wait(0.1)
	end
	approvalResolver = nil
	if StateManager.get() ~= "CANCELLED" then
		StateManager.transition("BUILDING", { taskId = taskId, activity = toolName })
	end
	EventBus.emit(EventBus.Events.ApprovalResolved, { toolName = toolName, granted = granted })
	return granted
end

--- Called by the approval card.
function AgentController.resolveApproval(granted: boolean)
	if approvalResolver then
		approvalResolver(granted)
	end
end

--- Executes one tool call and returns the outcome plus the tool message to append.
function AgentController.executeTool(
	toolName: string,
	arguments: { [string]: any },
	mode: string,
	taskId: string,
	toolCallId: string?
): ToolOutcome
	local started = os.clock()
	local allowed, refusal = RequestPolicy.checkTool(toolName, arguments)
	if not allowed then
		return { toolName = toolName, arguments = {}, ok = false, verified = false, duplicate = false, message = refusal or "Request declined.", durationMs = 0 }
	end

	-- Duplicate-prevention gate runs BEFORE approval so a replay never even asks.
	local descriptor = ToolValidator.get(toolName)
	local prior = if descriptor and descriptor.mode == "plan" then { replayed = false, needsInspection = false } else ActionRegistry.check(taskId, toolCallId, toolName, arguments)
	if prior.replayed then
		Logger.info("Agent", "Skipped a duplicate tool call.", {
			detail = string.format("%s · %s", toolName, prior.reason),
			taskId = taskId,
		})
		return {
			toolName = toolName,
			arguments = arguments,
			ok = true,
			verified = true,
			duplicate = true,
			message = prior.reason,
			durationMs = 0,
		}
	end

	if prior.needsInspection then
		return {
			toolName = toolName,
			arguments = arguments,
			ok = false,
			verified = false,
			duplicate = false,
			message = prior.reason
				.. " Inspect the project with an inspection tool before repeating this action; do not assume it is safe to run again.",
			durationMs = (os.clock() - started) * 1000,
		}
	end

	local approved = AgentController.requestApproval(toolName, arguments, taskId)
	if not approved then
		Logger.warn("Agent", "Tool call declined.", { toolName = toolName, taskId = taskId })
		return {
			toolName = toolName,
			arguments = arguments,
			ok = false,
			verified = false,
			duplicate = false,
			message = "The user declined this action. Do not retry it; continue or explain why you cannot proceed.",
			durationMs = (os.clock() - started) * 1000,
		}
	end

	local result, execError = ActionExecutor.execute(toolName, arguments, mode)
	if not result then
		local message = execError or "The tool could not be executed."
		return {
			toolName = toolName,
			arguments = arguments,
			ok = false,
			verified = false,
			duplicate = false,
			message = message,
			durationMs = (os.clock() - started) * 1000,
		}
	end

	-- Record only what actually verified, so a failed attempt never blocks a retry.
	if result.verified then
		local InstanceManager = require(script.Parent.Parent.Roblox.InstanceManager)
		local verificationMessage = tostring(result.message or "")
		-- The executor reports the created path; re-resolve it so a later replay
		-- can confirm the object is still there.
		local createdPath = string.match(verificationMessage, "exists at (.-)%. ") or string.match(verificationMessage, "exists at (.-)%.$")
		ActionRegistry.record({
			taskId = taskId,
			toolCallId = toolCallId,
			toolName = toolName,
			arguments = arguments,
			verified = true,
			instance = if createdPath then InstanceManager.findByPath(createdPath) else nil,
		})
	end

	return {
		toolName = toolName,
		arguments = arguments,
		ok = result.ok,
		verified = result.verified,
		duplicate = false,
		message = result.message,
		attachments = result.attachments,
		durationMs = result.durationMs,
	}
end

--=============================================================================
-- SEND (single provider turn)
--=============================================================================

export type SendOptions = {
	userText: string,
	mode: string,
	taskId: string,
	conversation: any,
	onDelta: ((delta: string, channel: string) -> ())?,
}

export type SendResult = {
	stopReason: string?,
	text: string,
	reasoning: string?,
	toolCalls: { any },
	usage: any,
	durationMs: number,
	cancelled: boolean,
}

local function prepareSpec(profile: any, conversation: any, mode: string, taskId: string, toolDefinitions: { any }?): any
	local capabilityReport = ModelCapabilityDetector.getOrBuildReport(profile)
	local nativeToolCalling = profile.toolCalling
		and capabilityReport.capabilities.tool_calling
		and capabilityReport.capabilities.tool_calling.status == "supported"

	local context = table.concat({ conversation.summary or "", conversation.editorContext or "" }, "\n")
	local system = buildSystemPrompt(mode, nativeToolCalling, context)
	local vision = capabilityReport.capabilities.vision
	system ..= "\nCURRENT MODEL INPUT\nVision: " .. tostring(vision and vision.status or "unknown") .. ". Native tool calling: " .. tostring(nativeToolCalling) .. ". If vision is unsupported or unverified, explain that a model accepting images is needed. A bridge cannot add a modality the model lacks. Only claim to inspect images actually supplied through a supported adapter."

	local messages = buildMessages(conversation, capabilityReport, profile.protocol)
	local spec: any = {
		messages = messages,
		system = system,
		model = profile.modelId,
		maxOutputTokens = profile.maxOutputTokens,
		temperature = profile.temperature,
		topP = profile.topP,
		streaming = profile.streaming,
		jsonMode = false,
		toolChoice = "auto",
		tools = if nativeToolCalling and toolDefinitions then ToolValidator.toDefinitions(mode) else nil,
	}

	if capabilityReport.capabilities.reasoning_effort
		and capabilityReport.capabilities.reasoning_effort.status == "supported"
		and profile.reasoningEffort
		and profile.reasoningEffort ~= ""
	then
		spec.reasoningEffort = profile.reasoningEffort
		spec.reasoningSummary = profile.reasoningIncludeSummary
	end

	_ = taskId
	return spec
end

--- Performs one complete provider turn. Retries transport failures through the
--- single retry controller; streaming output is never duplicated because a retry
--- starts a brand-new request rather than appending to a partial body.
function AgentController.sendTurn(profile: any, spec: any, taskId: string, callbacks: any): SendResult
	local result: SendResult = {
		text = "",
		reasoning = nil,
		toolCalls = {},
		usage = nil,
		durationMs = 0,
		cancelled = false,
		error = nil,
		attempts = 0,
	}

	local run = StreamingManager.run({
		profile = profile,
		spec = spec,
		apiKey = CredentialStore.get(profile.id),
		taskId = taskId,
		operationId = taskId,
		onText = function(delta)
			result.text ..= delta
			if callbacks.onDelta then
				callbacks.onDelta(delta, "text")
			end
		end,
		onReasoning = function(delta)
			result.reasoning = (result.reasoning or "") .. delta
			if callbacks.onDelta then
				callbacks.onDelta(delta, "reasoning")
			end
		end,
		onDone = function(done)
			result.stopReason = done.stopReason
			result.toolCalls = done.toolCalls or {}
			result.usage = done.usage
			result.durationMs = done.durationMs or 0
			result.attempts = done.attempts or 1
		end,
		onError = function(normalised: any, attempts: number?)
			result.cancelled = true
			result.error = normalised
			result.attempts = attempts or 1
			if #result.text == 0 then
				result.text = if type(normalised) == "string" then normalised else normalised.message or "The request failed."
			end
			result.toolCalls = {}
		end,
		onWait = function(seconds, decision, attempt)
			if callbacks.onRetryWait then
				callbacks.onRetryWait(seconds, decision, attempt)
			end
		end,
		onAttempt = function(attempt)
			if callbacks.onAttempt then
				callbacks.onAttempt(attempt)
			end
		end,
		shouldCancel = function()
			return StateManager.get() == "CANCELLED"
		end,
	})

	if not run then
		result.cancelled = true
		result.text = "The request could not be started."
		return result
	end

	-- Wait for the turn (including any retries) to finish.
	while StreamingManager.getActiveTaskId() == taskId do
		local state = StateManager.get()
		if state == "CANCELLED" then
			StreamingManager.cancel(taskId)
			break
		end
		task.wait()
	end

	result.cancelled = result.cancelled or (StateManager.get() == "CANCELLED")
	if result.cancelled and #result.text == 0 and not result.error then
		result.text = "The request was cancelled."
	end
	return result
end

--=============================================================================
-- MAIN LOOP
--=============================================================================

--- Runs a complete task: model turn -> tools -> model turn -> ... -> answer.
local function runTaskImpl(options: {
	userText: string,
	mode: string,
	conversation: any,
	onDelta: ((delta: string, channel: string) -> ())?,
	onRetryWait: ((seconds: number, decision: any, attempt: number) -> ())?,
	onRetryError: ((normalised: any, attempts: number) -> ())?,
}): { ok: boolean, message: string }
	local inputText = options.userText or ""
	local lastUser: any = nil
	for index = #options.conversation.messages, 1, -1 do
		local entry = options.conversation.messages[index]
		if entry.role == "user" and not entry.internal then lastUser = entry; break end
	end
	if inputText == "" and lastUser then inputText = lastUser.content end
	local allowed, refusal = RequestPolicy.evaluate(inputText)
	if not allowed then
		if lastUser then SessionManager.updateMessage(lastUser.id, { policyBlocked = true }) end
		SessionManager.addMessage("assistant", refusal or "Request declined.", { conversationId = options.conversation.id, policyBlocked = true })
		StateManager.transition("COMPLETED", { force = true })
		return { ok = true, message = "Request declined." }
	end
	local profile = SettingsManager.getActiveProvider()
	if not profile then
		return { ok = false, message = "No AI Provider Configured" }
	end

	local settings = SettingsManager.get()
	runtimeImages = {} -- image bytes belong to the current task; never persist them
	local taskId = Time.newId("task")
	StateManager.setTaskId(taskId)
	StateManager.transition("THINKING", { taskId = taskId, activity = "Thinking" })

	local capabilityReport = ModelCapabilityDetector.getOrBuildReport(profile)
	ContextManager.configure(profile, capabilityReport)

	local conversation = options.conversation
	local function addMessage(role: any, text: string, messageOptions: any?): any
		local opts = table.clone(messageOptions or {})
		opts.conversationId = conversation.id
		return SessionManager.addMessage(role, text, opts)
	end
	local message = addMessage("assistant", "", { taskId = taskId, model = profile.modelId, streaming = true })
	local toolCallCount = 0
	local buildActionCount = 0
	local cancelled = false
	local providerFailed = false
	local terminalReason: string? = nil
	local continuations = 0
	local taskComplete = false

	local function executeLimited(name: string, arguments: any, id: string?): ToolOutcome
		local descriptor = ToolValidator.get(name)
		if not terminalReason and descriptor and descriptor.mode == "build" and buildActionCount >= settings.maxBuildActions then
			terminalReason = string.format("The build action limit of %d was reached. Completed steps were kept; increase the limit in Settings > Agent or send a follow-up.", settings.maxBuildActions)
		end
		if terminalReason then return { toolName = name, arguments = {}, ok = false, verified = false, message = terminalReason, durationMs = 0 } end
		local outcome = AgentController.executeTool(name, arguments, options.mode, taskId, id)
		if outcome.verified and descriptor and descriptor.mode == "build" then buildActionCount += 1 end
		return outcome
	end

	local roundLimit = math.clamp(settings.maxToolCalls, 1, 500) + 4
	local loopBudget = roundLimit

	while loopBudget > 0 do
		loopBudget -= 1

		if StateManager.get() == "CANCELLED" then
			cancelled = true
			break
		end

		if loopBudget < roundLimit - 1 then
			message = addMessage("assistant", "", { taskId = taskId, model = profile.modelId, streaming = true })
		end
		-- `toolDefinitions` is the gate for native tool calling: without it `tools`
-- stayed nil and the whole tool-call branch below was unreachable.
		local spec = prepareSpec(profile, conversation, options.mode, taskId, ToolValidator.toDefinitions(options.mode))
		local flatText = ""
		for _, entry in spec.messages do
			flatText ..= tostring(entry.content or "")
		end
		ContextManager.setPendingEstimate(flatText)

		local turn = AgentController.sendTurn(profile, spec, taskId, {
			onDelta = function(delta, channel)
				SessionManager.appendToMessage(message.id, delta, channel)
				if options.onDelta then
					options.onDelta(delta, channel)
				end
			end,
			onRetryWait = function(seconds, decision, attempt)
				-- The retry card owns the countdown; the transcript is untouched.
				if options.onRetryWait then
					options.onRetryWait(seconds, decision, attempt)
				end
			end,
		})

		if turn.cancelled then
			if turn.error and type(turn.error) == "table" then
				-- A provider failure, not a user cancellation. Preserve everything.
				providerFailed = true
				RetryLogger.errorDetected(turn.error)
				if options.onRetryError then
					options.onRetryError(turn.error, turn.attempts)
				end
				SessionManager.updateMessage(message.id, {
					streaming = false,
					content = turn.text,
					error = turn.error.message or "The provider request failed. The partial answer was preserved.",
					elapsedMs = turn.durationMs,
				})
				local remedy = ProviderErrorNormalizer.remedy(turn.error.category, turn.error)
				addMessage("user", string.format(
					"The provider failed after %d attempt(s): %s%s Conversation, attachments and completed build actions are all preserved.",
					turn.attempts or 1,
					turn.error.message or "Provider request failed.",
					if remedy then ("  " .. remedy) else ""
				), { taskId = taskId })
				break
			end
			cancelled = true
			SessionManager.updateMessage(message.id, { streaming = false, elapsedMs = turn.durationMs })
			break
		end

		ContextManager.setPendingOutputEstimate(turn.text)
		ContextManager.recordRequest(turn.usage, turn.durationMs, capabilityReport.pricing)
		SessionManager.recordUsage(conversation.id, turn.usage)
		SessionManager.updateMessage(message.id, {
			content = turn.text,
			reasoning = turn.reasoning,
			streaming = false,
			elapsedMs = turn.durationMs,
			usage = {
				input = turn.usage and turn.usage.inputTokens or nil,
				output = turn.usage and turn.usage.outputTokens or nil,
				reasoning = turn.usage and turn.usage.reasoningTokens or nil,
			},
		})
		local finish = string.lower(tostring(turn.stopReason or ""))
		if finish == "length" or finish == "max_tokens" or finish == "max_output_tokens" then
			if #turn.toolCalls == 0 and continuations < 3 and loopBudget > 0 then
				continuations += 1
				StateManager.setActivity("Continuing after the provider output limit")
				addMessage("user", "Continue the unfinished answer exactly where you stopped, without repeating earlier text. Complete the original task using available tools when needed.", { taskId = taskId, internal = true })
				continue
			end
			terminalReason = "The provider reached its output limit. The partial answer was kept; send Continue to resume."
			break
		end

		-- 1. Structured protocol path (models without native tool calling) ------
		local nativeToolCalling = profile.toolCalling
			and capabilityReport.capabilities.tool_calling.status == "supported"

		local action, actionError = nil, nil
		if not nativeToolCalling then
			action, actionError = AgentController.parseStructuredAction(turn.text)
		end

		if actionError then
			Logger.warn("Agent", "Structured action rejected.", { detail = actionError, taskId = taskId })
			addMessage("user", string.format(
				"Your last action was rejected: %s Reply with prose only, or with a corrected JSON action block.",
				actionError
			), { taskId = taskId })
			continue
		end

		if action then
			if action.action == "ask_user" then
				local answer = AgentController.runQuestion({
					taskId = taskId,
					kind = action.arguments.kind,
					prompt = action.arguments.prompt,
					detail = action.arguments.detail,
					options = action.arguments.options,
					allowCustom = action.arguments.allowCustom,
					allowAiDecide = action.arguments.allowAiDecide,
					context = action.arguments.context,
				})
				if answer == nil then
					cancelled = true
					SessionManager.updateMessage(message.id, {
						content = turn.text .. "\n\n_The question was not answered, so this task stopped._",
					})
					break
				end
				addMessage("user", QuestionManager.resumePrompt({
					id = "q",
					prompt = action.arguments.prompt,
					options = action.arguments.options,
					context = action.arguments.context,
				}, answer), { taskId = taskId })
				continue
			end

			if action.action == "done" then
				taskComplete = true
				break
			end

			toolCallCount += 1
			if toolCallCount > settings.maxToolCalls then
				terminalReason = string.format("The tool call limit of %d was reached. Completed steps were kept; increase the limit in Settings > Agent or send a follow-up.", settings.maxToolCalls)
				break
			end

			local outcome = executeLimited(action.action, action.arguments, Time.newId("act"))

			EventBus.emit(EventBus.Events.BuildProgress, {
				phase = "toolResult",
				index = toolCallCount,
				total = toolCallCount,
				toolName = outcome.toolName,
				verified = outcome.verified,
			})

			local toolMessage = addMessage("tool", string.format(
				"[%s] %s\n%s",
				outcome.toolName,
				outcome.verified and "verified" or (outcome.ok and "finished (unverified)" or "failed"),
				outcome.message
			), { taskId = taskId })
            if outcome.attachments then runtimeImages[toolMessage.id] = outcome.attachments end

			if outcome.verified then
				StateManager.transition("BUILDING", { taskId = taskId, activity = outcome.toolName })
			end

			if terminalReason then break end
			addMessage("user", "Continue the task based on that tool result.", { taskId = taskId, internal = true })
			continue
		end

		-- 2. Native tool calling path -------------------------------------------
		if #turn.toolCalls > 0 then
			StateManager.transition("ANALYZING", { taskId = taskId, activity = "Deciding what to do" })

			local recordedCalls = {}
			for _, call in turn.toolCalls do
				recordedCalls[#recordedCalls + 1] = { id = call.id, name = call.name, arguments = call.arguments, state = "requested" }
			end
			SessionManager.updateMessage(message.id, { toolCalls = recordedCalls })

			local anyExecuted = false
			for _, call in turn.toolCalls do
				if StateManager.get() == "CANCELLED" then
					cancelled = true
					break
				end

				toolCallCount += 1
				if toolCallCount > settings.maxToolCalls then
					terminalReason = string.format("The tool call limit of %d was reached. Completed steps were kept; increase the limit in Settings > Agent or send a follow-up.", settings.maxToolCalls)
				end

				local outcome = executeLimited(call.name, call.arguments, call.id)
				for _, recorded in recordedCalls do
					if recorded.id == call.id then
						recorded.state = if outcome.ok then "completed" else "failed"
						recorded.result = outcome.message
					end
				end
				anyExecuted = true

				local toolMessage = addMessage("tool", string.format(
					"[%s] %s\n%s",
					call.name,
					outcome.verified and "verified" or (outcome.ok and "finished (unverified)" or "failed"),
					outcome.message
				), { taskId = taskId, toolCallId = call.id })
                if outcome.attachments then runtimeImages[toolMessage.id] = outcome.attachments end

				if buildActionCount == 1 and outcome.verified and options.mode == "build" then
					StateManager.setActivity(string.format("%s verified", call.name))
				end
			end

			SessionManager.updateMessage(message.id, { toolCalls = recordedCalls })
			if terminalReason then break end

			if not anyExecuted then
				break
			end
			continue
		end

		-- 3. Plain answer --------------------------------------------------------
		taskComplete = true
		break
	end
	if loopBudget == 0 and not taskComplete and not cancelled and not providerFailed and not terminalReason then
		terminalReason = "The agent reached its turn limit. Completed steps and the partial answer were kept; send a follow-up to continue."
	end
	if terminalReason then
		addMessage("assistant", terminalReason, { taskId = taskId })
		EventBus.emit(EventBus.Events.Toast, { kind = "warning", message = terminalReason })
	end


	SessionManager.updateMessage(message.id, { streaming = false })

	-- Attachments are cleared ONLY on a clean finish. A provider failure keeps the
	-- conversation, its attachments and the completed build steps intact so the
	-- user can retry without re-uploading anything.
	if not providerFailed and not cancelled and not terminalReason then
		AttachmentEncoder.clear()
	end

	if providerFailed then
		StateManager.transition("FAILED", { taskId = taskId, force = true })
		Logger.error("Agent", "Task stopped by a provider failure.", {
			detail = string.format(
				"%d tool call(s), %d verified action(s). The task registry was kept so a retry cannot duplicate them.",
				toolCallCount,
				buildActionCount
			),
			taskId = taskId,
		})
		return { ok = false, message = "Provider failure" }
	end

	if cancelled or StateManager.get() == "CANCELLED" then
		-- A cancelled task must not leave a replay-blocking registry behind.
		ActionRegistry.clearTask(taskId)
		StateManager.transition("CANCELLED", { taskId = taskId, force = true })
		return { ok = false, message = "Cancelled" }
	end

	-- The task is done; a future task may legitimately rebuild the same objects.
	ActionRegistry.clearTask(taskId)
	if terminalReason then
		StateManager.transition("COMPLETED", { taskId = taskId, force = true })
		return { ok = true, message = terminalReason }
	end

	StateManager.transition("COMPLETED", { taskId = taskId, force = true })
	Logger.success("Agent", "Task finished.", {
		detail = string.format("%d tool call(s), %d verified action(s).", toolCallCount, buildActionCount),
		taskId = taskId,
	})
	return { ok = true, message = "Task finished." }
end

-- Own the lock until the underlying request has stopped, even after Cancel.
function AgentController.runTask(options: any): { ok: boolean, message: string }
	if not StateManager.beginRun() then return { ok = false, message = "A task is already running." } end
	local ok, result = xpcall(function() return runTaskImpl(options) end, function(err) return tostring(err) end)
	if not ok then
		local taskId = StateManager.getTaskId()
		StreamingManager.cancelAll()
		for _, message in options.conversation.messages do
			if message.taskId == taskId and message.streaming then
				SessionManager.updateMessage(message.id, { streaming = false, error = "The task stopped: " .. tostring(result) })
			end
		end
		StateManager.transition("FAILED", { taskId = taskId, force = true })
		Logger.error("Agent", "Task failed.", { detail = tostring(result), taskId = taskId })
	end
	StateManager.endRun()
	return if ok then result else { ok = false, message = tostring(result) }
end

--=============================================================================
-- CONTEXT GATHERING
--=============================================================================

--- Reads the minimum context needed before the first request so the model is not
--- blind, without transmitting unrelated game content.
function AgentController.gatherContext(mode: string): string
	local parts: { string } = {}

	local selection = SelectionInspector.getSummary()
	if #selection > 0 and not string.find(selection, "Nothing is selected", 1, true) then
		parts[#parts + 1] = selection
	end

	local stats = WorkspaceInspector.getStats()
	parts[#parts + 1] = string.format(
		"Place `%s`: %d top-level Workspace children, %s descendants.",
		game.Name,
		stats.workspaceChildren,
		tostring(stats.workspaceDescendants)
	)

	local lighting = WorkspaceInspector.describeLighting()
	local lightingParts = {}
	for _, key in { "ClockTime", "Brightness", "GlobalShadows" } do
		if lighting[key] then
			lightingParts[#lightingParts + 1] = string.format("%s=%s", key, lighting[key])
		end
	end
	if #lightingParts > 0 then
		parts[#parts + 1] = "Lighting: " .. table.concat(lightingParts, ", ")
	end

	_ = mode
	return table.concat(parts, "\n")
end

return AgentController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">AttachmentEncoder</string>
          <string name="Source">--!strict
local StudioService = game:GetService("StudioService")
--[[
	ForgePilot / AI / AttachmentEncoder
	Reads files from Studio, validates them against the model's real capabilities,
	and prepares provider-ready payloads.

	IMPORTANT: reading a PDF's bytes does not mean a chat model can read a PDF.
	The encoder enforces the model's declared capabilities and rejects anything it
	cannot honestly deliver.
]]

local Base64 = require(script.Parent.Parent.Utilities.Base64)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ModelCapabilityDetector = require(script.Parent.ModelCapabilityDetector)
local Time = require(script.Parent.Parent.Utilities.Time)

local AttachmentEncoder = {}

--=============================================================================
-- LIMITS
--=============================================================================

AttachmentEncoder.Limits = {
	MAX_FILE_BYTES = 20 * 1024 * 1024,
	MAX_TOTAL_BYTES = 60 * 1024 * 1024,
	MAX_TEXT_INLINE_BYTES = 300 * 1024,
	MAX_IMAGE_BYTES = 20 * 1024 * 1024,
	MAX_TEXT_CHARS = 400_000,
}

--=============================================================================
-- FILE CATEGORIES
--=============================================================================

export type Category = "image" | "document" | "code" | "audio" | "video" | "unsupported"

local IMAGE_EXT = { png = true, jpg = true, jpeg = true, webp = true }
local TEXT_EXT = { txt = true, md = true, csv = true, json = true }
local CODE_EXT = {
	lua = true,
	luau = true,
	js = true,
	ts = true,
	py = true,
	html = true,
	css = true,
	xml = true,
}
local AUDIO_EXT = { mp3 = true, wav = true, ogg = true, flac = true, m4a = true }
local VIDEO_EXT = { mp4 = true, webm = true, mov = true, avi = true }

function AttachmentEncoder.categorise(fileName: string): Category
	local extension = string.lower(string.match(fileName, "%.([%w]+)$") or "")
	if IMAGE_EXT[extension] then
		return "image"
	elseif extension == "pdf" then
		return "document"
	elseif TEXT_EXT[extension] then
		return "document"
	elseif CODE_EXT[extension] then
		return "code"
	elseif AUDIO_EXT[extension] then
		return "audio"
	elseif VIDEO_EXT[extension] then
		return "video"
	end
	return "unsupported"
end

function AttachmentEncoder.categoryLabel(category: Category): string
	if category == "image" then
		return "Image"
	elseif category == "document" then
		return "Document"
	elseif category == "code" then
		return "Source Code"
	elseif category == "audio" then
		return "Audio"
	elseif category == "video" then
		return "Video"
	end
	return "Unsupported"
end

--=============================================================================
-- ATTACHMENT RECORD
--=============================================================================

export type Attachment = {
	id: string,
	name: string,
	category: Category,
	mime: string,
	sizeBytes: number,
	base64: string?,
	text: string?,
	previewAssetId: number?,
	accepted: boolean,
	rejectionReason: string?,
	warning: string?,
}

local attachments: { Attachment } = {}

function AttachmentEncoder.getAll(): { Attachment }
	return attachments
end

function AttachmentEncoder.count(): number
	return #attachments
end

function AttachmentEncoder.totalBytes(): number
	local total = 0
	for _, attachment in attachments do
		total += attachment.sizeBytes
	end
	return total
end

function AttachmentEncoder.clear()
	attachments = {}
	EventBus.emit(EventBus.Events.AttachmentsChanged, { count = 0, bytes = 0 })
end

function AttachmentEncoder.remove(id: string)
	for index, attachment in attachments do
		if attachment.id == id then
			table.remove(attachments, index)
			EventBus.emit(EventBus.Events.AttachmentsChanged, {
				count = #attachments,
				bytes = AttachmentEncoder.totalBytes(),
			})
			return
		end
	end
end

function AttachmentEncoder.emitChanged()
	EventBus.emit(EventBus.Events.AttachmentsChanged, {
		count = #attachments,
		bytes = AttachmentEncoder.totalBytes(),
	})
end

--=============================================================================
-- PICKER
--=============================================================================

--- Opens the Studio file picker. Returns the chosen `File` instances.
--- Returns an empty list when the user cancels (this is not an error).
function AttachmentEncoder.pickFiles(multiple: boolean?): { Instance }
	local ok, files = pcall(function()
		if multiple == false then
			local file = StudioService:PromptImportFileAsync()
			return if file then { file } else {}
		end
		local picked = StudioService:PromptImportFilesAsync()
		return picked or {}
	end)
	if not ok then
		Logger.error("File Attachments", "The Studio file picker could not be opened.", { detail = tostring(files) })
		return {}
	end
	return files
end

--=============================================================================
-- READING
--=============================================================================

local function readFile(file: Instance): (buffer?, string?)
	local ok, contents = pcall(function()
		return (file :: any):GetBinaryContents()
	end)
	if ok and type(contents) == "string" then
		return Base64.stringToBuffer(contents), nil
	end
	-- Some file types only expose text.
	local textOk, text = pcall(function()
		return (file :: any):GetContents()
	end)
	if textOk and type(text) == "string" then
		return Base64.stringToBuffer(text), nil
	end
	return nil, "Studio could not read this file's contents."
end

--=============================================================================
-- VALIDATION
--=============================================================================

--- Checks whether the model can genuinely accept this attachment.
--- `capabilityReport` comes from ModelCapabilityDetector; nil means unknown model,
--- in which case only text-like content is allowed (a conservative default).
function AttachmentEncoder.validate(
	attachment: Attachment,
	capabilityReport: any?,
	protocolId: string?
): (boolean, string?)
	local limits = AttachmentEncoder.Limits

	if attachment.sizeBytes &gt; limits.MAX_FILE_BYTES then
		return false,
			string.format(
				"`%s` is %s, over the %s per-file limit ForgePilot will send.",
				attachment.name,
				Time.formatBytes(attachment.sizeBytes),
				Time.formatBytes(limits.MAX_FILE_BYTES)
			)
	end

	if AttachmentEncoder.totalBytes() + attachment.sizeBytes &gt; limits.MAX_TOTAL_BYTES then
		return false,
			string.format(
				"Attachments would exceed the %s total limit.",
				Time.formatBytes(limits.MAX_TOTAL_BYTES)
			)
	end

	local allowed = ModelCapabilityDetector.allowedAttachmentKinds(capabilityReport, protocolId)

	if attachment.category == "image" then
		if not allowed.image then
			return false,
				string.format(
					"The selected model does not report vision (image input) support, so `%s` cannot be sent. Choose a vision-capable model or attach text instead.",
					attachment.name
				)
		end
		return true, nil
	end

	if attachment.category == "audio" then
		if not allowed.audio then
			return false,
				string.format(
					"`%s` is audio. Only the Google Gemini native protocol accepts inline audio through a chat endpoint; the current selection cannot accept it.",
					attachment.name
				)
		end
		return true, nil
	end

	if attachment.category == "video" then
		if not allowed.video then
			return false,
				string.format(
					"`%s` is video. Only the Google Gemini native protocol accepts inline video through a chat endpoint; the current selection cannot accept it.",
					attachment.name
				)
		end
		return true, nil
	end

	if attachment.category == "document" and string.match(string.lower(attachment.name), "%.pdf$") then
		if not allowed.pdf then
			return false,
				string.format(
					"`%s` is a PDF. ForgePilot can read the file bytes, but the selected model's chat endpoint does not accept inline PDF data, and ForgePilot cannot parse PDF text inside a Studio plugin. Extract the text and attach that instead.",
					attachment.name
				)
		end
		return true, "PDF is sent as raw inline bytes. Complex layouts may not be understood."
	end

	if attachment.category == "document" or attachment.category == "code" then
		if attachment.text == nil then
			return false, string.format("`%s` could not be decoded as text.", attachment.name)
		end
		if #attachment.text &gt; limits.MAX_TEXT_CHARS then
			return false,
				string.format(
					"`%s` is %d characters, over the %s inline limit. Split the file before attaching.",
					attachment.name,
					#attachment.text,
					Time.formatBytes(limits.MAX_TEXT_CHARS)
				)
		end
		return true, nil
	end

	return false,
		string.format(
			"`%s` has an unsupported extension. ForgePilot can read images (png/jpg/jpeg/webp), text (txt/md/csv/json), code (lua/luau/js/ts/py/html/css/xml), and — where the model supports them — pdf, audio and video.",
			attachment.name
		)
end

--=============================================================================
-- LOAD
--=============================================================================

--- Reads, validates and stores files. Returns accepted and rejected counts.
export type LoadResult = {
	accepted: { Attachment },
	rejected: { { name: string, reason: string } },
}

function AttachmentEncoder.load(files: { Instance }, capabilityReport: any?, protocolId: string?): LoadResult
	local result: LoadResult = { accepted = {}, rejected = {} }

	for _, file in files do
		local okName, name = pcall(function()
			return (file :: any):GetName()
		end)
		if not okName or type(name) ~= "string" then
			name = "untitled"
		end

		local okSize, size = pcall(function()
			return (file :: any):GetSize()
		end)
		if not okSize or type(size) ~= "number" then
			size = 0
		end

		local category = AttachmentEncoder.categorise(name)
		local attachment: Attachment = {
			id = Time.newId("att"),
			name = name,
			category = category,
			mime = Base64.mimeTypeFor(name),
			sizeBytes = size,
			accepted = false,
		}

		if category == "unsupported" then
			local _, reason = AttachmentEncoder.validate(attachment, capabilityReport, protocolId)
			result.rejected[#result.rejected + 1] = { name = name, reason = reason or "Unsupported format." }
			continue
		end

		local fileBuffer, readError = readFile(file)
		if not fileBuffer then
			result.rejected[#result.rejected + 1] = { name = name, reason = readError or "Could not read the file." }
			continue
		end

		if size == 0 then
			size = buffer.len(fileBuffer)
			attachment.sizeBytes = size
		end

		if category == "document" or category == "code" then
			local decoded = Base64.bufferToString(fileBuffer)
			if string.byte(decoded, 1, 1) == 0 or decoded:find("\0") then
				result.rejected[#result.rejected + 1] = {
					name = name,
					reason = string.format(
						"`%s` has a text extension but contains binary data. Attach it as its real format instead.",
						name
					),
				}
				continue
			end
			attachment.text = decoded
		else
			attachment.base64 = Base64.encodeBuffer(fileBuffer)
		end

		-- Studio can produce a temporary asset id for a native image preview.
		if category == "image" then
			pcall(function()
				-- GetTemporaryId returns forms like "rbxassetid://1234" or "1234".
				local raw = (file :: any):GetTemporaryId()
				if type(raw) == "string" then
					local digits = string.match(raw, "(%d+)$")
					if digits then
						attachment.previewAssetId = tonumber(digits)
					end
				end
			end)
		end

local accepted, reason = AttachmentEncoder.validate(attachment, capabilityReport, protocolId)
		attachment.accepted = accepted
		attachment.rejectionReason = reason

		if accepted then
			attachments[#attachments + 1] = attachment
			result.accepted[#result.accepted + 1] = attachment
			Logger.info("File Attachments", string.format("Attached %s (%s).", attachment.name, AttachmentEncoder.categoryLabel(category)))
		else
			result.rejected[#result.rejected + 1] = { name = name, reason = reason or "Rejected." }
			Logger.warn("File Attachments", string.format("Rejected %s.", name), { detail = reason })
		end
	end

	AttachmentEncoder.emitChanged()
	return result
end

--=============================================================================
-- PROVIDER PARTS
--=============================================================================

--- Converts accepted attachments into the adapter content-part shape.
--- Only the parts the model genuinely supports are emitted.
function AttachmentEncoder.toProviderParts(capabilityReport: any?, protocolId: string?): { any }
	local allowed = ModelCapabilityDetector.allowedAttachmentKinds(capabilityReport, protocolId)
	local parts: { any } = {}

	for _, attachment in attachments do
		if not attachment.accepted then
			continue
		end

		if attachment.category == "image" and attachment.base64 and allowed.image then
			parts[#parts + 1] = {
				kind = "image",
				mime = attachment.mime,
				data = attachment.base64,
				fileName = attachment.name,
			}
		elseif attachment.category == "audio" and attachment.base64 and allowed.audio then
			parts[#parts + 1] = {
				kind = "audio",
				mime = attachment.mime,
				data = attachment.base64,
				fileName = attachment.name,
			}
		elseif attachment.category == "video" and attachment.base64 and allowed.video then
			parts[#parts + 1] = {
				kind = "video",
				mime = attachment.mime,
				data = attachment.base64,
				fileName = attachment.name,
			}
		elseif attachment.category == "document" and allowed.pdf and attachment.base64 then
			parts[#parts + 1] = {
				kind = "document",
				mime = attachment.mime,
				data = attachment.base64,
				fileName = attachment.name,
			}
		elseif (attachment.category == "document" or attachment.category == "code") and attachment.text then
			local header = string.format("--- BEGIN %s (%s) ---\n", attachment.name, AttachmentEncoder.categoryLabel(attachment.category))
			local footer = string.format("\n--- END %s ---", attachment.name)
			local text = header .. attachment.text .. footer
			local entry = { kind = "text", text = text }
			if attachment.category == "code" then
				entry.language = string.match(string.lower(attachment.name), "%.([%w]+)$")
			end
			parts[#parts + 1] = entry
		end
	end

	return parts
end

--- Lightweight manifest used in chat history and logs. Contains no file bytes.
function AttachmentEncoder.manifest(): { { name: string, mime: string, sizeBytes: number } }
	local list = {}
	for _, attachment in attachments do
		if attachment.accepted then
			list[#list + 1] = { name = attachment.name, mime = attachment.mime, sizeBytes = attachment.sizeBytes }
		end
	end
	return list
end

function AttachmentEncoder.reset()
	AttachmentEncoder.clear()
end

return AttachmentEncoder</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BaseURLResolver</string>
          <string name="Source">--!strict
--[[
	ForgePilot / AI / BaseURLResolver
	Parses, validates and normalises provider base URLs.

	Two URL modes are supported and never guessed between:
	  * BASE      - an API root such as https://host/v1; the endpoint path is
	                appended by APIEndpointRouter.
	  * FULL      - a complete endpoint such as https://host/v1/chat/completions;
	                used verbatim, with no suffix appended.

	Everything here is pure string handling. No network access, no globals beyond
	the standard library, so it is fully testable.
]]

local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local BaseURLResolver = {}

--=============================================================================
-- TYPES
--=============================================================================

export type Mode = "base" | "full" | "auto"

export type ParsedUrl = {
	scheme: string,
	host: string,
	port: number?,
	authority: string,
	path: string,
	query: string?,
	fragment: string?,
}

export type Resolved = {
	ok: boolean,
	--- Normalised URL without credentials (there are none by construction).
	url: string?,
	parsed: ParsedUrl?,
	error: string?,
	--- Which mode was actually applied.
	mode: Mode,
	--- Set when a query string is carried through.
	query: string?,
}

--=============================================================================
-- TRUST
--=============================================================================

--- Domains ForgePilot recognises as established AI providers. Anything else
--- raises the "unrecognised host" warning before a credential is sent.
local TRUSTED_HOSTS: { [string]: boolean } = {
	["api.openai.com"] = true,
	["openrouter.ai"] = true,
	["generativelanguage.googleapis.com"] = true,
	["api.anthropic.com"] = true,
	["api.groq.com"] = true,
	["api.together.xyz"] = true,
	["api.fireworks.ai"] = true,
	["api.deepseek.com"] = true,
	["api.mistral.ai"] = true,
	["api.cohere.ai"] = true,
	["api.cerebras.ai"] = true,
	["open.bigmodel.cn"] = true,
	["dashscope.aliyuncs.com"] = true,
	["api.perplexity.ai"] = true,
	["api.x.ai"] = true,
	["api-inference.huggingface.co"] = true,
	["api.venice.ai"] = true,
}

--=============================================================================
-- PARSING
--=============================================================================

local SCHEME_PATTERN = "^(%a[%w%+%-%.]*)://(.+)$"

--- Splits a URL into its parts. Returns nil plus a reason on malformed input.
function BaseURLResolver.parse(raw: string): (ParsedUrl?, string?)
	if type(raw) ~= "string" then
		return nil, "URL must be a string."
	end

	local trimmed = StringUtil.trim(raw)
	-- Strip surrounding whitespace and any accidental wrapping quotes.
	trimmed = string.gsub(trimmed, '^"(.*)"$', "%1")
	trimmed = string.gsub(trimmed, "^'(.*)'$", "%1")
	trimmed = StringUtil.trim(trimmed)

	if #trimmed == 0 then
		return nil, "URL is empty."
	end
	if #trimmed &gt; 2048 then
		return nil, "URL is too long."
	end

	local scheme, rest = string.match(trimmed, SCHEME_PATTERN)
	if not scheme then
		return nil, "URL must start with a scheme, for example https://."
	end

	scheme = string.lower(scheme)
	if scheme ~= "https" and scheme ~= "http" then
		return nil, string.format("Unsupported URL scheme `%s`. Use https://.", scheme)
	end

	-- Fragment then query.
	local fragment: string? = nil
	local hashPos = string.find(rest, "#", 1, true)
	if hashPos then
		fragment = string.sub(rest, hashPos + 1)
		rest = string.sub(rest, 1, hashPos - 1)
	end

	local query: string? = nil
	local queryPos = string.find(rest, "?", 1, true)
	if queryPos then
		query = string.sub(rest, queryPos + 1)
		rest = string.sub(rest, 1, queryPos - 1)
	end

	local authority, path = string.match(rest, "^([^/]+)(.*)$")
	if not authority or #authority == 0 then
		return nil, "URL has no host."
	end

	-- Credentials embedded in the URL are refused outright.
	if string.find(authority, "@", 1, true) then
		return nil, "URL must not embed credentials. Use the API Key field instead."
	end

	local host, portText = string.match(authority, "^([^:]+):(%d+)$")
	if not host then
		host = authority
		portText = nil
	end

	host = string.lower(host)
	if not string.match(host, "^[%w][%w%-%.]*$") then
		return nil, "URL host contains unsupported characters."
	end
	if string.find(host, "..", 1, true) then
		return nil, "URL host is malformed."
	end

	local port: number? = nil
	if portText then
		port = tonumber(portText)
		if port == nil or port &lt; 1 or port &gt; 65535 then
			return nil, "URL port is out of range."
		end
	end

	return {
		scheme = scheme,
		host = host,
		port = port,
		authority = if portText then string.format("%s:%s", host, portText) else host,
		path = path or "",
		query = query,
		fragment = fragment,
	}, nil
end

--=============================================================================
-- HTTPS ENFORCEMENT
--=============================================================================

--- Returns the URL unchanged for https, or nil plus a reason otherwise.
--- Loopback HTTP supports the companion and 9Router. Remote addresses still
--- require HTTPS; the original scheme is preserved when building endpoints.
function BaseURLResolver.enforceHttps(parsed: ParsedUrl): (boolean, string?)
	if parsed.scheme == "https" or (parsed.scheme == "http" and (parsed.host == "127.0.0.1" or parsed.host == "localhost")) then
		return true, nil
	end
	return false,
		"Remote providers must use https://. Plain HTTP is accepted only for 127.0.0.1 or localhost."
end

--=============================================================================
-- NORMALISATION
--=============================================================================

--- Collapses a path: removes duplicate slashes and trailing slashes.
--- Collapses every run of slashes into one.
--- Uses repeated plain finds rather than a `{n,m}` quantifier so the behaviour is
--- identical on every Lua-family engine.
local function collapseSlashes(text: string): string
	local cleaned = text or ""
	while string.find(cleaned, "//", 1, true) do
		cleaned = string.gsub(cleaned, "//", "/", 1)
	end
	return cleaned
end

BaseURLResolver.collapseSlashes = collapseSlashes

function BaseURLResolver.normalisePath(path: string): string
	local cleaned = collapseSlashes(path or "")
	cleaned = string.gsub(cleaned, "/+$", "")
	return cleaned
end

--- Splits a path into non-empty segments.
function BaseURLResolver.segments(path: string): { string }
	local out: { string } = {}
	for segment in string.gmatch(path, "[^/]+") do
		out[#out + 1] = segment
	end
	return out
end

--- True when `path` already ends with `suffix` on a segment boundary.
function BaseURLResolver.pathEndsWith(path: string, suffix: string): boolean
	local a = string.sub(BaseURLResolver.normalisePath(path), 1, -(#suffix + 1))
	local b = string.sub(BaseURLResolver.normalisePath(path), -#suffix)
	if a ~= b then
		return false
	end
	-- Must be a whole segment, not a partial name like "mychatcompletions".
	local before = string.sub(BaseURLResolver.normalisePath(path), 1, -(#suffix + 1))
	return before == "" or string.sub(before, -1) == "/"
end

--- Strips `suffix` from the end of `path` when it is already present.
function BaseURLResolver.stripSuffix(path: string, suffix: string): string
	if not BaseURLResolver.pathEndsWith(path, suffix) then
		return BaseURLResolver.normalisePath(path)
	end
	local cleaned = string.sub(BaseURLResolver.normalisePath(path), 1, -(#suffix + 1))
	return BaseURLResolver.normalisePath(cleaned)
end

--- Validates and normalises a base URL. Returns the URL, or nil plus a reason.
--- Trailing slashes are removed; the path prefix (/v1, /v1beta, …) is preserved.
function BaseURLResolver.normaliseBase(raw: string): (string?, string?)
	local parsed, err = BaseURLResolver.parse(raw)
	if not parsed then
		return nil, err
	end
	local secure, secureErr = BaseURLResolver.enforceHttps(parsed)
	if not secure then
		return nil, secureErr
	end
	local path = BaseURLResolver.normalisePath(parsed.path)
	return string.format("%s://%s%s", parsed.scheme, parsed.authority, path), nil
end

--=============================================================================
-- TRUST
--=============================================================================

function BaseURLResolver.isTrustedHost(urlOrHost: string?): boolean
	if type(urlOrHost) ~= "string" then
		return false
	end
	local host = urlOrHost
	if string.find(host, "://", 1, true) then
		local parsed = BaseURLResolver.parse(host)
		if not parsed then
			return false
		end
		host = parsed.host
	end
	host = string.lower(host)
	if host == "127.0.0.1" or host == "localhost" then return true end
	if TRUSTED_HOSTS[host] then
		return true
	end
	for trusted in pairs(TRUSTED_HOSTS) do
		if string.sub(host, -(#trusted + 1)) == "." .. trusted then
			return true
		end
	end
	return false
end

--- Returns the host of a URL, or nil.
function BaseURLResolver.hostOf(url: string?): string?
	if type(url) ~= "string" then
		return nil
	end
	local parsed = BaseURLResolver.parse(url)
	return parsed and parsed.host or nil
end

--- Normalises and de-duplicates a base + endpoint pair.
---
--- When the endpoint template repeats segments already present at the end of the
--- base (e.g. base `/v1` + template `/v1/chat/completions`), the shared prefix is
--- emitted once. This prevents `/v1/v1/chat/completions` and
--- `/chat/completions/chat/completions` while leaving genuinely distinct
--- segments intact.
local function join(basePath: string, template: string): string
	local baseSegments = BaseURLResolver.segments(basePath)
	local templateSegments = BaseURLResolver.segments(template)

	-- Longest overlap between the tail of the base and the head of the template.
	local maxOverlap = math.min(#baseSegments, #templateSegments)
	local overlap = 0
	for size = maxOverlap, 1, -1 do
		local matches = true
		for index = 1, size do
			if baseSegments[#baseSegments - size + index] ~= templateSegments[index] then
				matches = false
				break
			end
		end
		if matches then
			overlap = size
			break
		end
	end

	local combined: { string } = {}
	for _, segment in baseSegments do
		combined[#combined + 1] = segment
	end
	for index = overlap + 1, #templateSegments do
		combined[#combined + 1] = templateSegments[index]
	end

	if #combined == 0 then
		return ""
	end
	return "/" .. table.concat(combined, "/")
end

BaseURLResolver.joinSegments = join

--=============================================================================
-- MODE DETECTION
--=============================================================================

--- Endpoint suffixes that identify a "full endpoint" URL.
local KNOWN_ENDPOINT_SUFFIXES = {
	"/chat/completions",
	"/completions",
	"/responses",
	"/messages",
	"/generatecontent",
	"/streamgeneratecontent",
	"/models",
	"/embeddings",
}

--- Guesses whether a URL is a BASE root or a FULL endpoint.
--- `auto` never changes the user's stored mode; it only informs the preview.
function BaseURLResolver.detectMode(path: string, endpointPath: string?): Mode
	local cleaned = string.lower(BaseURLResolver.normalisePath(path))
	if cleaned == "" or cleaned == "/" then
		return "base"
	end

	-- An exact match against the configured endpoint path is the strongest signal.
	if endpointPath and #endpointPath &gt; 0 then
		local template = BaseURLResolver.normalisePath((endpointPath:gsub("{model}", "___MODEL___")))
		if cleaned:sub(-#template) == string.lower(template) then
			return "full"
		end
	end

	for _, suffix in KNOWN_ENDPOINT_SUFFIXES do
		if string.sub(cleaned, -#suffix) == suffix then
			return "full"
		end
	end

	-- A path that still carries a version segment looks like a base root.
	local segments = BaseURLResolver.segments(cleaned)
	local last = segments[#segments]
	if last and string.match(last, "^v%d+[%w%-%.]*$") then
		return "base"
	end

	return "base"
end

--=============================================================================
-- RESOLUTION
--=============================================================================

--- Builds the final request URL.
---
--- options:
---   endpointPath - the protocol's path template, e.g. "/chat/completions".
---                   May contain "{model}".
---   mode         - "base" | "full" | "auto"
---   streaming    - use the protocol's streaming path when one exists.
function BaseURLResolver.resolve(raw: string, options: {
	endpointPath: string?,
	mode: Mode?,
	streaming: boolean?,
	model: string?,
	overridePath: string?,
}): Resolved
	local parsed, err = BaseURLResolver.parse(raw)
	if not parsed then
		return { ok = false, url = nil, parsed = nil, error = err, mode = "base" }
	end

	local secure, secureErr = BaseURLResolver.enforceHttps(parsed)
	if not secure then
		return { ok = false, url = nil, parsed = parsed, error = secureErr, mode = "base" }
	end

	local requestedMode = options.mode or "base"
	local template = options.overridePath or options.endpointPath or ""

	-- Substitute the model id, escaping Lua pattern characters in the result.
	if options.model then
		local safeModel = (options.model:gsub("([^%w%-%.%_%~])", "%%%1"))
		template = (template:gsub("{model}", safeModel))
	end

	local basePath = BaseURLResolver.normalisePath(parsed.path)
	local mode = requestedMode

	if requestedMode == "auto" then
		mode = BaseURLResolver.detectMode(basePath, template)
	end

	local resolvedPath: string
	if mode == "full" then
		-- The URL's own path wins; the template only strips a duplicate suffix
		-- the user may have pasted on top of a base.
		local cleanTemplate = BaseURLResolver.normalisePath((template:gsub("{model}", "__MODEL__")))
		if #cleanTemplate &gt; 0 and BaseURLResolver.pathEndsWith(basePath, cleanTemplate) then
			resolvedPath = BaseURLResolver.stripSuffix(basePath, cleanTemplate)
		else
			resolvedPath = basePath
		end
	else
		-- BASE mode: append the endpoint, de-duplicating shared segments so we
		-- never produce /v1/v1/chat/completions.
		if #template &gt; 0 then
			local cleanTemplate = BaseURLResolver.normalisePath((template:gsub("{model}", "__MODEL__")))
			resolvedPath = join(basePath, cleanTemplate)
		else
			resolvedPath = basePath
		end
	end

	-- Collapse any accidental double slash introduced by concatenation.
	resolvedPath = collapseSlashes(resolvedPath)

	local url = string.format("%s://%s%s", parsed.scheme, parsed.authority, resolvedPath)
	if parsed.query and #parsed.query &gt; 0 then
		url ..= "?" .. parsed.query
	end

	return {
		ok = true,
		url = url,
		parsed = parsed,
		error = nil,
		mode = mode,
		query = parsed.query,
	}
end

--- The model-list URL for a base. Returns nil plus a reason when unsupported.
function BaseURLResolver.modelListUrl(raw: string, options: { mode: Mode?, overridePath: string? }?): (string?, string?)
	local opts = options or {}
	local path = opts.overridePath or "/models"
	return BaseURLResolver.resolve(raw, {
		endpointPath = path,
		mode = opts.mode or "base",
	}).url
end

--- Strips every query parameter that could carry a credential, for display.
function BaseURLResolver.forDisplay(url: string): string
	if type(url) ~= "string" then
		return ""
	end
	local parsed = BaseURLResolver.parse(url)
	if not parsed then
		-- Never echo an unparseable string that might contain a key.
		return "(unparseable URL)"
	end
	local out = string.format("%s://%s%s", parsed.scheme, parsed.authority, parsed.path)
	if parsed.query and #parsed.query &gt; 0 then
		out ..= "?&lt;query hidden&gt;"
	end
	return out
end

return BaseURLResolver</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CapabilityInspector</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / CapabilityInspector
	V3.3 capability detection across model AND protocol.

	Combines three sources into one Supported / Unsupported / Unknown verdict:
	  * known provider metadata (preset table)
	  * model-specific metadata
	  * live probes (real requests, user-authorised)

	Hard rule: absent information stays UNKNOWN. It is never inferred from the
	protocol alone unless the protocol genuinely defines the capability.
]]

local APIEndpointRouter = require(script.Parent.APIEndpointRouter)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ModelCapabilityDetector = require(script.Parent.ModelCapabilityDetector)
local Time = require(script.Parent.Parent.Utilities.Time)
local UniversalHTTPClient = require(script.Parent.Parent.Utilities.UniversalHTTPClient)
local UniversalProviderRegistry = require(script.Parent.UniversalProviderRegistry)

local CapabilityInspector = {}

--=============================================================================
-- V3.3 CAPABILITY CATALOGUE
--=============================================================================

export type Verdict = "Supported" | "Unsupported" | "Unknown"

export type Row = {
	id: string,
	label: string,
	verdict: Verdict,
	source: string,
	checkedAt: number?,
	note: string,
	overridden: boolean,
	probeable: boolean,
	probeCost: "none" | "low" | "high",
	probeNote: string,
}

export type Report = {
	providerId: string,
	providerName: string,
	protocolId: string,
	modelId: string,
	rows: { Row },
	contextWindow: number,
	contextWindowSource: string,
	maxOutputTokens: number,
	maxOutputTokensSource: string,
	generatedAt: number,
}

--- Ordered catalogue matching the spec's capability list exactly.
local CATALOGUE: { { id: string, label: string, probeable: boolean, cost: "none" | "low" | "high", note: string } } = {
	{ id = "chat_completions", label = "Chat Completions", probeable = true, cost = "low", note = "Sends one chat request and validates the response structure." },
	{ id = "text_completions", label = "Text Completions", probeable = true, cost = "low", note = "Sends one /completions request and requires choices[].text." },
	{ id = "responses_api", label = "Responses API", probeable = true, cost = "low", note = "Sends one /responses request and requires an output field." },
	{ id = "streaming", label = "Streaming", probeable = true, cost = "low", note = "Opens a real stream and counts received chunks." },
	{ id = "tool_calling", label = "Tool Calling", probeable = true, cost = "low", note = "Offers a tool and checks whether the model requests it." },
	{ id = "parallel_tool_calling", label = "Parallel Tool Calling", probeable = true, cost = "low", note = "Offers two tools and counts returned calls." },
	{ id = "structured_json", label = "Structured JSON Output", probeable = true, cost = "low", note = "Requests JSON mode and validates the reply." },
	{ id = "vision", label = "Vision (Image Input)", probeable = true, cost = "high", note = "Sends a tiny generated PNG." },
	{ id = "image_generation", label = "Image Generation", probeable = false, cost = "high", note = "Requires a dedicated image endpoint ForgePilot does not call." },
	{ id = "pdf_input", label = "PDF Input", probeable = false, cost = "high", note = "Chat endpoints cannot verify binary PDF parsing." },
	{ id = "document_input", label = "Document Input", probeable = true, cost = "low", note = "Sends a short text document." },
	{ id = "audio_input", label = "Audio Input", probeable = false, cost = "high", note = "Only Gemini's native route inlines audio." },
	{ id = "video_input", label = "Video Input", probeable = false, cost = "high", note = "Only Gemini's native route inlines video." },
	{ id = "audio_output", label = "Audio Output", probeable = false, cost = "high", note = "No chat route returns audio." },
	{ id = "reasoning", label = "Reasoning", probeable = true, cost = "high", note = "Looks for reasoning tokens or reasoning text in the response." },
	{ id = "system_instructions", label = "System Instructions", probeable = true, cost = "low", note = "Sends a system instruction and checks it is honoured." },
}

CapabilityInspector.Catalogue = CATALOGUE

--=============================================================================
-- PROTOCOL DEFAULTS
--=============================================================================
-- These describe the WIRE FORMAT, not the model, so they are reliable.

local function protocolDefault(protocolId: string, capabilityId: string): (Verdict, string)
	local protocol = UniversalProviderRegistry.getProtocol(protocolId)

	if capabilityId == "chat_completions" then
		if protocolId == "gemini_native" or protocolId == "anthropic_messages" then
			return "Unsupported", "This protocol does not serve the Chat Completions route."
		end
		if protocolId == "custom_rest" then
			return "Unknown", "Depends entirely on your schema mapping."
		end
		return "Supported", "This protocol serves the Chat Completions route."
	end

	if capabilityId == "text_completions" then
		if protocol.supportsTextCompletions then
			return "Supported", "Protocol defines a /completions route."
		end
		return "Unsupported", "Protocol has no /completions route."
	end

	if capabilityId == "responses_api" then
		if protocolId == "openai_responses" then
			return "Supported", "Protocol is the Responses API."
		elseif protocolId == "openai_chat" or protocolId == "openrouter" then
			return "Unknown", "Not probed yet; some compatible servers also expose /responses."
		end
		return "Unsupported", "Protocol does not define a Responses route."
	end

	if capabilityId == "streaming" then
		if protocol.supportsStreaming then
			if UniversalHTTPClient.supportsStreaming() then
				return "Supported", "Protocol streams and this Studio build exposes CreateWebStreamClient."
			end
			return "Unknown", "Protocol streams, but this Studio build has no CreateWebStreamClient."
		end
		return "Unsupported", "Protocol does not stream."
	end

	if capabilityId == "tool_calling" then
		if protocol.supportsToolCalling then
			return "Supported", "Protocol defines tool definitions."
		end
		return "Unsupported", "Protocol has no tool-calling route."
	end

	if capabilityId == "system_instructions" then
		if protocol.supportsSystemRole then
			return "Supported", "Protocol carries a system prompt."
		end
		return "Unsupported", "Protocol has no system role."
	end

	if capabilityId == "structured_json" then
		if protocol.supportsJsonMode then
			return "Supported", "Protocol defines a JSON response mode."
		end
		return "Unsupported", "Protocol has no structured-output parameter."
	end

	if capabilityId == "reasoning" then
		if protocol.supportsReasoningSummaries then
			return "Unknown", "Protocol can carry reasoning; not probed yet."
		end
		return "Unknown", "Nothing about this protocol reports reasoning."
	end

	if capabilityId == "vision" or capabilityId == "document_input" or capabilityId == "pdf_input" then
		if protocol.supportsImages or protocol.supportsDocuments then
			return "Unknown", "Protocol can carry media; the model has not been probed yet."
		end
		return "Unsupported", "Protocol has no inline media block."
	end

	if capabilityId == "parallel_tool_calling" then
		return "Unknown", "Requires a two-tool probe."
	end

	return nil
end

--=============================================================================
-- BUILD REPORT
--=============================================================================

local overrides: { [string]: { [string]: Verdict } } = {}

local function keyFor(profile: any): string
	return string.format("%s|%s|%s", profile.id, profile.modelId or "", profile.protocol or "")
end

--- Builds a report from metadata + protocol knowledge. No network needed.
function CapabilityInspector.buildReport(profile: any): Report
	local preset = UniversalProviderRegistry.getPreset(profile.presetId)
	local modelMetadata = if preset then preset.modelMetadata[profile.modelId] else nil
	local rows: { Row } = {}
	local modelKey = keyFor(profile)
	local modelOverrides = overrides[modelKey] or {}

	for _, definition in CATALOGUE do
		local verdict: Verdict = "Unknown"
		local source = "no_information"
		local note = "No metadata available. Run a live probe or set a manual override."

		local modelHint = if modelMetadata then modelMetadata.capabilities[definition.id] else nil
		local presetHint = if preset then preset.providerCapabilities[definition.id] else nil

		if type(modelHint) == "string" and (modelHint == "yes" or modelHint == "no") then
			verdict = if modelHint == "yes" then "Supported" else "Unsupported"
			source = "model_metadata"
			note = string.format("Model metadata for %s.", profile.modelId)
		elseif type(presetHint) == "string" and (presetHint == "yes" or presetHint == "no") then
			verdict = if presetHint == "yes" then "Supported" else "Unsupported"
			source = "provider_metadata"
			note = string.format("Provider documentation for %s.", preset.label)
		else
			local defaultVerdict, defaultNote = protocolDefault(profile.protocol, definition.id)
			if defaultVerdict then
				verdict = defaultVerdict
				source = "protocol_definition"
				note = defaultNote
			end
		end

		local overridden = modelOverrides[definition.id] ~= nil
		if overridden then
			verdict = (modelOverrides[definition.id] :: Verdict)
			source = "manual_override"
			note = "Manual override. Not verified against this provider."
		end

		rows[#rows + 1] = {
			id = definition.id,
			label = definition.label,
			verdict = verdict,
			source = source,
			checkedAt = nil,
			note = note,
			overridden = overridden,
			probeable = definition.probeable,
			probeCost = definition.cost,
			probeNote = definition.note,
		}
	end

	local contextWindow = profile.contextWindow or 128000
	local contextWindowSource = "Manual value from the provider settings."
	local maxOutput = profile.maxOutputTokens or 4096
	local maxOutputSource = "Manual value from the provider settings."
	if modelMetadata and profile.contextWindowMode ~= "manual" then
		contextWindow = modelMetadata.contextWindow
		contextWindowSource = "Model metadata."
	elseif profile.contextWindowMode == "auto" and preset then
		contextWindowSource = "Provider default estimate; no model metadata for this id."
	end
	if modelMetadata and profile.maxOutputTokensMode ~= "manual" then
		maxOutput = modelMetadata.maxOutputTokens
		maxOutputSource = "Model metadata."
	end

	return {
		providerId = profile.id,
		providerName = profile.displayName or profile.providerName or "Provider",
		protocolId = profile.protocol,
		modelId = profile.modelId or "",
		rows = rows,
		contextWindow = contextWindow,
		contextWindowSource = contextWindowSource,
		maxOutputTokens = maxOutput,
		maxOutputTokensSource = maxOutputSource,
		generatedAt = os.clock(),
	}
end

--=============================================================================
-- OVERRIDES
--=============================================================================

function CapabilityInspector.setOverride(profile: any, capabilityId: string, verdict: Verdict?)
	local modelKey = keyFor(profile)
	if not overrides[modelKey] then
		overrides[modelKey] = {}
	end
	overrides[modelKey][capabilityId] = verdict
	local report = CapabilityInspector.buildReport(profile)
	EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report })
	return report
end

--=============================================================================
-- LIVE PROBES
--=============================================================================

export type ProbeOptions = {
	onProgress: ((row: Row) -> ())?,
	shouldCancel: (() -> boolean)?,
	only: string?,
}

local TINY_PNG_BASE64 =
	"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="

local function mark(rows: { Row }, capabilityId: string, verdict: Verdict, note: string)
	for _, row in rows do
		if row.id == capabilityId then
			if not row.overridden then
				row.verdict = verdict
				row.source = "live_probe"
				row.note = note
				row.checkedAt = os.clock()
			end
			return
		end
	end
end

local function rowById(rows: { Row }, capabilityId: string): Row?
	for _, row in rows do
		if row.id == capabilityId then
			return row
		end
	end
	return nil
end

--- Builds a profile for probing a different protocol against the same endpoint.
local function probeProfile(profile: any, protocolId: string): any
	local copy = table.clone(profile)
	copy.protocol = protocolId
	copy.endpointPath = APIEndpointRouter.chatPath(protocolId)
	copy.urlMode = "base"
	return copy
end

local function post(profile: any, protocolId: string, body: any, timeoutMs: number?, shouldCancel: (() -> boolean)?): any
	local ProviderService = require(script.Parent.ProviderService)
	local spec = {
		messages = { { role = "user", content = "Reply with the single word: ok" } },
		system = "You are a capability probe. Follow the instruction exactly.",
		model = profile.modelId,
		maxOutputTokens = 64,
		streaming = false,
		jsonMode = false,
		toolChoice = "none",
	}
	if protocolId == "openai_text_completions" then
		spec.messages = {}
		spec.system = nil
	end
	local prepared = ProviderService.prepare(probeProfile(profile, protocolId), spec, CredentialStore.get(profile.id), false)
	if not prepared then
		return nil, { transportError = "Could not build the probe request." }
	end

	local response = UniversalHTTPClient.postJson(
		prepared.url,
		prepared.headers,
		prepared.jsonBody or {},
		{ timeoutMs = timeoutMs or 30000, label = "capability-probe", shouldCancel = shouldCancel }
	)
	if not response.ok then
		return nil, {
			statusCode = response.statusCode,
			body = response.body,
			headers = response.headers,
			transportError = response.transportError,
		}
	end
	return response.body, nil
end

--- Runs capability probes. Every probe is a real request.
function CapabilityInspector.probe(profile: any, options: ProbeOptions?): Report
	local opts = options or {}
	local report = CapabilityInspector.buildReport(profile)
	local apiKey = CredentialStore.get(profile.id)
	local ProviderService = require(script.Parent.ProviderService)

	local function progress()
		-- The UI reads the report object each time, so one emit is enough.
		EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report })
	end

	local function cancelled(): boolean
		return opts.shouldCancel ~= nil and opts.shouldCancel() == true
	end

	-- 1. Chat Completions with a tool offer (covers tool calling + system prompt).
	if not cancelled() and (opts.only == nil or opts.only == "chat_completions" or opts.only == "tool_calling") then
		local spec = {
			messages = { { role = "user", content = "Call the probe_tool function exactly once." } },
			system = "You are a capability probe.",
			model = profile.modelId,
			maxOutputTokens = 128,
			streaming = false,
			jsonMode = false,
			toolChoice = "required",
			tools = {
				{
					name = "probe_tool",
					description = "Returns a constant.",
					parameters = { type = "object", properties = {}, additionalProperties = false },
				},
			},
		}
		local prepared = ProviderService.prepare(profile, spec, apiKey, false)
		if prepared then
			local response = UniversalHTTPClient.postJson(
				prepared.url,
				prepared.headers,
				prepared.jsonBody or {},
				{ timeoutMs = math.min(profile.timeoutMs or 30000, 30000), label = "capability/chat", shouldCancel = cancelled }
			)
			if response.ok then
				local parsed = ProviderService.parseAdapterResponse(profile, response.body)
				mark(report.rows, "chat_completions", "Supported", "A chat request succeeded and returned a usable reply.")
				mark(report.rows, "system_instructions", "Supported", "The request carried a system instruction.")
				if parsed and #parsed.toolCalls > 0 then
					mark(report.rows, "tool_calling", "Supported", string.format("The model requested `%s`.", parsed.toolCalls[1].name))
					mark(report.rows, "parallel_tool_calling", "Unknown", "One tool was offered, so parallelism was not measured.")
				else
					mark(report.rows, "tool_calling", "Unsupported", "The request succeeded but no tool call came back.")
				end
				if parsed and parsed.usage and parsed.usage.reasoningTokens and parsed.usage.reasoningTokens > 0 then
					mark(report.rows, "reasoning", "Supported", string.format("Reported %d reasoning tokens.", parsed.usage.reasoningTokens))
				else
					mark(report.rows, "reasoning", "Unknown", "No reasoning token field appeared in the usage block.")
				end
			else
				mark(report.rows, "chat_completions", "Unknown", "The chat probe request failed; see the log for details.")
				mark(report.rows, "tool_calling", "Unknown", "Not probed because the chat probe failed.")
			end
		else
			mark(report.rows, "chat_completions", "Unknown", "Could not build the probe request.")
		end
		progress()
	end

	-- 2. Text Completions.
	if
		not cancelled()
		and (opts.only == nil or opts.only == "text_completions")
		and UniversalProviderRegistry.getProtocol(profile.protocol).supportsTextCompletions
	then
		local textProfile = probeProfile(profile, "openai_text_completions")
		local ok, err = post(textProfile, "openai_text_completions", nil, math.min(profile.timeoutMs or 30000, 30000), cancelled)
		if ok then
			local decoded = require(script.Parent.Parent.Utilities.JSONValidator).decode(ok)
			local valid = type(decoded) == "table"
				and type(decoded.choices) == "table"
				and #decoded.choices > 0
				and type(decoded.choices[1].text) == "string"
			mark(
				report.rows,
				"text_completions",
				if valid then "Supported" else "Unknown",
				if valid
					then "The /completions route returned choices[].text."
					else "HTTP succeeded but choices[].text was absent."
			)
		else
			mark(report.rows, "text_completions", "Unsupported", string.format("Probe failed: %s", tostring((err :: any).statusCode or "error")))
		end
		progress()
	end

	-- 3. Responses API.
	if
		not cancelled()
		and (opts.only == nil or opts.only == "responses_api")
		and profile.protocol ~= "anthropic_messages"
		and profile.protocol ~= "gemini_native"
	then
		local ok = post(probeProfile(profile, "openai_responses"), "openai_responses", nil, math.min(profile.timeoutMs or 30000, 30000), cancelled)
		if ok then
			local decoded = require(script.Parent.Parent.Utilities.JSONValidator).decode(ok)
			local valid = type(decoded) == "table" and (decoded.output ~= nil or decoded.output_text ~= nil)
			mark(
				report.rows,
				"responses_api",
				if valid then "Supported" else "Unknown",
				if valid then "The /responses route returned an output field." else "HTTP succeeded but no output field appeared."
			)
		else
			mark(report.rows, "responses_api", "Unsupported", "This endpoint did not serve the /responses route.")
		end
		progress()
	end

	-- 4. Streaming — a real stream, counting chunks.
	if not cancelled() and (opts.only == nil or opts.only == "streaming") then
		if not UniversalHTTPClient.supportsStreaming() then
			mark(report.rows, "streaming", "Unknown", "This Studio build has no CreateWebStreamClient, so streaming cannot be tested here.")
		else
			local ProviderService2 = require(script.Parent.ProviderService)
			local spec = {
				messages = { { role = "user", content = "Count to three." } },
				model = profile.modelId,
				maxOutputTokens = 32,
				streaming = true,
				jsonMode = false,
				toolChoice = "none",
			}
			local prepared = ProviderService2.prepare(profile, spec, apiKey, true)
			if prepared and prepared.streaming then
				local chunks = 0
				local handle = UniversalHTTPClient.stream({
					url = prepared.url,
					headers = prepared.headers,
					body = prepared.body,
					timeoutMs = math.min(profile.timeoutMs or 30000, 30000),
					label = "capability/streaming",
				}, {
					onChunk = function()
						chunks += 1
					end,
					onComplete = function() end,
					onError = function() end,
				})
				if handle then
					local waited = 0
					while not handle.isDone() and waited < math.min(profile.timeoutMs or 30000, 30000) / 1000 and not cancelled() do
						task.wait(0.1)
						waited += 0.1
					end
					if not handle.isDone() then handle.cancel() end
					mark(
						report.rows,
						"streaming",
						if chunks > 1 then "Supported" else "Unknown",
						if chunks > 1
							then string.format("The stream delivered %d chunks.", chunks)
							else "The stream opened but produced fewer than two chunks."
					)
				else
					mark(report.rows, "streaming", "Unsupported", "The endpoint refused a streaming request.")
				end
			else
				mark(report.rows, "streaming", "Unsupported", "The request could not be prepared as a stream.")
			end
			progress()
		end
	end

	-- 5. Structured JSON.
	if not cancelled() and (opts.only == nil or opts.only == "structured_json") then
		local ProviderService3 = require(script.Parent.ProviderService)
		local spec = {
			messages = { { role = "user", content = 'Return {"ok":true}' } },
			model = profile.modelId,
			maxOutputTokens = 64,
			streaming = false,
			jsonMode = true,
			toolChoice = "none",
		}
		local prepared = ProviderService3.prepare(profile, spec, apiKey, false)
		if prepared then
			local response = UniversalHTTPClient.postJson(prepared.url, prepared.headers, prepared.jsonBody or {}, {
				timeoutMs = math.min(profile.timeoutMs or 30000, 30000),
				shouldCancel = cancelled,
				label = "capability/json",
			})
			if response.ok then
				local parsed = ProviderService3.parseAdapterResponse(profile, response.body)
				local valid = parsed ~= nil
					and require(script.Parent.Parent.Utilities.JSONValidator).decode(parsed.text or "") ~= nil
				mark(
					report.rows,
					"structured_json",
					if valid then "Supported" else "Unsupported",
					if valid then "JSON mode returned parseable JSON." else "JSON mode did not return parseable JSON."
				)
			else
				mark(report.rows, "structured_json", "Unknown", "The JSON-mode probe request failed.")
			end
		end
		progress()
	end

	-- 6. Vision.
	if not cancelled() and (opts.only == nil or opts.only == "vision") then
		local ProviderService4 = require(script.Parent.ProviderService)
		local spec = {
			messages = {
				{
					role = "user",
					parts = {
						{ kind = "text", text = "What colour is this? One word." },
						{ kind = "image", mime = "image/png", data = TINY_PNG_BASE64, fileName = "probe.png" },
					},
				},
			},
			model = profile.modelId,
			maxOutputTokens = 32,
			streaming = false,
			jsonMode = false,
			toolChoice = "none",
		}
		local prepared = ProviderService4.prepare(profile, spec, apiKey, false)
		if prepared then
			local response = UniversalHTTPClient.postJson(prepared.url, prepared.headers, prepared.jsonBody or {}, {
				timeoutMs = math.min(profile.timeoutMs or 30000, 30000),
				shouldCancel = cancelled,
				label = "capability/vision",
			})
			if response.ok then
				mark(report.rows, "vision", "Supported", "The endpoint accepted an inline image and replied.")
			else
				local status = response.statusCode or 0
				mark(
					report.rows,
					"vision",
					if status == 400 or status == 415 or status == 422 then "Unsupported" else "Unknown",
					if status == 400 or status == 415 or status == 422
						then string.format("The provider rejected the image (HTTP %d).", status)
						else "The vision probe was inconclusive."
				)
			end
		end
		progress()
	end

	report.generatedAt = os.clock()

	local counts = { Supported = 0, Unsupported = 0, Unknown = 0 }
	for _, row in report.rows do
		counts[row.verdict] += 1
	end

	Logger.success("Capabilities", "Capability probes finished.", {
		detail = string.format(
			"%s · %s · %d supported, %d unsupported, %d unknown",
			report.providerName,
			report.modelId,
			counts.Supported,
			counts.Unsupported,
			counts.Unknown
		),
	})

	return report
end

--=============================================================================
-- SUMMARY
--=============================================================================

function CapabilityInspector.summary(report: Report): { Supported: number, Unsupported: number, Unknown: number }
	local counts = { Supported = 0, Unsupported = 0, Unknown = 0 }
	for _, row in report.rows do
		counts[row.verdict] += 1
	end
	return counts
end

function CapabilityInspector.getRow(report: Report, capabilityId: string): Row?
	return rowById(report.rows, capabilityId)
end

function CapabilityInspector.describeRow(row: Row): string
	local when = if row.checkedAt then string.format(" · %.0fs ago", os.clock() - row.checkedAt) else ""
	return string.format("%s — %s (%s%s)", row.label, row.verdict, row.source, when)
end

return CapabilityInspector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ContextManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / ContextManager
	Context window accounting, trimming, and summarisation.

	TOKEN HONESTY
	-------------
	When a provider returns usage, those numbers are used verbatim and labelled
	"provider". When it does not, ForgePilot computes an ESTIMATE with a clearly
	labelled heuristic and marks it "estimated". Character counts are never
	presented as exact token counts.
]]

local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)


local ContextManager = {}

--=============================================================================
-- ESTIMATION
--=============================================================================

--- Conservative token estimate.
--- Calibration: English prose averages ~4 chars/token; code and JSON are denser,
--- so they are charged a higher chars-per-token ratio. Numbers are rounded up so
--- the estimate errs on the safe side.
local function estimateTokens(text: string): number
	if type(text) ~= "string" or #text == 0 then
		return 0
	end
	local codeChars = 0
	local total = #text

	-- Count characters that belong to code-ish content.
	for line in text:gmatch("([^\n]*)\n?") do
		if
			string.find(line, "{", 1, true)
			or string.find(line, "}", 1, true)
			or string.find(line, "function", 1, true)
			or string.find(line, "local ", 1, true)
			or string.find(line, "=", 1, true)
			or string.find(line, ";", 1, true)
		then
			codeChars += #line
		end
	end

	local proseChars = total - codeChars
	local tokens = proseChars / 4.0 + codeChars / 3.0
	return math.ceil(tokens)
end

ContextManager.estimateTokens = estimateTokens

--- Estimates the token cost of base64 payloads without decoding them.
local function estimateBinaryTokens(base64Length: number): number
	return math.ceil(base64Length / 4 / 3 * 4 / 3 * 1.1)
end

--=============================================================================
-- USAGE RECORD
--=============================================================================

export type Usage = {
	input: number,
	output: number,
	reasoning: number,
	cached: number,
	estimated: boolean,
	source: string,
	requestMs: number,
	estimatedCost: number?,
	currency: string,
}

export type Snapshot = {
	contextWindow: number,
	contextWindowSource: string,
	used: number,
	usedIsEstimate: boolean,
	remaining: number,
	percent: number,
	reservedForTools: number,
	availableForMessages: number,
	maxOutputTokens: number,
	lastRequest: Usage?,
	totalInput: number,
	totalOutput: number,
	totalReasoning: number,
	estimatedCost: number,
	pricingKnown: boolean,
	messageCount: number,
}

local snapshot: Snapshot = {
	contextWindow = 128000,
	contextWindowSource = "Default estimate",
	used = 0,
	usedIsEstimate = true,
	remaining = 128000,
	percent = 0,
	reservedForTools = 4096,
	availableForMessages = 123904,
	maxOutputTokens = 4096,
	lastRequest = nil,
	totalInput = 0,
	totalOutput = 0,
	totalReasoning = 0,
	estimatedCost = 0,
	pricingKnown = false,
	messageCount = 0,
}

function ContextManager.getSnapshot(): Snapshot
	return table.clone(snapshot)
end

--=============================================================================
-- CONFIGURATION
--=============================================================================

--- Syncs limits from the active provider and its capability report.
function ContextManager.configure(profile: any?, report: any?)
	local settings = require(script.Parent.Parent.Core.SettingsManager).get()
	local reserved = settings.reserveTokensForTools or 4096
	snapshot.reservedForTools = reserved

	if not profile then
		snapshot.contextWindow = 0
		snapshot.contextWindowSource = "No AI provider configured."
		snapshot.maxOutputTokens = 0
		snapshot.availableForMessages = 0
		snapshot.pricingKnown = false
		ContextManager.recompute()
		ContextManager.publish()
		return
	end

	if report then
		snapshot.contextWindow = report.contextWindow
		snapshot.contextWindowSource = report.contextWindowSource
		snapshot.maxOutputTokens = report.maxOutputTokens
		local pricing = if type(report.pricing) == "table" then report.pricing else {}
		snapshot.pricingKnown = pricing.input ~= nil and pricing.output ~= nil
	else
		snapshot.contextWindow = profile.contextWindow or 128000
		snapshot.contextWindowSource = "Manual value from provider settings."
		snapshot.maxOutputTokens = profile.maxOutputTokens or 4096
		snapshot.pricingKnown = false
	end

	snapshot.availableForMessages = math.max(0, snapshot.contextWindow - reserved - snapshot.maxOutputTokens)
	ContextManager.recompute()
	ContextManager.publish()
end

--=============================================================================
-- RECOMPUTE
--=============================================================================

function ContextManager.recompute()
	snapshot.remaining = math.max(0, snapshot.contextWindow - snapshot.used)
	snapshot.percent = if snapshot.contextWindow > 0
		then math.clamp(snapshot.used / snapshot.contextWindow * 100, 0, 100)
		else 0
end

function ContextManager.publish()
	EventBus.emit(EventBus.Events.TokenUsageChanged, { snapshot = ContextManager.getSnapshot() })
	EventBus.emit(EventBus.Events.ContextChanged, { snapshot = ContextManager.getSnapshot() })
end

--=============================================================================
-- MESSAGE ACCOUNTING
--=============================================================================

--- Recomputes context usage from a message list (used on load / after trimming).
function ContextManager.recomputeFromMessages(messages: { any })
	local total = 0
	for _, message in messages do
		total += estimateTokens(message.content or "")
		if message.reasoning then
			total += estimateTokens(message.reasoning)
		end
		for _, attachment in (message.attachments or {}) do
			if attachment.tokens then
				total += attachment.tokens
			end
		end
	end
	snapshot.used = total
	snapshot.usedIsEstimate = true
	snapshot.messageCount = #messages
	ContextManager.recompute()
	ContextManager.publish()
end

--=============================================================================
-- REQUEST RECORDING
--=============================================================================

--- Records the outcome of a real provider request.
function ContextManager.recordRequest(providerUsage: any?, requestMs: number, pricing: any?)
	local settings = require(script.Parent.Parent.Core.SettingsManager).get()

	local input: number
	local output: number
	local reasoning: number
	local cached = 0
	local isEstimate = false
	local source = "provider"

	if type(providerUsage) == "table" and providerUsage.source == "provider" then
		input = providerUsage.inputTokens or 0
		output = providerUsage.outputTokens or 0
		reasoning = providerUsage.reasoningTokens or 0
		cached = providerUsage.cachedTokens or 0
		if input == 0 and output == 0 then
			source = "none"
		end
	else
		isEstimate = true
		source = "estimated"
		input = snapshot.lastEstimatedInput or 0
		output = snapshot.lastEstimatedOutput or 0
		reasoning = 0
	end

	local cost: number? = nil
	if pricing and pricing.input and pricing.output then
		cost = (input / 1_000_000) * pricing.input + (output / 1_000_000) * pricing.output
	end

	local usage: Usage = {
		input = input,
		output = output,
		reasoning = reasoning,
		cached = cached,
		estimated = isEstimate,
		source = source,
		requestMs = requestMs,
		estimatedCost = cost,
		currency = "USD",
	}

	snapshot.lastRequest = usage
	snapshot.totalInput += input
	snapshot.totalOutput += output
	snapshot.totalReasoning += reasoning
	if cost then
		snapshot.estimatedCost += cost
	end

	-- Rolling context estimate: prompt tokens for this turn plus retained history.
	local newUsed = math.max(snapshot.used, input) + output
	snapshot.used = newUsed
	snapshot.usedIsEstimate = not (source == "provider")

	ContextManager.recompute()
	ContextManager.publish()

	Logger.info("Token Usage", string.format(
		"input %s · output %s%s",
		tostring(input),
		tostring(output),
		if isEstimate then " (estimated)" else ""
	), { durationMs = requestMs })

	return usage
end

--- Called before a request so the input side can be estimated if the provider
--- returns no usage.
function ContextManager.setPendingEstimate(text: string)
	snapshot.lastEstimatedInput = estimateTokens(text)
	snapshot.lastEstimatedOutput = 0
end

function ContextManager.setPendingOutputEstimate(text: string)
	snapshot.lastEstimatedOutput = estimateTokens(text)
end

--=============================================================================
-- TRIMMING
--=============================================================================

export type TrimPlan = {
	shouldTrim: boolean,
	removeFromIndex: number?,
	keepCount: number,
	estimatedSaved: number,
	ratio: number,
	reason: string,
}

--- Decides whether history must be trimmed before the next request.
function ContextManager.planTrim(messages: { any }, settings: any): TrimPlan
	local ratio = snapshot.availableForMessages > 0
		and (snapshot.used / snapshot.availableForMessages)
		or 0

	local threshold = settings.summarizeThreshold or 0.85

	if ratio < threshold then
		return {
			shouldTrim = false,
			removeFromIndex = nil,
			keepCount = #messages,
			estimatedSaved = 0,
			ratio = ratio,
			reason = string.format("Context is at %.0f%% of the available window.", ratio * 100),
		}
	end

	-- Keep the system prompt (index 1) and the most recent turns.
	local keepRecent = 6
	local removeFrom = math.max(2, #messages - keepRecent + 1)
	local saved = 0
	for index = removeFrom, #messages do
		saved += estimateTokens(messages[index].content or "")
	end

	return {
		shouldTrim = true,
		removeFromIndex = removeFrom,
		keepCount = #messages - removeFrom + 1,
		estimatedSaved = saved,
		ratio = ratio,
		reason = string.format(
			"Context reached %.0f%% of the available window; older messages will be summarised.",
			ratio * 100
		),
	}
end

--- Returns the message list actually sent to the provider, plus the summary
--- text that should replace anything dropped.
function ContextManager.buildSendWindow(messages: { any }, summary: string?): ({ any }, string?, string?)
	local systemCount = 0
	for _, message in messages do
		if message.role == "system" then
			systemCount += 1
		else
			break
		end
	end

	local out: { any } = {}
	for index = 1, systemCount do
		out[#out + 1] = messages[index]
	end
	for index = systemCount + 1, #messages do
		out[#out + 1] = messages[index]
	end

	if summary and #StringUtil.trim(summary) > 0 then
		return out, summary, string.format("%d earlier messages were summarised.", #out - systemCount)
	end
	return out, nil, nil
end

--=============================================================================
-- MANUAL CONTROLS
--=============================================================================

function ContextManager.reset()
	snapshot.used = 0
	snapshot.usedIsEstimate = true
	snapshot.totalInput = 0
	snapshot.totalOutput = 0
	snapshot.totalReasoning = 0
	snapshot.estimatedCost = 0
	snapshot.messageCount = 0
	snapshot.lastRequest = nil
	ContextManager.recompute()
	ContextManager.publish()
	Logger.info("Token Usage", "Context counters reset.")
end

function ContextManager.setReservedTokens(tokens: number)
	snapshot.reservedForTools = math.max(0, tokens)
	snapshot.availableForMessages =
		math.max(0, snapshot.contextWindow - snapshot.reservedForTools - snapshot.maxOutputTokens)
	ContextManager.recompute()
	ContextManager.publish()
end

--=============================================================================
-- DISPLAY HELPERS
--=============================================================================

local function compact(value: number): string
	if value >= 1_000_000 then
		return string.format("%.1fM", value / 1_000_000)
	elseif value >= 1000 then
		return string.format("%.1fk", value / 1000)
	end
	return tostring(math.floor(value + 0.5))
end

ContextManager.compact = compact

function ContextManager.formatUsageLabel(usage: Usage): string
	local prefix = if usage.estimated then "~" else ""
	local parts = {
		string.format("%sin %s", prefix, compact(usage.input)),
		string.format("%sout %s", prefix, compact(usage.output)),
	}
	if usage.reasoning > 0 then
		parts[#parts + 1] = string.format("%sthink %s", prefix, compact(usage.reasoning))
	end
	if usage.cached > 0 then
		parts[#parts + 1] = string.format("cache %s", compact(usage.cached))
	end
	parts[#parts + 1] = string.format("%.0fms", usage.requestMs)
	return table.concat(parts, " · ")
end

function ContextManager.formatCost(cost: number?): string?
	if cost == nil then
		return nil
	end
	if cost < 0.01 then
		return string.format("$%.4f", cost)
	end
	return string.format("$%.2f", cost)
end

return ContextManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CustomProviderManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / CustomProviderManager
	CRUD, validation and URL preview for user-defined providers.

	All validation lives here so the settings UI and the request path can never
	disagree about whether a provider is usable.
]]

local APIEndpointRouter = require(script.Parent.APIEndpointRouter)
local BaseURLResolver = require(script.Parent.BaseURLResolver)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local UniversalProviderRegistry = require(script.Parent.UniversalProviderRegistry)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local Time = require(script.Parent.Parent.Utilities.Time)

local CustomProviderManager = {}

--=============================================================================
-- VALIDATION
--=============================================================================

export type ValidationIssue = {
	field: string,
	message: string,
	severity: "error" | "warning",
}

export type ValidationResult = {
	ok: boolean,
	errors: { ValidationIssue },
	warnings: { ValidationIssue },
}

local function issue(field: string, message: string, severity: "error" | "warning"): ValidationIssue
	return { field = field, message = message, severity = severity }
end

--- Validates a provider profile without saving it.
function CustomProviderManager.validate(profile: any): ValidationResult
	local errors: { ValidationIssue } = {}
	local warnings: { ValidationIssue } = {}

	if type(profile) ~= "table" then
		return {
			ok = false,
			errors = { issue("profile", "No provider profile supplied.", "error") },
			warnings = warnings,
		}
	end

	if type(profile.displayName) ~= "string" or #StringUtil.trim(profile.displayName) == 0 then
		errors[#errors + 1] = issue("displayName", "AI Display Name is required.", "error")
	end

	local normalised, urlError = BaseURLResolver.normaliseBase(profile.baseUrl or "")
	if not normalised then
		errors[#errors + 1] = issue("baseUrl", tostring(urlError), "error")
	elseif not BaseURLResolver.isTrustedHost(normalised) then
		warnings[#warnings + 1] = issue(
			"baseUrl",
			"Unrecognised host. Your API key will be sent to this domain. Continue only if you trust it.",
			"warning"
		)
	end

	local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
	if protocol.id == "custom_rest" then
		local mapping = profile.schemaMapping
		if type(mapping) ~= "table" then
			errors[#errors + 1] = issue(
				"schemaMapping",
				"Custom REST requires a Request Schema Mapping and a Response Schema Mapping.",
				"error"
			)
		else
			if type(mapping.request) ~= "table" or type(mapping.request.prompt) ~= "string" then
				errors[#errors + 1] =
					issue("schemaMapping.request.prompt", "Request mapping needs a `prompt` destination path.", "error")
			end
			if type(mapping.response) ~= "table" or type(mapping.response.text) ~= "string" then
				errors[#errors + 1] =
					issue("schemaMapping.response.text", "Response mapping needs a `text` source path.", "error")
			end
		end
	end

	if type(profile.authStyle) == "string" then
		local valid = {
			bearer = true,
			header = true,
			query = true,
			none = true,
			custom = true,
		}
		if not valid[profile.authStyle] then
			errors[#errors + 1] = issue("authStyle", "Unknown authentication style.", "error")
		elseif
			(profile.authStyle == "header" or profile.authStyle == "custom")
			and (type(profile.authHeaderName) ~= "string" or #profile.authHeaderName == 0)
		then
			errors[#errors + 1] =
				issue("authHeaderName", "This authentication style needs a header name.", "error")
		elseif profile.authStyle == "query" and (type(profile.authQueryParam) ~= "string" or #profile.authQueryParam == 0) then
			errors[#errors + 1] =
				issue("authQueryParam", "Query authentication needs a parameter name.", "error")
		end
	end

	local maxTokens = tonumber(profile.maxOutputTokens)
	if maxTokens and maxTokens < 1 then
		errors[#errors + 1] = issue("maxOutputTokens", "Maximum Output Tokens must be at least 1.", "error")
	end

	local timeout = tonumber(profile.timeoutMs)
	if timeout and (timeout < 1000 or timeout > 600000) then
		errors[#errors + 1] = issue("timeoutMs", "Request Timeout must be between 1000 and 600000 ms.", "error")
	end

	if profile.streaming and protocol.supportsStreaming == false then
		warnings[#warnings + 1] =
			issue("streaming", protocol.label .. " does not stream; ForgePilot will use a single response.", "warning")
	end

	return { ok = #errors == 0, errors = errors, warnings = warnings }
end

--=============================================================================
-- ENDPOINT PREVIEW
--=============================================================================

export type Preview = {
	ok: boolean,
	url: string?,
	display: string,
	mode: string,
	endpointPath: string,
	note: string?,
	error: string?,
	streamingUrl: string?,
}

--- Builds the read-only URL preview shown in the settings panel.
--- Never includes the API key.
function CustomProviderManager.preview(profile: any): Preview
	local route = APIEndpointRouter.get(profile and profile.protocol)
	-- The preview follows the protocol unless the user edited the path by hand.
	local endpointPath: string = if type(profile) == "table"
			and profile.endpointPathCustom == true
			and type(profile.endpointPath) == "string"
			and #profile.endpointPath > 0
		then profile.endpointPath
		else route.chat

	local resolved = BaseURLResolver.resolve(profile and profile.baseUrl or "", {
		endpointPath = endpointPath,
		mode = (if type(profile) == "table" then profile.urlMode else "base") :: any,
		model = if type(profile) == "table" then profile.modelId else nil,
	})

	if not resolved.ok then
		return {
			ok = false,
			url = nil,
			display = "(invalid base URL)",
			mode = "base",
			endpointPath = endpointPath,
			note = nil,
			error = resolved.error,
			streamingUrl = nil,
		}
	end

	local url = resolved.url :: string
	local streamUrl: string? = nil
	if route.stream then
		local streamPath: string = if #endpointPath > 0 and profile and profile.urlMode == "full"
			then endpointPath
			else route.stream
		local streamResolved = BaseURLResolver.resolve(profile.baseUrl, {
			endpointPath = streamPath,
			mode = (profile.urlMode or "base") :: any,
			model = profile.modelId,
		})
		if streamResolved.ok then
			streamUrl = streamResolved.url
			local query = APIEndpointRouter.streamQuery(profile.protocol)
			if query and streamUrl and not string.find(streamUrl, "?", 1, true) then
				streamUrl ..= "?" .. query
			end
		end
	end

	local note: string? = nil
	if resolved.mode == "full" then
		note = "Full Endpoint URL mode: the path you supplied is used verbatim."
	elseif BaseURLResolver.detectMode(
		BaseURLResolver.parse(profile.baseUrl).path,
		endpointPath
	) == "full" then
		note = "This URL already ends with an endpoint path. Nothing will be appended."
	end

	return {
		ok = true,
		url = url,
		display = BaseURLResolver.forDisplay(url),
		mode = resolved.mode,
		endpointPath = endpointPath,
		note = note,
		error = nil,
		streamingUrl = streamUrl,
	}
end

--=============================================================================
-- CRUD
--=============================================================================

--- Opens an unconfigured preset for editing. Required connection fields are
--- validated by save/test, after the user has had a chance to enter them.
function CustomProviderManager.createDraft(presetId: string): (any?, string?)
	if not UniversalProviderRegistry.getPreset(presetId) then
		return nil, "Unknown provider preset."
	end
	local profile = UniversalProviderRegistry.newProfile(presetId)
	SettingsManager.addProvider(profile)
	Logger.info("AI Provider", "Created provider draft.", { detail = profile.providerName })
	return profile, nil
end

--- Creates a provider from a preset and makes it active.
function CustomProviderManager.create(presetId: string, overrides: { [string]: any }?): (any?, string?)
	local profile = UniversalProviderRegistry.newProfile(presetId)
	if type(overrides) == "table" then
		for key, value in overrides do
			(profile :: any)[key] = value
		end
	end
	local validation = CustomProviderManager.validate(profile)
	if not validation.ok then
		return nil, validation.errors[1] and validation.errors[1].message or "Invalid provider."
	end
	SettingsManager.addProvider(profile)
	SettingsManager.setActiveProvider(profile.id)
	Logger.info("AI Provider", string.format("Created provider \"%s\".", profile.displayName), {
		detail = string.format("%s · %s", profile.providerName, profile.protocol),
	})
	return profile, nil
end

--- Validates then saves. Returns nil plus the issue list when invalid.
function CustomProviderManager.save(profile: any, allowIncomplete: boolean?): (boolean, { ValidationIssue })
	local validation = CustomProviderManager.validate(profile)
	if not validation.ok then
		if not allowIncomplete then return false, validation.errors end
		for _, problem in validation.errors do
			local emptyUrl = problem.field == "baseUrl" and StringUtil.trim(profile.baseUrl or "") == ""
			local missingMapping = problem.field == "schemaMapping" and profile.schemaMapping == nil
			if not emptyUrl and not missingMapping then return false, validation.errors end
		end
	end
	SettingsManager.updateProvider(profile.id, {
		displayName = profile.displayName,
		providerName = profile.providerName,
		providerType = profile.providerType,
		presetId = profile.presetId,
		viaRouter = profile.viaRouter,
		routerProviderId = profile.routerProviderId,
		routerAlias = profile.routerAlias,
		providerCategory = profile.providerCategory,
		iconId = profile.iconId,
		hasOAuth = profile.hasOAuth,
		routerNoAuth = profile.routerNoAuth,
		protocol = profile.protocol,
		baseUrl = profile.baseUrl,
		endpointPath = profile.endpointPath,
		endpointPathCustom = profile.endpointPathCustom,
		urlMode = profile.urlMode,
		modelId = profile.modelId,
		authStyle = profile.authStyle,
		authHeaderName = profile.authHeaderName,
		authHeaderPrefix = profile.authHeaderPrefix,
		authQueryParam = profile.authQueryParam,
		defaultHeaders = profile.defaultHeaders,
		extraHeaders = profile.extraHeaders,
		contextWindow = profile.contextWindow,
		contextWindowMode = profile.contextWindowMode,
		maxOutputTokens = profile.maxOutputTokens,
		maxOutputTokensMode = profile.maxOutputTokensMode,
		temperature = profile.temperature,
		topP = profile.topP,
		reasoningEffort = profile.reasoningEffort,
		reasoningIncludeSummary = profile.reasoningIncludeSummary,
		streaming = profile.streaming,
		toolCalling = profile.toolCalling,
		parallelToolCalling = profile.parallelToolCalling,
		jsonMode = profile.jsonMode,
		timeoutMs = profile.timeoutMs,
		retryOverrides = profile.retryOverrides,
		schemaMapping = profile.schemaMapping,
	})
	return true, {}
end

function CustomProviderManager.duplicate(id: string): (any?, string?)
	local source = SettingsManager.getProvider(id)
	if not source then
		return nil, "Provider not found."
	end
	local copy = table.clone(source)
	copy.id = Time.newId("provider")
	copy.displayName = source.displayName .. " (copy)"
	copy.createdAt = os.time()
	copy.updatedAt = os.time()
	copy.extraHeaders = table.clone(source.extraHeaders or {})
	SettingsManager.addProvider(copy)
	SettingsManager.setActiveProvider(copy.id)
	Logger.info("AI Provider", string.format("Duplicated provider \"%s\".", source.displayName))
	return copy, nil
end

function CustomProviderManager.remove(id: string): boolean
	local existed = SettingsManager.getProvider(id) ~= nil
	if existed then
		SettingsManager.removeProvider(id)
		Logger.info("AI Provider", "Removed provider profile.")
	end
	return existed
end

--=============================================================================
-- CREDENTIALS
--=============================================================================

-- Injected so this module never has to depend on the credential store directly.
local credentialClear: (string) -> () = function(_id) end

function CustomProviderManager.setCredentialClear(fn: (string) -> ())
	credentialClear = if type(fn) == "function" then fn else function(_id)
	end
end

--- Clears the active provider and forgets session credentials for it.
function CustomProviderManager.disconnect(id: string?): boolean
	local profile = if id then SettingsManager.getProvider(id) else SettingsManager.getActiveProvider()
	if profile then
		credentialClear(profile.id)
	end
	if not profile or SettingsManager.getValue("activeProviderId") == profile.id then
		SettingsManager.setActiveProvider(nil)
	end
	return true
end

--=============================================================================
-- HEADERS
--=============================================================================

--- Parses `Name: value` lines into a header table. Invalid lines are reported.
function CustomProviderManager.parseHeaders(text: string): ({ [string]: string }, { string })
	local headers: { [string]: string } = {}
	local problems: { string } = {}
	for line in string.gmatch((text or "") .. "\n", "(.-)\r?\n") do
		local trimmed = StringUtil.trim(line)
		if #trimmed > 0 then
			local name, value = string.match(trimmed, "^([%w%-_%.]+)%s*:%s*(.*)$")
			if name then
				headers[name] = StringUtil.trim(value)
			else
				problems[#problems + 1] = string.format("Could not parse %q — expected `Name: value`.", trimmed)
			end
		end
	end
	return headers, problems
end

--- Renders a header table back into `Name: value` lines.
function CustomProviderManager.formatHeaders(headers: { [string]: string }?): string
	if type(headers) ~= "table" then
		return ""
	end
	local lines: { string } = {}
	for name, value in headers do
		lines[#lines + 1] = string.format("%s: %s", name, value)
	end
	table.sort(lines)
	return table.concat(lines, "\n")
end

--=============================================================================
-- ENDPOINT PATH SUGGESTION
--=============================================================================

--- Returns the endpoint path a protocol expects, for the editable field.
function CustomProviderManager.suggestEndpointPath(protocolId: string, streaming: boolean?): string
	local route = APIEndpointRouter.get(protocolId)
	if streaming then
		return route.stream or route.chat
	end
	return route.chat
end

return CustomProviderManager
]]></string>
        </Properties>
