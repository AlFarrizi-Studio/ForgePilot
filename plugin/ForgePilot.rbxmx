      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">Disclosure</string>
          <string name="Source"><![CDATA[--!strict
local TextService = game:GetService("TextService")
local Icons = require(script.Parent.Parent.Utilities.Icons)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local Disclosure = {}

-- The same controls exist for one-line and long results. Only the expanded
-- viewport scrolls; closing never leaves a hidden, full-height body behind.
function Disclosure.build(parent: Instance, options: any): (Frame, any)
	local frame = Instance.new("Frame")
	frame.Name = options.name or "ActivityDetails"
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	Theme.passThrough(frame)
	frame.Parent = parent
	Theme.listLayout(5).Parent = frame
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 28)
	Theme.passThrough(header)
	header.Parent = frame
	local icon = Icons.glyph(options.icon or "Tool", 16, Theme.Colors.Highlight)
	icon.Name = "ActivityIcon"
	icon.Position = UDim2.fromOffset(0, 6)
	icon.Parent = header
	local toggle = Theme.textButton("", { height = 28 })
	toggle.Name = "Toggle"
	toggle.Position = UDim2.fromOffset(22, 0)
	toggle.Size = UDim2.new(1, -22, 1, 0)
	toggle.BackgroundTransparency = 1
	toggle.TextXAlignment = Enum.TextXAlignment.Left
	toggle.TextSize = 12
	toggle.Parent = header
	local preview = Theme.label("", { size = 11, color = Theme.Extra.Muted })
	preview.Name = "Preview"
	preview.Size = UDim2.new(1, 0, 0, 18)
	preview.LayoutOrder = 1
	preview.TextTruncate = Enum.TextTruncate.AtEnd
	preview.Parent = frame
	local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	scroll.Name = "Content"
	scroll.Size = UDim2.new(1, 0, 0, 24)
	scroll.LayoutOrder = 2
	scroll.Active = true
	scroll.Parent = frame
	local text = Theme.autoText(options.text or "", { size = options.textSize or 12, color = options.color or Theme.Colors.SecondaryText, font = options.font or Theme.Fonts.Code })
	text.Name = options.textName or "Detail"
	text.RichText = false
	text.Parent = scroll
	local footer = Instance.new("Frame")
	footer.Name = "Footer"
	footer.Size = UDim2.new(1, 0, 0, 24)
	footer.LayoutOrder = 3
	Theme.passThrough(footer)
	Theme.listLayout(8, Enum.FillDirection.Horizontal).Parent = footer
	footer.Parent = frame
	local close = Theme.textButton("", { height = 24, width = UDim2.fromOffset(76, 24) })
	close.Name = "Close"
	close.BackgroundTransparency = 1
	close.TextSize = 11
	Icons.setButton(close, "ChevronUp", "Close")
	close.Parent = footer
	if options.onCopy then
		local copy = Theme.textButton("", { height = 24, width = UDim2.fromOffset(68, 24) })
		copy.Name = "Copy"
		copy.LayoutOrder = 1
		copy.BackgroundTransparency = 1
		copy.TextSize = 11
		Icons.setButton(copy, "Copy", "Copy")
		copy.Parent = footer
		copy.MouseButton1Click:Connect(function() options.onCopy(text.Text) end)
	end
	local expanded = options.expanded == true
	local function resize()
		local bounds = TextService:GetTextSize(text.Text, text.TextSize, text.Font, Vector2.new(math.max(120, scroll.AbsoluteSize.X - 12), 1000000))
		scroll.Size = UDim2.new(1, 0, 0, math.clamp(bounds.Y + 8, 24, options.maxHeight or 260))
	end
	local function refresh()
		scroll.Visible = expanded
		footer.Visible = expanded
		preview.Visible = not expanded and options.preview == true
		preview.Text = text.Text:match("([^\r\n]+)") or ""
		Icons.setButton(toggle, if expanded then "ChevronDown" else "ChevronRight", options.title or "Details")
		resize()
	end
	local function setExpanded(value: boolean)
		expanded = value
		refresh()
		if options.onToggle then options.onToggle(expanded) end
	end
	toggle.MouseButton1Click:Connect(function() setExpanded(not expanded) end)
	close.MouseButton1Click:Connect(function() setExpanded(false) end)
	scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	refresh()
	return frame, {
		setText = function(value: string) text.Text = value; refresh() end,
		setExpanded = setExpanded,
		isExpanded = function() return expanded end,
	}
end
return Disclosure
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">DockWidget</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / DockWidget
	Builds the dockable ForgePilot window and its navigation shell.

	Structure (a single vertical UIListLayout, no absolute Y offsets):

	    Root
	      Header    - brand, plugin name, assistant name, provider status
	      Nav       - five tabs that always tile the strip, icons-only when narrow
	      Content   - the active page, given whatever height is left over

	Every band sizes itself, so the window reflows when the DockWidget is
	resized instead of colliding at narrow widths.
]]

local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local Theme = require(script.Parent.Parent.Utilities.Theme)

local DockWidget = {}

export type Section = "chat" | "builder" | "history" | "logs" | "settings"

local sectionOrder: { Section } = { "chat", "builder", "history", "logs", "settings" }

DockWidget.SectionOrder = sectionOrder

local sectionMeta: { [Section]: { label: string, icon: string } } = {
	chat = { label = "Chat", icon = "Chat" },
	builder = { label = "Builder", icon = "Builder" },
	history = { label = "History", icon = "History" },
	logs = { label = "Logs", icon = "Logs" },
	settings = { label = "Settings", icon = "Settings" },
}

DockWidget.SectionMeta = sectionMeta

--=============================================================================
-- BUILD
--=============================================================================

function DockWidget.build(plugin: Plugin): PluginGui
	local gui = plugin:CreateDockWidgetPluginGuiAsync(
		"ForgePilotMain",
		DockWidgetPluginGuiInfo.new(
			Enum.InitialDockState.Right,
			false, -- initially enabled
			false, -- override previous state
			440, -- default width
			760, -- default height
			300, -- minimum width
			400 -- minimum height
		)
	)

	gui.Name = "ForgePilot"
	gui.Title = "ForgePilot"
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui:SetAttribute("ForgePilotBrand", "ForgePilot")
	-- DockWidgetPluginGui does not expose ScreenGui.ResetOnSpawn.

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Theme.Colors.Background
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.Parent = gui

	-- Subtle brand gradient behind the header strip.
	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Theme.Colors.Background
	backdrop.BorderSizePixel = 0
	backdrop.ZIndex = 1
	backdrop.Parent = root
	backdrop.ClipsDescendants = true

	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.Size = UDim2.new(1, 0, 0, 220)
	glow.BackgroundTransparency = 1
	Theme.passThrough(glow)
	glow.BorderSizePixel = 0
	glow.Parent = backdrop
	Theme.gradient(
		Theme.withAlpha(Theme.Colors.Highlight, 0.10),
		Theme.withAlpha(Theme.Colors.Highlight, 0)
	).Parent = glow

	-- The window shell: three bands, stacked. Nothing below the nav knows or
	-- cares what the nav's height is.
	local shell = Instance.new("Frame")
	shell.Name = "Shell"
	shell.Size = UDim2.fromScale(1, 1)
	shell.BackgroundTransparency = 1
	Theme.passThrough(shell)
	shell.BorderSizePixel = 0
	shell.Parent = root

	local shellPadding = Instance.new("UIPadding")
	shellPadding.PaddingLeft = UDim.new(0, Theme.Space.SM)
	shellPadding.PaddingRight = UDim.new(0, Theme.Space.SM)
	shellPadding.PaddingTop = UDim.new(0, Theme.Space.SM)
	shellPadding.PaddingBottom = UDim.new(0, Theme.Space.SM)
	shellPadding.Parent = shell

	local shellLayout = Instance.new("UIListLayout")
	shellLayout.SortOrder = Enum.SortOrder.LayoutOrder
	shellLayout.Padding = UDim.new(0, Theme.Space.SM)
	shellLayout.Parent = shell

	-- Header -------------------------------------------------------------
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, Theme.Metrics.HeaderHeight)
	header.BackgroundTransparency = 1
	Theme.passThrough(header)
	header.LayoutOrder = 1
	header.Parent = shell

	-- A horizontal UIListLayout with a flexible text column is what keeps the
	-- plugin name from sliding under the provider pill. The old version sized
	-- the title with `UDim2.new(1, -180, ...)` next to a fixed 150px pill,
	-- which overlapped at EVERY width, not just narrow ones.
	local headerLayout = Instance.new("UIListLayout")
	headerLayout.FillDirection = Enum.FillDirection.Horizontal
	headerLayout.SortOrder = Enum.SortOrder.LayoutOrder
	headerLayout.Padding = UDim.new(0, Theme.Space.SM)
	headerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	headerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	headerLayout.Parent = header

	local markSlot = Instance.new("Frame")
	markSlot.Name = "MarkSlot"
	markSlot.Size = UDim2.fromOffset(26, 26)
	markSlot.BackgroundTransparency = 1
	Theme.passThrough(markSlot)
	markSlot.LayoutOrder = 1
	markSlot.Parent = header
	Theme.minSize(markSlot, Vector2.new(26, 26)).Parent = markSlot

	local mark = Icons.brandMark(26)
	mark.Name = "BrandMark"
	mark.Parent = markSlot

	local textColumn = Instance.new("Frame")
	textColumn.Name = "Titles"
	textColumn.Size = UDim2.new(0, 0, 0, 36)
	textColumn.BackgroundTransparency = 1
	Theme.passThrough(textColumn)
	textColumn.ClipsDescendants = true
	textColumn.LayoutOrder = 2
	textColumn.Parent = header
	Theme.flexItem(textColumn, 1, 1)
	Theme.minSize(textColumn, Vector2.new(0, 0))

	local textLayout = Instance.new("UIListLayout")
	textLayout.SortOrder = Enum.SortOrder.LayoutOrder
	textLayout.Padding = UDim.new(0, 0)
	textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	textLayout.Parent = textColumn

	local titleLabel = Theme.label("ForgePilot", {
		size = Theme.TextSizes.Title,
		font = Theme.Fonts.Bold,
	})
	titleLabel.Name = "BrandTitle"
	titleLabel.Size = UDim2.new(1, 0, 0, 20)
	titleLabel.LayoutOrder = 1
	titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	titleLabel.ClipsDescendants = true
	titleLabel.Parent = textColumn

	local subtitleLabel = Theme.label("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Extra.Muted,
	})
	subtitleLabel.Name = "BrandSubtitle"
	subtitleLabel.Size = UDim2.new(1, 0, 0, 14)
	subtitleLabel.LayoutOrder = 2
	subtitleLabel.TextTruncate = Enum.TextTruncate.AtEnd
	subtitleLabel.ClipsDescendants = true
	subtitleLabel.Parent = textColumn

	-- Provider status pill ------------------------------------------------
	local statusPill = Instance.new("TextButton")
	statusPill.Name = "ProviderStatus"
	statusPill.Size = UDim2.new(0, 132, 0, 24)
	statusPill.BackgroundColor3 = Theme.Extra.Surface
	statusPill.BorderSizePixel = 0
	statusPill.AutoButtonColor = false
	statusPill.ClipsDescendants = true
	statusPill.Text = ""
	statusPill.TextColor3 = Theme.Extra.Muted
	statusPill.TextSize = Theme.TextSizes.Caption
	statusPill.Font = Theme.Fonts.Medium
	statusPill.TextTruncate = Enum.TextTruncate.AtEnd
	statusPill.LayoutOrder = 3
	statusPill.Parent = header
	Theme.flexItem(statusPill, 0, 0)
	Theme.corner(12).Parent = statusPill
	local pillStroke = Theme.stroke(Theme.Extra.Border)
	pillStroke.Parent = statusPill

	local pillLayout = Instance.new("UIListLayout")
	pillLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pillLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	pillLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	pillLayout.Parent = statusPill

	local pillLabel = Theme.label("No AI Provider", {
		size = Theme.TextSizes.Caption,
		color = Theme.Extra.Muted,
		font = Theme.Fonts.Medium,
		alignX = Enum.TextXAlignment.Center,
	})
	pillLabel.Name = "Text"
	pillLabel.AutomaticSize = Enum.AutomaticSize.None
	pillLabel.Size = UDim2.new(1, -8, 1, 0)
	pillLabel.ClipsDescendants = true
	pillLabel.TextTruncate = Enum.TextTruncate.AtEnd
	pillLabel.Parent = statusPill
	-- Shares whatever room the pill has and truncates, instead of running out
	-- through the right-hand edge at narrow widths.
	Theme.flexItem(pillLabel, 1, 1)

	-- Navigation ---------------------------------------------------------
	local nav = Instance.new("Frame")
	nav.Name = "Nav"
	nav.Size = UDim2.new(1, 0, 0, Theme.Metrics.NavHeight)
	nav.BackgroundTransparency = 1
	Theme.passThrough(nav)
	nav.LayoutOrder = 2
	nav.Parent = shell

	local navBackground = Instance.new("Frame")
	navBackground.Name = "Track"
	navBackground.Size = UDim2.fromScale(1, 1)
	navBackground.BackgroundColor3 = Theme.Extra.Surface
	navBackground.BorderSizePixel = 0
	navBackground.Parent = nav
	Theme.corner(Theme.Metrics.Radius).Parent = navBackground

	local trackLayout = Instance.new("UIListLayout")
	trackLayout.FillDirection = Enum.FillDirection.Horizontal
	trackLayout.SortOrder = Enum.SortOrder.LayoutOrder
	trackLayout.Padding = UDim.new(0, Theme.Space.XS)
	trackLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	trackLayout.Parent = navBackground
	Theme.padding(3).Parent = navBackground

	local tabButtons: { [Section]: TextButton } = {}
	local tabIcons: { [Section]: TextLabel } = {}
	local tabLabels: { [Section]: TextLabel } = {}

	for index, section in DockWidget.SectionOrder do
		local meta = DockWidget.SectionMeta[section]
		local button = Theme.textButton("", {
			height = Theme.Metrics.NavHeight - 6,
			radius = Theme.Metrics.RadiusSmall,
			color = Theme.Extra.Surface,
			font = Theme.Fonts.Medium,
		})
		button.Name = "Tab_" .. section
		button.LayoutOrder = index
		button.AutoButtonColor = false
		button.BackgroundTransparency = 1
		button.Text = ""
		-- Equal custom grow ratios make the five tabs share the strip, so they can
		-- never overlap or spill past the edge no matter how narrow it gets.
		button.Size = UDim2.new(0, 0, 1, 0)
		Theme.flexItem(button, 1, 1)
		Theme.minSize(button, Vector2.new(0, Theme.Metrics.NavHeight - 6))
		button.ClipsDescendants = true

		local buttonLayout = Instance.new("UIListLayout")
		buttonLayout.FillDirection = Enum.FillDirection.Horizontal
		buttonLayout.SortOrder = Enum.SortOrder.LayoutOrder
		buttonLayout.Padding = UDim.new(0, Theme.Space.XS)
		buttonLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		buttonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		buttonLayout.Parent = button
		Theme.padding4(0, Theme.Space.XS, 0, Theme.Space.XS).Parent = button

		local icon = Icons.glyph(meta.icon, 14, Theme.Colors.SecondaryText)
		icon.Name = "Icon"
		icon.Size = UDim2.fromOffset(16, 16)
		icon.LayoutOrder = 1
		icon.Parent = button

		local text = Theme.label(meta.label, {
			size = Theme.TextSizes.Small,
			font = Theme.Fonts.Medium,
			color = Theme.Colors.SecondaryText,
			alignX = Enum.TextXAlignment.Left,
		})
		text.Name = "Label"
		text.Size = UDim2.new(0, 0, 1, 0)
		text.AutomaticSize = Enum.AutomaticSize.X
		text.LayoutOrder = 2
		text.TextTruncate = Enum.TextTruncate.AtEnd
		text.ClipsDescendants = true
		text.Parent = button

		button.Parent = navBackground
		tabButtons[section] = button
		tabIcons[section] = icon
		tabLabels[section] = text
	end

	-- Content host -------------------------------------------------------
	-- The only element with a percentage height: it takes whatever the header
	-- and navigation left behind, at every window size.
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.new(1, 0, 0, 0)
	content.BackgroundTransparency = 1
	Theme.passThrough(content)
	content.ClipsDescendants = true
	content.LayoutOrder = 3
	content.Parent = shell
	-- A flex item in the shell's vertical list: the page claims whatever height
	-- the header and navigation did not use, at every window height. No magic
	-- "102" constant, and nothing to go stale when the header wraps.
	Theme.flexItem(content, 1, 1)

	-- Overlay layer ------------------------------------------------------
	-- Toasts, dropdown menus and dialogs live here so nothing can clip them.
	Theme.overlayHost(content)

	-- Resize handling ----------------------------------------------------
	local currentSection: Section = "chat"
	local currentBucket: string? = nil

	local function applyWidthRules(width: number)
		local bucket = Theme.bucketFor(width)
		if bucket == currentBucket then
			return
		end
		currentBucket = bucket

		local showLabels = width >= 440
		local showIcons = true
		for _, section in DockWidget.SectionOrder do
			local label = tabLabels[section]
			if label then
				label.Visible = showLabels
				label.AutomaticSize = if showLabels then Enum.AutomaticSize.X else Enum.AutomaticSize.None
				label.Size = UDim2.new(0, 0, 1, 0)
				label.TextXAlignment = Enum.TextXAlignment.Left
			end
			tabIcons[section].Visible = showIcons
			Theme.flexItem(tabButtons[section], 1, 1)
		end

		-- A narrower window needs less chrome around the status pill.
		statusPill.Size = UDim2.new(0, if bucket == "compact" then 96 else 132, 0, 24)
		textColumn.Size = UDim2.new(0, 0, 0, 36)
	end

	local function setSection(section: Section, notify: boolean?)
		if not sectionMeta[section] then return end
		currentSection = section
		for _, other in DockWidget.SectionOrder do
			local active = other == section
			local button = tabButtons[other]
			Theme.tween(button, {
				BackgroundTransparency = if active then 0 else 1,
				BackgroundColor3 = Theme.Extra.SurfaceHover,
			}, Theme.Motion.Fast):Play()
			local label = tabLabels[other]
			if label then
				Theme.tween(label, {
					TextColor3 = if active then Theme.Colors.MainText else Theme.Colors.SecondaryText,
				}, Theme.Motion.Fast):Play()
			end
			tabIcons[other].TextColor3 = if active then Theme.Colors.Highlight else Theme.Extra.Muted
		end
		if notify ~= false then EventBus.emit(EventBus.Events.Navigate, { section = section }) end
	end

	for _, section in DockWidget.SectionOrder do
		local captured = section
		tabButtons[section].MouseButton1Click:Connect(function()
			setSection(captured)
		end)
		tabButtons[section].MouseEnter:Connect(function()
			Theme.tween(tabButtons[section], { BackgroundColor3 = Theme.Extra.SurfaceHover }, Theme.Motion.Fast):Play()
		end)
		tabButtons[section].MouseLeave:Connect(function()
			Theme.tween(tabButtons[section], {
				BackgroundColor3 = Theme.Extra.SurfaceHover,
				BackgroundTransparency = if currentSection == section then 0 else 1,
			}, Theme.Motion.Fast):Play()
		end)
	end

	statusPill.MouseButton1Click:Connect(function()
		setSection("settings")
	end)

	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyWidthRules(root.AbsoluteSize.X)
	end)

	applyWidthRules(420)

	-- Public surface -----------------------------------------------------
	gui:SetAttribute("ForgePilotWidget", true)
	DockWidget.root = root
	DockWidget.content = content
	DockWidget.statusPill = statusPill
	DockWidget.subtitleLabel = subtitleLabel
	DockWidget.header = header
	DockWidget.nav = nav
	DockWidget.overlay = content:FindFirstChild("OverlayLayer")

	function DockWidget.setStatus(text: string, color: Color3)
		statusPill.Text = ""
		statusPill.TextColor3 = color
		pillLabel.Text = text
		pillLabel.TextColor3 = color
		pillStroke.Color = Theme.withAlpha(color, 0.4)
	end

	function DockWidget.setSubtitle(text: string)
		subtitleLabel.Text = text
	end

	function DockWidget.getSection(): Section
		return currentSection
	end

	function DockWidget.navigate(section: Section)
		setSection(section)
	end

	local unsubscribe = EventBus.on(EventBus.Events.Navigate, function(payload)
		if sectionMeta[payload.section] then setSection(payload.section, false) end
	end)
	gui.Destroying:Connect(unsubscribe)
	setSection("chat")

	return gui
end

return DockWidget
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">HistoryView</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / HistoryView
	Conversation list with new/rename/delete plus full-text message search.
]]

local Components = require(script.Parent.Components)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local SessionManager = require(script.Parent.Parent.Core.SessionManager)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)

local HistoryView = {}

function HistoryView.build(parent: GuiObject): Frame
	local view = Instance.new("Frame")
	view.Name = "HistoryView"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	Theme.passThrough(view)
	view.Parent = parent

	-- Toolbar -------------------------------------------------------------
	local toolbar = Instance.new("Frame")
	toolbar.Name = "Toolbar"
	toolbar.Size = UDim2.new(1, 0, 0, 30)
	toolbar.BackgroundTransparency = 1
	Theme.passThrough(toolbar)
	toolbar.Parent = view

	local newButton = Theme.textButton("New chat", { accent = true })
	newButton.Name = "NewChat"
	newButton.AnchorPoint = Vector2.new(1, 0)
	newButton.Position = UDim2.new(1, 0, 0, 0)
	newButton.Size = UDim2.fromOffset(108, 26)
	newButton.Parent = toolbar
	Icons.setButton(newButton, "Plus", "New chat")

	local searchBox = Theme.input("Search messages…")
	searchBox.Name = "Search"
	searchBox.Size = UDim2.new(1, -116, 0, 26)
	searchBox.Position = UDim2.fromOffset(0, 2)
	searchBox.TextSize = Theme.TextSizes.Small
	searchBox.Parent = toolbar

	-- Body ---------------------------------------------------------------
	local body = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	body.Name = "Body"
	body.Size = UDim2.new(1, 0, 1, -40)
	body.Position = UDim2.fromOffset(0, 40)
	body.BackgroundTransparency = 1
	Theme.passThrough(body)
	body.Parent = view
	Theme.padding(2).Parent = body
	Theme.listLayout(4).Parent = body

	local conversationList = Instance.new("Frame")
	conversationList.Name = "Conversations"
	conversationList.Size = UDim2.new(1, 0, 0, 0)
	conversationList.AutomaticSize = Enum.AutomaticSize.Y
	conversationList.BackgroundTransparency = 1
	Theme.passThrough(conversationList)
	conversationList.LayoutOrder = 1
	conversationList.Parent = body
	Theme.listLayout(4).Parent = conversationList

	local searchResults = Instance.new("Frame")
	searchResults.Name = "SearchResults"
	searchResults.Size = UDim2.new(1, 0, 0, 0)
	searchResults.AutomaticSize = Enum.AutomaticSize.Y
	searchResults.BackgroundTransparency = 1
	Theme.passThrough(searchResults)
	searchResults.LayoutOrder = 2
	searchResults.Visible = false
	searchResults.Parent = body
	Theme.listLayout(4).Parent = searchResults

	-- Rows ----------------------------------------------------------------
	local function IconButtonAt(xOffset: number, iconKey: string, parent: Instance, callback: any): TextButton
		local button = Instance.new("TextButton")
		button.Name = "IconButton"
		button.AnchorPoint = Vector2.new(1, 0)
		button.Position = UDim2.new(1, -(if iconKey == "Edit" then 26 else 4), 0, 13)
		button.Size = UDim2.fromOffset(18, 18)
		button.BackgroundTransparency = 1
		Icons.setButton(button, iconKey)
		button.TextColor3 = Theme.Extra.Muted
		button.TextSize = 12
		button.Parent = parent
		button.MouseButton1Click:Connect(callback)
		return button
	end

	local function makeRow(title: string, subtitle: string, order: number, onClick: any, onRename: any?, onDelete: any?)
		local row = Instance.new("TextButton")
		row.Name = "Row"
		row.LayoutOrder = order
		row.Size = UDim2.new(1, 0, 0, 42)
		row.BackgroundColor3 = Theme.Extra.Surface
		row.BorderSizePixel = 0
		row.Text = ""
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.AutoButtonColor = false
		row.Parent = nil
		Theme.corner(Theme.Metrics.RadiusSmall).Parent = row

		local titleLabel = Theme.label(title, {
			size = Theme.TextSizes.Small,
			font = Theme.Fonts.Medium,
			truncate = true,
		})
		titleLabel.Name = "Title"
		titleLabel.Position = UDim2.fromOffset(30, 5)
		titleLabel.Size = UDim2.new(1, -70, 0, 16)
		titleLabel.Parent = row

		local subtitleLabel = Theme.label(subtitle, {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
			truncate = true,
		})
		subtitleLabel.Name = "Subtitle"
		subtitleLabel.Position = UDim2.fromOffset(30, 22)
		subtitleLabel.Size = UDim2.new(1, -70, 0, 14)
		subtitleLabel.Parent = row

		local icon = Icons.glyph("Chat", 13, Theme.Extra.Muted)
		icon.Name = "Icon"
		icon.Size = UDim2.fromOffset(15, 15)
		icon.Position = UDim2.fromOffset(9, 13)
		icon.Parent = row

		if onRename then
			local renameButton = IconButtonAt(1, "Edit", row, onRename)
			renameButton.Name = "Rename"
		end
		if onDelete then
			local deleteButton = IconButtonAt(1, "Trash", row, onDelete)
			deleteButton.Name = "Delete"
		end

		row.MouseButton1Click:Connect(onClick)
		row.MouseEnter:Connect(function()
			Theme.tween(row, { BackgroundColor3 = Theme.Extra.SurfaceHover }, Theme.Motion.Fast):Play()
		end)
		row.MouseLeave:Connect(function()
			Theme.tween(row, { BackgroundColor3 = Theme.Extra.Surface }, Theme.Motion.Fast):Play()
		end)
		return row
	end

	-- Rendering -----------------------------------------------------------
	local function renderConversations()
		for _, child in conversationList:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		local conversations = SessionManager.getConversations()
		local activeId = SessionManager.getActiveId()

		if #conversations == 0 then
			local empty = Components.emptyState("History", "No conversations yet", "Start a chat and it will appear here.")
			empty.Parent = conversationList
			return
		end

		for index, conversation in conversations do
			local subtitle = string.format(
				"%d message%s · %s%s",
				#conversation.messages,
				if #conversation.messages == 1 then "" else "s",
				Time.formatDuration(os.time() - conversation.updatedAt) .. " ago",
				if conversation.model then (" · " .. conversation.model) else ""
			)
			local row = makeRow(conversation.title, subtitle, index, function()
				SessionManager.setActive(conversation.id)
			end, function()
				HistoryView.promptRename(view, conversation.id)
			end, function()
				SessionManager.deleteConversation(conversation.id)
				renderConversations()
			end)
			if conversation.id == activeId then
				row.BackgroundColor3 = Theme.withAlpha(Theme.Colors.Highlight, 0.16)
			end
			row.Parent = conversationList
		end
	end

	local function renderSearch(query: string)
		for _, child in searchResults:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		local query2 = StringUtil.trim(query)
		if #query2 < 2 then
			searchResults.Visible = false
			conversationList.Visible = true
			return
		end

		searchResults.Visible = true
		conversationList.Visible = false

		local results = SessionManager.search(query2, 60)
		if #results == 0 then
			local empty = Components.emptyState("Search", "No matches", string.format('Nothing matches "%s".', query2))
			empty.Parent = searchResults
			return
		end

		for index, result in results do
			local preview = string.gsub(StringUtil.trim(result.message.content), "%s+", " ")
			preview = string.sub(preview, 1, 110)
			local row = makeRow(
				string.sub(result.conversation.title, 1, 42),
				preview,
				index,
				function()
					SessionManager.setActive(result.conversation.id)
					EventBus.emit(EventBus.Events.Toast, {
						kind = "info",
						message = string.format("Opened \"%s\".", result.conversation.title),
					})
				end
			)
			row.Parent = searchResults
		end
	end

	-- Behaviour -----------------------------------------------------------
	newButton.MouseButton1Click:Connect(function()
		SessionManager.createConversation({ mode = SettingsManager.getValue("defaultMode") })
		EventBus.emit(EventBus.Events.Toast, { kind = "success", message = "New chat created." })
		renderConversations()
	end)

	local debounce: thread? = nil
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if debounce then
			task.cancel(debounce)
		end
		local snapshot = searchBox.Text
		debounce = task.spawn(function()
			task.wait(0.2)
			renderSearch(snapshot)
		end)
	end)

	local disconnect = EventBus.on(EventBus.Events.ConversationListChanged, function()
		renderConversations()
	end)

	-- Roblox Instances reject new members ("x is not a valid member of Frame"),
	-- so the view's API lives on a plain table returned alongside the frame.
	-- ChatInput, ThinkingIndicator and TokenMeter already use this shape.
	local api: { [string]: any } = {
		render = renderConversations,
		search = renderSearch,
		destroy = function()
			disconnect()
			if debounce then
				task.cancel(debounce)
			end
		end,
	}

	renderConversations()
	return view, api
end

--- Inline rename using a temporary TextBox over the title.
function HistoryView.promptRename(parent: GuiObject, conversationId: string)
	local conversation = SessionManager.getConversation(conversationId)
	if not conversation then
		return
	end

	local dialog = Instance.new("Frame")
	dialog.Name = "RenameDialog"
	dialog.AnchorPoint = Vector2.new(0.5, 0.5)
	dialog.Position = UDim2.fromScale(0.5, 0.5)
	dialog.Size = UDim2.fromOffset(280, 120)
	dialog.BackgroundColor3 = Theme.Extra.SurfaceRaised
	dialog.BorderSizePixel = 0
	dialog.ZIndex = 80
	dialog.Parent = parent
	Theme.corner(Theme.Metrics.Radius).Parent = dialog
	Theme.stroke(Theme.Extra.BorderStrong).Parent = dialog
	Theme.padding(14).Parent = dialog

	local label = Theme.label("Conversation name", {
		size = Theme.TextSizes.Small,
		color = Theme.Colors.SecondaryText,
	})
	label.Size = UDim2.new(1, 0, 0, 18)
	label.Parent = dialog

	local box = Theme.input(conversation.title)
	box.Name = "Input"
	box.Text = conversation.title
	box.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
	box.Position = UDim2.fromOffset(0, 24)
	box.Parent = dialog

	local buttons = Instance.new("Frame")
	buttons.Size = UDim2.new(1, 0, 0, 28)
	buttons.Position = UDim2.fromOffset(0, 66)
	buttons.BackgroundTransparency = 1
	Theme.passThrough(buttons)
	buttons.Parent = dialog
	local buttonsLayout = Instance.new("UIListLayout")
	buttonsLayout.FillDirection = Enum.FillDirection.Horizontal
	buttonsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	buttonsLayout.Padding = UDim.new(0, 8)
	buttonsLayout.Parent = buttons

	local confirmButton = Components.textButton("Rename", { accent = true, order = 1 })
	confirmButton.Parent = buttons
	local cancelButton = Components.textButton("Cancel", { order = 2 })
	cancelButton.Parent = buttons

	local function close()
		dialog:Destroy()
	end

	confirmButton.MouseButton1Click:Connect(function()
		SessionManager.renameConversation(conversationId, box.Text)
		close()
	end)
	cancelButton.MouseButton1Click:Connect(close)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			SessionManager.renameConversation(conversationId, box.Text)
			close()
		end
	end)

	box:CaptureFocus()
end

return HistoryView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">MessageRenderer</string>
          <string name="Source"><![CDATA[--!strict
-- A message owns its layout and returns a separate controller table.
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local Components = require(script.Parent.Components)
local Disclosure = require(script.Parent.Disclosure)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)

local MessageRenderer = {}
export type Block = { kind: "text" | "code", content: string, language: string? }
export type RenderOptions = {
	onCopy: ((string) -> ())?, onRegenerate: ((string) -> ())?,
	onEdit: ((string) -> ())?, onRetry: ((string) -> ())?,
	onSwitchToBuild: ((string) -> ())?, onPlanAction: ((string, string) -> ())?,
	onToolExpand: ((string) -> ())?,
}

function MessageRenderer.escapeRichText(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function MessageRenderer.formatInline(text: string): string
	local code: { string } = {}
	local escaped = MessageRenderer.escapeRichText(text)
	escaped = escaped:gsub("`([^`]+)`", function(value)
		code[#code + 1] = '<font face="Code" color="#C6B2F5">' .. value .. '</font>'
		return "\1" .. #code .. "\2"
	end)
	escaped = escaped:gsub("%*%*([^*]+)%*%*", "<b>%1</b>"):gsub("%*([^*]+)%*", "<i>%1</i>")
	return (escaped:gsub("\1(%d+)\2", function(index) return code[tonumber(index) :: number] end))
end

function MessageRenderer.parseBlocks(source: string): { Block }
	local blocks: { Block } = {}
	local cursor = 1
	while cursor <= #source do
		local first = source:find("```", cursor, true)
		if not first then
			blocks[#blocks + 1] = { kind = "text", content = source:sub(cursor) }
			break
		end
		if first > cursor then blocks[#blocks + 1] = { kind = "text", content = source:sub(cursor, first - 1) } end
		local newline = source:find("\n", first + 3, true)
		if not newline then
			blocks[#blocks + 1] = { kind = "text", content = source:sub(first) }
			break
		end
		local last = source:find("```", newline + 1, true)
		local language = source:sub(first + 3, newline - 1):gsub("%s", "")
		blocks[#blocks + 1] = {
			kind = "code", language = if language == "" then "text" else language,
			content = source:sub(newline + 1, if last then last - 1 else #source):gsub("\n$", ""),
		}
		cursor = if last then last + 3 else #source + 1
	end
	return blocks
end

local function column(name: string, parent: Instance?, gap: number?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.BorderSizePixel = 0
	Theme.passThrough(frame)
	Theme.listLayout(gap or 8).Parent = frame
	frame.Parent = parent
	return frame
end

local function clear(frame: Frame)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then child:Destroy() end
	end
end

local function codeBlock(parent: Frame, block: Block, opts: RenderOptions, order: number)
	local card = column("CodeBlock", parent, 0)
	card.LayoutOrder = order
	card.BackgroundTransparency = 0
	card.BackgroundColor3 = Theme.Extra.Overlay
	Theme.corner(8).Parent = card
	Theme.stroke(Theme.Extra.Border).Parent = card
	Theme.padding(10).Parent = card
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 28)
	Theme.passThrough(header)
	header.LayoutOrder = 1
	header.Parent = card
	local language = Theme.label(block.language or "code", { size = 11, color = Theme.Extra.Muted, font = Theme.Fonts.Mono })
	language.Size = UDim2.new(1, -58, 1, 0)
	language.TextTruncate = Enum.TextTruncate.AtEnd
	language.Parent = header
	local copy = Theme.textButton("Copy", { height = 24, width = UDim2.fromOffset(50, 24) })
	copy.Name = "CopyCode"
	copy.BackgroundTransparency = 1
	copy.AnchorPoint = Vector2.new(1, 0)
	copy.Position = UDim2.new(1, 0, 0, 0)
	copy.TextSize = 11
	copy.Parent = header
	copy.MouseButton1Click:Connect(function() if opts.onCopy then opts.onCopy(block.content) end end)
	local bounds = TextService:GetTextSize(block.content, 12, Theme.Fonts.Code, Vector2.new(1000000, 1000000))
	local scroll = Theme.scrollingFrame({ scrollingDirection = Enum.ScrollingDirection.XY })
	scroll.Name = "CodeScroll"
	scroll.LayoutOrder = 2
	scroll.Size = UDim2.new(1, 0, 0, math.clamp(bounds.Y + 14, 34, 240))
	scroll.CanvasSize = UDim2.fromOffset(bounds.X + 14, bounds.Y + 14)
	scroll.Active = true
	scroll.Parent = card
	local code = Theme.label(block.content, { size = 12, font = Theme.Fonts.Code, alignY = Enum.TextYAlignment.Top })
	code.Name = "Code"
	code.Size = UDim2.fromOffset(bounds.X + 8, bounds.Y + 8)
	code.Position = UDim2.fromOffset(0, 2)
	code.RichText = false
	code.Parent = scroll
end

local function renderParagraph(content: string): string
	local lines = {}
	for line in (content .. "\n"):gmatch("(.-)\n") do
		local heading = line:match("^#+%s+(.+)")
		local bullet = line:match("^%s*[-*]%s+(.+)")
		lines[#lines + 1] = if heading then "<b>" .. MessageRenderer.formatInline(heading) .. "</b>"
			elseif bullet then "\u{2022}  " .. MessageRenderer.formatInline(bullet)
			else MessageRenderer.formatInline(line)
	end
	return (table.concat(lines, "\n"):gsub("^%s+", ""):gsub("%s+$", ""))
end

function MessageRenderer.render(message: any, options: RenderOptions?): (Frame, any)
	local opts = options or {}
	local isUser = message.role == "user"
	local isTool = message.role == "tool"
	local container = column("Message_" .. message.id, nil, 0)
	container.LayoutOrder = message.layoutOrder or 0
	local bubble = column("Bubble", container, 10)
	Theme.padding4(12, 12, 12, 12).Parent = bubble
	if isUser or isTool then
		bubble.BackgroundTransparency = 0
		bubble.BackgroundColor3 = if isUser then Theme.Colors.Accent else Theme.Extra.Surface
		Theme.corner(12).Parent = bubble
	end
	if isTool then
		local toolName = message.toolName or (message.content or ""):match("^%[([^%]]+)%]") or "Tool result"
		local iconKey = if toolName == "web_search" then "Search" elseif toolName == "web_fetch" then "Globe" elseif toolName == "view_image" then "Image" elseif toolName == "run_command" then "Terminal" else "Tool"
		local disclosure = Disclosure.build(bubble, {
			name = "ToolResult", title = "Tool result · " .. toolName, icon = iconKey,
			text = Redact.scrubText(message.content or ""), preview = true,
			onCopy = opts.onCopy, onToggle = function() if opts.onToolExpand then opts.onToolExpand(message.id) end end,
		})
		disclosure.LayoutOrder = 1
		return container, { appendDelta = function() end, destroy = function() end }
	end
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 22)
	Theme.passThrough(header)
	header.LayoutOrder = 1
	header.Parent = bubble
	local role = Theme.label(if isUser then "You" elseif isTool then "Tool result" else SettingsManager.getValue("assistantName") or "ForgePilot", {
		size = 12, font = Theme.Fonts.Bold, color = if isUser then Theme.Colors.SecondaryText else Theme.Colors.MainText,
	})
	role.Name = "Role"
	role.Size = UDim2.new(1, -64, 1, 0)
	role.TextTruncate = Enum.TextTruncate.AtEnd
	role.Parent = header
	local meta = Theme.label(if message.streaming then "Writing…" elseif message.elapsedMs then Time.formatDuration(message.elapsedMs / 1000) else "", {
		size = 11, color = Theme.Extra.Muted, alignX = Enum.TextXAlignment.Right,
	})
	meta.Name = "Meta"
	meta.Size = UDim2.fromOffset(62, 22)
	meta.AnchorPoint = Vector2.new(1, 0)
	meta.Position = UDim2.fromScale(1, 0)
	meta.Parent = header
	if message.attachments and #message.attachments > 0 then
		local chips = column("Attachments", bubble, 4)
		chips.LayoutOrder = 2
		for index, attachment in message.attachments do
			local chip = Theme.label(attachment.name .. " · " .. Time.formatBytes(attachment.sizeBytes or 0), { size = 11, color = Theme.Colors.SecondaryText })
			chip.Name = "Attachment"
			chip.LayoutOrder = index
			chip.Size = UDim2.new(1, 0, 0, 22)
			chip.TextTruncate = Enum.TextTruncate.AtEnd
			chip.Parent = chips
		end
	end
	local body = column("Body", bubble, 10)
	body.LayoutOrder = 3
	local live = Theme.autoText(message.content or "", { size = Theme.TextSizes.Body, color = Theme.Colors.MainText })
	live.Name = "Live"
	live.Visible = message.streaming == true
	live.RichText = false
	live.Parent = body
    local reasoningRow, reasoningDetails = Disclosure.build(bubble, {
        name = "LiveReasoning", title = "Thinking", icon = "Thinking", text = message.reasoning or "",
        textName = "ReasoningText", expanded = message.streaming == true,
        font = Theme.Fonts.Regular, onCopy = opts.onCopy,
    })
    reasoningRow.LayoutOrder = 2
    reasoningRow.Visible = #(message.reasoning or "") > 0
	local source = message.content or ""
    local reasoningSource = message.reasoning or ""
	local streaming = message.streaming == true
	local disposed = false
	local function flush()
		if not disposed then live.Text = source end
	end
	local function renderBody()
		clear(body)
		for index, block in MessageRenderer.parseBlocks(source) do
			if block.kind == "code" then
				codeBlock(body, block, opts, index)
			elseif block.content:match("%S") then
				local label = Theme.autoText(renderParagraph(block.content), { size = Theme.TextSizes.Body, color = Theme.Colors.MainText, rich = true })
				label.Name = "Block"
				label.LayoutOrder = index
				label.Parent = body
			end
		end
	end
	if not streaming then renderBody() end
	if message.toolCalls and #message.toolCalls > 0 then
		local tools = column("ToolCalls", bubble, 6)
		tools.LayoutOrder = 4
		for index, call in message.toolCalls do
			local ok, encoded = pcall(function() return HttpService:JSONEncode(call.arguments or {}) end)
			local text = Redact.scrubText((if ok then encoded else "{}") .. (if call.result then "\n" .. tostring(call.result) else ""))
			local row = Disclosure.build(tools, {
				name = "ToolCall", title = tostring(call.name or "Tool") .. " · " .. tostring(call.state or "requested"),
				icon = if call.name == "web_search" then "Search" elseif call.name == "web_fetch" then "Globe" else "Tool",
				text = text, textSize = 11, onCopy = opts.onCopy,
				onToggle = function() if opts.onToolExpand then opts.onToolExpand(message.id) end end,
			})
			row.LayoutOrder = index
		end
	end
	if message.error then
		local label = Theme.autoText(message.error, { color = Theme.Colors.Error, size = 12 })
		label.Name = "Error"
		label.LayoutOrder = 5
		label.Parent = bubble
	end
	local details = column("Details", bubble, 6)
	details.LayoutOrder = 7
	details.Visible = false
	local facts = {}
	if message.model then facts[#facts + 1] = "Model · " .. message.model end
	if message.usage then
		facts[#facts + 1] = string.format("Tokens · %s in / %s out", tostring(message.usage.input or "~"), tostring(message.usage.output or "~"))
	end
	if #facts > 0 then
		local info = Theme.autoText(table.concat(facts, "\n"), { size = 11 })
		info.LayoutOrder = 1
		info.Parent = details
	end
	if message.reasoning and #message.reasoning > 0 then
		local reasoning = Theme.autoText(message.reasoning, { size = 12 })
		reasoning.Name = "Reasoning"
		reasoning.LayoutOrder = 2
		reasoning.Parent = details
	end
	if not isTool then
		local actions = Instance.new("Frame")
		actions.Name = "Actions"
		actions.Size = UDim2.new(1, 0, 0, 24)
		Theme.passThrough(actions)
		actions.LayoutOrder = 6
		actions.Visible = not streaming
		actions.Parent = bubble
		local layout = Theme.listLayout(8, Enum.FillDirection.Horizontal)
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Parent = actions
		local function action(text: string, order: number, callback: () -> ())
			local button = Theme.textButton(text, { height = 24, width = UDim2.fromOffset(68, 24) })
			button.Name = "Action_" .. text
			button.BackgroundTransparency = 1
			button.TextColor3 = Theme.Extra.Muted
			button.TextSize = 11
			button.LayoutOrder = order
			button.Parent = actions
			button.MouseButton1Click:Connect(callback)
		end
		action("Copy", 1, function() if opts.onCopy then opts.onCopy(message.content or source) end end)
		if isUser then
			action("Edit", 2, function() if opts.onEdit then opts.onEdit(message.id) end end)
		elseif message.error then
			action("Retry", 2, function() if opts.onRetry then opts.onRetry(message.id) end end)
		else
			action("Regenerate", 2, function() if opts.onRegenerate then opts.onRegenerate(message.id) end end)
		end
		if #facts > 0 or message.reasoning then action("Details", 3, function() details.Visible = not details.Visible end) end
		if message.plan and not streaming then
			local row, add = Components.buttonRow({ columns = 2, order = 8, padding = 6 })
			row.Name = "PlanActions"
			row.Parent = bubble
			add("Build this plan", { accent = true, order = 1 }).MouseButton1Click:Connect(function()
				if opts.onSwitchToBuild then opts.onSwitchToBuild(message.id) end
			end)
			add("Revise plan", { order = 2 }).MouseButton1Click:Connect(function()
				if opts.onPlanAction then opts.onPlanAction(message.id, "revise") end
			end)
		end
	end
	container.Destroying:Connect(function() disposed = true end)
	return container, {
		appendDelta = function(delta: string, channel: string?)
			if disposed or not streaming then return end
            if channel == "reasoning" then
                reasoningSource ..= delta; reasoningDetails.setText(reasoningSource); reasoningRow.Visible = true; meta.Text = "Thinking…"
            else
			    source ..= delta
			    flush(); meta.Text = "Writing…"
            end
		end,
		destroy = function() disposed = true end,
	}
end

return MessageRenderer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">ProviderView</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
--[[
    ForgePilot / UI / ProviderView
    A searchable provider catalog and a focused editor with Connection, Model,
    Advanced and Tests pages. Save/test controls remain outside the scroll area.
    Profiles contain no secrets; API keys live only in CredentialStore.
]]

local BaseURLResolver = require(script.Parent.Parent.AI.BaseURLResolver)
local CapabilityInspector = require(script.Parent.Parent.AI.CapabilityInspector)
local Components = require(script.Parent.Components)
local ContextManager = require(script.Parent.Parent.AI.ContextManager)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local CustomProviderManager = require(script.Parent.Parent.AI.CustomProviderManager)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ProtocolDetector = require(script.Parent.Parent.AI.ProtocolDetector)
local ProviderService = require(script.Parent.Parent.AI.ProviderService)
local RetryDelayCalculator = require(script.Parent.Parent.AI.RetryDelayCalculator)
local RetryLogger = require(script.Parent.Parent.Utilities.RetryLogger)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local SmartRetrySettings = require(script.Parent.Parent.Core.SmartRetrySettings)
local StreamingManager = require(script.Parent.Parent.AI.StreamingManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)
local UniversalHTTPClient = require(script.Parent.Parent.Utilities.UniversalHTTPClient)
local UniversalProviderRegistry = require(script.Parent.Parent.AI.UniversalProviderRegistry)

local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local ProviderLogo = require(script.Parent.Parent.Utilities.ProviderLogo)
local ProviderView = {}

CustomProviderManager.setCredentialClear(CredentialStore.clear)

--=============================================================================
-- OPTION LISTS
--=============================================================================

local PROVIDER_TYPE_OPTIONS = {
	{ label = "OpenAI", value = "openai" },
	{ label = "OpenRouter", value = "openrouter" },
	{ label = "Anthropic", value = "anthropic" },
	{ label = "Gemini", value = "gemini" },
	{ label = "OpenAI-Compatible", value = "openai_compatible" },
	{ label = "Custom REST", value = "custom_rest" },
}

local PROTOCOL_OPTIONS = {
	{ label = "Chat Completions", value = "openai_chat" },
	{ label = "Text Completions (Legacy)", value = "openai_text_completions" },
	{ label = "Responses API", value = "openai_responses" },
	{ label = "OpenRouter Chat", value = "openrouter" },
	{ label = "Anthropic Messages", value = "anthropic_messages" },
	{ label = "Gemini Native", value = "gemini_native" },
	{ label = "Gemini (OpenAI surface)", value = "gemini_openai" },
	{ label = "Custom REST", value = "custom_rest" },
}

local AUTH_OPTIONS = {
	{ label = "Authorization: Bearer KEY", value = "bearer" },
	{ label = "x-api-key header", value = "header" },
	{ label = "Query parameter", value = "query" },
	{ label = "Custom header", value = "custom" },
	{ label = "No authentication", value = "none" },
}

local function labelsOf(list: { { label: string, value: string } }): { string }
	local out = {}
	for index, entry in list do
		out[index] = entry.label
	end
	return out
end

local function valueOf(list: { { label: string, value: string } }, label: string?): string?
	for _, entry in list do
		if entry.label == label then
			return entry.value
		end
	end
	return nil
end

local function labelOf(list: { { label: string, value: string } }, value: any): string?
	for _, entry in list do
		if entry.value == value then
			return entry.label
		end
	end
	return nil
end

--=============================================================================
-- HELPERS
--=============================================================================

--- A labelled field in a section body, in the order the rows are stacked.
local function field(parent: Instance, label: string, order: number, hint: string?): Frame
	local row, _holder = Components.field(label, { hint = hint, order = order })
	row.Parent = parent
	return row
end

--- A dropdown in a section body. Returns (row, setOptions, getSelected).
---
--- The old code built a field, threw it away except for its value holder, and
--- then parented a SECOND whole field into that holder. That is what stacked a
--- second "Preset" / "Provider Type" / "API Protocol" label on top of the first
--- and pushed unrelated controls over the Settings navigation.
local function dropdownField(
	parent: Instance,
	label: string,
	options: { string },
	onSelect: (string) -> (),
	order: number,
	hint: string?
): (Frame, any, any, any)
	local row, setOptions, getSelected, setSelected =
		Components.dropdown(label, options, onSelect, { hint = hint, order = order })
	row.Parent = parent
	return row, setOptions, getSelected, setSelected
end

--- A full-width text input inside a section body.
local function textField(
	parent: Instance,
	label: string,
	placeholder: string,
	order: number,
	hint: string?,
	height: number?,
	multiline: boolean?
): TextBox
	local row, holder = Components.field(label, { hint = hint, order = order })
	row.Parent = parent
	local box = Theme.input(placeholder, { multiLine = multiline })
	box.Name = "Input"
	box.Size = UDim2.new(1, 0, 0, height or Theme.Metrics.InputHeight)
	box.TextTruncate = Enum.TextTruncate.AtEnd
	if multiline then
		box.TextYAlignment = Enum.TextYAlignment.Top
		box.Font = Theme.Fonts.Code
		box.TextSize = Theme.TextSizes.Small
	end
	box.Parent = holder
	return box
end

--- An input sitting inside an existing field's value holder.
local function smallInput(holder: Instance, placeholder: string, multiLine: boolean?, height: number?): TextBox
	local box = Theme.input(placeholder, { multiLine = multiLine })
	box.Name = "Input"
	box.Size = UDim2.new(1, 0, 0, height or Theme.Metrics.InputHeight)
	box.TextTruncate = Enum.TextTruncate.AtEnd
	-- Field holders are a vertical stack, so the input owns the first slot and
	-- anything the caller adds below it (a warning line) comes after.
	box.LayoutOrder = 1
	box.Parent = holder
	return box
end

--=============================================================================
-- BUILD
--=============================================================================

function ProviderView.build(parent: GuiObject): (Frame, any)
	local view = Instance.new("Frame")
	view.Name = "ProviderView"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	Theme.passThrough(view)
	view.Parent = parent

	local draft = table.clone(SettingsManager.getActiveProvider() or UniversalProviderRegistry.newProfile("custom"))
	local busy = false
	local probeBusy = false
	local operation: any = nil
	local destroyed = false
	local editorTab = "Connection"
	local profileActions: { [string]: () -> () } = {}
	local addPreset: (string) -> () = nil :: any
	local showEditor: (any) -> () = nil :: any
	local refreshPreview: () -> () = nil :: any
	local refresh: () -> () = nil :: any
	local syncLimits: () -> () = function() end
	local runCapabilityProbe: () -> () = nil :: any
	local function configureIfActive(report: any?)
		if not StateManager.isBusy() and SettingsManager.getValue("activeProviderId") == draft.id then
			ContextManager.configure(draft, report or CapabilityInspector.buildReport(draft))
		end
	end

	local overview = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	overview.Name = "ProviderOverview"
	overview.BackgroundTransparency = 1
	overview.Parent = view
	Theme.padding4(2, 2, 12, 8).Parent = overview
	Theme.listLayout(12).Parent = overview
	local searchBox = Theme.input("Search providers…")
	searchBox.Name = "ProviderSearch"
	searchBox.LayoutOrder = 0
	searchBox.Parent = overview

	local editor = Instance.new("Frame")
	editor.Name = "ProviderEditor"
	editor.Size = UDim2.fromScale(1, 1)
	Theme.passThrough(editor)
	editor.Visible = false
	editor.ClipsDescendants = true
	editor.Parent = view
	local editorHeader = Instance.new("Frame")
	editorHeader.Name = "EditorHeader"
	editorHeader.Size = UDim2.new(1, 0, 0, 30)
	Theme.passThrough(editorHeader)
	editorHeader.Parent = editor
	local backButton = Components.textButton("← Back")
	backButton.Name = "BackToProviders"
	backButton.Size = UDim2.fromOffset(60, 30)
	backButton.Parent = editorHeader
	local editorTitle = Theme.label("Provider", { size = Theme.TextSizes.Small, font = Theme.Fonts.Medium, truncate = true })
	editorTitle.Name = "ProviderTitle"
	editorTitle.Position = UDim2.fromOffset(70, 0)
	editorTitle.Size = UDim2.new(1, -154, 1, 0)
	editorTitle.Parent = editorHeader
	local menuRow, _, _, setActionLabel = Components.dropdown("Profile actions", {
		"Use for chat", "Duplicate profile", "Disconnect key", "Remove profile",
	}, function(value)
		if not busy and profileActions[value] then profileActions[value]() end
	end, { menuWidth = 194 })
	menuRow.Name = "ProfileActions"
	local menuLabel = menuRow:FindFirstChild("Label")
	if menuLabel then menuLabel:Destroy() end
	menuRow.AutomaticSize = Enum.AutomaticSize.None
	menuRow.Size = UDim2.fromOffset(76, 30)
	menuRow.AnchorPoint = Vector2.new(1, 0)
	menuRow.Position = UDim2.fromScale(1, 0)
	menuRow.Parent = editorHeader
	setActionLabel("More")

	local pages: { [string]: ScrollingFrame } = {}
	for _, name in { "Connection", "Model", "Advanced", "Tests" } do
		local page = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
		page.Name = name .. "Page"
		page.BackgroundTransparency = 1
		page.Visible = name == editorTab
		page.Parent = editor
		Theme.padding4(2, 2, 12, 8).Parent = page
		Theme.listLayout(12).Parent = page
		pages[name] = page
	end
	local tabBar, selectTab = Components.tabBar({ "Connection", "Model", "Advanced", "Tests" }, function(name)
		editorTab = name
		for tab, page in pages do page.Visible = tab == name end
	end)
	tabBar.Name = "ProviderTabs"
	tabBar.Position = UDim2.fromOffset(0, 38)
	tabBar.Parent = editor
	local footer = Instance.new("Frame")
	footer.Name = "ProviderFooter"
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.fromScale(0, 1)
	footer.Size = UDim2.new(1, 0, 0, 64)
	Theme.passThrough(footer)
	footer.Parent = editor
	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.Size = UDim2.new(1, 0, 0, 1)
	divider.BackgroundColor3 = Theme.Extra.Border
	divider.BorderSizePixel = 0
	divider.Parent = footer
	local footerRow, addFooterButton = Components.buttonRow({ padding = 8 })
	footerRow.Name = "FooterActions"
	footerRow.AutomaticSize = Enum.AutomaticSize.None
	footerRow.Position = UDim2.fromOffset(0, 8)
	footerRow.Size = UDim2.new(1, 0, 0, Theme.Metrics.ButtonHeight)
	footerRow.Parent = footer
	local testButton = addFooterButton("Test connection", { order = 1 })
	local saveButton = addFooterButton("Save changes", { accent = true, order = 2 })
	local footerStatus = Theme.label("", { size = Theme.TextSizes.Caption, color = Theme.Extra.Muted, truncate = true })
	footerStatus.Name = "ProviderStatus"
	footerStatus.Position = UDim2.fromOffset(0, 43)
	footerStatus.Size = UDim2.new(1, 0, 0, 18)
	footerStatus.Parent = footer
	local function layoutEditor()
		for _, page in pages do
			page.Position = UDim2.fromOffset(0, 76)
			page.Size = UDim2.new(1, 0, 1, -148)
		end
	end
	layoutEditor()

	local function commit(validateNow: boolean?): (boolean, { any }?)
		if StateManager.isBusy() then
			return false, { { field = "task", message = "Wait for the current task to finish before changing the provider." } }
		end
		if not SettingsManager.getProvider(draft.id) then
			return false, { { field = "profile", message = "Choose or add a provider first." } }
		end
		local ok, errors = CustomProviderManager.save(draft, validateNow ~= true)
		if not ok then
			local first = errors and errors[1]
			EventBus.emit(EventBus.Events.Toast, {
				kind = "error", message = if first then (first.field .. ": " .. first.message) else "The provider could not be saved.",
			})
		end
		return ok, errors
	end
	local function showOverview()
		if busy then return end
		Components.closeMenus()
		editor.Visible = false
		overview.Visible = true
	end
	backButton.MouseButton1Click:Connect(showOverview)

	local listCard, listHolder = Components.section("Your providers", { order = 1 })
	listCard.Name = "SavedProviders"
	listCard.Parent = overview
	local catalogCard, catalogHolder = Components.section("Add a provider", {
		subtitle = "Choose a preset or connect your own API.", order = 2,
	})
	catalogCard.Name = "ProviderCatalog"
	catalogCard.Parent = overview
	local function matches(text: string): boolean
		local query = string.lower(StringUtil.trim(searchBox.Text))
		return query == "" or string.find(string.lower(text), query, 1, true) ~= nil
	end
	local function clearRows(holder: Instance)
		for _, child in holder:GetChildren() do
			if child:IsA("GuiObject") then child:Destroy() end
		end
	end
	local function providerRow(holder: Instance, name: string, detail: string, badge: string, color: Color3, order: number, iconId: string?): TextButton
		local button = Theme.textButton("", { height = 56, color = Theme.Extra.Surface, radius = Theme.Metrics.RadiusSmall })
		button.Size = UDim2.new(1, 0, 0, 56)
		button.Interactable = not busy
		button.LayoutOrder = order
		button.Parent = holder
        local mark = ProviderLogo.build(iconId, 30)
        mark.Name = "ProviderMark"
        mark.Position = UDim2.fromOffset(8, 13)
        mark.Parent = button
		local title = Theme.label(name, { size = Theme.TextSizes.Small, font = Theme.Fonts.Medium, truncate = true })
		title.Name = "Title"
		title.Position = UDim2.fromOffset(48, 8)
		title.Size = UDim2.new(1, -124, 0, 18)
		title.Parent = button
		local subtitle = Theme.label(detail, { size = Theme.TextSizes.Caption, color = Theme.Extra.Muted, truncate = true })
		subtitle.Name = "Subtitle"
		subtitle.Position = UDim2.fromOffset(48, 29)
		subtitle.Size = UDim2.new(1, -60, 0, 16)
		subtitle.Parent = button
		local state = Theme.label(badge, { size = Theme.TextSizes.Caption, color = color, alignX = Enum.TextXAlignment.Right, truncate = true })
		state.Name = "State"
		state.AnchorPoint = Vector2.new(1, 0)
		state.Position = UDim2.new(1, -10, 0, 8)
		state.Size = UDim2.fromOffset(64, 18)
		state.Parent = button
		return button
	end
	local function emptyRow(holder: Instance, text: string)
		local label = Theme.autoText(text, { size = Theme.TextSizes.Small, color = Theme.Extra.Muted })
		label.Name = "Empty"
		label.Parent = holder
	end
	local function renderProfileList()
		clearRows(listHolder)
		local count = 0
		for index, profile in SettingsManager.getValue("providers") do
			if matches((profile.displayName or "") .. " " .. (profile.providerName or "") .. " " .. (profile.modelId or "")) then
				count += 1
				local active = profile.id == SettingsManager.getValue("activeProviderId")
				local ready = profile.viaRouter or profile.authStyle == "none" or CredentialStore.has(profile.id)
				local state = if active then "Active" elseif not ready then "Needs key" else "Saved"
				local button = providerRow(listHolder, profile.displayName, if profile.modelId ~= "" then profile.modelId else "No model selected", state, if active then Theme.Colors.Highlight elseif not ready then Theme.Extra.Warning else Theme.Extra.Muted, index, profile.iconId or (UniversalProviderRegistry.getPreset(profile.presetId) or {}).iconId)
				button.Name = "Profile_" .. profile.id
				button.MouseButton1Click:Connect(function() if not busy then showEditor(profile) end end)
			end
		end
		if count == 0 then emptyRow(listHolder, if #SettingsManager.getValue("providers") == 0 then "No providers yet. Choose one below to get started." else "No matching providers.") end
	end
    local category = "oauth"
    local pageNumber = 1
    local categoryNames = { oauth = "OAuth providers", free = "Free / Free-tier providers", apikey = "API-key providers", direct = "Direct API / Custom" }
    local categories = { "OAuth", "Free / Free tier", "API key", "Direct / Custom" }
    local categoryValues = { ["OAuth"] = "oauth", ["Free / Free tier"] = "free", ["API key"] = "apikey", ["Direct / Custom"] = "direct" }
    local renderCatalog: () -> ()
    local categoryRow = Components.dropdown("Provider category", categories, function(selected)
        category = categoryValues[selected] or "oauth"; pageNumber = 1; renderCatalog()
    end, { order = 0 })
    categoryRow.Parent = overview
    local function renderCatalogImpl()
        clearRows(catalogHolder)
        local entries = {}
        for _, preset in UniversalProviderRegistry.presetList() do
            if matches(preset.label .. " " .. preset.id) and (preset.category == category or StringUtil.trim(searchBox.Text) ~= "") then entries[#entries + 1] = preset end
        end
        local pagesCount = math.max(1, math.ceil(#entries / 9))
        pageNumber = math.clamp(pageNumber, 1, pagesCount)
        local heading = Theme.autoText((if StringUtil.trim(searchBox.Text) == "" then categoryNames[category] else "Search results") .. " · " .. tostring(#entries), { size = 12, color = Theme.Colors.SecondaryText })
        heading.LayoutOrder = 0; heading.Parent = catalogHolder
        for index = (pageNumber - 1) * 9 + 1, math.min(pageNumber * 9, #entries) do
            local preset = entries[index]
            local description = if preset.viaRouter then (if preset.hasOAuth then "Browser sign in · 9Router" elseif preset.noAuth then "No provider key · 9Router" else "Connect account / key in 9Router") else "Direct connection · " .. (labelOf(PROVIDER_TYPE_OPTIONS, preset.providerType) or "Custom API")
            if preset.deprecated then description ..= " · upstream notice" end
            local button = providerRow(catalogHolder, preset.label, description, "Add +", Theme.Extra.Muted, index, preset.iconId)
            button.Name = "AddPreset_" .. preset.id
            button.MouseButton1Click:Connect(function() if not busy then addPreset(preset.id) end end)
        end
        if #entries == 0 then emptyRow(catalogHolder, "No matching presets. Try another provider name.") end
        if pagesCount > 1 then
            local nav = Instance.new("Frame"); nav.Name = "CatalogPages"; nav.Size = UDim2.new(1, 0, 0, 28); nav.LayoutOrder = 999; Theme.passThrough(nav); nav.Parent = catalogHolder
            local previous = Components.textButton("← Previous"); previous.Size = UDim2.new(0.33, -2, 1, 0); previous.Parent = nav; previous.Interactable = pageNumber > 1 and not busy
            local nextPage = Components.textButton("Next →"); nextPage.Size = UDim2.new(0.33, -2, 1, 0); nextPage.Position = UDim2.fromScale(0.67, 0); nextPage.Parent = nav; nextPage.Interactable = pageNumber < pagesCount and not busy
            local label = Theme.label(tostring(pageNumber) .. " / " .. tostring(pagesCount), { size = 11, alignX = Enum.TextXAlignment.Center }); label.Position = UDim2.fromScale(0.34, 0); label.Size = UDim2.new(0.32, 0, 1, 0); label.Parent = nav
            previous.MouseButton1Click:Connect(function() if not busy and pageNumber > 1 then pageNumber -= 1; renderCatalog() end end)
            nextPage.MouseButton1Click:Connect(function() if not busy and pageNumber < pagesCount then pageNumber += 1; renderCatalog() end end)
        end
    end
    renderCatalog = renderCatalogImpl
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() pageNumber = 1; renderProfileList(); renderCatalog() end)

	--=========================================================================
	-- IDENTITY
	--=========================================================================

	local _, identityBody = (function()
		local card, body = Components.section("Connection details", { order = 1 })
		card.Parent = pages.Connection
		return card, body
	end)()

    local routerCard, routerBody = Components.section("9Router account", { order = 0, subtitle = "Sign in or connect a provider key in the local dashboard." })
    routerCard.Name = "RouterAccount"; routerCard.Parent = pages.Connection
    local routerNote = Theme.autoText("", { size = 12, color = Theme.Extra.Muted }); routerNote.LayoutOrder = 0; routerNote.Parent = routerBody
    local login = Components.textButton("Sign in / Log in", { order = 1 }); login.Name = "ProviderSignIn"; login.Size = UDim2.new(1, 0, 0, 30); login.Parent = routerBody
    local statusButton = Components.textButton("Refresh connection", { order = 2 }); statusButton.Name = "RefreshOAuthStatus"; statusButton.Size = UDim2.new(1, 0, 0, 28); statusButton.Parent = routerBody
    local loginGeneration = 0
    local function refreshAccount(providerId: string, profileId: string, current: number)
        local value, err = BridgeClient.providerStatus(providerId)
        if destroyed or current ~= loginGeneration or draft.id ~= profileId then return end
        routerNote.Text = if value then value.message else err or "Connection check failed."
        routerNote.TextColor3 = if value and value.connected then Theme.Colors.Success else Theme.Extra.Muted
        if value and value.connected then login.Text = "Manage account in 9Router" end
    end
    login.MouseButton1Click:Connect(function()
        if busy or StateManager.isBusy() or not draft.viaRouter then return end
        loginGeneration += 1
        local current = loginGeneration; local profileId = draft.id; local providerId = draft.routerProviderId
        login.Interactable = false; statusButton.Interactable = false; routerNote.Text = "Opening local provider sign in…"
        task.spawn(function()
            local value, err = BridgeClient.openProvider(providerId)
            if destroyed or current ~= loginGeneration or draft.id ~= profileId then return end
            login.Interactable = not StateManager.isBusy(); statusButton.Interactable = not StateManager.isBusy()
            routerNote.Text = if value then value.message else err or "Could not open the dashboard."
            if value then
                task.spawn(function()
                    for _ = 1, 45 do
                        if destroyed or current ~= loginGeneration or draft.id ~= profileId then return end
                        local result = BridgeClient.providerStatus(providerId)
                        if result and result.connected then refreshAccount(providerId, profileId, current); return end
                        task.wait(2)
                    end
                end)
            end
        end)
    end)
    statusButton.MouseButton1Click:Connect(function()
        if busy or StateManager.isBusy() then return end
        loginGeneration += 1; local current = loginGeneration; local profileId = draft.id; local providerId = draft.routerProviderId
        statusButton.Interactable = false; statusButton.Text = "Checking…"
        task.spawn(function()
            refreshAccount(providerId, profileId, current)
            if destroyed or current ~= loginGeneration or draft.id ~= profileId then return end
            statusButton.Interactable = not StateManager.isBusy(); statusButton.Text = "Refresh connection"
        end)
    end)
	local displayNameRow = field(identityBody, "Profile name", 0, "Used to identify this connection.")
	local displayNameBox = smallInput(displayNameRow:FindFirstChild("Value") :: Instance, "My Roblox Assistant")
	displayNameBox.Text = draft.displayName
	displayNameBox.FocusLost:Connect(function()
		do
			draft.displayName = displayNameBox.Text
			commit()
		end
	end)

	local providerNameRow = field(identityBody, "Provider Name", 1)
	local providerNameBox = smallInput(providerNameRow:FindFirstChild("Value") :: Instance, "My Custom AI")
	providerNameBox.Text = draft.providerName
	providerNameBox.FocusLost:Connect(function()
		do
			draft.providerName = providerNameBox.Text
			commit()
		end
	end)

	local typeField, _, _, setType = dropdownField(identityBody, "Provider Type", labelsOf(PROVIDER_TYPE_OPTIONS), function(selected)
		local value = valueOf(PROVIDER_TYPE_OPTIONS, selected)
		if not value then
			return
		end
		draft.providerType = value
		-- Adopting a type also adopts its documented protocol and auth style.
		for _, preset in UniversalProviderRegistry.presetList() do
			if preset.providerType == value then
				draft.protocol = preset.protocol
				draft.authStyle = preset.authStyle
				draft.authHeaderName = preset.authHeaderName
				break
			end
		end
		draft.endpointPath = ""
		draft.endpointPathCustom = false
		commit()
		refresh()
	end, 2)

