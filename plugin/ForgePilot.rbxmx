	docsUrl: string,
	notes: string,
	authStyle: AuthStyle,
	authHeaderName: string?,
	defaultHeaders: { [string]: string },
	providerCapabilities: { [string]: string },
	modelMetadata: { [string]: ModelMetadata },
}

