      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">SmartRetrySettings</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Core / SmartRetrySettings
	Thin, validated accessor over the persisted `smartRetry` settings block.

	The Settings tab writes through here so every value is clamped on the way in
	and a provider override can never weaken the global safety limits.
]]

local SettingsManager = require(script.Parent.SettingsManager)

local SmartRetry = {}

--=============================================================================
-- NUMERIC FIELDS
--=============================================================================

local LIMITS: { [string]: { min: number, max: number, integer: boolean? } } = {
	maxRetries = { min = 0, max = 20, integer = true },
	initialDelaySeconds = { min = 0.25, max = 120 },
	multiplier = { min = 1, max = 10 },
	linearStepSeconds = { min = 1, max = 60 },
	maxDelaySeconds = { min = 1, max = 3600 },
	maxAutoWaitSeconds = { min = 5, max = 3600 },
	jitterPercent = { min = 0, max = 100 },
}

--=============================================================================
-- ACCESSORS
--=============================================================================

local function block(): any
	local settings = SettingsManager.get()
	if type(settings.smartRetry) ~= "table" then
		settings.smartRetry = {}
	end
	return settings.smartRetry
end

--- Reads a retry setting.
function SmartRetry.get(key: string): any
	return block()[key]
end

--- Writes a retry setting, clamping numeric values and validating enums.
function SmartRetry.set(key: string, value: any)
	local limits = LIMITS[key]
	local coerced = value

	if limits then
		local numberValue = tonumber(value)
		if numberValue == nil then
			return false
		end
		numberValue = math.clamp(numberValue, limits.min, limits.max)
		coerced = if limits.integer then math.floor(numberValue) else numberValue
	elseif key == "enabled"
		or key == "respectRetryAfter"
		or key == "dynamicCooldown"
		or key == "rateLimitScheduler"
		or key == "multilingualErrors"
		or key == "showCountdown"
		or key == "showRetryLogs"
	then
		coerced = value == true
	elseif key == "strategy" then
		local valid = { adaptive = true, exponential = true, linear = true, custom = true }
		if not valid[value] then
			return false
		end
	elseif key == "customSequence" then
		if type(value) ~= "table" then
			coerced = nil
		else
			local sequence: { number } = {}
			for _, entry in value do
				local numberValue = tonumber(entry)
				if numberValue then
					sequence[#sequence + 1] = math.clamp(numberValue, 0, 3600)
				end
				if #sequence &gt;= 20 then
					break
				end
			end
			coerced = if #sequence &gt; 0 then sequence else nil
		end
	end

	block()[key] = coerced
	SettingsManager.persist()
	return true
end

--- The shipped defaults, written explicitly so a reset is exact rather than
--- dependent on the settings template being re-seeded.
local DEFAULTS: { [string]: any } = {
	enabled = true,
	strategy = "adaptive",
	maxRetries = 5,
	initialDelaySeconds = 2,
	multiplier = 2,
	linearStepSeconds = 3,
	maxDelaySeconds = 120,
	maxAutoWaitSeconds = 120,
	jitterPercent = 25,
	respectRetryAfter = true,
	dynamicCooldown = true,
	rateLimitScheduler = true,
	multilingualErrors = true,
	showCountdown = true,
	showRetryLogs = true,
	customSequence = nil,
	providerOverrides = {},
}

--- Resets the whole block to the shipped defaults.
function SmartRetry.resetDefaults()
	local settings = SettingsManager.get()
	local fresh = {}
	for key, value in DEFAULTS do
		fresh[key] = if type(value) == "table" then table.clone(value) else value
	end
	settings.smartRetry = fresh
	SettingsManager.persist()
	return true
end

--=============================================================================
-- PROVIDER OVERRIDES
--=============================================================================

function SmartRetry.getProviderOverride(providerId: string): { [string]: any }
	local overrides = block().providerOverrides
	if type(overrides) ~= "table" then
		return {}
	end
	local entry = overrides[providerId]
	return type(entry) == "table" and entry or {}
end

--- Sets (or clears) a per-provider override. nil clears it.
function SmartRetry.setProviderOverride(providerId: string, patch: { [string]: any }?)
	local overrides = block().providerOverrides
	if type(overrides) ~= "table" then
		overrides = {}
		block().providerOverrides = overrides
	end

	if patch == nil then
		overrides[providerId] = nil
	else
		local clamped: { [string]: any } = {}
		for key, value in patch do
			local limits = LIMITS[key]
			if limits then
				local numberValue = tonumber(value)
				if numberValue then
					clamped[key] = if limits.integer
						then math.floor(math.clamp(numberValue, limits.min, limits.max))
						else math.clamp(numberValue, limits.min, limits.max)
				end
			else
				clamped[key] = value
			end
		end
		overrides[providerId] = clamped
	end

	SettingsManager.persist()
	return true
end

--=============================================================================
-- DESCRIPTION
--=============================================================================

local function human(seconds: number): string
	if seconds &gt;= 60 then
		return string.format("%.0fm", seconds / 60)
	end
	return string.format("%.0fs", seconds)
end

--- A one-line human description of the current schedule.
function SmartRetry.describe(): string
	local strategy = block().strategy or "adaptive"
	local maxRetries = block().maxRetries or 5
	local initial = block().initialDelaySeconds or 2
	local multiplier = block().multiplier or 2

	if not block().enabled then
		return "Automatic retry is disabled."
	end

	if strategy == "linear" then
		local step = block().linearStepSeconds or 3
		return string.format(
			"Linear: %s, %s, %s, %s … (up to %d retries)",
			human(step),
			human(step * 2),
			human(step * 3),
			human(step * 4),
			maxRetries
		)
	end

	return string.format(
		"Exponential from %s, x%s, up to %d retries.",
		human(initial),
		tostring(multiplier),
		maxRetries
	)
end

return SmartRetry</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">StateManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Core / StateManager
	The agent state machine.

	Every transition is validated against an explicit table, illegal transitions
	are rejected, and duplicate work is suppressed while a task is already running.
]]

local EventBus = require(script.Parent.EventBus)

local StateManager = {}

export type State =
	| "IDLE"
	| "CONNECTING"
	| "THINKING"
	| "ANALYZING"
	| "PLANNING"
	| "AWAITING_USER_ANSWER"
	| "AWAITING_APPROVAL"
	| "BUILDING"
	| "VERIFYING"
	| "COMPLETED"
	| "FAILED"
	| "CANCELLED"
	-- Provider-recovery states (V3.3). Fed by RetryStateManager.
	| "RATE_LIMIT_DETECTED"
	| "WAITING_FOR_QUOTA"
	| "RETRY_SCHEDULED"
	| "RETRYING"
	| "PROVIDER_RECOVERED"
	| "RETRIES_EXHAUSTED"
	| "RETRY_CANCELLED"

-- A SET of every valid state name. Transitions are checked against this, so it
-- must be keyed by state name (`States.THINKING`), not a positional array.
local allStates: { [State]: boolean } = {
	IDLE = true,
	CONNECTING = true,
	THINKING = true,
	ANALYZING = true,
	PLANNING = true,
	AWAITING_USER_ANSWER = true,
	AWAITING_APPROVAL = true,
	BUILDING = true,
	VERIFYING = true,
	COMPLETED = true,
	FAILED = true,
	CANCELLED = true,
	RATE_LIMIT_DETECTED = true,
	WAITING_FOR_QUOTA = true,
	RETRY_SCHEDULED = true,
	RETRYING = true,
	PROVIDER_RECOVERED = true,
	RETRIES_EXHAUSTED = true,
	RETRY_CANCELLED = true,
}

StateManager.States = allStates

--- Which states may follow which.
local ALLOWED: { [State]: { [State]: boolean } } = {
	IDLE = { CONNECTING = true, THINKING = true, PLANNING = true, CANCELLED = true },
	-- CONNECTING transitions are defined below together with rate-limit recovery.
	THINKING = { ANALYZING = true, PLANNING = true, BUILDING = true, AWAITING_USER_ANSWER = true, AWAITING_APPROVAL = true, COMPLETED = true, FAILED = true, CANCELLED = true },
	ANALYZING = { THINKING = true, PLANNING = true, BUILDING = true, AWAITING_USER_ANSWER = true, AWAITING_APPROVAL = true, COMPLETED = true, FAILED = true, CANCELLED = true },
	PLANNING = { AWAITING_USER_ANSWER = true, AWAITING_APPROVAL = true, COMPLETED = true, FAILED = true, CANCELLED = true, THINKING = true },
	AWAITING_USER_ANSWER = { THINKING = true, ANALYZING = true, PLANNING = true, BUILDING = true, CANCELLED = true, FAILED = true },
	AWAITING_APPROVAL = { PLANNING = true, BUILDING = true, THINKING = true, CANCELLED = true, FAILED = true },
	BUILDING = { VERIFYING = true, THINKING = true, AWAITING_USER_ANSWER = true, COMPLETED = true, FAILED = true, CANCELLED = true },
	VERIFYING = { THINKING = true, BUILDING = true, COMPLETED = true, FAILED = true, CANCELLED = true },
	COMPLETED = { IDLE = true, THINKING = true, PLANNING = true, CANCELLED = true },
	FAILED = { IDLE = true, THINKING = true, PLANNING = true, CANCELLED = true },
	CANCELLED = { IDLE = true, THINKING = true, PLANNING = true },

	-- Provider recovery. Any active work state may hit a provider failure and
	-- enter the retry chain; the chain can only return to active work once the
	-- provider actually responds.
	CONNECTING = { THINKING = true, FAILED = true, CANCELLED = true, IDLE = true, RATE_LIMIT_DETECTED = true, WAITING_FOR_QUOTA = true, RETRYING = true },
}

-- States that mean "the agent is mid-task and may still transition to work".
local ACTIVE_STATES: { [State]: boolean } = {
	CONNECTING = true,
	THINKING = true,
	ANALYZING = true,
	PLANNING = true,
	AWAITING_USER_ANSWER = true,
	AWAITING_APPROVAL = true,
	BUILDING = true,
	VERIFYING = true,
}

-- Any active work state may drop into the retry chain, including cancellation.
for from in pairs(ACTIVE_STATES) do
	local row = ALLOWED[from]
	row.CONNECTING = true
	row.RATE_LIMIT_DETECTED = true
	row.WAITING_FOR_QUOTA = true
	row.RETRYING = true
	row.RETRY_CANCELLED = true
	row.RETRIES_EXHAUSTED = true
end

-- IDLE and the terminal states can only reach the chain's own end states.
ALLOWED.IDLE.RETRY_CANCELLED = true
ALLOWED.IDLE.RETRIES_EXHAUSTED = true

-- The retry chain itself.
ALLOWED.RATE_LIMIT_DETECTED = {
	WAITING_FOR_QUOTA = true,
	RETRYING = true,
	PROVIDER_RECOVERED = true,
	RETRIES_EXHAUSTED = true,
	RETRY_CANCELLED = true,
	FAILED = true,
	CANCELLED = true,
}
ALLOWED.WAITING_FOR_QUOTA = {
	RETRY_SCHEDULED = true,
	RETRYING = true,
	RETRY_CANCELLED = true,
	RETRIES_EXHAUSTED = true,
	FAILED = true,
	CANCELLED = true,
}
ALLOWED.RETRY_SCHEDULED = {
	RETRYING = true,
	RETRY_CANCELLED = true,
	WAITING_FOR_QUOTA = true,
	RETRIES_EXHAUSTED = true,
	FAILED = true,
	CANCELLED = true,
}
ALLOWED.RETRYING = {
	PROVIDER_RECOVERED = true,
	RATE_LIMIT_DETECTED = true,
	WAITING_FOR_QUOTA = true,
	RETRIES_EXHAUSTED = true,
	RETRY_CANCELLED = true,
	FAILED = true,
	CANCELLED = true,
}
ALLOWED.PROVIDER_RECOVERED = {
	THINKING = true,
	ANALYZING = true,
	PLANNING = true,
	BUILDING = true,
	VERIFYING = true,
	AWAITING_USER_ANSWER = true,
	AWAITING_APPROVAL = true,
	COMPLETED = true,
	FAILED = true,
	CANCELLED = true,
	IDLE = true,
}
ALLOWED.RETRIES_EXHAUSTED = {
	FAILED = true,
	IDLE = true,
	THINKING = true,
	CANCELLED = true,
}
ALLOWED.RETRY_CANCELLED = {
	IDLE = true,
	FAILED = true,
	THINKING = true,
	PLANNING = true,
	CANCELLED = true,
}

StateManager.RETRY_STATES = {
	"RATE_LIMIT_DETECTED",
	"WAITING_FOR_QUOTA",
	"RETRY_SCHEDULED",
	"RETRYING",
	"PROVIDER_RECOVERED",
	"RETRIES_EXHAUSTED",
	"RETRY_CANCELLED",
}

local displayLabels: { [State]: string } = {
	IDLE = "Ready",
	CONNECTING = "Connecting",
	THINKING = "Thinking",
	ANALYZING = "Analyzing",
	PLANNING = "Planning",
	AWAITING_USER_ANSWER = "Waiting for your answer",
	AWAITING_APPROVAL = "Waiting for approval",
	BUILDING = "Building",
	VERIFYING = "Verifying",
	COMPLETED = "Completed",
	FAILED = "Failed",
	CANCELLED = "Cancelled",
	RATE_LIMIT_DETECTED = "Rate limit detected",
	WAITING_FOR_QUOTA = "Waiting for quota",
	RETRY_SCHEDULED = "Retry scheduled",
	RETRYING = "Retrying request",
	PROVIDER_RECOVERED = "Provider recovered",
	RETRIES_EXHAUSTED = "Retries exhausted",
	RETRY_CANCELLED = "Retry cancelled",
}

StateManager.displayLabel = displayLabels

local currentState: State = "IDLE"
local currentTaskId: string? = nil
local activeActivity: string? = nil
local busy = false
local history: { { state: State, at: number, taskId: string? } } = {}

--=============================================================================
-- RETRY CHAIN MEMBERSHIP
--=============================================================================

local RETRY_SET: { [string]: boolean } = {}
for _, name in StateManager.RETRY_STATES do
	RETRY_SET[name] = true
end

--- True when the agent is inside the provider-recovery chain.
function StateManager.isInRetryChain(): boolean
	return RETRY_SET[currentState] == true
end

--- True when a rate-limit or quota wait is in progress.
function StateManager.isWaitingOnProvider(): boolean
	return currentState == "WAITING_FOR_QUOTA" or currentState == "RATE_LIMIT_DETECTED"
end

--=============================================================================
-- QUERIES
--=============================================================================

function StateManager.get(): State
	return currentState
end

function StateManager.getTaskId(): string?
	return currentTaskId
end

function StateManager.getActivity(): string?
	return activeActivity
end

local taskRunning = false
function StateManager.isBusy(): boolean
	return busy or taskRunning
end

function StateManager.beginRun(): boolean
	if StateManager.isBusy() then return false end
	taskRunning = true
	EventBus.emit(EventBus.Events.StateChanged, {
		state = currentState, taskId = currentTaskId, busy = true, activity = activeActivity,
	})
	return true
end

function StateManager.endRun()
	taskRunning = false
	EventBus.emit(EventBus.Events.StateChanged, {
		state = currentState, taskId = currentTaskId, busy = busy, activity = activeActivity,
	})
end

--- True when the agent is mid-task and must not start another one.
function StateManager.isTerminal(): boolean
	return currentState == "COMPLETED" or currentState == "FAILED" or currentState == "CANCELLED"
end

function StateManager.history(): { { state: State, at: number, taskId: string? } }
	return table.clone(history)
end

--=============================================================================
-- TRANSITIONS
--=============================================================================

--- Attempts a transition. Returns `true` when the move was accepted.
function StateManager.transition(next: State, options: { taskId: string?, activity: string?, force: boolean? }?)
	if not StateManager.States[next] then
		warn("[ForgePilot] unknown state requested: " .. tostring(next))
		return false
	end

	if next == currentState and not (options and options.force) then
		return true
	end

	local allowed = ALLOWED[currentState]
	if allowed and not allowed[next] and not (options and options.force) then
		warn(string.format("[ForgePilot] rejected transition %s -> %s", currentState, next))
		return false
	end

	local previous = currentState
	currentState = next
	if options and options.taskId then
		currentTaskId = options.taskId
	end
	if options and options.activity ~= nil then
		activeActivity = options.activity
	end

	busy = next ~= "IDLE"
		and next ~= "COMPLETED"
		and next ~= "FAILED"
		and next ~= "CANCELLED"

	history[#history + 1] = { state = next, at = os.clock(), taskId = currentTaskId }
	if #history > 500 then
		table.remove(history, 1)
	end

	EventBus.emit(EventBus.Events.StateChanged, {
		previous = previous,
		state = next,
		label = StateManager.displayLabel[next],
		taskId = currentTaskId,
		busy = busy,
		activity = activeActivity,
	})
	return true
end

--- Sets the free-text activity line shown next to the state (e.g. "Analyzing Workspace...").
function StateManager.setActivity(activity: string?)
	if activeActivity == activity then
		return
	end
	activeActivity = activity
	EventBus.emit(EventBus.Events.ActivityChanged, { activity = activity, state = currentState })
end

--- Clears activity text (state label remains).
function StateManager.clearActivity()
	StateManager.setActivity(nil)
end

function StateManager.setTaskId(taskId: string?)
	currentTaskId = taskId
end

--=============================================================================
-- CANCELLATION
--=============================================================================

--- Marks the current task cancelled and returns the id that was cancelled.
function StateManager.cancel(): string?
	local cancelled = currentTaskId
	if busy then
		StateManager.transition("CANCELLED", { taskId = cancelled, activity = nil, force = true })
		busy = false
	end
	return cancelled
end

function StateManager.reset()
	StateManager.transition("IDLE", { taskId = nil, activity = nil, force = true })
	busy = false
end

--- True when the agent should accept a new user message.
function StateManager.canAcceptInput(): boolean
	return not StateManager.isBusy()
end

return StateManager
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="45">
      <Properties>
        <string name="Name">Roblox</string>
      </Properties>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ActionExecutor</string>
          <string name="Source">--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Roblox / ActionExecutor
	The ONLY module that mutates the DataModel.

	Every write goes through:
	    ToolValidator.validate  -&gt;  mode gate  -&gt;  permission check
	    -&gt;  change-history transaction  -&gt;  post-action verification

	The post-action check is mandatory: ForgePilot never reports success unless
	Studio confirms the object exists with the requested configuration.
]]

local EventBus = require(script.Parent.Parent.Core.EventBus)
local HistoryManager = require(script.Parent.HistoryManager)
local InstanceManager = require(script.Parent.InstanceManager)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local WorkspaceInspector = require(script.Parent.WorkspaceInspector)
local ScriptManager = require(script.Parent.ScriptManager)
local Terrain = require(script.Parent.ModelBuilder).Terrain
local Buildings = require(script.Parent.ModelBuilder).Buildings
local Roads = require(script.Parent.ModelBuilder).Roads
local GUIBuilder = require(script.Parent.GUIBuilder)
local LightingManager = require(script.Parent.LightingManager)
local ToolValidator = require(script.Parent.ToolValidator)
local EventBus = require(script.Parent.Parent.Core.EventBus)

local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local ActionExecutor = {}

--=============================================================================
-- VALUE COERCION
--=============================================================================

local function toVector3(value: any, fallback: Vector3): Vector3
	if type(value) == "table" then
		local x = value.x or value.X or value[1]
		local y = value.y or value.Y or value[2]
		local z = value.z or value.Z or value[3]
		if x and y and z then
			return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
		end
	elseif type(value) == "string" then
		local x, y, z = string.match(value, "^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*$")
		if x then
			return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
		end
	end
	return fallback
end

ActionExecutor.toVector3 = toVector3

local function toColor3(value: any, fallback: Color3): Color3
	if type(value) == "string" then
		local hex = string.gsub(StringUtil.trim(value), "^#", "")
		if string.match(hex, "^%x%x%x%x%x%x$") then
			return Color3.fromHex(hex)
		end
		return fallback
	elseif type(value) == "table" then
		local r = value.r or value.R
		local g = value.g or value.G
		local b = value.b or value.B
		if r and g and b then
			return Color3.new(math.clamp(tonumber(r) or 0, 0, 1), math.clamp(tonumber(g) or 0, 0, 1), math.clamp(tonumber(b) or 0, 0, 1))
		end
	end
	return fallback
end

ActionExecutor.toColor3 = toColor3

--- Writable-property enforcement lives in InstanceManager.isWritable.

local function resolveParent(path: string): (Instance?, string?)
	return InstanceManager.resolveParent(path)
end

local function resolveTarget(path: string): (Instance?, string?)
	return WorkspaceInspector.resolve(path)
end

--=============================================================================
-- READ TOOL HANDLERS
--=============================================================================

local function handleRead(toolName: string, args: { [string]: any }): (string?, string?)
	if toolName == "inspect_place" then
		local info = WorkspaceInspector.getPlaceInfo()
		local stats = WorkspaceInspector.getStats()
		local lines = {
			string.format("Place: %s (PlaceId %s, GameId %s)", info.name, tostring(info.placeId), tostring(info.gameId)),
		}
		if info.genre then
			lines[#lines + 1] = "Genre: " .. info.genre
		end
		if info.description and #info.description &gt; 0 then
			lines[#lines + 1] = "Description: " .. string.sub(info.description, 1, 400)
		end
		lines[#lines + 1] =
			string.format("Workspace: %d direct children, %s descendants.", stats.workspaceChildren, tostring(stats.workspaceDescendants))
		if args.includeClassCounts ~= false then
			local counts = WorkspaceInspector.countByClass()
			local keys = {}
			for className, count in counts do
				keys[#keys + 1] = className
			end
			table.sort(keys)
			local parts = {}
			for index, key in keys do
				if index &gt; 30 then
					break
				end
				parts[#parts + 1] = string.format("%s=%d", key, counts[key])
			end
			lines[#lines + 1] = "Class counts: " .. table.concat(parts, ", ")
		end
		lines[#lines + 1] = "Top-level Workspace outline:"
		lines[#lines + 1] = WorkspaceInspector.summariseTree()
		return table.concat(lines, "\n"), nil
	end

	if toolName == "inspect_tree" then
		local instance, err = resolveTarget(args.path)
		if not instance then
			return nil, err
		end
		local tree = WorkspaceInspector.describeTree(instance, args.maxDepth or 3)
		local ok, encoded = pcall(HttpService.JSONEncode, HttpService, tree)
		if not ok then
			return nil, "Could not serialise the tree."
		end
		return encoded, nil
	end

	if toolName == "inspect_selection" then
		return require(script.Parent.SelectionInspector).getSummary(), nil
	end

	if toolName == "inspect_properties" then
		local instance, err = resolveTarget(args.path)
		if not instance then
			return nil, err
		end
		local properties = WorkspaceInspector.readProperties(instance)
		local lines = { string.format("%s (%s)", instance:GetFullName(), instance.ClassName) }
		for key, value in properties do
			lines[#lines + 1] = string.format("  %s = %s", key, value)
		end
		return table.concat(lines, "\n"), nil
	end

	if toolName == "inspect_script" then
		local instance, err = resolveTarget(args.path)
		if not instance then
			return nil, err
		end
		if not instance:IsA("LuaSourceContainer") then
			return nil, string.format("`%s` is a %s, not a script.", instance:GetFullName(), instance.ClassName)
		end
		local source = (instance :: any).Source
		if type(source) ~= "string" then
			return nil, "This script has no readable source (it may be a built-in instance)."
		end
		if #source &gt; WorkspaceInspector.LIMITS.MAX_SCRIPT_CHARS then
			return string.format(
				"-- truncated at %d of %d characters --\n%s",
				WorkspaceInspector.LIMITS.MAX_SCRIPT_CHARS,
				#source,
				string.sub(source, 1, WorkspaceInspector.LIMITS.MAX_SCRIPT_CHARS)
			),
				nil
		end
		return source, nil
	end

	if toolName == "inspect_lighting" then
		local properties = WorkspaceInspector.describeLighting()
		local lines = { "Lighting:" }
		for key, value in properties do
			lines[#lines + 1] = string.format("  %s = %s", key, value)
		end
		return table.concat(lines, "\n"), nil
	end

	if toolName == "inspect_ui" then
		local info = WorkspaceInspector.describeUI()
		local lines = {}
		for _, entry in info.playerGuis do
			lines[#lines + 1] = string.format("%s (%d gui elements)", entry.name, entry.total)
			for _, screen in entry.screens do
				lines[#lines + 1] = "  " .. screen
			end
		end
		if #lines == 0 then
			lines[1] = "No PlayerGui instances are present in this place."
		end
		lines[#lines + 1] = info.note
		return table.concat(lines, "\n"), nil
	end

	if toolName == "inspect_place_stats" then
		local stats = WorkspaceInspector.getStats()
		return string.format(
			"Workspace direct children: %d\nWorkspace descendants: %s\nEditor placeholder objects are not included.",
			stats.workspaceChildren,
			tostring(stats.workspaceDescendants)
		),
			nil
	end

	return nil, string.format("No handler for read tool `%s`.", toolName)
end

--=============================================================================
-- WRITE TOOL HANDLERS
--=============================================================================

local function handleCreatePart(args): (Instance?, string?)
	local parent, err = resolveParent(args.parent or "Workspace")
	if not parent then
		return nil, err
	end

	local part = Instance.new("Part")
	part.Name = args.name
	part.Size = toVector3(args.size, Vector3.new(10, 1, 10))
	part.CFrame = CFrame.new(toVector3(args.position, Vector3.new(0, 5, 0)))
	part.Anchored = args.anchored ~= false
	part.CanCollide = args.canCollide ~= false
	if args.material then
		local okEnum = pcall(function()
			part.Material = Enum.Material[args.material]
		end)
		if not okEnum then
			part:Destroy()
			return nil, string.format("`%s` is not a valid Material enum.", tostring(args.material))
		end
	end
	if args.color then
		part.Color = toColor3(args.color, part.Color)
	end
	if args.shape then
		local okShape = pcall(function()
			part.Shape = Enum.PartType[args.shape]
		end)
		if not okShape then
			part:Destroy()
			return nil, string.format("`%s` is not a valid Part shape.", tostring(args.shape))
		end
	end

	part.Parent = parent
	return part, nil
end

local function handleCreateModel(args): (Instance?, string?)
	local result = InstanceManager.create("Model", { Name = args.name, Parent = args.parent or "Workspace" })
	if not result.ok then
		return nil, result.message
	end
	return result.instance, result.message
end

local function handleCreateFolder(args): (Instance?, string?)
	local result = InstanceManager.create("Folder", { Name = args.name, Parent = args.parent or "Workspace" })
	if not result.ok then
		return nil, result.message
	end
	return result.instance, result.message
end

local function handleGenerateMap(args): (Instance?, string?)
	local parent, err = resolveParent(args.parent or "Workspace")
	if not parent then
		return nil, err
	end

	local ModelBuilder = require(script.Parent.ModelBuilder)
	local map, detail = ModelBuilder.generateSimpleMap({
		name = args.name,
		origin = ActionExecutor.toVector3(args.origin, Vector3.zero),
		radius = args.radius,
		buildings = args.buildings,
		roads = args.roads,
		color = args.color,
	})
	if not map then
		return nil, detail
	end

	map.Parent = parent
	return map, detail
end

local function handleCreateScript(args): (Instance?, string?)
	local parent, err = resolveParent(args.parent)
	if not parent then
		return nil, err
	end

	local className = args.scriptType or "LocalScript"
	local scriptInstance = Instance.new(className)
	scriptInstance.Name = args.name

	scriptInstance.Source = if type(args.source) == "string" and #args.source &gt; 0
		then args.source
		else string.format("-- %s\n-- Created by ForgePilot\n", args.name)

	scriptInstance.Parent = parent

	if args.enabled == false then
		scriptInstance.Enabled = false
	end

	if args.openInEditor ~= false then
		ScriptManager.open(scriptInstance)
	end

	return scriptInstance, nil
end

local function handleEditScript(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end
	if not instance:IsA("LuaSourceContainer") then
		return nil, string.format("`%s` is a %s, not a script.", instance:GetFullName(), instance.ClassName)
	end

	local previous = (instance :: any).Source
	if type(previous) ~= "string" then
		return nil, "This script's source is not readable, so ForgePilot will not overwrite it."
	end

	(instance :: any).Source = args.source

	if args.openInEditor ~= false then
		ScriptManager.open(instance)
	end
	return instance, nil
end

local function handleAppendScript(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end
	if not instance:IsA("LuaSourceContainer") then
		return nil, string.format("`%s` is a %s, not a script.", instance:GetFullName(), instance.ClassName)
	end
	(instance :: any).Source = tostring((instance :: any).Source or "") .. args.text
	if args.openInEditor ~= false then
		ScriptManager.open(instance)
	end
	return instance, nil
end

local function handleSetProperties(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end

	local result = InstanceManager.setProperties(instance, args.properties :: any)
	local applied = result.applied
	local rejected = result.rejected

	if #applied == 0 then
		return nil,
			string.format(
				"No property could be set on `%s`. Rejected: %s",
				instance:GetFullName(),
				#rejected &gt; 0 and table.concat(rejected, ", ") or "(none listed)"
			)
	end

	if #rejected &gt; 0 then
		Logger.warn("Build", "Some properties were rejected.", {
			detail = string.format("%s: %s", instance:GetFullName(), table.concat(rejected, ", ")),
		})
	end

	return instance, string.format("Set %s.", table.concat(applied, ", "))
end

local function handleMove(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end

	if args.newParent then
		local newParent, parentErr = resolveParent(args.newParent)
		if not newParent then
			return nil, parentErr
		end
		if newParent == instance or newParent:IsDescendantOf(instance) then
			return nil, "An instance cannot be parented inside itself or one of its own descendants."
		end
		instance.Parent = newParent
	end

	if args.position and instance:IsA("BasePart") then
		instance.CFrame = CFrame.new(toVector3(args.position, instance.Position))
	elseif args.position and instance:IsA("Model") then
		local pivot = (instance :: any).Pivot
		instance:PivotTo(CFrame.new(toVector3(args.position, pivot.Position)))
	end

	return instance, nil
end

local function handleResize(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end
	local size = toVector3(args.size, Vector3.zero)
	if size.Magnitude &lt; 0.001 then
		return nil, "The requested size is zero."
	end
	if instance:IsA("BasePart") then
		instance.Size = size
	elseif instance:IsA("GuiObject") then
		instance.Size = UDim2.fromOffset(math.round(size.X), math.round(size.Y))
	else
		return nil, string.format("`%s` is a %s, which has no resizable Size.", instance:GetFullName(), instance.ClassName)
	end
	return instance, nil
end

local function handleGroup(args): (Instance?, string?)
	local target: Instance
	if args.into then
		local resolved, err = resolveTarget(args.into)
		if not resolved then
			return nil, err
		end
		target = resolved
	else
		local parent, parentErr = resolveParent("Workspace")
		if not parent then
			return nil, parentErr
		end
		target = Instance.new("Model")
		target.Name = args.name or "Group"
		target.Parent = parent
	end

	local moved = 0
	for _, path in (args.paths :: { string }) do
		local instance, resolveErr = resolveTarget(path)
		if instance then
			if instance ~= target and not target:IsDescendantOf(instance) then
				instance.Parent = target
				moved += 1
			end
		else
			Logger.warn("Build", "Skipped an unresolvable path.", { detail = tostring(path) .. ": " .. tostring(resolveErr) })
		end
	end

	if moved == 0 then
		return nil, "None of the given paths could be grouped."
	end
	return target, string.format("Grouped %d instance(s).", moved)
end

local function handleDelete(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end

	local destroyed, message = InstanceManager.destroy(instance)
	if not destroyed then
		return nil, message
	end
	return nil, message
end

local function handleSetDisabled(args): (Instance?, string?)
	local instance, err = resolveTarget(args.path)
	if not instance then
		return nil, err
	end
	if not instance:IsA("LuaSourceContainer") then
		return nil, string.format("`%s` is a %s, not a script.", instance:GetFullName(), instance.ClassName)
	end
	instance.Enabled = args.enabled
	return instance, nil
end

local function handleCreateUI(args): (Instance?, string?)
	local parent, err = resolveParent(args.parent or "StarterGui")
	if not parent then
		return nil, err
	end
	local gui, guiErr = GUIBuilder.build(args)
	if not gui then
		return nil, guiErr
	end
	gui.Parent = parent
	if args.openInEditor ~= false then
		ScriptManager.focus(gui)
	end
	return gui, nil
end

--=============================================================================
-- VERIFICATION
--=============================================================================

--- Confirms the result actually exists in the DataModel.
-- `instance`/`note` are the (Instance?, string?) pair returned by the handler.
local function verify(toolName: string, args: { [string]: any }, instance: Instance?, note: string?): (boolean, string)
	if toolName == "delete_instance" then
		local target, err = resolveTarget(args.path)
		if not target then
			return true, (note or "Deleted.") .. " Verified: the instance is no longer present."
		end
		return false, string.format("Deletion could not be verified: `%s` still exists.", tostring(args.path))
	end

	if instance then
		local stillParented = instance.Parent ~= nil
		if not stillParented then
			return false, "The created instance is not parented to anything."
		end
		local detail = note or ""
		return true,
			string.format(
				"Verified: %s exists at %s.%s",
				instance.Name,
				instance:GetFullName(),
				if #detail &gt; 0 then (" " .. detail) else ""
			)
	end

	return false, note or "The action reported no instance."
end

--=============================================================================
-- EXECUTE
--=============================================================================

export type ExecutionResult = {
	ok: boolean,
	toolName: string,
	verified: boolean,
	message: string,
	detail: string?,
	actionId: string,
	durationMs: number,
}

local actionCounter = 0

--- Executes one validated tool call.
function ActionExecutor.execute(toolName: string, args: { [string]: any }, mode: string): (ExecutionResult?, string?)
	local validation = ToolValidator.validate(toolName, args, mode)
	if not validation.ok or not validation.tool then
		return nil, table.concat(validation.errors, " ")
	end

	local tool = validation.tool
	local arguments = validation.arguments or {}
	actionCounter += 1
	local actionId = string.format("act-%d", actionCounter)
	local started = os.clock()

	Logger.log("TOOL", tool.category, ToolValidator.summarise(toolName, arguments), {
		toolName = toolName,
		detail = "Validated. Executing.",
	})
	EventBus.emit(EventBus.Events.ToolCallStarted, {
		toolName = toolName,
		actionId = actionId,
		summary = ToolValidator.summarise(toolName, arguments),
	})

    if tool.external then
        local value, problem = BridgeClient.execute(toolName, arguments, mode, function() return StateManager.get() == "CANCELLED" end)
        local ok = value ~= nil and value.ok == true
        local result = { ok = ok, verified = ok and value.verified == true, toolName = toolName, message = if value then tostring(value.message or "") else problem or "Bridge tool failed.", actionId = actionId, durationMs = (os.clock() - started) * 1000, attachments = if value then value.attachments else nil }
        EventBus.emit(if ok then EventBus.Events.ToolCallFinished else EventBus.Events.ToolCallFailed, result)
        return result, nil
    end

	local result: any = nil -- (Instance?, string?) pair returned by the handler
	local handlerError: string? = nil

	local function runHandler()
		if tool.mode == "plan" then
			local value, err = handleRead(toolName, arguments)
			result = value; handlerError = err
			return
		end

		local ok, err = HistoryManager.transact(
			string.format("ForgePilot: %s", toolName),
			function()
				if toolName == "create_part" then
					result = handleCreatePart(arguments)
				elseif toolName == "create_model" then
					result = handleCreateModel(arguments)
				elseif toolName == "create_folder" then
					result = handleCreateFolder(arguments)
				elseif toolName == "create_building" then
					result = Buildings.create(arguments)
				elseif toolName == "create_road" then
					result = Roads.create(arguments)
				elseif toolName == "fill_terrain" then
					result = Terrain.fill(arguments)
				elseif toolName == "generate_map" then
					result = handleGenerateMap(arguments)
				elseif toolName == "create_ui" then
					result = handleCreateUI(arguments)
				elseif toolName == "create_script" then
					result = handleCreateScript(arguments)
				elseif toolName == "edit_script" then
					result = handleEditScript(arguments)
				elseif toolName == "append_script" then
					result = handleAppendScript(arguments)
				elseif toolName == "set_properties" then
					result = handleSetProperties(arguments)
				elseif toolName == "move_instance" then
					result = handleMove(arguments)
				elseif toolName == "resize_instance" then
					result = handleResize(arguments)
				elseif toolName == "group_instances" then
					result = handleGroup(arguments)
				elseif toolName == "configure_lighting" then
					result = LightingManager.apply(arguments.settings)
				elseif toolName == "delete_instance" then
					result = handleDelete(arguments)
				elseif toolName == "set_disabled" then
					result = handleSetDisabled(arguments)
				else
					error(string.format("No handler for write tool `%s`.", toolName), 0)
				end
			end
		)
		if not ok then
			handlerError = tostring(err)
		end
	end

	runHandler()

	local durationMs = (os.clock() - started) * 1000

	if handlerError then
		local message = string.format("`%s` failed: %s", toolName, handlerError)
		Logger.error("Build", "Tool execution failed.", { detail = message, toolName = toolName })
		EventBus.emit(EventBus.Events.ToolCallFailed, {
			toolName = toolName,
			actionId = actionId,
			message = message,
		})
		return {
			ok = false,
			toolName = toolName,
			verified = false,
			message = message,
			detail = handlerError,
			actionId = actionId,
			durationMs = durationMs,
		}, nil
	end

    if tool.mode == "plan" then
        local readResult = { ok = type(result) == "string", verified = type(result) == "string", toolName = toolName, message = tostring(result or "No inspection result."), actionId = actionId, durationMs = durationMs }
        EventBus.emit(EventBus.Events.ToolCallFinished, readResult)
        return readResult, nil
    end
	local resultInstance, resultNote = result
	local verified, detail = verify(toolName, arguments, resultInstance, resultNote)

	local executionResult: ExecutionResult = {
		ok = true,
		toolName = toolName,
		verified = verified,
		message = detail,
		detail = resultNote,
		actionId = actionId,
		durationMs = durationMs,
	}

	if verified then
		Logger.success("Build", ToolValidator.summarise(toolName, arguments), {
			detail = detail,
			toolName = toolName,
			durationMs = durationMs,
		})
	else
		Logger.error("Build", "Action finished but could not be verified.", {
			detail = detail,
			toolName = toolName,
		})
	end

	EventBus.emit(EventBus.Events.ToolCallFinished, executionResult)
	return executionResult, nil
end

--- Executes a read tool regardless of mode (used for context gathering).
function ActionExecutor.read(toolName: string, args: { [string]: any }?): (string?, string?)
	local validation = ToolValidator.validate(toolName, args or {}, "plan")
	if not validation.ok then
		return nil, table.concat(validation.errors, " ")
	end
	return handleRead(toolName, validation.arguments or {})
end

return ActionExecutor</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">ActionRegistry</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / ActionRegistry
	Duplicate build prevention.

	PROBLEM
	If ForgePilot successfully creates ten buildings and the provider then fails,
	retrying the request must not create ten more.

	APPROACH
	  * Every write tool call gets a stable key derived from the task id, the tool
	    call id and the tool arguments.
	  * A completed action is recorded ONLY after ActionExecutor verifies success.
	  * Before a call runs, the registry answers "has this already happened?".
	  * When the answer is genuinely unknown (an action failed mid-flight, or the
	    instance vanished), the caller is told to INSPECT rather than blindly repeat.
	  * Registry state is cleared when a task ends, so a fresh task legitimately
	    recreates the same objects.

	Verification is not inferred from the registry alone: the registry also checks
	that the instance it recorded still exists in the DataModel.
]]

local InstanceManager = require(script.Parent.InstanceManager)

local ActionRegistry = {}

--=============================================================================
-- RECORDS
--=============================================================================

export type Record = {
	key: string,
	taskId: string,
	toolCallId: string?,
	toolName: string,
	argumentsHash: string,
	verified: boolean,
	instancePath: string?,
	instanceClass: string?,
	completedAt: number,
	at: number,
}

local records: { [string]: Record } = {}
local order: { string } = {}
local byTask: { [string]: { string } } = {}

local MAX_RECORDS = 500

--=============================================================================
-- KEYS
--=============================================================================

--- A stable, order-independent fingerprint of a tool's arguments.
function ActionRegistry.hashArguments(arguments: any): string
	if type(arguments) ~= "table" then
		return "none"
	end

	local parts: { string } = {}
	for key, value in arguments do
		if key ~= "__required" then
			parts[#parts + 1] = string.format("%s=%s", tostring(key), ActionRegistry.stringify(value))
		end
	end
	table.sort(parts)

	-- FNV-1a over the sorted key/value list.
	local hash = 2166136261
	local text = table.concat(parts, "|")
	for index = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, index))
		hash = bit32.band(hash * 16777619, 0xFFFFFFFF)
	end
	return string.format("%08x", hash)
end

local function stringify(value: any, depth: number): string
	local level = depth or 0
	if level &gt; 6 then
		return "…"
	end
	local valueType = type(value)
	if valueType == "string" then
		return value
	elseif valueType == "number" or valueType == "boolean" then
		return tostring(value)
	elseif valueType == "table" then
		local keys = {}
		for key in pairs(value) do
			keys[#keys + 1] = key
		end
		table.sort(keys, function(a, b)
			return tostring(a) &lt; tostring(b)
		end)
		local parts = {}
		for _, key in keys do
			parts[#parts + 1] = string.format("%s:%s", tostring(key), stringify(value[key], level + 1))
		end
		return "{" .. table.concat(parts, ",") .. "}"
	end
	return "?"
end

ActionRegistry.stringify = stringify

--- Builds the deduplication key for a call.
function ActionRegistry.key(taskId: string, toolCallId: string?, toolName: string, arguments: any): string
	return string.format(
		"%s|%s|%s|%s",
		taskId,
		toolCallId or "-",
		toolName,
		ActionRegistry.hashArguments(arguments)
	)
end

--=============================================================================
-- RECORD
--=============================================================================

local function push(key: string, record: Record)
	records[key] = record
	order[#order + 1] = key
	byTask[record.taskId] = byTask[record.taskId] or {}
	table.insert(byTask[record.taskId], key)

	while #order &gt; MAX_RECORDS do
		local oldest = table.remove(order, 1)
		local oldRecord = records[oldest]
		records[oldest] = nil
		if oldRecord and byTask[oldRecord.taskId] then
			local taskKeys = byTask[oldRecord.taskId]
			for index, taskKey in taskKeys do
				if taskKey == oldest then
					table.remove(taskKeys, index)
					break
				end
			end
		end
	end
end

--- Records a verified action. Only ever called after the executor confirmed it.
function ActionRegistry.record(entry: {
	taskId: string,
	toolCallId: string?,
	toolName: string,
	arguments: any,
	verified: boolean,
	instance: Instance?,
}): Record
	local record: Record = {
		key = ActionRegistry.key(entry.taskId, entry.toolCallId, entry.toolName, entry.arguments),
		taskId = entry.taskId,
		toolCallId = entry.toolCallId,
		toolName = entry.toolName,
		argumentsHash = ActionRegistry.hashArguments(entry.arguments),
		verified = entry.verified,
		instancePath = if entry.instance and entry.instance.Parent
			then entry.instance:GetFullName()
			else nil,
		instanceClass = if entry.instance then entry.instance.ClassName else nil,
		completedAt = os.clock(),
		at = os.time(),
	}
	push(record.key, record)
	return record
end

--=============================================================================
-- QUERY
--=============================================================================

export type Prior = {
	replayed: boolean,
	reason: string,
	record: Record?,
	--- True when the caller should inspect the project before deciding.
	needsInspection: boolean,
}

--- Answers: has this exact call already completed successfully?
function ActionRegistry.check(
	taskId: string,
	toolCallId: string?,
	toolName: string,
	arguments: any
): Prior
	local key = ActionRegistry.key(taskId, toolCallId, toolName, arguments)
	local existing = records[key]
	if not existing then
		return { replayed = false, reason = "No prior record for this call.", record = nil, needsInspection = false }
	end

	if not existing.verified then
		return {
			replayed = false,
			reason = "A previous attempt at this call did not verify.",
			record = existing,
			needsInspection = true,
		}
	end

	-- The record claims success: confirm the object is still there.
	if existing.instancePath then
		local resolved = InstanceManager.findByPath(existing.instancePath)
		if resolved then
			return {
				replayed = true,
				reason = string.format("Already completed: %s exists.", existing.instancePath),
				record = existing,
				needsInspection = false,
			}
		end
		return {
			replayed = false,
			reason = string.format(
				"A previous attempt verified %s, but that instance no longer exists. Inspect before repeating.",
				existing.instancePath
			),
			record = existing,
			needsInspection = true,
		}
	end

	-- No instance to check (deletes, terrain, lighting): trust the record.
	return {
		replayed = true,
		reason = string.format("Already completed: %s.", existing.toolName),
		record = existing,
		needsInspection = false,
	}
end

function ActionRegistry.isRecorded(taskId: string, toolCallId: string?, toolName: string, arguments: any): boolean
	return records[ActionRegistry.key(taskId, toolCallId, toolName, arguments)] ~= nil
end

function ActionRegistry.get(key: string): Record?
	return records[key]
end

function ActionRegistry.getForTask(taskId: string): { Record }
	local list: { Record } = {}
	for _, key in (byTask[taskId] or {}) do
		local record = records[key]
		if record then
			list[#list + 1] = record
		end
	end
	table.sort(list, function(a, b)
		return a.at &lt; b.at
	end)
	return list
end

function ActionRegistry.countForTask(taskId: string): number
	local n = 0
	for _, key in (byTask[taskId] or {}) do
		if records[key] then
			n += 1
		end
	end
	return n
end

--=============================================================================
-- LIFECYCLE
--=============================================================================

--- Clears everything for a finished task so a new task may recreate the world.
function ActionRegistry.clearTask(taskId: string)
	local keys = byTask[taskId]
	if not keys then
		return
	end
	for _, key in keys do
		records[key] = nil
	end
	byTask[taskId] = nil
	for index = #order, 1, -1 do
		if not records[order[index]] then
			table.remove(order, index)
		end
	end
end

function ActionRegistry.clearAll()
	records = {}
	order = {}
	byTask = {}
end

--- Verification pass: drops records whose instance no longer exists.
function ActionRegistry.audit(): { dropped: number, kept: number }
	local dropped = 0
	local kept = 0
	for key, record in records do
		if record.instancePath and not InstanceManager.findByPath(record.instancePath) then
			records[key] = nil
			dropped += 1
		else
			kept += 1
		end
	end
	if dropped &gt; 0 then
		for index = #order, 1, -1 do
			if not records[order[index]] then
				table.remove(order, index)
			end
		end
	end
	return { dropped = dropped, kept = kept }
end

return ActionRegistry</string>
        </Properties>
      </Item>
