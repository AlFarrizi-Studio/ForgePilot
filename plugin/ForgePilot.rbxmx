-- Match the current 9router chat catalog. Credentials and OAuth protocol
-- differences remain in 9router, not in Roblox plugin preferences.
local RouterCatalog = require(script.Parent.RouterProviderCatalog)
for _, entry in RouterCatalog do
    presets[entry.id] = {
        id = entry.id, label = entry.label, providerType = "openai_compatible",
        protocol = "openai_compatible", baseUrl = "http://127.0.0.1:20128/v1",
        authStyle = "bearer", defaultHeaders = {}, docsUrl = entry.docsUrl,
        notes = "Connect this provider in 9Router. Select a model from Refresh models; account limits apply.",
        providerCapabilities = table.clone(PRESET_CAPABILITIES.unknownAll), modelMetadata = {},
        category = entry.category, iconId = entry.iconId, viaRouter = true,
        routerProviderId = entry.routerProviderId, routerAlias = entry.routerAlias,
        hasOAuth = entry.hasOAuth, noAuth = entry.noAuth, deprecated = entry.deprecated,
    }
end
local nativeIcons = { openai = "openai", openrouter = "openrouter", anthropic = "anthropic", gemini = "gemini", groq = "groq", deepseek = "deepseek", mistral = "mistral", together = "together" }
for id, preset in presets do
    if not preset.viaRouter then
        preset.category = "direct"
        preset.iconId = nativeIcons[id] or ""
    end
end
UniversalProviderRegistry.Presets = presets

function UniversalProviderRegistry.getPreset(id: any): Preset?
	if type(id) == "string" then
		return presets[id]
	end
	return nil
end

function UniversalProviderRegistry.presetList(): { Preset }
	local list = {}
	for _, preset in presets do
		list[#list + 1] = preset
	end
	table.sort(list, function(a, b)
		return a.label &lt; b.label
	end)
	return list
end

function UniversalProviderRegistry.presetsForType(providerType: ProviderType): { Preset }
	local list = {}
	for _, preset in presets do
		if preset.providerType == providerType then
			list[#list + 1] = preset
		end
	end
	table.sort(list, function(a, b)
		return a.label &lt; b.label
	end)
	return list
end

--=============================================================================
-- ENDPOINT RESOLUTION
--=============================================================================

--- Builds the final URL for a provider profile.
function UniversalProviderRegistry.resolveUrl(
	profile: {
		baseUrl: string,
		protocol: string,
		endpointPath: string?,
		urlMode: string?,
		modelId: string?,
	},
	options: { streaming: boolean? }?
): (string?, string?)
	local opts = options or {}
	local protocolId = profile.protocol
	local streaming = opts.streaming == true

	local route = APIEndpointRouter.get(protocolId)

	-- The endpoint path follows the protocol by default, so changing protocols
	-- can never leave a stale path behind. A path is honoured only when the user
	-- explicitly edited it (endpointPathCustom).
	local endpointPath: string = if profile.endpointPathCustom == true
			and type(profile.endpointPath) == "string"
		then profile.endpointPath
		else if streaming then route.stream or route.chat else route.chat

	local resolved = BaseURLResolver.resolve(profile.baseUrl, {
		endpointPath = endpointPath,
		mode = (profile.urlMode or "base") :: any,
		streaming = streaming,
		model = profile.modelId,
	})

	if not resolved.ok then
		return nil, resolved.error
	end

	local url = resolved.url :: string
	local needsQuery = if streaming then APIEndpointRouter.streamQuery(protocolId) else nil
	if needsQuery then
		if string.find(url, "?", 1, true) then
			url ..= "&amp;" .. needsQuery
		else
			url ..= "?" .. needsQuery
		end
	end
	return url, nil
end

--- The model-list URL, or nil plus a reason when the protocol has none.
function UniversalProviderRegistry.modelListUrl(profile: { baseUrl: string, protocol: string, endpointPath: string?, urlMode: string? }): (string?, string?)
	local path = APIEndpointRouter.modelsPath(profile.protocol)
	if not path then
		local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
		return nil,
			string.format(
				"%s does not expose a model list endpoint ForgePilot can read. Enter the model id manually.",
				protocol.label
			)
	end
	local resolved = BaseURLResolver.resolve(profile.baseUrl, {
		endpointPath = path,
		mode = (profile.urlMode or "base") :: any,
	})
	if not resolved.ok then
		return nil, resolved.error
	end
	return resolved.url, nil
end

function UniversalProviderRegistry.isTrustedHost(url: string?): boolean
	return BaseURLResolver.isTrustedHost(url)
end

--- Normalises a base URL. Kept for backwards compatibility.
function UniversalProviderRegistry.normaliseBaseUrl(raw: string?): (string?, string?)
	return BaseURLResolver.normaliseBase(raw or "")
end

--=============================================================================
-- PROFILE CONSTRUCTION
--=============================================================================

--- Creates a new, blank provider profile. No credentials are ever prefilled.
function UniversalProviderRegistry.newProfile(presetId: string): any
	local preset = UniversalProviderRegistry.getPreset(presetId) or presets.custom
	local route = APIEndpointRouter.get(preset.protocol)
	local profile: any = {
		id = Time.newId("provider"),
		displayName = preset.label,
		providerName = preset.label,
		providerType = preset.providerType,
		presetId = preset.id,
		viaRouter = preset.viaRouter,
		routerProviderId = preset.routerProviderId,
		routerAlias = preset.routerAlias,
		providerCategory = preset.category,
		iconId = preset.iconId,
		hasOAuth = preset.hasOAuth,
		routerNoAuth = preset.noAuth,
		protocol = preset.protocol,
		baseUrl = preset.baseUrl,
		endpointPath = route.chat,
		-- The path follows the protocol until the user edits it by hand.
		endpointPathCustom = false,
		urlMode = "base",
		modelId = "",
		authStyle = preset.authStyle,
		authHeaderName = preset.authHeaderName,
		authHeaderPrefix = nil,
		authQueryParam = nil,
		defaultHeaders = table.clone(preset.defaultHeaders or {}),
		extraHeaders = {},
		contextWindow = 128000,
		contextWindowMode = "auto",
		maxOutputTokens = 8192,
		maxOutputTokensMode = "auto",
		temperature = 0.7,
		topP = 1.0,
		reasoningEffort = "",
		reasoningIncludeSummary = true,
		streaming = true,
		toolCalling = true,
		parallelToolCalling = true,
		jsonMode = false,
		timeoutMs = 120000,
		retryOverrides = nil,
		schemaMapping = nil,
		createdAt = os.time(),
		updatedAt = os.time(),
	}
	-- The endpoint path must track the protocol: Custom REST has no default.
	if profile.protocol == "custom_rest" then
		profile.endpointPath = ""
	end
	return profile
end

--- Applies preset defaults without clobbering what the user already set.
function UniversalProviderRegistry.applyPreset(profile: any, presetId: string): boolean
	local preset = UniversalProviderRegistry.getPreset(presetId)
	if not preset then
		return false
	end
	local route = APIEndpointRouter.get(preset.protocol)
	profile.providerType = preset.providerType
	profile.protocol = preset.protocol
	profile.presetId = preset.id
	profile.viaRouter = preset.viaRouter
	profile.routerProviderId = preset.routerProviderId
	profile.routerAlias = preset.routerAlias
	profile.providerCategory = preset.category
	profile.iconId = preset.iconId
	profile.hasOAuth = preset.hasOAuth
	profile.routerNoAuth = preset.noAuth
	profile.providerName = preset.label
	profile.authStyle = preset.authStyle
	profile.authHeaderName = preset.authHeaderName
	profile.defaultHeaders = table.clone(preset.defaultHeaders or {})
	if type(profile.baseUrl) ~= "string" or #profile.baseUrl == 0 then
		profile.baseUrl = preset.baseUrl
	end
	if type(profile.endpointPath) ~= "string" or #profile.endpointPath == 0 then
		profile.endpointPath = route.chat
	end
	return true
end

return UniversalProviderRegistry</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="36">
      <Properties>
        <string name="Name">Core</string>
      </Properties>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">ApplicationController</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Core / ApplicationController
	Wires the plugin object to every subsystem and owns top-level lifecycle.

	Startup is staged and every stage reports its own outcome. Stages the window
	cannot exist without are required; everything else is optional, so a broken
	optional subsystem degrades the interface instead of preventing it from
	opening. `init` never throws: it returns a report the bootstrap can display.
]]

local ActivityLogs = require(script.Parent.Parent.UI.ActivityLogs)
local BuilderView = require(script.Parent.Parent.UI.BuilderView)
local ChatView = require(script.Parent.Parent.UI.ChatView)
local Components = require(script.Parent.Parent.UI.Components)
local ContextManager = require(script.Parent.Parent.AI.ContextManager)
local CredentialStore = require(script.Parent.CredentialStore)
local EventBus = require(script.Parent.EventBus)
local HistoryManager = require(script.Parent.Parent.Roblox.HistoryManager)
local HistoryView = require(script.Parent.Parent.UI.HistoryView)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ModelCapabilityDetector = require(script.Parent.Parent.AI.ModelCapabilityDetector)
local ProviderRateLimitScheduler = require(script.Parent.Parent.AI.ProviderRateLimitScheduler)
local RetryStateManager = require(script.Parent.Parent.AI.RetryStateManager)
local SessionManager = require(script.Parent.SessionManager)
local SettingsManager = require(script.Parent.SettingsManager)
local SettingsView = require(script.Parent.Parent.UI.SettingsView)
local StateManager = require(script.Parent.StateManager)
local StreamingManager = require(script.Parent.Parent.AI.StreamingManager)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local WelcomeDialog = require(script.Parent.Parent.UI.WelcomeDialog)
local DockWidget = require(script.Parent.Parent.UI.DockWidget)

local ApplicationController = {}

export type StageReport = {
	stage: string,
	modulePath: string,
	ok: boolean,
	required: boolean,
	cause: string?,
	trace: string?,
}

export type Report = {
	ok: boolean,
	stages: { StageReport },
	cause: string?,
	trace: string?,
}

local pluginRef: Plugin? = nil
local gui: PluginGui? = nil
local views: { [string]: any } = {}
-- Per-view teardown hooks, kept out of the Instances themselves.
local viewApis: { [string]: any } = {}
local currentSection: string = "chat"
local unsubs: { () -> () } = {}
local lastReport: Report? = nil

--=============================================================================
-- HEADER STATUS
--=============================================================================

local function refreshHeader()
	local settings = SettingsManager.get()
	Theme.motionEnabled = settings.animations ~= false and not settings.reducedMotion
	DockWidget.setSubtitle(string.format("%s · %s", settings.assistantName, game.Name))

	local profile = SettingsManager.getActiveProvider()
	if not profile then
		DockWidget.setStatus("No AI Provider Configured", Theme.Extra.Muted)
		return
	end

	local hasKey = profile.viaRouter or profile.authStyle == "none" or CredentialStore.has(profile.id)
	local modelLabel = if profile.modelId ~= "" then profile.modelId else "(no model set)"

	if not hasKey then
		DockWidget.setStatus(string.format("%s · no key", profile.displayName), Theme.Extra.Warning)
	else
		local stream = StreamingManager.streamingStatus(profile)
		local suffix = if stream.available then "" else " · no stream"
		DockWidget.setStatus(string.format("%s · %s%s", profile.displayName, modelLabel, suffix), Theme.Extra.Muted)
	end
end

--=============================================================================
-- BUILD
--=============================================================================

--- Each view is built independently: one failing view leaves the rest usable and
--- is reported instead of taking the window down with it.
local function buildViews(content: Frame, stages: { StageReport })
	local builders: { [string]: (Frame) -> any } = {
		chat = function(frame)
			return ChatView.build(frame, {
				onNavigate = function(section: string)
					DockWidget.navigate(section)
				end,
			})
		end,
		builder = BuilderView.build,
		history = HistoryView.build,
		logs = ActivityLogs.build,
		settings = SettingsView.build,
	}

	for _, name in ipairs(DockWidget.SectionOrder) do
		local builder = builders[name]
		if builder then
			-- Every view build returns (frame, api). The frame is the GuiObject;
			-- the api is a plain table because Roblox Instances cannot carry
			-- extra members.
			local ok, frame, api = xpcall(function()
				return builder(content)
			end, function(message)
				return debug.traceback(tostring(message), 2)
			end)
			local stage: StageReport = {
				stage = "Initial UI Rendering",
				modulePath = string.format("UI/%s", name),
				ok = ok,
				required = false,
			}
			if ok and frame then
				views[name] = frame
				viewApis[name] = api
				views[name].Visible = name == "chat"
				views[name].Parent = content
			else
				stage.cause = tostring(frame)
				stage.trace = tostring(frame)
				warn("[ForgePilot][VIEW ERROR] UI/" .. name .. ": " .. stage.cause)
			end
			stages[#stages + 1] = stage
		end
	end

	if views.chat then
		views.chat.Visible = true
	end
end

--=============================================================================
-- STAGE RUNNER
--=============================================================================

local function runStage(
	stages: { StageReport },
	name: string,
	modulePath: string,
	required: boolean,
	action: () -> ()
): boolean
	local ok, err = xpcall(action, function(message)
		return debug.traceback(tostring(message), 2)
	end)
	local stage: StageReport = {
		stage = name,
		modulePath = modulePath,
		ok = ok,
		required = required,
	}
	if not ok then
		stage.cause = tostring(err)
		stage.trace = tostring(err)
		warn("[ForgePilot][STAGE ERROR] " .. name .. " (" .. modulePath .. "): " .. stage.cause)
	end
	stages[#stages + 1] = stage
	return ok
end

--=============================================================================
-- INIT
--=============================================================================

--- Starts ForgePilot. Always returns a report; never throws.
function ApplicationController.init(plugin: Plugin): Report
	pluginRef = plugin

	local stages: { StageReport } = {}
	local report: Report = { ok = true, stages = stages }
	lastReport = report

	local function finish(): Report
		for _, stage in ipairs(stages) do
			if not stage.ok and stage.required then
				report.ok = false
				report.cause = stage.cause
				report.trace = stage.trace
				break
			elseif not stage.ok and report.cause == nil then
				report.cause = string.format("%s (%s): %s", stage.stage, stage.modulePath, tostring(stage.cause))
				report.trace = stage.trace
			end
		end
		return report
	end

	-- 1. Core services --------------------------------------------------------
	if not runStage(stages, "Core Services", "Core/SettingsManager", true, function()
		SettingsManager.init(plugin)
		Theme.motionEnabled = SettingsManager.get().animations ~= false and not SettingsManager.get().reducedMotion
		SessionManager.init(plugin)
		HistoryManager.resetOrphan()
	end) then
		return finish()
	end

	-- 2. State ----------------------------------------------------------------
	runStage(stages, "State Manager", "Core/StateManager", true, function()
		RetryStateManager.init()
	end)
	runStage(stages, "State Manager", "AI/ProviderRateLimitScheduler", false, function()
		ProviderRateLimitScheduler.setEnabled(
			SettingsManager.getValue("smartRetry") ~= nil
				and SettingsManager.get().smartRetry.rateLimitScheduler ~= false
		)
	end)

	-- 3. Dock widget ----------------------------------------------------------
	local builtOk = runStage(stages, "DockWidget Creation", "UI/DockWidget", true, function()
		gui = DockWidget.build(plugin)
	end)
	if not builtOk or not gui then
		return finish()
	end

	-- 4. Provider capabilities (optional; never blocks the window) -----------
	runStage(stages, "Context Manager", "AI/ModelCapabilityDetector", false, function()
		local profile = SettingsManager.getActiveProvider()
		if profile then
			ModelCapabilityDetector.buildReport(profile)
			ContextManager.configure(profile, ModelCapabilityDetector.getOrBuildReport(profile))
		end
	end)

	-- 5. Views ----------------------------------------------------------------
	runStage(stages, "UI Components", "UI/*", false, function()
		buildViews(DockWidget.content, stages)
	end)

	-- 6. Event binding --------------------------------------------------------
	runStage(stages, "Event Binding", "Core/EventBus", false, function()
		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.Navigate, function(payload)
			local section = payload.section :: string
			if not table.find(DockWidget.SectionOrder, section) then return end
			Components.closeMenus()
			currentSection = section
			for name in pairs(views) do
				local view = views[name]
				if view then
					view.Visible = (name == section)
				end
			end
		end)

		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ProvidersChanged, refreshHeader)
		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ActiveProviderChanged, refreshHeader)
		local function syncContext()
			local profile = SettingsManager.getActiveProvider()
			ContextManager.configure(profile, if profile then ModelCapabilityDetector.getOrBuildReport(profile) else nil)
		end
		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ActiveProviderChanged, syncContext)
		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ProvidersChanged, syncContext)
		unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.CapabilitiesChanged, syncContext)
	end)

	-- 7. Initial render -------------------------------------------------------
	runStage(stages, "Initial UI Rendering", "UI/DockWidget", false, function()
		refreshHeader()
	end)

	Logger.info("System", "ForgePilot ready.", {
		detail = SettingsManager.getActiveProvider()
				and "A provider profile is selected. Enter an API key in Settings."
			or "No provider configured. ForgePilot is usable offline for editor tools.",
	})

	-- First-run naming prompt (optional, skippable, never blocks the UI).
	task.defer(function()
		local window = gui
		if not window then
			return
		end
		pcall(function()
			window.Enabled = true
		end)
		local ok, result = pcall(function()
			return WelcomeDialog.show(window)
		end)
		if ok and type(result) == "table" and result.named then
			refreshHeader()
		end
	end)

	ApplicationController.views = views
	ApplicationController.gui = gui
	return finish()
end

function ApplicationController.getViews()
	return views
end

function ApplicationController.getGui()
	return gui
end

function ApplicationController.getReport(): Report?
	return lastReport
end

function ApplicationController.destroy()
	for _, name in ipairs(DockWidget.SectionOrder) do
		local api = viewApis[name]
		if api and typeof(api.destroy) == "function" then
			local ok, err = pcall(api.destroy)
			if not ok then
				warn("[ForgePilot] View teardown failed (" .. name .. "): " .. tostring(err))
			end
		end
	end
	for _, unsubscribe in ipairs(unsubs) do
		local ok, err = pcall(unsubscribe)
		if not ok then
			warn("[ForgePilot] Unsubscribe failed during shutdown: " .. tostring(err))
		end
	end
	table.clear(unsubs)
	table.clear(views)
	table.clear(viewApis)
	if gui then gui:Destroy() end
	gui = nil
	pluginRef = nil
	HistoryManager.resetOrphan()
end

return ApplicationController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">BridgeClient</string>
          <string name="Source"><![CDATA[--!strict
-- Local companion transport. The pairing token is session-only and is never
-- sent in prompts, saved with plugin preferences, or forwarded to providers.
local HttpService = game:GetService("HttpService")
local SettingsManager = require(script.Parent.SettingsManager)
local EventBus = require(script.Parent.EventBus)
local BridgeClient = {}
local token = ""
local health: any = nil
local endpointGeneration = 0
local modelMetadata: { [string]: any } = {}

local function endpoint(): string?
    if SettingsManager.getValue("bridgeEnabled") == false then return nil end
    local url = SettingsManager.getValue("bridgeUrl") or "http://127.0.0.1:20129"
    if not string.match(url, "^http://127%.0%.0%.1:%d+/?$") and not string.match(url, "^http://localhost:%d+/?$") then return nil end
    return string.gsub(url, "/$", "")
end
function BridgeClient.setToken(value: string)
    token = string.gsub(value or "", "^%s*(.-)%s*$", "%1")
    health = nil
    endpointGeneration += 1
end
function BridgeClient.reset()
    health = nil
    endpointGeneration += 1
end
function BridgeClient.isConnected(): boolean
    return health ~= nil and endpoint() ~= nil and #token >= 24
end
function BridgeClient.getHealth(): any return health end
function BridgeClient.canTool(name: string): boolean
    return BridgeClient.isConnected() and (name ~= "run_command" or health.fullAccess == true)
end
function BridgeClient.request(route: string, body: any?, method: string?, timeout: number?, shouldCancel: (() -> boolean)?): (any?, string?)
    local base = endpoint()
    if not base or #token < 24 then return nil, "Start-ForgePilot-Bridge and connect it in Settings > Agent Access. Setup: https://github.com/AlFarrizi-Studio/ForgePilot" end
    local current = endpointGeneration
    local done = false
    local response: any = nil
    local failure: string? = nil
    local worker = task.spawn(function()
        local ok, value = pcall(function()
            local request: any = { Url = base .. route, Method = method or (if body then "POST" else "GET"), Headers = { Authorization = "Bearer " .. token } }
            if body then request.Headers["Content-Type"] = "application/json"; request.Body = HttpService:JSONEncode(body) end
            return HttpService:RequestAsync(request)
        end)
        if done or current ~= endpointGeneration then return end
        if ok then response = value else failure = "Local bridge request failed. Check that its terminal is still open and HTTP access is allowed." end
        done = true
    end)
    local started = os.clock()
    while not done do
        if current ~= endpointGeneration or (shouldCancel and shouldCancel()) then done = true; pcall(task.cancel, worker); return nil, "Cancelled." end
        if os.clock() - started > (timeout or 15) then done = true; pcall(task.cancel, worker); return nil, "Local bridge request timed out." end
        task.wait()
    end
    if failure then health = nil; return nil, failure end
    if type(response) ~= "table" or type(response.Body) ~= "string" or type(response.StatusCode) ~= "number" then return nil, "Bridge returned an invalid HTTP response." end
    local ok, value = pcall(HttpService.JSONDecode, HttpService, response.Body)
    if not ok or type(value) ~= "table" then return nil, "Bridge returned an invalid response." end
    if response.StatusCode < 200 or response.StatusCode >= 300 then return nil, tostring(value.message or "Bridge rejected the request.") end
    return value, nil
end
function BridgeClient.connect(): (any?, string?)
    local current = endpointGeneration
    local value, err = BridgeClient.request("/health")
    if value and value.ok and type(value.capabilities) == "table" and (value.capabilities.toolJobs ~= true or value.capabilities.streamIdleTimeout ~= true) then
        value = nil
        err = "The bridge is from an older package. Stop its terminal and run the new Start-ForgePilot-Bridge before reconnecting."
    end
    if current == endpointGeneration then
        health = if value and value.ok and type(value.capabilities) == "table" then value else nil
        EventBus.emit("BridgeChanged", { connected = health ~= nil })
    end
    return health, err
end
function BridgeClient.capabilityText(): string
    if not BridgeClient.isConnected() then return "Local bridge is disconnected. Web search, URL fetching, local files, downloads, terminal commands and file-based image tools are unavailable. Tell the user plainly when their request needs one of these features and show https://github.com/AlFarrizi-Studio/ForgePilot for setup, then Settings > Agent Access. Roblox inspection/build tools are still available. User-selected image/document attachments depend separately on the selected model and adapter; do not promise vision until supported input was supplied." end
    return string.format("Local bridge connected. Workspace: %s. File scope: %s. Web search, fetching URLs, reading/searching files and viewing supported images are available. Build also permits file editing and downloads%s. The operating system's permissions still apply. Image interpretation depends on the selected model's vision capability.", tostring(health.workspace), if health.fullAccess then "full computer access" else "workspace only", if health.fullAccess then " and terminal commands" else "")
end
function BridgeClient.execute(name: string, args: any, mode: string, shouldCancel: (() -> boolean)?): (any?, string?)
    local id = HttpService:GenerateGUID(false)
    local function cancelJob()
        task.spawn(function() BridgeClient.request("/cancel", { operationId = id }, "POST", 5) end)
    end
    local job, err = BridgeClient.request("/tools/start", { name = name, arguments = args, mode = mode, operationId = id }, "POST", 15, shouldCancel)
    if not job then cancelJob(); return nil, err end
    local deadline = os.clock() + 320
    while true do
        if (shouldCancel and shouldCancel()) or os.clock() >= deadline then
            cancelJob()
            return nil, if os.clock() >= deadline then "Local tool timed out." else "Cancelled."
        end
        local value, problem = BridgeClient.request("/tools/" .. id, nil, "GET", 15, shouldCancel)
        if not value then cancelJob(); return nil, problem end
        if value.done then return value.result, value.error end
        -- Yield even if an immediate localhost response contains no result.
        task.wait()
    end
end
function BridgeClient.stream(request: any, callbacks: any): (any?, string?)
    local current = endpointGeneration
    local job, err = BridgeClient.request("/stream", request, "POST", 15)
    if not job then return nil, err end
    if type(job.id) ~= "string" then return nil, "Bridge returned an invalid stream id." end
    local cancelled = false
    local done = false
    local released = false
    local cursor = 0
    local started = os.clock()
    local idleSeconds = math.clamp((request.timeoutMs or 120000) / 1000, 1, 600)
    local lastActivity = started
    local activitySequence: number? = nil
    local collected = {}
    local function release()
        if released then return end
        released = true
        task.spawn(function() BridgeClient.request("/stream/" .. job.id, nil, "DELETE", 5) end)
    end
    local function reportError(message: string)
        done = true
        release()
        if callbacks.onError then pcall(callbacks.onError, message) end
    end
    local function cancel()
        if done then return end
        cancelled = true; done = true; release()
    end
    task.spawn(function()
        -- A parser/UI callback exception must still settle the transport handle.
        local ok = pcall(function()
            while not done do
                if current ~= endpointGeneration then cancel(); break end
                if os.clock() - lastActivity >= idleSeconds then reportError("Provider stream timed out: no upstream data within the configured idle timeout."); break end
                local value, problem = BridgeClient.request("/stream/" .. job.id .. "?cursor=" .. tostring(cursor), nil, "GET", math.min(15, math.max(1, idleSeconds - (os.clock() - lastActivity))), function() return cancelled end)
                if cancelled or done then break end
                if not value then reportError(problem or "Bridge stream failed."); break end
                if type(value.activitySequence) == "number" and value.activitySequence ~= activitySequence then
                    activitySequence = value.activitySequence
                    lastActivity = os.clock()
                    if callbacks.onActivity then callbacks.onActivity() end
                end
                for _, event in (value.events or {}) do
                    if type(event.cursor) ~= "number" or type(event.chunk) ~= "string" then error("Invalid bridge stream event.") end
                    if event.cursor > cursor then
                        lastActivity = os.clock()
                        if callbacks.onActivity then callbacks.onActivity() end
                        collected[#collected + 1] = event.chunk
                        cursor = event.cursor
                        if callbacks.onChunk then callbacks.onChunk(event.chunk) end
                    end
                end
                if value.done then
                    done = true
                    release()
                    if value.error then
                        if callbacks.onError then pcall(callbacks.onError, value.error) end
                    elseif callbacks.onComplete then
                        callbacks.onComplete(table.concat(collected), (os.clock() - started) * 1000, value.statusCode)
                    end
                else
                    task.wait()
                end
            end
        end)
        if not ok then reportError("Stream processing failed. Check Logs, then retry the request.") end
    end)
    return { cancel = cancel, isCancelled = function() return cancelled end, isDone = function() return done end, frames = collected }, nil
end
function BridgeClient.openProvider(providerId: string): (any?, string?)
    return BridgeClient.request("/providers/open", { providerId = providerId })
end
function BridgeClient.providerStatus(providerId: string): (any?, string?)
    return BridgeClient.request("/providers/status", { providerId = providerId })
end
function BridgeClient.signInRouter(password: string): (any?, string?)
    return BridgeClient.request("/router/login", { password = password })
end
function BridgeClient.listModels(profile: any, apiKey: string?, shouldCancel: (() -> boolean)?): ({ string }?, string?)
    local value, err = BridgeClient.request("/router/models", { providerId = profile.routerProviderId, apiKey = apiKey }, "POST", 15, shouldCancel)
    if not value then return nil, err end
    local metadata = if type(value.metadata) == "table" then value.metadata else {}
    modelMetadata[profile.routerProviderId] = metadata
    EventBus.emit("RouterModelsChanged", { providerId = profile.routerProviderId })
    return value.models or {}, nil
end
function BridgeClient.getModelMetadata(profile: any): any
    local bucket = modelMetadata[profile.routerProviderId]
    if not bucket then return nil end
    local model = profile.modelId or ""
    return bucket[model] or bucket[(profile.routerAlias or "") .. "/" .. model]
end
return BridgeClient
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">CredentialStore</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Core / CredentialStore
	Session-only secret storage.

	This is a plain in-memory table, not an encrypted vault and not persisted
	anywhere. Its lifetime is the current Roblox Studio session. On restart the
	user must re-enter each API key, which the UI states plainly.
]]

local EventBus = require(script.Parent.EventBus)
local Redact = require(script.Parent.Parent.Utilities.Redact)

local CredentialStore = {}

-- slot id -&gt; secret string
local slots: { [string]: string } = {}

local function fingerprintOf(id: string): string
	return Redact.fingerprint(slots[id] or "")
end

--=============================================================================
-- CRUD
--=============================================================================

--- Stores a secret in a named slot (usually `&lt;providerId&gt;`).
function CredentialStore.set(id: string, secret: string)
	if type(id) ~= "string" or #id == 0 then
		return false
	end
	if type(secret) ~= "string" or #secret == 0 then
		slots[id] = nil
	else
		slots[id] = secret
	end
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "credential", slotId = id })
	return true
end

--- Reads a secret. Callers should minimise how long they hold the value.
function CredentialStore.get(id: string): string?
	return slots[id]
end

function CredentialStore.has(id: string): boolean
	return slots[id] ~= nil
end

--- Non-reversible fingerprint for "is a key loaded?" indicators.
function CredentialStore.fingerprint(id: string): string
	return fingerprintOf(id)
end

--- Safe preview for UI: only ever shows head/tail characters.
function CredentialStore.preview(id: string): string
	local secret = slots[id]
	if not secret then
		return ""
	end
	return Redact.mask(secret)
end

function CredentialStore.clear(id: string)
	slots[id] = nil
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "credentialCleared", slotId = id })
end

function CredentialStore.clearAll()
	table.clear(slots)
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "credentialsCleared" })
end

function CredentialStore.count(): number
	local n = 0
	for _ in slots do
		n += 1
	end
	return n
end

--- Returns ids of slots that hold a secret (ids are not secret).
function CredentialStore.slots(): { string }
	local list = {}
	for id in slots do
		list[#list + 1] = id
	end
	table.sort(list)
	return list
end

return CredentialStore</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">EventBus</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Core / EventBus
	Typed signal hub shared by the AI, Roblox and UI layers.

	Modules never hold references to each other directly; they publish and
	subscribe here. This keeps the plugin's dependency graph acyclic.
]]

export type Payload = { [string]: any }

local EventBus = {}

-- Canonical event names. Referencing these constants avoids string typos.
EventBus.Events = {
	-- Session / chat
	MessageStarted = "message:started",
	MessageDelta = "message:delta",
	MessageUpdated = "message:updated",
	MessageCompleted = "message:completed",
	MessageFailed = "message:failed",
	ConversationChanged = "conversation:changed",
	ConversationListChanged = "conversation:list",
	ConversationRenamed = "conversation:renamed",
	ConversationDeleted = "conversation:deleted",
	ConversationSearchResults = "conversation:search",

	-- Agent lifecycle
	StateChanged = "agent:stateChanged",
	ModeChanged = "agent:modeChanged",
	ActivityChanged = "agent:activity",
	ThinkingStarted = "agent:thinkingStarted",
	ThinkingEnded = "agent:thinkingEnded",

	-- Providers
	ProvidersChanged = "provider:changed",
	ActiveProviderChanged = "provider:activeChanged",
	ConnectionTestResult = "provider:testResult",
	CapabilitiesChanged = "provider:capabilities",
	ModelListChanged = "provider:models",

	-- Context
	TokenUsageChanged = "context:tokens",
	ContextChanged = "context:changed",

	-- Attachments
	AttachmentsChanged = "attachment:changed",

	-- Questions
	QuestionAsked = "question:asked",
	QuestionAnswered = "question:answered",
	QuestionCancelled = "question:cancelled",

	-- Tools
	ToolCallStarted = "tool:started",
	ToolCallFinished = "tool:finished",
	ToolCallFailed = "tool:failed",
	ApprovalRequested = "tool:approval",
	ApprovalResolved = "tool:approvalResolved",
	BuildProgress = "tool:progress",

	-- UI
	Navigate = "ui:navigate",
	Toast = "ui:toast",
	FloatingSizeChanged = "ui:floatingSize",
	StreamEvent = "ui:streamEvent",
}

type Handler = (payload: Payload) -&gt; ()

local handlers: { [string]: { { id: number, callback: Handler } } } = {}
local nextHandlerId = 1

--=============================================================================
-- SUBSCRIBE
--=============================================================================

--- Subscribes to an event. Returns a function that unsubscribes.
function EventBus.on(eventName: string, callback: Handler): () -&gt; ()
	local bucket = handlers[eventName]
	if not bucket then
		bucket = {}
		handlers[eventName] = bucket
	end
	local id = nextHandlerId
	nextHandlerId += 1
	table.insert(bucket, { id = id, callback = callback })

	return function()
		local current = handlers[eventName]
		if not current then
			return
		end
		for index, entry in current do
			if entry.id == id then
				table.remove(current, index)
				return
			end
		end
	end
end

--- Subscribes for a single delivery.
function EventBus.once(eventName: string, callback: Handler): () -&gt; ()
	local disconnect: () -&gt; ()
	disconnect = EventBus.on(eventName, function(payload)
		disconnect()
		callback(payload)
	end)
	return disconnect
end

--=============================================================================
-- PUBLISH
--=============================================================================

function EventBus.emit(eventName: string, payload: Payload?)
	local bucket = handlers[eventName]
	if not bucket then
		return
	end
	-- Copy so handlers may subscribe/unsubscribe during dispatch.
	local snapshot = table.clone(bucket)
	local body = payload or {}
	for _, entry in snapshot do
		local ok, err = pcall(entry.callback, body)
		if not ok then
			warn(string.format("[ForgePilot] handler error for '%s': %s", eventName, tostring(err)))
		end
	end
end

function EventBus.clear(eventName: string?)
	if eventName then
		handlers[eventName] = nil
	else
		table.clear(handlers)
	end
end

function EventBus.listenerCount(eventName: string): number
	local bucket = handlers[eventName]
	return bucket and #bucket or 0
end

return EventBus</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">SessionManager</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Core / SessionManager
	Conversation list, message storage, and per-session token accounting.

	Messages are persisted to Plugin:SetSetting under a dedicated key so history
	survives a Studio restart. Every message passes through Redact on the way in,
	so a pasted API key can never be written to disk.
]]

local EventBus = require(script.Parent.EventBus)
local StateManager = require(script.Parent.StateManager)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Time = require(script.Parent.Parent.Utilities.Time)

local SessionManager = {}

local HISTORY_KEY = "ForgePilot.Conversations.v1"
local MAX_CONVERSATIONS = 60
local MAX_MESSAGES_PER_CONVERSATION = 400

export type Role = "system" | "user" | "assistant" | "tool"

export type Message = {
	internal: boolean?,
	policyBlocked: boolean?,
	id: string,
	role: Role,
	content: string,
	at: number,
	taskId: string?,
	toolCallId: string?,
	attachments: { { name: string, mime: string, sizeBytes: number } }?,
	reasoning: string?,
	toolCalls: { { id: string, name: string, args: any, result: string?, state: string } }?,
	question: any?,
	plan: any?,
	streaming: boolean?,
	elapsedMs: number?,
	usage: { input: number?, output: number?, reasoning: number?, total: number? }?,
	model: string?,
	error: string?,
}

export type Conversation = {
	id: string,
	title: string,
	createdAt: number,
	updatedAt: number,
	mode: string,
	providerId: string?,
	model: string?,
	messages: { Message },
	summary: string?,
	editorContext: string?,
	summarisedUpTo: number,
	totalInput: number,
	totalOutput: number,
	totalReasoning: number,
}

local conversations: { Conversation } = {}
local activeConversationId: string? = nil
local pluginRef: Plugin? = nil

--=============================================================================
-- LIFECYCLE
--=============================================================================

local function serialisable(message: Message): any
	return {
		internal = message.internal,
		policyBlocked = message.policyBlocked,
		id = message.id,
		role = message.role,
		content = Redact.scrubText(message.content),
		at = message.at,
		taskId = message.taskId,
		toolCallId = message.toolCallId,
		attachments = message.attachments,
		reasoning = if message.reasoning then Redact.scrubText(message.reasoning) else nil,
		toolCalls = message.toolCalls,
		question = message.question,
		plan = message.plan,
		elapsedMs = message.elapsedMs,
		usage = message.usage,
		model = message.model,
		error = if message.error then Redact.scrubText(message.error) else nil,
	}
end

local function deserialisable(raw: any): Message?
	if type(raw) ~= "table" or type(raw.id) ~= "string" then
		return nil
	end
	return {
		internal = raw.internal == true,
		policyBlocked = raw.policyBlocked == true,
		id = raw.id,
		role = (raw.role or "user") :: Role,
		content = tostring(raw.content or ""),
		at = tonumber(raw.at) or os.time(),
		taskId = raw.taskId,
		toolCallId = raw.toolCallId,
		attachments = raw.attachments,
		reasoning = raw.reasoning,
		toolCalls = raw.toolCalls,
		question = raw.question,
		plan = raw.plan,
		elapsedMs = raw.elapsedMs,
		usage = raw.usage,
		model = raw.model,
		error = raw.error,
	}
end

function SessionManager.init(plugin: Plugin)
	pluginRef = plugin
	SessionManager.load()
end

function SessionManager.load()
	conversations = {}
	activeConversationId = nil
	if not pluginRef then
		return
	end
	local ok, raw = pcall(pluginRef.GetSetting, pluginRef, HISTORY_KEY)
	if not ok or type(raw) ~= "string" or #raw == 0 then
		return
	end
	local decodeOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if not decodeOk or type(decoded) ~= "table" then
		return
	end
	for _, entry in decoded do
		if type(entry) == "table" and type(entry.id) == "string" then
			local messages = {}
			for _, rawMessage in (entry.messages or {}) do
				local message = deserialisable(rawMessage)
				if message then
					messages[#messages + 1] = message
				end
			end
			conversations[#conversations + 1] = {
				id = entry.id,
				title = tostring(entry.title or "New chat"),
				createdAt = tonumber(entry.createdAt) or os.time(),
				updatedAt = tonumber(entry.updatedAt) or os.time(),
				mode = tostring(entry.mode or "plan"),
				providerId = entry.providerId,
				model = entry.model,
				messages = messages,
				summary = entry.summary,
				summarisedUpTo = tonumber(entry.summarisedUpTo) or 0,
				totalInput = tonumber(entry.totalInput) or 0,
				totalOutput = tonumber(entry.totalOutput) or 0,
				totalReasoning = tonumber(entry.totalReasoning) or 0,
			}
		end
	end
	if #conversations > 0 then
		activeConversationId = conversations[1].id
	end
end

function SessionManager.persist()
	if not pluginRef then
		return false
	end
	local payload = {}
	for _, conversation in conversations do
		local messages = {}
		for _, message in conversation.messages do
			messages[#messages + 1] = serialisable(message)
		end
		payload[#payload + 1] = {
			id = conversation.id,
			title = conversation.title,
			createdAt = conversation.createdAt,
			updatedAt = conversation.updatedAt,
			mode = conversation.mode,
			providerId = conversation.providerId,
			model = conversation.model,
			messages = messages,
			summary = conversation.summary,
			summarisedUpTo = conversation.summarisedUpTo,
			totalInput = conversation.totalInput,
			totalOutput = conversation.totalOutput,
			totalReasoning = conversation.totalReasoning,
		}
	end
	local encodeOk, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
	if not encodeOk then
		return false
	end
	local setOk = pcall(pluginRef.SetSetting, pluginRef, HISTORY_KEY, encoded)
	return setOk
end

--=============================================================================
-- CONVERSATIONS
--=============================================================================

function SessionManager.getConversations(): { Conversation }
	return table.clone(conversations)
end

function SessionManager.getConversation(id: string?): Conversation?
	if not id then
		return nil
	end
	for _, conversation in conversations do
		if conversation.id == id then
			return conversation
		end
	end
	return nil
end

function SessionManager.getActive(): Conversation?
	return SessionManager.getConversation(activeConversationId)
end

function SessionManager.getActiveId(): string?
	return activeConversationId
end

function SessionManager.createConversation(options: { title: string?, mode: string?, providerId: string?, model: string? }?): Conversation
	local active = SessionManager.getActive()
	if StateManager.isBusy() and active then
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Wait for the current task to finish before starting a new chat." })
		return active
	end
	local opts = options or {}
	local conversation: Conversation = {
		id = Time.newId("conv"),
		title = opts.title or "New chat",
		createdAt = os.time(),
		updatedAt = os.time(),
		mode = opts.mode or "build",
		providerId = opts.providerId,
		model = opts.model,
		messages = {},
		summary = nil,
		summarisedUpTo = 0,
		totalInput = 0,
		totalOutput = 0,
		totalReasoning = 0,
	}
	table.insert(conversations, 1, conversation)
	while #conversations > MAX_CONVERSATIONS do
		table.remove(conversations)
	end
	activeConversationId = conversation.id
	SessionManager.persist()
	EventBus.emit(EventBus.Events.ConversationChanged, { conversationId = conversation.id })
	EventBus.emit(EventBus.Events.ConversationListChanged, {})
	return conversation
end

--- Ensures a conversation exists; creates one on first use.
function SessionManager.ensureConversation(): Conversation
	local active = SessionManager.getActive()
	if active then
		return active
	end
	return SessionManager.createConversation()
end

function SessionManager.setActive(id: string)
	if StateManager.isBusy() and id ~= activeConversationId then
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Wait for the current task to finish before switching chats." })
		return false
	end
	local conversation = SessionManager.getConversation(id)
	if not conversation then
		return false
	end
	activeConversationId = id
	EventBus.emit(EventBus.Events.ConversationChanged, { conversationId = id })
	return true
end

function SessionManager.renameConversation(id: string, title: string): boolean
	local conversation = SessionManager.getConversation(id)
	if not conversation then
		return false
	end
	local trimmed = StringUtil.trim(title or "")
	if #trimmed == 0 then
		return false
	end
	conversation.title = string.sub(trimmed, 1, 60)
	conversation.updatedAt = os.time()
	SessionManager.persist()
	EventBus.emit(EventBus.Events.ConversationListChanged, {})
	EventBus.emit(EventBus.Events.ConversationRenamed, { conversationId = id, title = conversation.title })
	return true
end

function SessionManager.deleteConversation(id: string): boolean
	if StateManager.isBusy() and id == activeConversationId then
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Finish or stop the task before deleting this chat." })
		return false
	end
	for index, conversation in conversations do
		if conversation.id == id then
			table.remove(conversations, index)
			if activeConversationId == id then
				activeConversationId = if #conversations > 0 then conversations[1].id else nil
			end
			SessionManager.persist()
			EventBus.emit(EventBus.Events.ConversationDeleted, { conversationId = id })
			EventBus.emit(EventBus.Events.ConversationListChanged, {})
			EventBus.emit(EventBus.Events.ConversationChanged, { conversationId = activeConversationId })
			return true
		end
	end
	return false
end

function SessionManager.clearAll()
	if StateManager.isBusy() then
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Finish or stop the task before clearing history." })
		return false
	end
	conversations = {}
	activeConversationId = nil
	SessionManager.persist()
	EventBus.emit(EventBus.Events.ConversationListChanged, {})
	EventBus.emit(EventBus.Events.ConversationChanged, { conversationId = nil })
	return true
end

function SessionManager.setConversationMeta(id: string, patch: { mode: string?, providerId: string?, model: string? })
	local conversation = SessionManager.getConversation(id)
	if not conversation then
		return
	end
	if patch.mode then
		conversation.mode = patch.mode
		EventBus.emit(EventBus.Events.ModeChanged, { mode = patch.mode, conversationId = id })
	end
	if patch.providerId ~= nil then
		conversation.providerId = patch.providerId
	end
	if patch.model ~= nil then
		conversation.model = patch.model
	end
	conversation.updatedAt = os.time()
	SessionManager.persist()
end

--=============================================================================
-- MESSAGES
--=============================================================================

function SessionManager.addMessage(role: Role, content: string, options: {
	internal: boolean?,
	policyBlocked: boolean?,
	taskId: string?,
	toolCallId: string?,
	conversationId: string?,
	streaming: boolean?,
	attachments: { { name: string, mime: string, sizeBytes: number } }?,
	reasoning: string?,
	toolCalls: any?,
	question: any?,
	plan: any?,
	model: string?,
}?): Message
	local opts = options or {}
	local conversation = SessionManager.getConversation(opts.conversationId) or SessionManager.ensureConversation()
	local message: Message = {
		internal = opts.internal,
		policyBlocked = opts.policyBlocked,
		id = Time.newId("msg"),
		role = role,
		content = Redact.scrubText(content or ""),
		at = os.time(),
		taskId = opts.taskId,
		toolCallId = opts.toolCallId,
		streaming = opts.streaming,
		attachments = opts.attachments,
		reasoning = if opts.reasoning then Redact.scrubText(opts.reasoning) else nil,
		toolCalls = opts.toolCalls,
		question = opts.question,
		plan = opts.plan,
		model = opts.model,
	}

	table.insert(conversation.messages, message)
	while #conversation.messages > MAX_MESSAGES_PER_CONVERSATION do
		table.remove(conversation.messages, 1)
		conversation.summarisedUpTo = math.max(0, conversation.summarisedUpTo - 1)
	end
	conversation.updatedAt = os.time()

	-- First user message names the chat.
	if role == "user" and conversation.title == "New chat" and StringUtil.trim(content) ~= "" then
		local derived = string.gsub(StringUtil.trim(content), "%s+", " ")
		conversation.title = string.sub(derived, 1, 48)
		EventBus.emit(EventBus.Events.ConversationListChanged, {})
	end

	SessionManager.persist()
	EventBus.emit(EventBus.Events.MessageStarted, { message = message, conversationId = conversation.id })
	return message
end

function SessionManager.appendToMessage(id: string, chunk: string, channel: string?): Message?
	local conversation = nil
	for _, candidate in conversations do
		for _, entry in candidate.messages do
			if entry.id == id then conversation = candidate; break end
		end
		if conversation then break end
	end
	if not conversation then return nil end
	for index = #conversation.messages, 1, -1 do
		local message = conversation.messages[index]
		if message.id == id then
            if channel == "reasoning" then message.reasoning = (message.reasoning or "") .. chunk else message.content ..= chunk end
			message.streaming = true
			EventBus.emit(EventBus.Events.MessageDelta, { messageId = id, delta = chunk, channel = channel or "text", conversationId = conversation.id })
			return message
		end
	end
	return nil
end

function SessionManager.updateMessage(id: string, patch: { [string]: any }): Message?
	local conversation = nil
	for _, candidate in conversations do
		for _, entry in candidate.messages do
			if entry.id == id then conversation = candidate; break end
		end
		if conversation then break end
	end
	if not conversation then return nil end
	for index = #conversation.messages, 1, -1 do
		local message = conversation.messages[index]
		if message.id == id then
			for key, value in patch do
				(message :: any)[key] = if type(value) == "string" then Redact.scrubText(value) else value
			end
			conversation.updatedAt = os.time()
			SessionManager.persist()
			EventBus.emit(EventBus.Events.MessageUpdated, { message = message, conversationId = conversation.id })
			return message
		end
	end
	return nil
end

function SessionManager.findMessage(id: string): Message?
	for _, conversation in conversations do
		for _, message in conversation.messages do
			if message.id == id then
				return message
			end
		end
	end
	return nil
end

--- Truncates a conversation at a message index (used by "edit previous message").
function SessionManager.truncateAfter(messageId: string): boolean
	local conversation = SessionManager.getActive()
	if not conversation then
		return false
	end
	for index, message in conversation.messages do
		if message.id == messageId then
			for cut = #conversation.messages, index + 1, -1 do
				table.remove(conversation.messages, cut)
			end
			conversation.updatedAt = os.time()
			SessionManager.persist()
			EventBus.emit(EventBus.Events.MessageStarted, { message = message, replaced = true })
			return true
		end
	end
	return false
end

function SessionManager.getMessages(): { Message }
	local conversation = SessionManager.getActive()
	if not conversation then
		return {}
	end
	return conversation.messages
end

--=============================================================================
-- USAGE ACCOUNTING
--=============================================================================

function SessionManager.recordUsage(conversationId: string?, usage: any?)
	local conversation = SessionManager.getConversation(conversationId) or SessionManager.getActive()
	if not conversation or type(usage) ~= "table" then
		return
	end
	conversation.totalInput += tonumber(usage.inputTokens or usage.input) or 0
	conversation.totalOutput += tonumber(usage.outputTokens or usage.output) or 0
	conversation.totalReasoning += tonumber(usage.reasoningTokens or usage.reasoning) or 0
	conversation.updatedAt = os.time()
end

function SessionManager.getTotals(): { input: number, output: number, reasoning: number, total: number }
	local conversation = SessionManager.getActive()
	if not conversation then
		return { input = 0, output = 0, reasoning = 0, total = 0 }
	end
	return {
		input = conversation.totalInput,
		output = conversation.totalOutput,
		reasoning = conversation.totalReasoning,
		-- Reasoning is a breakdown of output tokens, not an extra token bill.
		total = conversation.totalInput + conversation.totalOutput,
	}
end

--=============================================================================
-- SEARCH
--=============================================================================

--- Returns matching messages across all conversations, newest first.
function SessionManager.search(query: string, limit: number?): { { conversation: Conversation, message: Message } }
	local needle = string.lower(StringUtil.trim(query or ""))
	if #needle < 2 then
		return {}
	end
	local results: { { conversation: Conversation, message: Message } } = {}
	local cap = limit or 100

	for conversationIndex = 1, #conversations do
		local conversation = conversations[conversationIndex]
		for messageIndex = #conversation.messages, 1, -1 do
			local message = conversation.messages[messageIndex]
			if string.find(string.lower(message.content), needle, 1, true) then
				results[#results + 1] = { conversation = conversation, message = message }
				if #results >= cap then
					EventBus.emit(EventBus.Events.ConversationSearchResults, { count = #results })
					return results
				end
			end
		end
	end

	EventBus.emit(EventBus.Events.ConversationSearchResults, { count = #results })
	return results
end

return SessionManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">SettingsManager</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Core / SettingsManager
	Persists UI preferences and NON-SECRET provider profiles via Plugin:SetSetting.

	SECURITY CONTRACT
	-----------------
	API keys are never written through SetSetting, never placed in chat history,
	never logged, and never serialised into saved provider profiles. Secrets live
	only in the in-memory SessionCredentialStore for the lifetime of the Studio
	session, and the user is told to expect re-entry after a restart.
]]

local EventBus = require(script.Parent.EventBus)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)


local SettingsManager = {}

local SETTINGS_KEY = "ForgePilot.Settings.v1"

export type ProviderProtocol =
	"openai_chat"
	| "openai_responses"
	| "anthropic_messages"
	| "gemini_native"
	| "openai_compatible"
	| "custom_compatible"

export type ProviderProfile = {
	id: string,
	displayName: string,
	providerName: string,
	providerType: string,
	protocol: string,
	baseUrl: string,
	endpointPath: string,
	urlMode: string,
	modelId: string,
	authStyle: string,
	authHeaderName: string?,
	authHeaderPrefix: string?,
	authQueryParam: string?,
	defaultHeaders: { [string]: string },
	extraHeaders: { [string]: string },
	contextWindow: number,
	contextWindowMode: string,
	maxOutputTokens: number,
	maxOutputTokensMode: string,
	temperature: number,
	topP: number,
	reasoningEffort: string,
	reasoningIncludeSummary: boolean,
	streaming: boolean,
	toolCalling: boolean,
	parallelToolCalling: boolean,
	jsonMode: boolean,
	timeoutMs: number,
	retryOverrides: { [string]: any }?,
	schemaMapping: { [string]: any }?,
	presetId: string?,
	createdAt: number,
	updatedAt: number,
}

export type SmartRetrySettings = {
	enabled: boolean,
	strategy: string,
	maxRetries: number,
	initialDelaySeconds: number,
	multiplier: number,
	linearStepSeconds: number,
	maxDelaySeconds: number,
	maxAutoWaitSeconds: number,
	jitterPercent: number,
	respectRetryAfter: boolean,
	dynamicCooldown: boolean,
	rateLimitScheduler: boolean,
	multilingualErrors: boolean,
	showCountdown: boolean,
	showRetryLogs: boolean,
	customSequence: { number }?,
	providerOverrides: { [string]: any },
}

export type Settings = {
	assistantName: string,
	theme: string,
	animations: boolean,
	reducedMotion: boolean,
	language: string,
	confirmDestructive: boolean,
	confirmToolCalls: boolean,
	defaultMode: string,
	modeDefaultsVersion: number,
	autoAsk: boolean,
	letAiDecide: boolean,
	autoApproveReadOnly: boolean,
	toolPermissions: { [string]: boolean },
	maxToolCalls: number,
	maxBuildActions: number,
	streamResponses: boolean,
	bridgeEnabled: boolean,
	bridgeUrl: string,
	summarizeThreshold: number,
	reserveTokensForTools: number,
	smartRetry: SmartRetrySettings,
	providers: { ProviderProfile },
	activeProviderId: string?,
}

--=============================================================================
-- DEFAULTS
--=============================================================================

local function defaultSettings(): Settings
	return {
		assistantName = "ForgePilot Assistant",
		theme = "ForgePilot Dark",
		animations = true,
		reducedMotion = false,
		language = "English",
		confirmDestructive = true,
		confirmToolCalls = true,
		defaultMode = "build",
		modeDefaultsVersion = 2,
		autoAsk = true,
		letAiDecide = true,
		autoApproveReadOnly = true,
		toolPermissions = {},
		maxToolCalls = 40,
		maxBuildActions = 200,
		streamResponses = true,
		bridgeEnabled = true,
		bridgeUrl = "http://127.0.0.1:20129",
		summarizeThreshold = 0.85,
		reserveTokensForTools = 4096,
		smartRetry = {
			enabled = true,
			strategy = "adaptive",
			maxRetries = 5,
			initialDelaySeconds = 2,
			multiplier = 2,
			linearStepSeconds = 3,
			maxDelaySeconds = 120,
			maxAutoWaitSeconds = 120,
			jitterPercent = 25,
			respectRetryAfter = true,
			dynamicCooldown = true,
			rateLimitScheduler = true,
			multilingualErrors = true,
			showCountdown = true,
			showRetryLogs = true,
			customSequence = nil,
			providerOverrides = {},
		},
		providers = {},
		activeProviderId = nil,
	}
end

--=============================================================================
-- SCHEMA GUARD
--=============================================================================
-- Anything loaded from disk is untrusted: an older or hand-edited settings blob
-- must never crash the plugin or smuggle unexpected keys through.

local function coerce(raw: any, template: any): any
	if template == nil then
		return raw
	end
	local templateType = type(template)
	if raw == nil then
		return template
	end
	if templateType == "number" then
		return if type(raw) == "number" then raw else template
	elseif templateType == "string" then
		return if type(raw) == "string" then raw else template
	elseif templateType == "boolean" then
		return if type(raw) == "boolean" then raw else template
	elseif templateType == "table" then
		if type(raw) ~= "table" then
			return template
		end
		if #template > 0 then
			local arr = {}
			for index, item in raw do
				if type(item) == type(template[1]) then
					arr[#arr + 1] = item
				end
			end
			return arr
		end
		local out = {}
		for key, value in raw do
			if template[key] ~= nil then
				out[key] = coerce(value, template[key])
			end
		end
		return out
	end
	return template
end

--=============================================================================
-- STATE
--=============================================================================

local settings: Settings = defaultSettings()
local pluginRef: Plugin? = nil

--=============================================================================
-- LIFECYCLE
--=============================================================================

function SettingsManager.init(plugin: Plugin)
	pluginRef = plugin
	SettingsManager.load()
end

function SettingsManager.load()
	if not pluginRef then
		return
	end
	local ok, raw = pcall(pluginRef.GetSetting, pluginRef, SETTINGS_KEY)
	if ok and raw ~= nil then
		local decodedOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if decodedOk and type(decoded) == "table" then
			settings = coerce(decoded, defaultSettings())
			if (tonumber(decoded.modeDefaultsVersion) or 0) < 2 then
				settings.defaultMode = "build"
				SettingsManager.persist()
			end
			-- Any key accidentally present in a saved blob is dropped here.
			for _, provider in settings.providers do
				provider.secretSlot = provider.secretSlot
			end
		else
			settings = defaultSettings()
		end
	else
		settings = defaultSettings()
	end
end

--- Serialises settings WITHOUT any credential material.
function SettingsManager.persist()
	if not pluginRef then
		return false
	end
	local snapshot = SettingsManager.get()
	local providers = {}
	for _, provider in snapshot.providers do
		local copy = table.clone(provider)
		copy.secretSlot = nil -- belt and braces: secrets never reach disk
		providers[#providers + 1] = copy
	end
	snapshot.providers = providers

	local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, snapshot)
	if not encodedOk then
		return false
	end
	local setOk = pcall(pluginRef.SetSetting, pluginRef, SETTINGS_KEY, encoded)
	return setOk
end

--=============================================================================
-- ACCESSORS
--=============================================================================

function SettingsManager.get(): Settings
	return settings
end

function SettingsManager.getValue<K>(key: K): any
	return (settings :: any)[key]
end

function SettingsManager.setValue<K>(key: K, value: any)
	(settings :: any)[key] = value
	SettingsManager.persist()
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "settings" })
end

function SettingsManager.resetAll()
	settings = defaultSettings()
	SettingsManager.persist()
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "reset" })
end

function SettingsManager.update(updater: (Settings) -> ())
	updater(settings)
	SettingsManager.persist()
end

function SettingsManager.setAssistantName(name: string)
	local trimmed = StringUtil.trim(name or "")
	settings.assistantName = if #trimmed > 0 then trimmed else "ForgePilot Assistant"
	SettingsManager.persist()
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "settings", field = "assistantName" })
end

--=============================================================================
-- PROVIDER PROFILES (non-secret)
--=============================================================================

function SettingsManager.addProvider(provider: ProviderProfile)
	settings.providers[#settings.providers + 1] = provider
	if not settings.activeProviderId then
		settings.activeProviderId = provider.id
	end
	SettingsManager.persist()
	EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "added", providerId = provider.id })
end

function SettingsManager.updateProvider(id: string, patch: { [string]: any })
	for index, provider in settings.providers do
		if provider.id == id then
			for key, value in patch do
				(provider :: any)[key] = value
			end
			provider.updatedAt = os.time()
			settings.providers[index] = provider
			SettingsManager.persist()
			EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "updated", providerId = id })
			return provider
		end
	end
	return nil
end

function SettingsManager.removeProvider(id: string): boolean
	for index, provider in settings.providers do
		if provider.id == id then
			table.remove(settings.providers, index)
			if settings.activeProviderId == id then
				settings.activeProviderId = if #settings.providers > 0 then settings.providers[1].id else nil
			end
			SettingsManager.persist()
			EventBus.emit(EventBus.Events.ProvidersChanged, { reason = "removed", providerId = id })
			return true
		end
	end
	return false
end

function SettingsManager.getProvider(id: string?): ProviderProfile?
	if not id then
		return nil
	end
	for _, provider in settings.providers do
		if provider.id == id then
			return provider
		end
	end
	return nil
end

function SettingsManager.getActiveProvider(): ProviderProfile?
	return SettingsManager.getProvider(settings.activeProviderId)
end

function SettingsManager.setActiveProvider(id: string?)
	settings.activeProviderId = id
	SettingsManager.persist()
	EventBus.emit(EventBus.Events.ActiveProviderChanged, { providerId = id })
end

--=============================================================================
-- SAFETY CHECK: asserts nothing secret can be serialised
--=============================================================================

--- Development guard. Walks a settings snapshot and reports any credential-like
--- value that would leak through JSONEncode.
function SettingsManager.assertNoSecrets(): (boolean, { string }?)
	local problems: { string } = {}

	local function walk(value: any, path: string, depth: number)
		if depth > 8 or type(value) ~= "table" then
			return
		end
		for key, entry in value do
			local nextPath = if type(key) == "string" then path .. "." .. key else path .. "[?]"
			if type(key) == "string" and Redact.isSecretKey(key) and entry ~= nil then
				problems[#problems + 1] = nextPath
			else
				walk(entry, nextPath, depth + 1)
			end
		end
	end

	walk(settings, "settings", 0)
	return #problems == 0, problems
end

return SettingsManager
]]></string>
