      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">Redact</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Utilities / Redact
	Secret and sensitive-content scrubbing used before anything is logged,
	rendered into the chat transcript, or written to disk.
]]

local Redact = {}

local PLACEHOLDER = "«redacted»"

-- Field names whose values must never be displayed or persisted.
local SECRET_FIELDS: { [string]: true } = {
	apikey = true,
	api_key = true,
	authorization = true,
	auth = true,
	token = true,
	access_token = true,
	refreshtoken = true,
	refresh_token = true,
	id_token = true,
	secret = true,
	client_secret = true,
	password = true,
	bearer = true,
	x_api_key = true,
	["x-goog-api-key"] = true,
	["proxy-authorization"] = true,
	cookie = true,
	["set-cookie"] = true,
}

local SECRET_PATTERNS = {
	-- Bearer / Basic tokens in free text
	{"%f[%w]Bearer%s+[%w%.%-_]+", PLACEHOLDER},
	-- OpenAI style keys
	{"sk%-[%w%-_]+", PLACEHOLDER},
	{"sk-ant%-[%w%-_]+", PLACEHOLDER},
	-- Google keys
	{"AIza[%w%-_]+", PLACEHOLDER},
	-- AWS style
	{"AKIA[%w]+", PLACEHOLDER},
	-- Generic long hex secrets, handled by a callback rather than a `{n,m}`
	-- quantifier so the rule behaves identically on every Lua engine.
	{
		"%f[%w]%x+",
		function(match: string)
			return if #match &gt;= 40 then PLACEHOLDER else match
		end,
	},
	-- JSON style key:value pairs inside strings
	{'"apikey"%s*:%s*"[^"]*"', '"apiKey":"' .. PLACEHOLDER .. '"'},
	{'"api_key"%s*:%s*"[^"]*"', '"api_key":"' .. PLACEHOLDER .. '"'},
}

--- True when a table key should have its value scrubbed.
function Redact.isSecretKey(key: string): boolean
	local lowered = string.lower(key)
	return SECRET_FIELDS[lowered] == true
end

--- Recursively scrubs secret-bearing fields out of an arbitrary table.
--- Returns a new table; the input is not mutated.
function Redact.scrub(value: any, depth: number?): any
	local level = depth or 0
	if level &gt; 8 then
		return "«depth-limit»"
	end

	if type(value) == "string" then
		return Redact.scrubText(value)
	elseif type(value) ~= "table" then
		return value
	end

	local out = {}
	for key, entry in value do
		if type(key) == "string" and Redact.isSecretKey(key) then
			if type(entry) == "string" and #entry &gt; 0 then
				out[key] = PLACEHOLDER
			elseif entry ~= nil then
				out[key] = "«redacted»"
			end
		else
			out[key] = Redact.scrub(entry, level + 1)
		end
	end
	return out
end

--- Scrubs known secret patterns out of arbitrary text.
function Redact.scrubText(text: string): string
	if type(text) ~= "string" or #text == 0 then
		return text
	end
	local result = text
	for _, entry in SECRET_PATTERNS do
		result = string.gsub(result, entry[1], entry[2])
	end
	return result
end

--- Returns a short, non-reversible fingerprint of a secret.
--- Used to show "key loaded (sha 1a2b3c)" without revealing the value.
function Redact.fingerprint(secret: string): string
	if type(secret) ~= "string" or #secret == 0 then
		return "none"
	end
	local sum = 0
	for index = 1, #secret do
		sum = (sum * 31 + string.byte(secret, index)) % 0xFFFFFFFF
	end
	return string.format("%08x", sum)
end

--- Masks a secret for display: keeps a short prefix/suffix only.
function Redact.mask(secret: string?): string
	if type(secret) ~= "string" or #secret == 0 then
		return ""
	end
	if #secret &lt;= 10 then
		return string.rep("*", #secret)
	end
	local head = string.sub(secret, 1, 4)
	local tail = string.sub(secret, -3)
	return head .. string.rep("*", math.min(16, #secret - 7)) .. tail
end

return Redact</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">RetryLogger</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Utilities / RetryLogger
	Provider and retry events in ForgePilot's Activity Log.

	Every line here corresponds to something that actually happened. API keys,
	authorization headers and response bodies are never logged; endpoints are shown
	through BaseURLResolver.forDisplay, which strips query strings.
]]

local BaseURLResolver = require(script.Parent.Parent.AI.BaseURLResolver)
local Logger = require(script.Parent.Logger)
local Redact = require(script.Parent.Redact)

local RetryLogger = {}

--=============================================================================
-- PROVIDER EVENTS
--=============================================================================

function RetryLogger.providerSelected(profile: any)
	Logger.info("AI Provider", "Provider selected.", {
		detail = string.format(
			"%s · %s · %s",
			tostring(profile.displayName),
			tostring(profile.modelId ~= "" and profile.modelId or "(no model)"),
			tostring(profile.protocol)
		),
	})
end

function RetryLogger.requestStarted(profile: any, url: string, streaming: boolean)
	Logger.info("API", string.format("%s %s", if streaming then "STREAM" else "POST", BaseURLResolver.forDisplay(url)), {
		detail = string.format("%s · %s", profile.displayName, profile.modelId),
	})
end

function RetryLogger.requestFinished(provider: string, model: string, status: number?, durationMs: number, usage: any?)
	local detail = string.format("%s · %s · %.0f ms", provider, model, durationMs)
	if type(usage) == "table" and usage.inputTokens then
		detail ..= string.format(" · %d in / %d out", usage.inputTokens, usage.outputTokens or 0)
	end
	Logger.info("API", string.format("Provider responded HTTP %s.", tostring(status)), { detail = detail })
end

--=============================================================================
-- ERROR EVENTS
--=============================================================================

function RetryLogger.errorDetected(normalised: any)
	local UED = require(script.Parent.UniversalErrorDetector)
	local upstreamNote = if normalised.upstreamRetry and normalised.upstreamRetry.present
		then string.format(
			" · upstream reported retry attempt %s%s",
			tostring(normalised.upstreamRetry.attempt),
			if normalised.upstreamRetry.delaySeconds
				then string.format(" in %.0fs", normalised.upstreamRetry.delaySeconds)
				else ""
		)
		else ""

	Logger.error("ERROR", "Provider error detected.", {
		detail = string.format(
			"%s · %s%s",
			normalised.message,
			normalised.classificationSource,
			upstreamNote
		),
	})

	Logger.info("ERROR", string.format(
		"Classified as %s (confidence %.2f).",
		normalised.category,
		normalised.confidence
	), {
		detail = string.format(
			"HTTP %s · code %s · request %s",
			tostring(normalised.httpStatus),
			tostring(normalised.providerCode),
			tostring(normalised.requestId)
		),
	})

	if normalised.rateLimit and normalised.rateLimit.limit and normalised.rateLimit.windowMs then
		Logger.warn("Rate Limit", string.format(
			"%d requests per %.0f seconds.",
			normalised.rateLimit.limit,
			normalised.rateLimit.windowMs / 1000
		), {
			detail = if normalised.rateLimit.estimated
				then "Window not reported by the provider; this is a conservative estimate."
				else "Window was stated by the provider.",
		})
	end

	_ = UED
end

function RetryLogger.retryScheduled(
	provider: string,
	model: string,
	attempt: number,
	maxRetries: number,
	decision: any
)
	Logger.info("RETRY", string.format(
		"Retry %d/%d scheduled in %.1fs.",
		attempt,
		maxRetries,
		decision.delaySeconds
	), {
		detail = string.format(
			"%s · %s · %s%s%s",
			provider,
			model,
			decision.source,
			if decision.mandatory then " (provider-mandated)" else "",
			if decision.estimated then " (estimated)" else ""
		),
	})
end

function RetryLogger.retryPaused(provider: string, model: string, reason: string)
	Logger.warn("Retry", "Retries paused.", { detail = string.format("%s · %s · %s", provider, model, reason) })
end

function RetryLogger.providerRecovered(provider: string, model: string, attempts: number)
	Logger.success("Retry", "Provider recovered.", {
		detail = string.format("%s · %s succeeded after %d attempt(s).", provider, model, attempts),
	})
end

function RetryLogger.retriesExhausted(provider: string, model: string, attempts: number, reason: string)
	Logger.error("Retry", "Automatic retries exhausted.", {
		detail = string.format("%s · %s · %d attempt(s) · %s", provider, model, attempts, reason),
	})
end

function RetryLogger.retryCancelled(provider: string, model: string, attempts: number, reason: string)
	Logger.warn("Retry", "Retry cancelled.", {
		detail = string.format("%s · %s · %d attempt(s) · %s", provider, model, attempts, reason),
	})
end

function RetryLogger.cooldownActivated(provider: string, seconds: number, estimated: boolean)
	Logger.warn("Rate Limit", "Provider cooldown activated.", {
		detail = string.format(
			"%s · %.0fs%s",
			provider,
			seconds,
			if estimated then " · estimated (ForgePilot cannot see other apps' usage)" else ""
		),
	})
end

--=============================================================================
-- CONFIGURATION EVENTS
--=============================================================================

function RetryLogger.protocolConfirmed(profile: any, protocolId: string, source: string)
	Logger.success("API", string.format("Protocol: %s", protocolId), {
		detail = string.format("%s · determined by %s", profile.displayName, source),
	})
end

function RetryLogger.protocolRejected(profile: any, protocolId: string, reason: string)
	Logger.warn("API", string.format("Protocol %s not available.", protocolId), {
		detail = string.format("%s · %s", profile.displayName, Redact.scrubText(reason)),
	})
end

function RetryLogger.capabilities(result: string, detail: string?)
	Logger.info("Capabilities", result, { detail = detail })
end

return RetryLogger</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">StringUtil</string>
          <string name="Source">--!strict
--[[
	Utilities/StringUtil

	Roblox ships `string.split` but NOT `string.trim`, and the `string` table is
	locked in the plugin sandbox, so it cannot be polyfilled:

	    Unable to assign property trim.

	ForgePilot trims user input, HTTP headers and streamed SSE payloads in 60+
	places, so the helper lives here instead and is required explicitly.
]]
local StringUtil = {}

--- Removes leading and trailing whitespace.
---
--- Non-string input is coerced with tostring so callers can pass any value
--- without a nil check at every call site.
function StringUtil.trim(value: any): string
	local text = tostring(value)
	local withoutLead = string.gsub(text, "^%s+", "")
	return (string.gsub(withoutLead, "%s+$", ""))
end

return StringUtil</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Utilities / Theme
	Central design tokens and UI construction helpers.
	All colours, spacing, radii and motion live here so the interface stays consistent.
]]

local TweenService = game:GetService("TweenService")
local Theme = {}

--=============================================================================
-- COLOUR PALETTE
--=============================================================================

Theme.Colors = {
	Background = Color3.fromHex("#17161C"),
	Secondary = Color3.fromHex("#222027"),
	Accent = Color3.fromHex("#2C2331"),
	Highlight = Color3.fromHex("#9879E8"),
	MainText = Color3.fromHex("#F4F1F8"),
	SecondaryText = Color3.fromHex("#A7A0B2"),
	Success = Color3.fromHex("#49C591"),
	Error = Color3.fromHex("#F16E7A"),
}

-- Derived / supporting tones. Kept explicit so contrast can be tuned in one place.
Theme.Extra = {
	Surface = Color3.fromHex("#1D1B23"),
	SurfaceRaised = Color3.fromHex("#292630"),
	SurfaceHover = Color3.fromHex("#34303D"),
	SurfacePressed = Color3.fromHex("#3E3350"),
	Overlay = Color3.fromHex("#0E0C12"),
	Border = Color3.fromHex("#34303C"),
	BorderStrong = Color3.fromHex("#463B56"),
	HighlightSoft = Color3.fromHex("#3A2F4C"),
	Warning = Color3.fromHex("#E8B661"),
	Info = Color3.fromHex("#6FA8DC"),
	Muted = Color3.fromHex("#9992A4"),
}

Theme.Metrics = {
	RowHeight = 30,
	InputHeight = 30,
	ButtonHeight = 30,
	PrimaryButtonHeight = 34,
	TabHeight = 26,
	SectionTabHeight = 28,
	HeaderHeight = 44,
	NavHeight = 34,
	ToggleWidth = 38,
	ToggleHeight = 20,
	ToggleKnob = 16,
	MinButtonWidth = 64,
	Radius = 8,
	RadiusSmall = 6,
	RadiusLarge = 12,
	Gutter = 10,
	PadX = 12,
	PadY = 10,
	Stroke = 1,
	ScrollThickness = 5,
}

--=============================================================================
-- SPACING SCALE
--=============================================================================
-- A closed scale. Every gap, inset and row height in the interface comes from
-- here, which is what stops "close enough" spacing from drifting apart across
-- five screens built by five different files.

Theme.Space = {
	XS = 4,
	SM = 8,
	MD = 12,
	LG = 16,
	XL = 20,
	XXL = 24,
}

--=============================================================================
-- RESPONSIVE BREAKPOINTS
--=============================================================================
-- The DockWidget can be docked as narrow as 240px and as wide as the whole
-- editor. Widths below these thresholds switch padding, navigation density and
-- field stacking. They are content widths (the window minus its gutter).

Theme.Breakpoints = {
	Compact = 380,
	Medium = 560,
}

export type Bucket = "compact" | "medium" | "wide"

--- Maps a window width to the responsive bucket used by every view.
function Theme.bucketFor(width: number): Bucket
	if width < Theme.Breakpoints.Compact then
		return "compact"
	elseif width < Theme.Breakpoints.Medium then
		return "medium"
	end
	return "wide"
end

--- Horizontal page inset, tightened on narrow windows.
function Theme.gutterFor(width: number): number
	local bucket = Theme.bucketFor(width)
	if bucket == "compact" then
		return Theme.Space.SM
	elseif bucket == "medium" then
		return Theme.Space.MD
	end
	return Theme.Space.LG
end

--- True when a field should stack its control under its label instead of
--- placing it on the right-hand side.
function Theme.shouldStackField(width: number): boolean
	return width < Theme.Breakpoints.Medium
end

Theme.Fonts = {
	Regular = Enum.Font.Gotham,
	Medium = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
	Code = Enum.Font.Code,
	Mono = Enum.Font.RobotoMono,
	Icon = Enum.Font.GothamBold,
}

Theme.TextSizes = {
	Caption = 11,
	Small = 12,
	Body = 14,
	BodyLarge = 15,
	Title = 16,
	Heading = 18,
}

Theme.Motion = {
	Fast = 0.10,
	Normal = 0.18,
	Slow = 0.30,
	Fade = Enum.EasingStyle.Quad,
	Out = Enum.EasingDirection.Out,
	In = Enum.EasingDirection.In,
	OutBack = Enum.EasingDirection.Out,
}

Theme.motionEnabled = true

Theme.LoggerPrefix = "[ForgePilot] "

--=============================================================================
-- COLOUR UTILITIES
--=============================================================================

--- Mixes two colours. `alpha` of 0 returns `a`, 1 returns `b`.
function Theme.mix(a: Color3, b: Color3, alpha: number): Color3
	return a:Lerp(b, math.clamp(alpha, 0, 1))
end

--- Tints `color` toward the window background.
--
-- Roblox's Color3 has no alpha channel, and `Color3.new(r, g, b, alpha)` silently
-- drops the fourth argument. Translucency therefore has to be expressed by
-- pre-mixing the colour against the background it will be drawn over, which is
-- what the interface actually means by "10% highlight" and friends.
-- `alpha` of 0 returns the background, 1 returns `color` unchanged.
function Theme.withAlpha(color: Color3, alpha: number): Color3
	local amount = math.clamp(alpha, 0, 1)
	if amount >= 1 then
		return color
	end
	return color:Lerp(Theme.Colors.Background, 1 - amount)
end

--- Lightens a colour toward white by `amount` (0..1).
function Theme.lighten(color: Color3, amount: number): Color3
	return Theme.mix(color, Color3.new(1, 1, 1), amount)
end

--- Darkens a colour toward black by `amount` (0..1).
function Theme.darken(color: Color3, amount: number): Color3
	return Theme.mix(color, Color3.new(0, 0, 0), amount)
end

--=============================================================================
-- UI CONSTRUCTION HELPERS
--=============================================================================

function Theme.create(className: string, properties: { [string]: any }?): Instance
	local instance = Instance.new(className)
	if properties then
		for key, value in properties do
			(instance :: any)[key] = value
		end
	end
	return instance
end

function Theme.corner(radius: number?): UICorner
	return Theme.create("UICorner", {
		CornerRadius = UDim.new(0, radius or Theme.Metrics.Radius),
	})
end

function Theme.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Theme.create("UIStroke", {
		Color = color or Theme.Extra.Border,
		Thickness = thickness or Theme.Metrics.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

--- Creates a gradient used for panel headers and the brand strip.
function Theme.gradient(c1: Color3, c2: Color3, rotation: number?): UIGradient
	return Theme.create("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 90,
	})
end

--- Applies a background + rounded corners + optional stroke in one call.
function Theme.surface(guiObject: GuiObject, options: { color: Color3?, radius: number?, stroke: Color3? }?)
	local opts = options or {}
	guiObject.BackgroundColor3 = opts.color or Theme.Extra.Surface
	guiObject.BorderSizePixel = 0
	guiObject.ClipsDescendants = true
	local corner = Theme.corner(opts.radius or Theme.Metrics.Radius)
	corner.Parent = guiObject
	if opts.stroke then
		local s = Theme.stroke(opts.stroke)
		s.Parent = guiObject
	end
	return guiObject
end

--=============================================================================
-- TYPOGRAPHY HELPERS
--=============================================================================

function Theme.label(text: string, options: {
	size: number?,
	color: Color3?,
	font: Enum.Font?,
	alignX: Enum.TextXAlignment?,
	alignY: Enum.TextYAlignment?,
	wrap: boolean?,
	textX: Enum.TextXAlignment?,
	truncate: boolean?,
	rich: boolean?,
	width: UDim2?,
	height: UDim2?,
}?): TextLabel
	local o = options or {}
	local textWrapped = if o.wrap ~= nil then o.wrap else false
	local label = Theme.create("TextLabel", {
		BackgroundTransparency = 1,
		Size = o.width or UDim2.new(1, 0, 0, 18),
		Text = text,
		TextSize = o.size or Theme.TextSizes.Body,
		TextColor3 = o.color or Theme.Colors.MainText,
		Font = o.font or Theme.Fonts.Regular,
		TextXAlignment = o.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = o.alignY or Enum.TextYAlignment.Center,
		TextTruncate = if o.truncate then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		TextWrapped = textWrapped,
		RichText = o.rich == true,
	})
	if o.height then
		label.Size = UDim2.new(label.Size.X.Scale, label.Size.X.Offset, o.height.Y.Scale, o.height.Y.Offset)
	end
	return label
end

--- A label that owns its own height.
---
--- Every description, hint and paragraph in ForgePilot goes through this: it
--- measures itself and grows, so a three-line hint can never be painted over
--- the control below it. A TextLabel with a fixed height and TextWrapped is the
--- single most common source of overlapping text in a Roblox GUI, so the
--- design system simply does not expose one.
function Theme.autoText(text: string, options: {
	size: number?,
	color: Color3?,
	font: Enum.Font?,
	alignX: Enum.TextXAlignment?,
	alignY: Enum.TextYAlignment?,
	rich: boolean?,
	minHeight: number?,
	width: UDim2?,
}?): TextLabel
	local o = options or {}
	local fontSize = o.size or Theme.TextSizes.Small
	local label = Theme.label(text, {
		size = fontSize,
		color = o.color or Theme.Colors.SecondaryText,
		font = o.font or Theme.Fonts.Regular,
		alignX = o.alignX,
		alignY = o.alignY or Enum.TextYAlignment.Top,
		rich = o.rich,
		width = o.width or UDim2.new(1, 0, 0, 0),
	})
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextTruncate = Enum.TextTruncate.None
	label.Name = "AutoText"
	-- Guarantee the box is at least one full line tall. Roblox clips a
	-- GuiObject's own contents to its rectangle, so a label whose measured
	-- height lands a couple of pixels under its line box loses its descenders.
	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(0, o.minHeight or math.ceil(fontSize * 1.3))
	constraint.Parent = label
	return label
end

function Theme.textButton(text: string, options: {
	size: number?,
	color: Color3?,
	hoverColor: Color3?,
	pressedColor: Color3?,
	font: Enum.Font?,
	height: number?,
	width: UDim2?,
	textColor: Color3?,
	autoButtonColor: boolean?,
	alignX: Enum.TextXAlignment?,
	truncate: boolean?,
	radius: number?,
}?): TextButton
	local o = options or {}
	local baseColor = o.color or Theme.Extra.SurfaceRaised
	local button = Theme.create("TextButton", {
		BackgroundColor3 = baseColor,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = text,
		TextSize = o.size or Theme.TextSizes.Body,
		TextColor3 = o.textColor or Theme.Colors.MainText,
		Font = o.font or Theme.Fonts.Medium,
		TextXAlignment = o.alignX or Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTruncate = if o.truncate then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		Size = o.width or UDim2.new(1, 0, 0, o.height or Theme.Metrics.ButtonHeight),
	})
	-- Clipped so a long label can never paint over the control next to it.
	button.ClipsDescendants = true
	local c = Theme.corner(o.radius or Theme.Metrics.RadiusSmall)
	c.Parent = button
	Theme.stroke(nil, 1, 0.25).Parent = button

	button.MouseEnter:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(Theme.Motion.Fast, Theme.Motion.Fade, Theme.Motion.Out),
			{ BackgroundColor3 = o.hoverColor or Theme.Extra.SurfaceHover }
		):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(Theme.Motion.Fast, Theme.Motion.Fade, Theme.Motion.Out),
			{ BackgroundColor3 = baseColor }
		):Play()
	end)
	return button
end

--- Lets a child of a horizontal UIListLayout give up width when the row would
--- otherwise overflow its parent. This is the anti-overflow rule: a row of
--- buttons shrinks instead of running past the edge of a 320px window.
function Theme.flexItem(guiObject: GuiObject, growRatio: number?, shrinkRatio: number?): UIFlexItem
	local item = guiObject:FindFirstChildOfClass("UIFlexItem")
	if not item then
		item = Instance.new("UIFlexItem")
		item.Parent = guiObject
	end
	-- Custom is the only mode that honours both ratios. Fill ignores them,
	-- which made fixed buttons grow and the transcript lose its available space.
	item.FlexMode = Enum.UIFlexMode.Custom
	item.GrowRatio = if growRatio ~= nil then math.max(0, growRatio) else 1
	item.ShrinkRatio = if shrinkRatio ~= nil then math.max(0, shrinkRatio) else 1
	return item :: UIFlexItem
end

function Theme.minSize(guiObject: GuiObject, minimum: Vector2): UISizeConstraint
	local constraint = guiObject:FindFirstChildOfClass("UISizeConstraint")
	if not constraint then
		constraint = Instance.new("UISizeConstraint")
		constraint.Parent = guiObject
	end
	constraint.MinSize = minimum
	return constraint :: UISizeConstraint
end

--- Marks a frame as a pure layout container.
---
--- Roblox makes ANY Active GuiObject hit-testable, including a fully
--- transparent full-width Frame. Layout containers therefore silently swallow
--- clicks meant for whatever sits behind them — the chat composer covering the
--- empty-state button was exactly this bug. Every structural frame ForgePilot
--- creates for layout calls this.
---
--- It also clears the background. Roblox gives every GuiObject a visible light
--- gray (#B7B5B8) and an Active hitbox by default, so a structural frame left
--- alone both repaints the theme away and covers the controls underneath it.
--- The Builder's full-height stack rendering the whole page white and the
--- Settings stack doing the same were both this bug.
function Theme.passThrough(guiObject: GuiObject)
	-- Only ever raises transparency; it never sets a colour, so a caller that
	-- wants a visible surface opts back in after calling this.
	if guiObject.BackgroundTransparency < 1 then
		guiObject.BackgroundTransparency = 1
	end
	guiObject.Active = guiObject:IsA("ScrollingFrame")
	guiObject.Selectable = false
	guiObject.BorderSizePixel = 0
	return guiObject
end

function Theme.input(placeholder: string, options: { multiLine: boolean?,
	height: number?,
	alignX: Enum.TextXAlignment?,
}?): TextBox
	local o = options or {}
	local box = Theme.create("TextBox", {
		BackgroundColor3 = Theme.Extra.Surface,
		BorderSizePixel = 0,
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = Theme.Extra.Muted,
		TextColor3 = Theme.Colors.MainText,
		TextSize = Theme.TextSizes.Body,
		Font = Theme.Fonts.Regular,
		ClearTextOnFocus = false,
		TextXAlignment = o.alignX or Enum.TextXAlignment.Left,
		TextYAlignment = if o.multiLine then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center,
		TextWrapped = o.multiLine == true,
		MultiLine = o.multiLine == true,
		Size = UDim2.new(1, 0, 0, o.height or Theme.Metrics.InputHeight),
	})
	Theme.padding4(6, 10, 6, 10).Parent = box
	-- A long Base URL or Model ID must scroll inside the box, never escape it.
	box.ClipsDescendants = true
	Theme.corner(Theme.Metrics.RadiusSmall).Parent = box
	local stroke = Theme.stroke(Theme.Extra.Border)
	stroke.Parent = box
	box.Focused:Connect(function()
		stroke.Color = Theme.Colors.Highlight
	end)
	box.FocusLost:Connect(function()
		stroke.Color = Theme.Extra.Border
	end)
	return box
end

function Theme.padding(all: number?): UIPadding
	return Theme.create("UIPadding", {
		PaddingTop = UDim.new(0, all or Theme.Metrics.PadY),
		PaddingBottom = UDim.new(0, all or Theme.Metrics.PadY),
		PaddingLeft = UDim.new(0, all or Theme.Metrics.PadX),
		PaddingRight = UDim.new(0, all or Theme.Metrics.PadX),
	})
end

--- Asymmetric padding (top, right, bottom, left).
function Theme.padding4(top: number, right: number, bottom: number, left: number): UIPadding
	return Theme.create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		PaddingRight = UDim.new(0, right),
	})
end

--=============================================================================
-- OVERLAY LAYER
--=============================================================================

Theme.OverlayZIndex = 50

--- Returns the shared overlay frame for a view, creating it on first use.
---
--- Dropdown menus, toasts and modals are parented here rather than inside the
--- control that opened them. A menu parented to its own button is clipped by
--- every ScrollingFrame between the button and the window edge, which is why
--- dropdowns used to open half off-screen inside the Settings page.
---
--- An existing layer on any ancestor is reused. Nesting a fresh one inside a
--- control is actively harmful: an auto-sized field holder would see the new
--- full-scale overlay as content, grow to fit it, and the overlay would then
--- grow again -- a feedback loop that inflated whole Settings sections to
--- 100,000px. The window-level layer already spans the content area and is not
--- inside an auto-sized frame, so one per window is both correct and cheaper.
function Theme.overlayHost(parent: GuiObject): Frame
	local cursor: Instance? = parent
	while cursor do
		local existing = cursor:FindFirstChild("OverlayLayer")
		if existing and existing:IsA("Frame") then
			return existing
		end
		cursor = cursor.Parent
	end

	local overlay = Instance.new("Frame")
	overlay.Name = "OverlayLayer"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.ZIndex = Theme.OverlayZIndex
	overlay.Active = false
	overlay.ClipsDescendants = false
	overlay.Parent = parent

	-- Every floating child inherits the overlay's ZIndex band unless it asks for
	-- something higher, so a toast can still sit above a dropdown.
	local function inherit(node: Instance)
		for _, child in ipairs(node:GetChildren()) do
			if child:IsA("GuiObject") then
				child.ZIndex = math.max(child.ZIndex, Theme.OverlayZIndex)
			end
			inherit(child)
		end
	end
	overlay.DescendantAdded:Connect(function(child)
		if child:IsA("GuiObject") then
			child.ZIndex = math.max(child.ZIndex, Theme.OverlayZIndex)
		end
	end)
	inherit(overlay)

	return overlay
end

--- Reparents an existing floating widget into the overlay layer.
function Theme.raise(overlay: Frame, node: GuiObject, offset: number?)
	node.ZIndex = math.max(node.ZIndex, Theme.OverlayZIndex + (offset or 0))
end

function Theme.listLayout(padding: number?, direction: Enum.FillDirection?, sortOrder: Enum.SortOrder?): UIListLayout
	return Theme.create("UIListLayout", {
		Padding = UDim.new(0, padding or 4),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = sortOrder or Enum.SortOrder.LayoutOrder,
	})
end

function Theme.separator(): Frame
	local f = Theme.create("Frame", {
		BackgroundColor3 = Theme.Extra.Border,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
	})
	return f
end

function Theme.scrollingFrame(options: {
	automaticCanvasSize: Enum.AutomaticSize?,
	layoutOrder: number?,
	scrollingDirection: Enum.ScrollingDirection?,
}?): ScrollingFrame
	local o = options or {}
	return Theme.create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = Theme.Metrics.ScrollThickness,
		ScrollBarImageColor3 = Theme.Extra.BorderStrong,
		ScrollBarImageTransparency = 0.25,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = o.automaticCanvasSize or Enum.AutomaticSize.None,
		LayoutOrder = o.layoutOrder or 0,
		ScrollingDirection = o.scrollingDirection or Enum.ScrollingDirection.Y,
	})
end

--=============================================================================
-- MOTION
--=============================================================================

function Theme.tween(instance: Instance, goal: { [string]: any }, duration: number?): Tween
	return TweenService:Create(
		instance,
		TweenInfo.new(if Theme.motionEnabled == false then 0 else (duration or Theme.Motion.Normal), Theme.Motion.Fade, Theme.Motion.Out),
		goal
	)
end

function Theme.fadeIn(instance: GuiObject, duration: number?): Tween
	return Theme.tween(instance, { BackgroundTransparency = 1, TextTransparency = 1, ImageTransparency = 1 }, 0)
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">Time</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Utilities / Time
	Small time formatting helpers plus a monotonic id generator used for
	task IDs, action IDs and conversations.
]]

local Time = {}

Time._counter = 0

--- Monotonic, collision-free identifier with a readable prefix.
function Time.newId(prefix: string?): string
	Time._counter += 1
	local suffix = string.format("%x", math.floor(os.clock() * 1000000) % 0xFFFFFF):sub(-4)
	return string.format("%s-%d%s", prefix or "id", Time._counter, suffix)
end

--- Formats seconds as `8.4s` / `1m 04s` / `0.9s`.
function Time.formatDuration(seconds: number): string
	if seconds &lt; 0 then
		seconds = 0
	end
	if seconds &lt; 60 then
		return string.format("%.1fs", seconds)
	end
	local minutes = math.floor(seconds / 60)
	local remainder = math.floor(seconds % 60)
	if minutes &lt; 60 then
		return string.format("%dm %02ds", minutes, remainder)
	end
	local hours = math.floor(minutes / 60)
	return string.format("%dh %02dm", hours, minutes % 60)
end

--- Formats a byte count for attachment rows.
function Time.formatBytes(bytes: number): string
	if bytes &lt; 1024 then
		return string.format("%d B", bytes)
	elseif bytes &lt; 1024 * 1024 then
		return string.format("%.1f KB", bytes / 1024)
	elseif bytes &lt; 1024 * 1024 * 1024 then
		return string.format("%.1f MB", bytes / (1024 * 1024))
	end
	return string.format("%.2f GB", bytes / (1024 * 1024 * 1024))
end

--- Comma separated integer formatting for token counts.
function Time.formatNumber(value: number): string
	local rounded = math.floor(value + 0.5)
	local text = tostring(rounded)
	local sign = if string.sub(text, 1, 1) == "-" then "-" else ""
	text = string.sub(text, #sign + 1)
	local out = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	out = string.gsub(out, "^,", "")
	return sign .. out
end

--- Wall-clock stamp used in log rows and message headers.
function Time.timestamp(): string
	-- FormatLocalTime already renders in the viewer's local zone, so no
	-- ToLocal() step is needed (and the real engine rejects the call).
	return DateTime.now():FormatLocalTime("HH:mm:ss", "short")
end

function Time.clockNow(): number
	return os.clock()
end

return Time</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">UIHealthCheck</string>
          <string name="Source"><![CDATA[--!strict
-- Local checks: no provider request, persistent settings or Workspace edits.
local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Parent.UI.Components)
local Renderer = require(script.Parent.Parent.UI.MessageRenderer)

local UIHealthCheck = {}

function UIHealthCheck.run(): { passed: number, total: number, errors: { string } }
	local report = { passed = 0, total = 0, errors = {} :: { string } }
	local owned: { Instance } = {}
	local function keep<T>(object: T): T
		owned[#owned + 1] = object :: any
		return object
	end
	local function check(name: string, operation: () -> boolean)
		report.total += 1
		local ok, result = pcall(operation)
		if ok and result == true then report.passed += 1
		else report.errors[#report.errors + 1] = name .. ": " .. tostring(result) end
	end
	check("Rich text", function()
		return Renderer.formatInline("<Part> & **bold**") == "&lt;Part&gt; &amp; <b>bold</b>"
	end)
	check("Code blocks", function()
		local blocks = Renderer.parseBlocks("Example\n```lua\nprint(1)\n```\nDone")
		return #blocks == 3 and blocks[2].kind == "code" and blocks[2].content == "print(1)"
	end)
	check("Input sizing", function()
		local input = keep(Theme.input("Message"))
		return input.Size.Y.Scale == 0 and input.Size.Y.Offset == Theme.Metrics.InputHeight
	end)
	check("Flex reuse", function()
		local frame = keep(Instance.new("Frame"))
		Theme.flexItem(frame, 1, 1)
		local flex = Theme.flexItem(frame, 0, 0)
		return #frame:GetChildren() == 1 and flex.FlexMode == Enum.UIFlexMode.Custom and flex.GrowRatio == 0
	end)
	check("Scrolling input", function()
		local scroll = keep(Instance.new("ScrollingFrame"))
		Theme.passThrough(scroll)
		return scroll.Active
	end)
	check("Dropdown selection", function()
		local row, _, selected, setSelected = Components.dropdown("Mode", { "Chat", "Plan" }, function() end)
		keep(row)
		setSelected("Plan")
		return selected() == "Plan"
	end)
	check("Button grid", function()
		local row, add = Components.buttonRow({ columns = 2 })
		keep(row)
		add("One"); add("Two"); add("Three")
		return row.Size.Y.Offset >= Theme.Metrics.ButtonHeight * 2
	end)
	check("Message controller", function()
		local frame, controller = Renderer.render({ id = "ui-check", role = "assistant", content = "", streaming = true }, {})
		keep(frame)
		return typeof(frame) == "Instance" and type(controller) == "table" and type(controller.appendDelta) == "function"
	end)
	for _, object in owned do object:Destroy() end
	return report
end

return UIHealthCheck
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">UniversalErrorDetector</string>
          <string name="Source">--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Utilities / UniversalErrorDetector
	Classifies provider failures regardless of language or shape.

	DETECTION PRIORITY (highest first)
	  1. HTTP status
	  2. Structured provider error code
	  3. Provider error category
	  4. Response headers
	  5. Documented provider error schema
	  6. Multilingual message classification
	  7. Unknown fallback

	CRITICAL GUARANTEE
	The detector only ever runs on FAILURE paths: a non-2xx status, a 2xx body
	that carries a provider error object, an SSE error event, or a transport
	error. It is never applied to ordinary assistant chat text, so a user asking
	"why does 429 mean rate limited?" can never trigger a retry.
]]

local Redact = require(script.Parent.Redact)

local UniversalErrorDetector = {}

--=============================================================================
-- CATEGORIES
--=============================================================================

export type Category =
	| "RATE_LIMITED"
	| "CONCURRENCY_LIMITED"
	| "PROVIDER_OVERLOADED"
	| "QUOTA_WINDOW_EXHAUSTED"
	| "DAILY_QUOTA_EXHAUSTED"
	| "INSUFFICIENT_CREDITS"
	| "INVALID_API_KEY"
	| "INVALID_MODEL"
	| "INVALID_ENDPOINT"
	| "INVALID_REQUEST"
	| "CONTEXT_LENGTH_EXCEEDED"
	| "UNSUPPORTED_FEATURE"
	| "INVALID_ATTACHMENT"
	| "CONTENT_FILTERED"
	| "PERMISSION_DENIED"
	| "SERVER_ERROR"
	| "NETWORK_ERROR"
	| "TIMEOUT"
	| "STREAM_INTERRUPTED"
	| "UNKNOWN_ERROR"

local categories: { [string]: Category } = {
	RATE_LIMITED = "RATE_LIMITED",
	CONCURRENCY_LIMITED = "CONCURRENCY_LIMITED",
	PROVIDER_OVERLOADED = "PROVIDER_OVERLOADED",
	QUOTA_WINDOW_EXHAUSTED = "QUOTA_WINDOW_EXHAUSTED",
	DAILY_QUOTA_EXHAUSTED = "DAILY_QUOTA_EXHAUSTED",
	INSUFFICIENT_CREDITS = "INSUFFICIENT_CREDITS",
	INVALID_API_KEY = "INVALID_API_KEY",
	INVALID_MODEL = "INVALID_MODEL",
	INVALID_ENDPOINT = "INVALID_ENDPOINT",
	INVALID_REQUEST = "INVALID_REQUEST",
	CONTEXT_LENGTH_EXCEEDED = "CONTEXT_LENGTH_EXCEEDED",
	UNSUPPORTED_FEATURE = "UNSUPPORTED_FEATURE",
	INVALID_ATTACHMENT = "INVALID_ATTACHMENT",
	CONTENT_FILTERED = "CONTENT_FILTERED",
	PERMISSION_DENIED = "PERMISSION_DENIED",
	SERVER_ERROR = "SERVER_ERROR",
	NETWORK_ERROR = "NETWORK_ERROR",
	TIMEOUT = "TIMEOUT",
	STREAM_INTERRUPTED = "STREAM_INTERRUPTED",
	UNKNOWN_ERROR = "UNKNOWN_ERROR",
}

UniversalErrorDetector.Categories = categories

--- Categories a Smart Retry controller may retry automatically.
local RETRYABLE: { [string]: boolean } = {
	RATE_LIMITED = true,
	CONCURRENCY_LIMITED = true,
	PROVIDER_OVERLOADED = true,
	QUOTA_WINDOW_EXHAUSTED = true,
	SERVER_ERROR = true,
	NETWORK_ERROR = true,
	TIMEOUT = true,
	STREAM_INTERRUPTED = true,
	UNKNOWN_ERROR = false,
}

--- Categories that must never be retried automatically.
local NEVER_RETRY: { [string]: boolean } = {
	INVALID_API_KEY = true,
	INVALID_MODEL = true,
	INVALID_ENDPOINT = true,
	PERMISSION_DENIED = true,
	INSUFFICIENT_CREDITS = true,
	DAILY_QUOTA_EXHAUSTED = true,
	CONTEXT_LENGTH_EXCEEDED = true,
	UNSUPPORTED_FEATURE = true,
	CONTENT_FILTERED = true,
}

UniversalErrorDetector.RETRYABLE = RETRYABLE
UniversalErrorDetector.NEVER_RETRY = NEVER_RETRY

--=============================================================================
-- BODY DECODING
--=============================================================================

--- Decodes an error body.
---
--- Providers routinely append human text to their JSON — a request id, a
--- bracketed retry notice, a stack hint. Decoding the WHOLE body then fails, so
--- the leading balanced JSON object is extracted as a fallback. Anything that is
--- not JSON at all is returned as nil so the text rules can still run.
local function decodeErrorBody(body: any): any
	if type(body) ~= "string" or #body == 0 then
		return nil
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
	if ok and type(decoded) == "table" then
		return decoded
	end

	-- Fall back to the leading balanced object.
	local JSONValidator = require(script.Parent.JSONValidator)
	local extracted = JSONValidator.extractObject(body)
	if extracted and type(extracted) == "table" then
		return extracted
	end
	return nil
end

--=============================================================================
-- CLASSIFICATION TABLES
--=============================================================================
-- Patterns live in Utilities/UniversalPatternTables so they can be extended
-- without touching this file. Every row is a plain literal: no alternation, no
-- non-capturing groups, no multi-byte character classes. The first match wins.

local Tables = require(script.Parent.UniversalPatternTables)

type Row = { pattern: string, category: Category }

local function rows(list: { string }, category: Category): { Row }
	local out: { Row } = {}
	for index, pattern in list do
		out[index] = { pattern = pattern, category = category }
	end
	return out
end

local RATE_LIMIT_ROWS = rows(Tables.RATE_LIMIT, "RATE_LIMITED")
local CONCURRENCY_ROWS = rows(Tables.CONCURRENCY, "CONCURRENCY_LIMITED")
local OVERLOAD_ROWS = rows(Tables.OVERLOAD, "PROVIDER_OVERLOADED")
local QUOTA_DAILY_ROWS = rows(Tables.DAILY_QUOTA, "DAILY_QUOTA_EXHAUSTED")

--- A window/plan rate limit is distinct from a plain rate limit, so it is
--- matched first and separately.
local QUOTA_WINDOW_ROWS: { Row } = {
	{ pattern = "exceeded your current quota", category = "QUOTA_WINDOW_EXHAUSTED" },
	{ pattern = "quota exceeded", category = "QUOTA_WINDOW_EXHAUSTED" },
	{ pattern = "requests per minute", category = "RATE_LIMITED" },
	{ pattern = "requests per minute", category = "RATE_LIMITED" },
}
local CREDITS_ROWS = rows(Tables.CREDITS, "INSUFFICIENT_CREDITS")
local AUTH_ROWS = rows(Tables.AUTH, "INVALID_API_KEY")
local MODEL_ROWS = rows(Tables.MODEL, "INVALID_MODEL")
local ENDPOINT_ROWS = rows(Tables.ENDPOINT, "INVALID_ENDPOINT")
local REQUEST_ROWS = rows(Tables.REQUEST, "INVALID_REQUEST")
local CONTEXT_ROWS = rows(Tables.CONTEXT, "CONTEXT_LENGTH_EXCEEDED")
local UNSUPPORTED_ROWS = rows(Tables.UNSUPPORTED, "UNSUPPORTED_FEATURE")
local ATTACHMENT_ROWS = rows(Tables.ATTACHMENT, "INVALID_ATTACHMENT")
local FILTER_ROWS = rows(Tables.FILTER, "CONTENT_FILTERED")
local PERMISSION_ROWS = rows(Tables.PERMISSION, "PERMISSION_DENIED")

--=============================================================================-- Order matters: the first matching group wins. A window-specific rate limit is
-- distinguished from a generic rate limit BEFORE the generic table is reached.
local GROUPS: { { name: string, rows: { Row } } } = {
	{ name = "credits", rows = CREDITS_ROWS },
	{ name = "quota_window", rows = QUOTA_WINDOW_ROWS },
	{ name = "daily_quota", rows = QUOTA_DAILY_ROWS },
	{ name = "auth", rows = AUTH_ROWS },
	{ name = "model", rows = MODEL_ROWS },
	{ name = "endpoint", rows = ENDPOINT_ROWS },
	{ name = "attachment", rows = ATTACHMENT_ROWS },
	{ name = "filter", rows = FILTER_ROWS },
	{ name = "context", rows = CONTEXT_ROWS },
	{ name = "unsupported", rows = UNSUPPORTED_ROWS },
	{ name = "permission", rows = PERMISSION_ROWS },
	{ name = "concurrency", rows = CONCURRENCY_ROWS },
	{ name = "rate_limit", rows = RATE_LIMIT_ROWS },
	{ name = "overload", rows = OVERLOAD_ROWS },
	{ name = "request", rows = REQUEST_ROWS },
}

--=============================================================================
-- STRUCTURED CODES
--=============================================================================
-- Providers expose stable machine codes. These win over message text.

local CODE_MAP: { [string]: Category } = {
	["rate_limit_exceeded"] = "RATE_LIMITED",
	["rate_limit"] = "RATE_LIMITED",
	["too_many_requests"] = "RATE_LIMITED",
	["requests_per_minute"] = "RATE_LIMITED",
	["throttling"] = "RATE_LIMITED",
	["resource_exhausted"] = "RATE_LIMITED",
	["overloaded"] = "PROVIDER_OVERLOADED",
	["service_unavailable"] = "PROVIDER_OVERLOADED",
	["high_load"] = "PROVIDER_OVERLOADED",
	["concurrency_limit"] = "CONCURRENCY_LIMITED",
	["quota_exceeded"] = "QUOTA_WINDOW_EXHAUSTED",
	["billing_hard_limit_reached"] = "DAILY_QUOTA_EXHAUSTED",
	["insufficient_quota"] = "INSUFFICIENT_CREDITS",
	["insufficient_credits"] = "INSUFFICIENT_CREDITS",
	["insufficient_balance"] = "INSUFFICIENT_CREDITS",
	["credit_balance_is_too_low"] = "INSUFFICIENT_CREDITS",
	["account_depleted"] = "INSUFFICIENT_CREDITS",
	["invalid_api_key"] = "INVALID_API_KEY",
	["invalid_authentication"] = "INVALID_API_KEY",
	["unauthorized"] = "INVALID_API_KEY",
	["authentication_error"] = "INVALID_API_KEY",
	["model_not_found"] = "INVALID_MODEL",
	["invalid_model"] = "INVALID_MODEL",
	["model_not_available"] = "INVALID_MODEL",
	["not_found"] = "INVALID_ENDPOINT",
	["invalid_url"] = "INVALID_ENDPOINT",
	["invalid_request_error"] = "INVALID_REQUEST",
	["invalid_request"] = "INVALID_REQUEST",
	["bad_request"] = "INVALID_REQUEST",
	["context_length_exceeded"] = "CONTEXT_LENGTH_EXCEEDED",
	["max_tokens_exceeded"] = "CONTEXT_LENGTH_EXCEEDED",
	["content_policy_violation"] = "CONTENT_FILTERED",
	["content_filter"] = "CONTENT_FILTERED",
	["blocked"] = "CONTENT_FILTERED",
	["safety_violation"] = "CONTENT_FILTERED",
	["permission_denied"] = "PERMISSION_DENIED",
	["forbidden"] = "PERMISSION_DENIED",
	["region_not_supported"] = "PERMISSION_DENIED",
	["unsupported_feature"] = "UNSUPPORTED_FEATURE",
	["invalid_file"] = "INVALID_ATTACHMENT",
	["unsupported_media_type"] = "INVALID_ATTACHMENT",
	["timeout"] = "TIMEOUT",
	["deadline_exceeded"] = "TIMEOUT",
	["internal_error"] = "SERVER_ERROR",
	["internal_server_error"] = "SERVER_ERROR",
	["api_error"] = "SERVER_ERROR",
	["upstream_error"] = "SERVER_ERROR",
}

--=============================================================================
-- HELPERS
--=============================================================================

local function normaliseMessage(text: any): string
	if type(text) ~= "string" then
		return ""
	end
	return Redact.scrubText(string.lower(text))
end

local function matches(haystack: string, pattern: string): boolean
	-- Patterns are plain literals. A guarded find keeps a malformed row from
	-- throwing and silently disabling every rule behind it.
	local ok, result = pcall(string.find, haystack, pattern, 1, true)
	return ok and result ~= nil
end

--=============================================================================
-- UPSTREAM RETRY METADATA
--=============================================================================

export type UpstreamRetry = {
	present: boolean,
	attempt: number?,
	delaySeconds: number?,
}

--- Detects a provider's OWN retry notice, e.g. "[retrying in 3s attempt #2]".
--- This is upstream metadata and must never be confused with ForgePilot's own
--- retry controller.
function UniversalErrorDetector.detectUpstreamRetry(text: any): UpstreamRetry
	local lowered = string.lower(tostring(text or ""))
	local attempt = string.match(lowered, "attempt%s*#?%s*(%d+)")
	-- "[retrying in 3s attempt #2]" and "retrying in 3 seconds"
	local delay = string.match(lowered, "retrying in%s+(%d+%.?%d*)%s*s")
		or string.match(lowered, "retrying in%s+(%d+%.?%d*)%s*second")
	local retrySeconds = string.match(lowered, "retry_after%s*[:=]%s*(%d+%.?%d*)")
	return {
		present = attempt ~= nil or delay ~= nil or retrySeconds ~= nil,
		attempt = if attempt then tonumber(attempt) else nil,
		delaySeconds = if delay then tonumber(delay) else (if retrySeconds then tonumber(retrySeconds) else nil),
	}
end

--=============================================================================
-- RATE LIMIT WINDOW PARSING
--=============================================================================

export type RateWindow = {
	found: boolean,
	limit: number?,
	windowMs: number?,
	raw: string?,
}

local TIME_UNITS: { [string]: number } = {
	s = 1000,
	sec = 1000,
	secs = 1000,
	second = 1000,
	seconds = 1000,
	m = 60 * 1000,
	min = 60 * 1000,
	mins = 60 * 1000,
	minute = 60 * 1000,
	minutes = 60 * 1000,
	h = 3600 * 1000,
	hr = 3600 * 1000,
	hour = 3600 * 1000,
	hours = 3600 * 1000,
	d = 86400 * 1000,
	day = 86400 * 1000,
	days = 86400 * 1000,
	week = 604800 * 1000,
	month = 2592000 * 1000,
	year = 31536000 * 1000,
	-- Localized units, because providers state windows in the user's language.
	["秒"] = 1000,
	["分"] = 60 * 1000,
	["分钟"] = 60 * 1000,
	["分鐘"] = 60 * 1000,
	["小时"] = 3600 * 1000,
	["小時"] = 3600 * 1000,
	["時間"] = 3600 * 1000,
	["天"] = 86400 * 1000,
	["日"] = 86400 * 1000,
	["周"] = 604800 * 1000,
	["週"] = 604800 * 1000,
	["週間"] = 604800 * 1000,
	["月"] = 2592000 * 1000,
	["月间"] = 2592000 * 1000,
	["月間"] = 2592000 * 1000,
	["年"] = 31536000 * 1000,
	["年間"] = 31536000 * 1000,
	["초"] = 1000,
	["분"] = 60 * 1000,
	["시간"] = 3600 * 1000,
	["일"] = 86400 * 1000,
	["주"] = 604800 * 1000,
	["달"] = 2592000 * 1000,
	["년"] = 31536000 * 1000,
	["detik"] = 1000,
	["menit"] = 60 * 1000,
	["jam"] = 3600 * 1000,
	["hari"] = 86400 * 1000,
	["minggu"] = 604800 * 1000,
	["bulan"] = 2592000 * 1000,
	["tahun"] = 31536000 * 1000,
	["segundo"] = 1000,
	["minuto"] = 60 * 1000,
	["hora"] = 3600 * 1000,
	["día"] = 86400 * 1000,
	["semana"] = 604800 * 1000,
	["mes"] = 2592000 * 1000,
	["año"] = 31536000 * 1000,
}

--- Extracts "&lt;limit&gt; per &lt;window&gt;" from a localized message.
--- Handles "5 requests per 60 seconds", "5 requests/minute",
--- "1分钟内最多请求5次" and "最多5次/分钟".
-- CJK forms put the LIMIT after an "at most" marker and the WINDOW before it:
--   "1分钟内最多请求5次"  -&gt; 5 requests per 1 minute
--   "每分钟最多5次"       -&gt; 5 requests per 1 minute
-- The marker is located with plain finds so multi-byte text is never put into a
-- character class, and the containment suffix is trimmed by byte length.
local CONTAINMENT_IN = string.byte("内")
local CONTAINMENT_YI = string.byte("以")

local function trimContainment(unit: string): string
	local trimmed = unit
	while true do
		local length = #trimmed
		if length &gt;= 6 and string.byte(trimmed, length - 5) == CONTAINMENT_YI and string.byte(trimmed, length - 2) == CONTAINMENT_IN then
			trimmed = string.sub(trimmed, 1, length - 6)
		elseif length &gt;= 3 and string.byte(trimmed, length - 2) == CONTAINMENT_IN then
			trimmed = string.sub(trimmed, 1, length - 3)
		else
			return trimmed
		end
	end
end

local MARKERS = { "最多请求", "最多", "不得超过", "上限为" }

--- Last plain-text occurrence of a needle, or nil.
local function lastPlainFind(text: string, needle: string): (number?, number?)
	local from = 1
	local lastStart: number? = nil
	local lastEnd: number = 0
	while true do
		local a, b = string.find(text, needle, from, true)
		if not a then
			break
		end
		lastStart = a
		lastEnd = b
		from = b + 1
	end
	return lastStart, lastEnd
end

--- The last run of digits in a string, with its 1-based start and end.
--- Uses repeated `string.find` rather than position captures in `string.gmatch`,
--- because position-capture support varies between Lua-family engines.
local function lastNumber(text: string): (string?, number, number)
	local from = 1
	local lastStart: number? = nil
	local lastEnd = 0

	while true do
		local a, b = string.find(text, "%d+", from)
		if not a then
			break
		end
		lastStart = a
		lastEnd = b
		from = b + 1
	end

	if lastStart then
		return string.sub(text, lastStart, lastEnd), lastStart, lastEnd
	end
	return nil, 0, 0
end

local function parseCjkWindow(lowered: string, raw: string): RateWindow?
	local markerStart: number? = nil
	local markerEnd: number = 0
	for _, marker in MARKERS do
		local a, b = string.find(lowered, marker, 1, true)
		if a then
			markerStart = a
			markerEnd = b
			break
		end
	end
	if not markerStart then
		return nil
	end

	-- The limit is the first number after the marker.
	local limitText = string.match(string.sub(lowered, markerEnd + 1), "%d+")
	if not limitText then
		return nil
	end

	local before = string.sub(lowered, 1, markerStart - 1)

	-- "每&lt;unit&gt;最多N次": no number sits between 每 and the marker.
	local perStart, perEnd = lastPlainFind(before, "每")
	local numberText, _, numberEnd = lastNumber(before)

	if perStart and (not numberText or numberEnd &lt; perEnd) then
		local unit = trimContainment(string.sub(before, perEnd + 1))
		local ms = TIME_UNITS[unit]
		if ms then
			return { found = true, limit = tonumber(limitText), windowMs = ms, raw = raw }
		end
		return nil
	end

	-- "&lt;N&gt;&lt;unit&gt;以内最多请求&lt;M&gt;次": the window number is the LAST number before
	-- the marker, and the unit plus containment word follow it.
	if not numberText then
		return nil
	end
	local unit = trimContainment(string.sub(before, numberEnd + 1))
	local ms = TIME_UNITS[unit]
	if not ms then
		return nil
	end

	return {
		found = true,
		limit = tonumber(limitText),
		windowMs = tonumber(numberText) * ms,
		raw = raw,
	}
end

function UniversalErrorDetector.parseRateWindow(text: any): RateWindow
	if type(text) ~= "string" or #text == 0 then
		return { found = false }
	end
	local lowered = string.lower(text)

	-- English / Latin: "5 requests per minute", "5 per min", "max 5/min".
	-- `%a` does not match CJK, so CJK segments are handled separately.
	local count = string.match(lowered, "(%d+)")
	if count then
		local unit = string.match(lowered, "per%s+([%a]+)")
		if unit and TIME_UNITS[unit] then
			return { found = true, limit = tonumber(count), windowMs = TIME_UNITS[unit], raw = text }
		end
		local slashUnit = string.match(lowered, "/%s*([%a]+)")
		if slashUnit and TIME_UNITS[slashUnit] then
			return { found = true, limit = tonumber(count), windowMs = TIME_UNITS[slashUnit], raw = text }
		end
	end

	-- "5次/分钟" and "5/分钟"
	local perFirst, slashSecond = string.match(lowered, "(%d+)%s*次?%s*/%s*([^%d%s]+)")
	if perFirst and TIME_UNITS[slashSecond] then
		return { found = true, limit = tonumber(perFirst), windowMs = TIME_UNITS[slashSecond], raw = text }
	end

	local cjk = parseCjkWindow(lowered, text)
	if cjk then
		return cjk
	end

	return { found = false }
end

--=============================================================================
-- MESSAGE EXTRACTION
--=============================================================================

--- Pulls a human message out of any of the common error body shapes.
function UniversalErrorDetector.extractMessage(body: any): string?
	local decoded = decodeErrorBody(body)
	if decoded == nil then
		if type(body) == "string" and #body &gt; 0 and #body &lt; 2000 then
			return body
		end
		return nil
	end

	local cursor = decoded
	local depth = 0
	while type(cursor) == "table" and depth &lt; 6 do
		local err = cursor.error
		if type(err) == "string" then
			return err
		end
		if type(err) == "table" then
			if type(err.message) == "string" then
				return err.message
			end
			if type(err[1]) == "table" and type(err[1].message) == "string" then
				return err[1].message
			end
			-- Providers nest under a variety of wrapper keys.
			local descended = false
			for _, key in { "inner", "error", "cause", "reason", "detail", "details", "data" } do
				if type(err[key]) == "table" then
					cursor = err[key]
					descended = true
					break
				end
			end
			if descended then
				depth += 1
				continue
			end
			break
		end
		if type(cursor.message) == "string" then
			return cursor.message
		end
		if type(cursor.detail) == "string" then
			return cursor.detail
		end
		if type(cursor.description) == "string" then
			return cursor.description
		end
		if type(cursor.reason) == "string" then
			return cursor.reason
		end
		if type(cursor[1]) == "string" then
			return cursor[1]
		end
		if type(cursor[1]) == "table" and type(cursor[1].message) == "string" then
			return cursor[1].message
		end
		if type(cursor.details) == "table" and type(cursor.details[1]) == "string" then
			return cursor.details[1]
		end
		break
	end
	return nil
end

--- Pulls a machine error code out of any of the common shapes.
function UniversalErrorDetector.extractCode(body: any): string?
	local decoded = decodeErrorBody(body)
	if decoded == nil then
		return nil
	end

	local FIELDS = { "code", "type", "error_code", "status" }

	-- Breadth-first so a top-level code always wins over a nested one.
	local queue: { any } = { decoded }
	local seen = 0
	while #queue &gt; 0 and seen &lt; 24 do
		local node = table.remove(queue, 1)
		seen += 1
		if type(node) == "table" then
			for _, field in FIELDS do
				local value = node[field]
				if type(value) == "string" and #value &gt; 0 then
					return value
				end
				if type(value) == "number" then
					return tostring(value)
				end
			end
			-- Descend only into the objects providers actually nest under.
			for _, key in { "error", "error_info", "detail", "details", "data", "meta" } do
				if type(node[key]) == "table" then
					table.insert(queue, node[key])
				end
			end
			if type(node[1]) == "table" then
				table.insert(queue, node[1])
			end
		end
	end
	return nil
end

--- True when a 2xx body actually carries a provider error rather than content.
function UniversalErrorDetector.bodyIsError(body: string?): boolean
	if type(body) ~= "string" or #body == 0 then
		return false
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
	if not ok or type(decoded) ~= "table" then
		return false
	end
	if decoded.error ~= nil then
		return true
	end
	if type(decoded.object) == "string" and decoded.object == "error" then
		return true
	end
	if type(decoded.success) == "boolean" and decoded.success == false then
		return true
	end
	if type(decoded.status) == "string" and string.find(decoded.status:lower(), "fail", 1, true) then
		return true
	end
	if type(decoded.detail) == "string" and decoded.error == nil then
		-- Some gateways return {"detail": "..."} with a 200.
		return decoded.error ~= nil or decoded.message ~= nil
	end
	return false
end

--=============================================================================
-- CLASSIFICATION
--=============================================================================

export type Input = {
	statusCode: number?,
	body: string?,
	headers: { [string]: string }?,
	transportError: string?,
	streamInterrupted: boolean?,
}

export type Classification = {
	category: Category,
	source: string,
	confidence: number,
	providerCode: string?,
	message: string?,
	rateWindow: RateWindow,
	upstreamRetry: UpstreamRetry,
}

--- Classifies a provider failure. Returns the category plus how it was decided.
function UniversalErrorDetector.classify(input: Input): Classification
	local result: Classification = {
		category = "UNKNOWN_ERROR",
		source = "unknown_fallback",
		confidence = 0.1,
		providerCode = nil,
		message = nil,
		rateWindow = { found = false },
		upstreamRetry = { present = false },
	}

	local message = UniversalErrorDetector.extractMessage(input.body)
	result.message = if message then Redact.scrubText(message) else nil
	result.providerCode = UniversalErrorDetector.extractCode(input.body)
	result.upstreamRetry = UniversalErrorDetector.detectUpstreamRetry(input.body or input.transportError)
	result.rateWindow = UniversalErrorDetector.parseRateWindow(input.body or "")

	-- 0. Transport failures (no HTTP response at all).
	if input.transportError then
		local text = string.lower(input.transportError)
		if string.find(text, "timed out", 1, true) or string.find(text, "timeout", 1, true) then
			result.category = "TIMEOUT"
			result.source = "transport_error"
			result.confidence = 0.95
			return result
		end
		result.category = "NETWORK_ERROR"
		result.source = "transport_error"
		result.confidence = 0.8
		result.message = Redact.scrubText(input.transportError)
		return result
	end

	if input.streamInterrupted then
		result.category = "STREAM_INTERRUPTED"
		result.source = "stream_state"
		result.confidence = 0.9
		return result
	end

	-- 1. HTTP status.
	local status = input.statusCode
	if status ~= nil then
		if status == 401 then
			result.category = "INVALID_API_KEY"
			result.source = "http_status"
			result.confidence = 0.97
			return result
		end
		if status == 402 then
			result.category = "INSUFFICIENT_CREDITS"
			result.source = "http_status"
			result.confidence = 0.95
			return result
		end
		if status == 403 then
			result.category = "PERMISSION_DENIED"
			result.source = "http_status"
			result.confidence = 0.9
			return result
		end
		if status == 408 then
			result.category = "TIMEOUT"
			result.source = "http_status"
			result.confidence = 0.9
			return result
		end
		if status == 413 then
			result.category = "INVALID_ATTACHMENT"
			result.source = "http_status"
			result.confidence = 0.8
			return result
		end
		if status == 429 then
			result.category = "RATE_LIMITED"
			result.source = "http_status"
			result.confidence = 0.9
			return result
		end
		if status == 404 then
			result.category = "INVALID_ENDPOINT"
			result.source = "http_status"
			result.confidence = 0.75
			return result
		end
		if status == 405 then
			result.category = "INVALID_ENDPOINT"
			result.source = "http_status"
			result.confidence = 0.8
			return result
		end
		if status &gt;= 500 and status &lt; 600 then
			result.category = "SERVER_ERROR"
			result.source = "http_status"
			result.confidence = 0.85
			return result
		end
	end

	-- 2. Structured provider code.
	if result.providerCode then
		local mapped = CODE_MAP[string.lower(result.providerCode)]
		if mapped then
			result.category = mapped
			result.source = "provider_code"
			result.confidence = 0.9
			return result
		end
	end

	-- 3. Provider error category field.
	if type(input.body) == "string" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, input.body)
		if ok and type(decoded) == "table" then
			local providerCategory = (decoded.error :: any)
			if type(providerCategory) == "table" and type(providerCategory.type) == "string" then
				local mapped = CODE_MAP[string.lower(providerCategory.type)]
				if mapped then
					result.category = mapped
					result.source = "provider_category"
					result.confidence = 0.88
					return result
				end
			end
		end
	end

	-- 4. Response headers.
	local headers = input.headers or {}
	for key, value in headers do
		local loweredKey = string.lower(key)
		if loweredKey == "x-error-category" or loweredKey == "x-error-code" then
			local mapped = CODE_MAP[string.lower(tostring(value))]
			if mapped then
				result.category = mapped
				result.source = "response_header"
				result.confidence = 0.85
				return result
			end
		end
	end

	-- 5/6. Multilingual message classification.
	local haystack = normaliseMessage(input.body) .. " " .. normaliseMessage(result.message)
	if #haystack &gt; 1 then
		for _, group in GROUPS do
			for _, row in group.rows do
				if matches(haystack, row.pattern) then
					result.category = row.category
					result.source = "message_" .. group.name
					result.confidence = 0.78
					return result
				end
			end
		end
	end

	-- 7. Unknown fallback.
	if status ~= nil and status &gt;= 400 then
		result.source = "http_status_unknown"
		result.confidence = 0.4
	end
	return result
end

--- Convenience wrapper used by the retry controller.
function UniversalErrorDetector.isRetryable(category: Category): boolean
	if UniversalErrorDetector.NEVER_RETRY[category] then
		return false
	end
	return UniversalErrorDetector.RETRYABLE[category] == true
end

return UniversalErrorDetector</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">UniversalHTTPClient</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / Utilities / UniversalHTTPClient
	The single transport layer. Every provider adapter goes through here.

	Responsibilities
	  * URL validation and HTTPS enforcement
	  * Request IDs (ForgePilot's own, plus provider ids from the response)
	  * Timeout management and caller-enforced deadlines
	  * Response header collection
	  * Streaming via CreateWebStreamClient with guaranteed cleanup
	  * Sanitised logging (never logs headers, keys or bodies)
	  * Error normalisation hooks

	Retry is deliberately NOT here: one SmartAutoRetryManager owns retries for an
	entire operation so retry loops can never be nested.
]]

local BaseURLResolver = require(script.Parent.Parent.AI.BaseURLResolver)
local ErrorHandler = require(script.Parent.ErrorHandler)
local Logger = require(script.Parent.Logger)
local Redact = require(script.Parent.Redact)
local StringUtil = require(script.Parent.StringUtil)
local JSONValidator = require(script.Parent.JSONValidator)

local Time = require(script.Parent.Time)

local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local UniversalHTTPClient = {}

--=============================================================================
-- TYPES
--=============================================================================

export type Headers = { [string]: string }

export type Response = {
	ok: boolean,
	statusCode: number?,
	statusMessage: string?,
	headers: Headers,
	body: string,
	durationMs: number,
	requestId: string?,
	url: string,
	transportError: string?,
}

export type RequestOptions = {
	headers: Headers?,
	json: any?,
	body: string?,
	timeoutMs: number?,
	shouldCancel: (() -> boolean)?,
	label: string?,
	method: "GET" | "POST" | "PUT" | "DELETE" | "PATCH"?,
	accept: string?,
}

--=============================================================================
-- CAPABILITIES
--=============================================================================

local streamingAvailable: boolean? = nil

--- Probes HttpService once and caches the answer.
function UniversalHTTPClient.supportsStreaming(): boolean
	if BridgeClient.isConnected() then return true end
	if streamingAvailable ~= nil then
		return streamingAvailable
	end
	local ok, result = pcall(function()
		return typeof(HttpService.CreateWebStreamClient) == "function"
	end)
	streamingAvailable = ok and result == true
	return streamingAvailable
end

function UniversalHTTPClient.resetCapabilityCache()
	streamingAvailable = nil
end

--=============================================================================
-- INTERNAL
--=============================================================================

local MAX_ERROR_BODY = 4000
local requestCounter = 0

local function nextRequestId(): string
	requestCounter += 1
	return string.format("fp-%d-%d", math.floor(os.clock() * 1000) % 100000, requestCounter)
end

local function headerMap(raw: any): Headers
	local out: Headers = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, value in raw do
		out[string.lower(tostring(key))] = tostring(value)
	end
	return out
end

--- Finds the provider's own request id in a response.
local function extractProviderRequestId(headers: Headers): string?
	for _, name in { "x-request-id", "request-id", "openai-request-id", "anthropic-request-id", "cf-ray" } do
		local value = headers[name]
		if type(value) == "string" and #value > 0 then
			return Redact.scrubText(value)
		end
	end
	return nil
end

--- Validates a URL before anything is sent.
function UniversalHTTPClient.validateUrl(url: string): (string?, string?)
	return BaseURLResolver.normaliseBase(url)
end

local function buildFailure(url: string, message: string, started: number, requestId: string): Response
	return {
		ok = false,
		statusCode = nil,
		statusMessage = nil,
		headers = {},
		body = "",
		durationMs = (os.clock() - started) * 1000,
		requestId = requestId,
		url = url,
		transportError = Redact.scrubText(message),
	}
end

--=============================================================================
-- REQUEST
--=============================================================================

--- Performs one HTTP request. Never retries; never throws.
function UniversalHTTPClient.request(url: string, options: RequestOptions?): Response
	local opts = options or {}
	local started = os.clock()
	local requestId = nextRequestId()

	local normalised, urlError = UniversalHTTPClient.validateUrl(url)
	if not normalised then
		return buildFailure(url, urlError or "Invalid URL.", started, requestId)
	end
	url = normalised

	local headers: Headers = table.clone(opts.headers or {})
	if opts.accept then
		headers["Accept"] = opts.accept
	end

	local bodyText: string? = opts.body
	if bodyText == nil and opts.json ~= nil then
		local encoded = JSONValidator.encode(opts.json)
		if type(encoded) ~= "string" or encoded == "" then
			return buildFailure(url, "Could not serialise the request body to JSON.", started, requestId)
		end
		bodyText = encoded
		headers["Content-Type"] = headers["Content-Type"] or "application/json"
	end

	local request = {
		Url = url,
		Method = opts.method or "POST",
		Headers = headers,
	}
	if bodyText then
		request.Body = bodyText
	end
	if opts.timeoutMs and opts.timeoutMs > 0 and opts.timeoutMs <= 30000 then
		-- Roblox accepts an integer that shortens its native request timeout.
		-- Longer caller deadlines are enforced below, rather than sent as an
		-- unsupported attempt to extend the engine timeout.
		request.Timeout = math.max(1, math.ceil(opts.timeoutMs / 1000))
	end

	Logger.debug("Connection", string.format("%s %s", request.Method, BaseURLResolver.forDisplay(url)), {
		detail = string.format("request %s", requestId),
	})

	local done = false
	local ok, response = false, nil :: any
	if opts.shouldCancel and opts.shouldCancel() then
		return buildFailure(url, "Cancelled.", started, requestId)
	end
	local worker = task.spawn(function()
		ok, response = pcall(HttpService.RequestAsync, HttpService, request)
		done = true
	end)
	local deadline = started + math.max(1, opts.timeoutMs or 120000) / 1000
	while not done do
		local cancelled = opts.shouldCancel and opts.shouldCancel()
		if cancelled or os.clock() >= deadline then
			-- Some engine yield states cannot be cancelled. Their eventual result
			-- is discarded; this caller and its UI do not wait for it.
			pcall(task.cancel, worker)
			return buildFailure(url, if cancelled then "Cancelled." else "Request timed out.", started, requestId)
		end
		task.wait(0.05)
	end
	local durationMs = (os.clock() - started) * 1000

	if not ok then
		local message = ErrorHandler.describe(response)
		Logger.error("Connection", "Request failed before a response.", {
			detail = string.format("%s · %s", BaseURLResolver.forDisplay(url), message),
		})
		return buildFailure(url, message, started, requestId)
	end

	local statusCode = tonumber(response.StatusCode)
	local success = statusCode ~= nil and statusCode >= 200 and statusCode < 300
	local textBody: string = if type(response.Body) == "string"
		then response.Body
		else if response.Body ~= nil then tostring(response.Body) else ""

	if not success and #textBody > MAX_ERROR_BODY then
		textBody = string.sub(textBody, 1, MAX_ERROR_BODY) .. "\n…(truncated)"
	end

	local parsedHeaders = headerMap(response.Headers)

	local result: Response = {
		ok = success,
		statusCode = statusCode,
		statusMessage = response.StatusMessage,
		headers = parsedHeaders,
		body = textBody,
		durationMs = durationMs,
		requestId = extractProviderRequestId(parsedHeaders),
		url = url,
		transportError = nil,
	}

	-- A 200 that actually carries a provider error object is NOT a success.
	if success then
		local okDetect, isError = pcall(function()
			return require(script.Parent.UniversalErrorDetector).bodyIsError(textBody)
		end)
		if okDetect and isError then
			result.ok = false
		end
	end

	-- Headers are never logged; only a safe summary is.
	Logger.debug("Connection", string.format("%s → HTTP %s in %.0f ms", opts.label or "request", tostring(statusCode), durationMs), {
		detail = string.format("request %s", requestId),
	})

	return result
end

--- POSTs a JSON body.
function UniversalHTTPClient.postJson(url: string, headers: Headers?, json: any, options: { timeoutMs: number?, label: string?, shouldCancel: (() -> boolean)? }?): Response
	local opts = options or {}
	return UniversalHTTPClient.request(url, {
		method = "POST",
		headers = headers,
		json = json,
		timeoutMs = opts.timeoutMs,
		label = opts.label,
		shouldCancel = opts.shouldCancel,
		accept = "application/json",
	})
end

--- GETs a resource.
function UniversalHTTPClient.get(url: string, headers: Headers?, options: { timeoutMs: number?, label: string?, accept: string?, shouldCancel: (() -> boolean)? }?): Response
	local opts = options or {}
	return UniversalHTTPClient.request(url, {
		method = "GET",
		headers = headers,
		timeoutMs = opts.timeoutMs,
		label = opts.label,
		shouldCancel = opts.shouldCancel,
		accept = opts.accept or "application/json",
	})
end

--=============================================================================
-- STREAMING
--=============================================================================

export type StreamCallbacks = {
	onActivity: (() -> ())?,
	onOpen: ((statusCode: number?, headers: Headers) -> ())?,
	onChunk: ((chunk: string) -> ())?,
	onComplete: ((body: string, durationMs: number, requestId: string?) -> ())?,
	onError: ((message: string) -> ())?,
}

export type StreamHandle = {
	cancel: () -> (),
	isCancelled: () -> boolean,
	isDone: () -> boolean,
	--- Server-Sent Events frames already decoded. Useful for SSE error events.
	frames: { string },
}

--- Opens a streaming request and delivers SSE bytes through callbacks.
---
--- Uses the documented WebStreamClient surface: the body is supplied up front and
--- chunks arrive on the `MessageReceived` signal. Every exit path calls Close()
--- exactly once.
function UniversalHTTPClient.stream(request: {
	url: string,
	headers: Headers,
	body: string,
	timeoutMs: number,
	label: string,
}, callbacks: StreamCallbacks): (StreamHandle?, string?)
    if BridgeClient.isConnected() then return BridgeClient.stream(request, callbacks) end
	if not UniversalHTTPClient.supportsStreaming() then
		return nil,
			"This Studio build does not expose HttpService:CreateWebStreamClient, so streaming is unavailable. Non-streaming requests still work."
	end

	local normalised, urlError = BaseURLResolver.normaliseBase(request.url)
	if not normalised then
		return nil, urlError
	end

	local headers: Headers = table.clone(request.headers)
	headers["Accept"] = "text/event-stream"

	-- HttpService:CreateWebStreamClient(streamClientType, requestOptions).
	-- Enum.WebStreamClientType is { SSE, RawStream, WebSocket } — there is no
	-- "HttpRequest" member. RawStream preserves SSE event names and framing for the adapters.
	-- The body travels in requestOptions.Body and the response arrives through the
	-- client's signals; WebStreamClient has no Write/Flush/ReadChunk members.
	local opened, client = pcall(HttpService.CreateWebStreamClient, HttpService, Enum.WebStreamClientType.RawStream, {
		Url = normalised,
		Method = "POST",
		Headers = headers,
		Body = request.body,
	})

	if not opened or client == nil then
		return nil, "Could not open a stream: " .. ErrorHandler.describe(client)
	end

	local cancelled = false
	local closed = false
	local finished = false
	local started = os.clock()
	local lastDataAt = started
	local frames: { string } = {}
	local collected: { string } = {}

	local function safeClose()
		if closed then
			return
		end
		closed = true
		pcall(function()
			client:Close()
		end)
	end

	local function finishComplete()
		if finished or cancelled then
			return
		end
		finished = true
		safeClose()
		if callbacks.onComplete then
            local ok = pcall(callbacks.onComplete, table.concat(collected), (os.clock() - started) * 1000, nil)
            if not ok and callbacks.onError then pcall(callbacks.onError, "Stream completion callback failed.") end
		end
	end

	local function finishError(message: string)
		if finished or cancelled then
			return
		end
		finished = true
		safeClose()
		if callbacks.onError then pcall(callbacks.onError, message) end
	end

	-- Idle watchdog: a provider that accepts the connection and then goes quiet.
	local idleWatchdog = math.max(1, (request.timeoutMs or 120000) / 1000)
	task.spawn(function()
		repeat
			task.wait(1)
		until cancelled or finished or (os.clock() - lastDataAt) > idleWatchdog
		if not cancelled and not finished then
			finishError(
				"No data received within the configured timeout. The provider may not support streaming on this endpoint."
			)
		end
	end)

	client.MessageReceived:Connect(function(chunk)
		if cancelled or finished then
			return
		end
		if type(chunk) == "string" and #chunk > 0 then
			lastDataAt = os.clock()
			collected[#collected + 1] = chunk
			frames[#frames + 1] = chunk
            if callbacks.onChunk or callbacks.onActivity then
                local ok = pcall(function()
                    if callbacks.onActivity then callbacks.onActivity() end
                    if callbacks.onChunk then callbacks.onChunk(chunk) end
                end)
                if not ok then finishError("Stream processing failed. Check Logs, then retry the request.") end
			end
		end
	end)

	client.Error:Connect(function(status, message)
		finishError(if type(message) == "string" then ("HTTP " .. tostring(status) .. ": " .. message) else ErrorHandler.describe(status))
	end)

	client.Closed:Connect(function()
		finishComplete()
	end)

	local handle: StreamHandle = {
		frames = frames,
		cancel = function()
			cancelled = true
			finished = true
			safeClose()
		end,
		isCancelled = function()
			return cancelled
		end,
		isDone = function()
			return finished or cancelled
		end,
	}

	Logger.debug("Connection", string.format("stream opened: %s", BaseURLResolver.forDisplay(normalised)), {
		detail = Time.timestamp(),
	})
	return handle, nil
end

--- Splits a raw SSE byte stream into decoded `data:` payloads.
--- Shared by every adapter so the framing rules cannot drift between them.
function UniversalHTTPClient.streamSse(raw: string): { string }
	local payloads: { string } = {}
	for frame in string.gmatch(raw or "", "(.-)\n\n") do
		for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
			if string.sub(line, 1, 6) == "data: " then
				payloads[#payloads + 1] = string.sub(line, 7)
			elseif string.sub(line, 1, 5) == "data:" then
				payloads[#payloads + 1] = StringUtil.trim(string.sub(line, 6))
			end
		end
	end
	return payloads
end

--- Extracts an SSE `event:` name plus its `data:` payload from one frame.
function UniversalHTTPClient.parseSseFrame(frame: string): { name: string?, data: string? }
	local name: string? = nil
	local dataLines: { string } = {}
	for line in (frame .. "\n"):gmatch("(.-)\r?\n") do
		if string.sub(line, 1, 7) == "event: " then
			name = StringUtil.trim(string.sub(line, 9))
		elseif string.sub(line, 1, 6) == "data: " then
			dataLines[#dataLines + 1] = string.sub(line, 7)
		elseif string.sub(line, 1, 5) == "data:" then
			dataLines[#dataLines + 1] = StringUtil.trim(string.sub(line, 6))
		end
	end
	return { name = name, data = if #dataLines > 0 then table.concat(dataLines, "") else nil }
end

return UniversalHTTPClient
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">UniversalPatternTables</string>
          <string name="Source"><![CDATA[--[[
	ForgePilot / Utilities / UniversalPatternTables
	Flat, alternation-free matching tables for provider error classification.

	WHY FLAT
	Every row is a single literal pattern and the FIRST match wins. There is no
	alternation `(a|b)`, no non-capturing group, and no character class containing
	multi-byte characters. That makes matching identical on every Lua-family
	runtime (including Roblox Studio and the headless test harness), keeps the
	tables trivial to extend, and makes each rule independently verifiable.

	Tables are evaluated in the order given by UniversalErrorDetector.GROUPS, so
	more specific categories are listed before general ones.
]]

local Tables = {}

local rateLimit: { string } = {
	-- English
	"rate limit",
	"rate_limit",
	"ratelimit",
	"too many requests",
	"requests per minute",
	"requests per second",
	"requests per hour",
	"requests per day",
	"request limit",
	"throttl",
	-- "quota exceeded" and "exceeded your current quota" are deliberately absent
	-- here: they map to QUOTA_WINDOW_EXHAUSTED, which is matched earlier.
	"slow down",
	-- Simplified Chinese
	"请求过于频繁",
	"请求频率超限",
	"已达到请求数限制",
	"达到请求数限制",
	"访问频率过高",
	"每分钟请求次数限制",
	"频率限制",
	"超出频率",
	"调用次数超限",
	"请求数限制",
	-- Traditional Chinese
	"請求過於頻繁",
	"請求頻率超限",
	"已達到請求數限制",
	"訪問頻率過高",
	"頻率限制",
	-- Japanese
	"レート制限",
	"リクエストが多すぎ",
	"頻度制限",
	"アクセスが集中",
	"多すぎるリクエスト",
	-- Korean
	"요청 한도",
	"요청이 너무 많",
	"호출 한도",
	"속도 제한",
	"요청 제한",
	-- Indonesian
	"terlalu banyak permintaan",
	"batas permintaan",
	"permintaan melebihi",
	"batas laju",
	-- Spanish
	"demasiadas solicitudes",
	"demasiadas peticiones",
	"límite de solicitudes",
	"límite de peticiones",
	"excede el límite",
	"excede el limite",
	"límite alcanzado",
	"limite alcanzado",
	"solicitudes por minuto",
	"intente de nuevo más tarde",
	"intente de nuevo mas tarde",
}

local concurrency: { string } = {
	"concurrent",
	"too many concurrent",
	"并发请求数已达上限",
	"并发",
	"並行",
	"동시 요청",
	"permintaan bersamaan",
	"solicitudes simultáneas",
	"solicitudes simultaneas",
}

local overload: { string } = {
	"overloaded",
	"server is busy",
	"service unavailable",
	"temporarily unavailable",
	"try again later",
