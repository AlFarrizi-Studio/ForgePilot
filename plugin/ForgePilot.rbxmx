local function countKeys(t: any): number
	if type(t) ~= "table" then
		return 0
	end
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

local function countKeys(t: any): number
	if type(t) ~= "table" then
		return 0
	end
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

--=============================================================================
-- REGISTRY
--=============================================================================

local registry: { [string]: Tool } = {}
local ordered: { Tool } = {}

for _, tool in READ_TOOLS do
	registry[tool.name] = tool
	ordered[#ordered + 1] = tool
end
for _, tool in WRITE_TOOLS do
	registry[tool.name] = tool
	ordered[#ordered + 1] = tool
end

for _, tool in ExternalTools.list do
    registry[tool.name] = tool
    ordered[#ordered + 1] = tool
end

ToolValidator.registry = registry
ToolValidator.ordered = ordered

function ToolValidator.get(name: string): Tool?
	return registry[name]
end

function ToolValidator.all(): { Tool }
	return table.clone(ordered)
end

function ToolValidator.forMode(mode: Mode): { Tool }
	local list = {}
	for _, tool in ordered do
		if tool.external and not BridgeClient.canTool(tool.name) then continue end
		if tool.mode == "plan" then
			list[#list + 1] = tool
		elseif mode == "build" then
			list[#list + 1] = tool
		end
	end
	return list
end

--=============================================================================
-- VALIDATION
--=============================================================================

export type ValidationResult = {
	ok: boolean,
	tool: Tool?,
	arguments: { [string]: any }?,
	errors: { string },
	blockedReason: string?,
}

--- Validates a model-issued tool call.
--- `mode` is the plugin's current operating mode; Planning can never call a
--- write tool, regardless of what the model asked for.
function ToolValidator.validate(toolName: string, rawArguments: any, mode: Mode): ValidationResult
	local tool = registry[toolName]
	if not tool then
		local suggestions = {}
		for name in pairs(registry) do
			if string.find(string.lower(name), string.lower(toolName), 1, true) then
				suggestions[#suggestions + 1] = name
			end
		end
		local hint = if #suggestions > 0
			then string.format(" Did you mean: %s?", table.concat(suggestions, ", "))
			else ""
		return {
			ok = false,
			tool = nil,
			arguments = nil,
			errors = { string.format("Unknown tool `%s`.%s", tostring(toolName), hint) },
			blockedReason = "unknown_tool",
		}
	end

	if tool.mode == "build" and mode ~= "build" then
		return {
			ok = false,
			tool = tool,
			arguments = nil,
			errors = {
				string.format(
					"`%s` is a write action. Planning Mode is read-only — it cannot create, modify or delete anything.",
					toolName
				),
			},
			blockedReason = "read_only_mode",
		}
	end

	if tool.external and not BridgeClient.canTool(toolName) then
        return { ok = false, tool = tool, arguments = nil, errors = { "This bridge tool is unavailable. Connect Settings > Agent Access; commands require full access." }, blockedReason = "bridge_unavailable" }
    end

	if type(rawArguments) ~= "table" then
		return {
			ok = false,
			tool = tool,
			arguments = nil,
			errors = { "`arguments` must be a JSON object." },
			blockedReason = "bad_arguments",
		}
	end

	local result = JSONValidator.validate(rawArguments, tool.parameters)
	return {
		ok = result.ok,
		tool = tool,
		arguments = if result.ok then result.value else nil,
		errors = result.errors,
		blockedReason = if result.ok then nil else "bad_arguments",
	}
end

--- Human-readable one-liner for approval dialogs and logs.
function ToolValidator.summarise(toolName: string, arguments: { [string]: any }?): string
	local tool = registry[toolName]
	if not tool then
		return string.format("Run unknown tool `%s`", toolName)
	end
	if tool.summarise and arguments then
		local ok, summary = pcall(tool.summarise, arguments)
		if ok and type(summary) == "string" then
			return summary
		end
	end
	return string.format("Run `%s`", toolName)
end

--=============================================================================
-- TOOL DEFINITIONS FOR THE MODEL
--=============================================================================

--- Converts the registry into provider tool definitions with JSON Schema.
function ToolValidator.toDefinitions(mode: Mode): { { name: string, description: string, parameters: { [string]: any } } }
	local list = {}
	for _, tool in ToolValidator.forMode(mode) do
		local properties: { [string]: any } = {}
		local requiredList: { string } = {}
		local typeMap = {
			string = "string",
			number = "number",
			boolean = "boolean",
			table = "object",
			array = "array",
		}

		for fieldName, rule in tool.parameters do
			local schema: { [string]: any } = {}
			schema.type = typeMap[rule.typeName or "any"]
			if rule.description then
				schema.description = rule.description
			end
			if rule.oneOf then
				schema.enum = rule.oneOf
			end
			if rule.min then
				schema[if rule.typeName == "string" then "minLength" else "minimum"] = rule.min
			end
			if rule.max then
				schema[if rule.typeName == "string" then "maxLength" else "maximum"] = rule.max
			end
			if rule.default ~= nil then
				schema.default = rule.default
			end
			if rule.typeName == "array" then
				schema.items = rule.items or { type = "string", description = "String value." }
			end
			properties[fieldName] = schema
			if rule.required then
				requiredList[#requiredList + 1] = fieldName
			end
		end

		table.insert(list, {
			name = tool.name,
			description = tool.description,
			parameters = {
				type = "object",
				properties = properties,
				required = requiredList,
			},
		})
	end
	return list
end

return ToolValidator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">WorkspaceInspector</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / WorkspaceInspector
	Read-only inspection of the open place.

	Everything here is observation. Nothing in this module mutates the DataModel.
	Output is capped and summarised so a large place does not flood the model.
]]

local WorkspaceInspector = {}

local LIMITS = {
	MAX_CHILDREN = 200,
	MAX_DEPTH = 4,
	MAX_PROPERTIES = 40,
	MAX_SCRIPT_CHARS = 12000,
}

WorkspaceInspector.LIMITS = LIMITS

--=============================================================================
-- BASIC INFO
--=============================================================================

function WorkspaceInspector.getPlaceInfo(): { [string]: any }
	local game = game
	local info: { [string]: any } = {
		name = game.Name,
		placeId = game.PlaceId,
		gameId = game.GameId,
		creatorId = game.CreatorId,
		creatorType = if game.CreatorType == Enum.CreatorType.User then "User" else "Group",
		jobId = game.JobId,
		genre = nil,
	}

	-- Enum.InfoType has no `Game` member (Asset, Product, GamePass,
	-- Subscription, Bundle), so experience metadata is read from the place asset
	-- instead. Any failure just falls back to the place name below.
	local ok, placeInfo = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
	end)
	if ok and type(placeInfo) == "table" then
		info.description = placeInfo.Description
		info.thumbnailId = placeInfo.Thumbnail
	end

	return info
end

--=============================================================================
-- TREE WALK
--=============================================================================

local function describeInstance(instance: Instance, depth: number, budget: { used: number })
	if budget.used &gt; 12000 then
		return { name = instance.Name, className = instance.ClassName, truncated = true }
	end

	local node: { [string]: any } = {
		name = instance.Name,
		className = instance.ClassName,
	}

	if instance:IsA("BasePart") then
		node.size = instance.Size
		node.position = instance.Position
		node.material = instance.Material.Name
		node.color = instance.Color
		local transparency = instance.Transparency
		node.transparent = transparency &gt; 0.05
	end

	if instance:IsA("Model") or instance:IsA("Folder") or instance:IsA("Configuration") then
		node.childCount = #instance:GetChildren()
	end

	local children = instance:GetChildren()
	if depth &lt; LIMITS.MAX_DEPTH and #children &gt; 0 then
		local list = {}
		local limit = math.min(#children, LIMITS.MAX_CHILDREN)
		for index = 1, limit do
			budget.used += 120
			list[index] = describeInstance(children[index], depth + 1, budget)
		end
		if #children &gt; limit then
			list[limit + 1] = { name = string.format("… %d more children", #children - limit), className = "…" }
		end
		node.children = list
	end

	return node
end

function WorkspaceInspector.describeTree(root: Instance?, maxDepth: number?): { [string]: any }
	local target = root or workspace
	local budget = { used = 0 }
	return describeInstance(target, 0, budget)
end

function WorkspaceInspector.summariseTree(root: Instance?): string
	local lines: { string } = {}
	local total = 0

	local function count(instance: Instance)
		total += 1
		local indent = string.rep("  ", math.min(4, math.floor(#lines / 8)))
		lines[#lines + 1] = string.format("%s%s (%s)", indent, instance.Name, instance.ClassName)
		if #lines &gt; LIMITS.MAX_CHILDREN then
			return
		end
		for _, child in instance:GetChildren() do
			count(child)
		end
	end

	count(root or workspace)
	return table.concat(lines, "\n")
end

--=============================================================================
-- PROPERTY READING
--=============================================================================

local SAFE_PROPERTIES: { [string]: { [string]: any } } = {
	BasePart = {
		Anchored = true,
		CanCollide = true,
		Material = true,
		Reflectance = true,
		Transparency = true,
		TopSurface = true,
		BottomSurface = true,
	},
	Part = { Shape = true, Size = true },
	Model = { PrimaryPart = "InstanceRef" },
	Lighting = {
		Ambient = true,
		OutdoorAmbient = true,
		Brightness = true,
		ClockTime = true,
		EnvironmentDiffuseScale = true,
		EnvironmentSpecularScale = true,
		ExposureCompensation = true,
		GlobalShadows = true,
		ShadowSoftness = true,
		Technology = true,
	},
	SoundService = { RespectFilteringEnabled = true },
}

local function tryRead(instance: Instance, property: string): (any?, string?)
	local ok, value = pcall(function()
		return (instance :: any)[property]
	end)
	if ok then
		return value, nil
	end
	return nil, tostring(value)
end

local function serialiseValue(value: any): string
	local valueType = typeof(value)
	if valueType == "EnumItem" then
		return value.Name
	elseif valueType == "Instance" then
		return string.format("%s (%s)", value:GetFullName(), value.ClassName)
	elseif valueType == "Color3" then
		return string.format("#%02X%02X%02X", math.round(value.R * 255), math.round(value.G * 255), math.round(value.B * 255))
	elseif valueType == "UDim2" or valueType == "UDim" or valueType == "Vector3" or valueType == "Vector2" then
		return tostring(value)
	elseif valueType == "number" then
		return string.format("%.4g", value)
	elseif valueType == "string" then
		return string.len(value) &gt; 120 and (string.sub(value, 1, 120) .. "…") or value
	end
	return tostring(value)
end

WorkspaceInspector.serialiseValue = serialiseValue

--- Reads a safe allowlist of properties from any instance.
function WorkspaceInspector.readProperties(instance: Instance): { [string]: string }
	local out: { [string]: string } = {}
	if not instance then
		return out
	end

	-- Universal, always-safe attributes.
	local always = { Name = true, ClassName = true, Archivable = true, Tags = true }
	for key, value in always do
		local ok, result = tryRead(instance, key)
		if ok then
			out[key] = serialiseValue(result)
		end
	end

	local classRules = SAFE_PROPERTIES[instance.ClassName]
	if not classRules then
		for ancestor in instance:GetAncestors() do
			classRules = SAFE_PROPERTIES[ancestor.ClassName]
			if classRules then
				break
			end
		end
	end

	if classRules then
		local count = 0
		for property in pairs(classRules) do
			if count &gt;= LIMITS.MAX_PROPERTIES then
				break
			end
			local ok, value = tryRead(instance, property)
			if ok then
				out[property] = serialiseValue(value)
				count += 1
			end
		end
	end

	return out
end

--=============================================================================
-- CHILDREN OF A NODE
--=============================================================================

function WorkspaceInspector.listChildren(path: string): { { name: string, className: string, path: string } }
	local ok, instance = pcall(function()
		return WorkspaceInspector.resolve(path)
	end)
	if not ok or not instance then
		return {}
	end
	local list = {}
	for index, child in instance:GetChildren() do
		if index &gt; LIMITS.MAX_CHILDREN then
			break
		end
		list[#list + 1] = { name = child.Name, className = child.ClassName, path = child:GetFullName() }
	end
	return list
end

function WorkspaceInspector.resolve(path: string): (Instance?, string?)
	if type(path) ~= "string" then return nil, "Path is empty." end
	local text = path:match("^%s*(.-)%s*$") or ""
	if text == "" then return nil, "Path is empty." end
	if text == "game" or text == game.Name then return game, nil end
	for _, prefix in { "game.", "game/", game.Name .. ".", game.Name .. "/" } do
		if text:sub(1, #prefix) == prefix then text = text:sub(#prefix + 1); break end
	end
	-- Slash paths preserve dots inside object names. Dotted paths match the
	-- names returned by Roblox and the paths advertised in the tool schema.
	local separator = if text:find("/", 1, true) then "[^/]+" else "[^%.]+"
	local current: Instance = game
	for segment in text:gmatch(separator) do
		local child: Instance? = nil
		if current == game and (segment == "Workspace" or segment == "workspace") then child = workspace
		else
			child = current:FindFirstChild(segment)
			if not child and current == game then
				local ok, service = pcall(game.GetService, game, segment)
				if ok then child = service end
			end
		end
		if not child then return nil, string.format("No child named '%s' under %s.", segment, current:GetFullName()) end
		current = child
	end
	return current, nil
end

--=============================================================================
-- LIGHTING
--=============================================================================

function WorkspaceInspector.describeLighting(): { [string]: string }
	local out: { [string]: string } = {}
	local lighting = game:GetService("Lighting")
	local properties = SAFE_PROPERTIES.Lighting
	for property in pairs(properties) do
		local ok, value = tryRead(lighting, property)
		if ok then
			out[property] = serialiseValue(value)
		end
	end

	local effects = {}
	for _, child in lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("BloomEffect") or child:IsA("Sky") then
			effects[#effects + 1] = child.ClassName .. " (" .. child.Name .. ")"
		end
	end
	if #effects &gt; 0 then
		out.Effects = table.concat(effects, ", ")
	end
	return out
end

--=============================================================================
-- GAME UI
--=============================================================================

function WorkspaceInspector.describeUI(): { [string]: any }
	local playerGuiService = game:GetService("PlayerGui")
	local list = {}
	for _, playerGui in playerGuiService:GetChildren() do
		local entry: { [string]: any } = { name = playerGui.Name, screens = {} }
		local count = 0
		for _, child in playerGui:GetDescendants() do
			if child:IsA("GuiObject") or child:IsA("LayerCollector") then
				count += 1
				if count &lt;= 40 then
					entry.screens[#entry.screens + 1] = string.format("%s (%s)", child.Name, child.ClassName)
				end
			end
		end
		entry.total = count
		table.insert(list, entry)
		if #list &gt;= 10 then
			break
		end
	end
	return { playerGuis = list, note = "PlayerGui contents only exist at runtime unless ScreenGui.Enabled and ResetOnSpawn settings are inspected in the editor." }
end

--=============================================================================
-- GAME PLAY SETTINGS
--=============================================================================

function WorkspaceInspector.describeGameSettings(): { [string]: any }
	local settings = {
		maxPlayers = nil,
		joinRequiresPassword = nil,
		allowThirdPartySales = nil,
		loaded = false,
	}

	local ok = pcall(function()
		local service = game:GetService("GameSettings")
		-- Published settings are not readable from an unpublished place.
		settings.loaded = false
	end)

	if not settings.loaded then
		settings.note = "GameSettings publishing options are only readable from a published place, so ForgePilot cannot read them here."
	end
	return settings
end

--=============================================================================
-- COUNTING HELPERS
--=============================================================================

function WorkspaceInspector.countByClass(root: Instance?): { [string]: number }
	local counts: { [string]: number } = {}
	local target = root or workspace
	local budget = 0
	for _, descendant in target:GetDescendants() do
		budget += 1
		if budget &gt; 20000 then
			break
		end
		counts[descendant.ClassName] = (counts[descendant.ClassName] or 0) + 1
	end
	return counts
end

function WorkspaceInspector.getStats(): { [string]: any }
	local totalDescendants = 0
	for _ in workspace:GetDescendants() do
		totalDescendants += 1
		if totalDescendants &gt; 50000 then
			break
		end
	end
	return {
		workspaceChildren = #workspace:GetChildren(),
		workspaceDescendants = totalDescendants,
		counted = totalDescendants &lt;= 50000,
	}
end

return WorkspaceInspector</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="58">
      <Properties>
        <string name="Name">UI</string>
      </Properties>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">ActivityLogs</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / ActivityLogs
	Terminal-style activity panel with auto-scroll, pause, filter, search,
	copy, clear and expandable tool details.

	Everything shown here came from a real event. Nothing is synthesised.
]]

local Clipboard = require(script.Parent.Parent.Utilities.Clipboard)
local Components = require(script.Parent.Components)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local Theme = require(script.Parent.Parent.Utilities.Theme)

local ActivityLogs = {}

local LEVEL_KEYS: { [string]: string } = {
	INFO = "INFO",
	SUCCESS = "OK",
	WARN = "WARN",
	ERROR = "ERR",
	CONNECT = "CONN",
	AGENT = "AGNT",
	PLAN = "PLAN",
	QUESTION = "QSTN",
	TOOL = "TOOL",
	DEBUG = "DBUG",
}

function ActivityLogs.build(parent: GuiObject): Frame
	local view = Instance.new("Frame")
	view.Name = "LogsView"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	Theme.passThrough(view)
	view.Parent = parent

	-- Controls ------------------------------------------------------------
	local controls = Instance.new("Frame")
	controls.Name = "Controls"
	controls.Size = UDim2.new(1, 0, 0, 28)
	controls.BackgroundTransparency = 1
	Theme.passThrough(controls)
	controls.Parent = view

	local searchBox = Theme.input("Filter logs…")
	searchBox.Name = "Search"
	searchBox.Size = UDim2.new(1, -230, 0, 26)
	searchBox.Position = UDim2.fromOffset(0, 1)
	searchBox.TextSize = Theme.TextSizes.Small
	searchBox.Parent = controls

	local pauseButton = Theme.textButton("Pause", { height = 26 })
	pauseButton.Name = "Pause"
	pauseButton.AnchorPoint = Vector2.new(1, 0)
	pauseButton.Position = UDim2.new(1, 0, 0, 1)
	pauseButton.Size = UDim2.fromOffset(72, 26)
	pauseButton.TextSize = Theme.TextSizes.Caption
	pauseButton.TextColor3 = Theme.Colors.SecondaryText
	pauseButton.Parent = controls
	Icons.setButton(pauseButton, "Stop", "Pause")

	local copyButton = Theme.textButton("", { height = 26 })
	copyButton.Name = "Copy"
	copyButton.AnchorPoint = Vector2.new(1, 0)
	copyButton.Position = UDim2.new(1, -76, 0, 1)
	copyButton.Size = UDim2.fromOffset(36, 26)
	Icons.setButton(copyButton, "Copy")
	copyButton.TextSize = 12
	copyButton.TextColor3 = Theme.Colors.SecondaryText
	copyButton.Parent = controls

	local clearButton = Theme.textButton("", { height = 26 })
	clearButton.Name = "Clear"
	clearButton.AnchorPoint = Vector2.new(1, 0)
	clearButton.Position = UDim2.new(1, -116, 0, 1)
	clearButton.Size = UDim2.fromOffset(36, 26)
	Icons.setButton(clearButton, "Trash")
	clearButton.TextSize = 12
	clearButton.TextColor3 = Theme.Colors.SecondaryText
	clearButton.Parent = controls

	local autoScrollButton = Theme.textButton("Auto", { height = 26 })
	autoScrollButton.Name = "AutoScroll"
	autoScrollButton.AnchorPoint = Vector2.new(1, 0)
	autoScrollButton.Position = UDim2.new(1, -156, 0, 1)
	autoScrollButton.Size = UDim2.fromOffset(58, 26)
	autoScrollButton.TextSize = Theme.TextSizes.Caption
	autoScrollButton.TextColor3 = Theme.Colors.Success
	autoScrollButton.Parent = controls
	Icons.setButton(autoScrollButton, "ChevronDown", "Auto")

	-- Filter chips --------------------------------------------------------
	local filterRow = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	filterRow.Name = "Filters"
	filterRow.Size = UDim2.new(1, 0, 0, 0)
	filterRow.AutomaticSize = Enum.AutomaticSize.Y
	filterRow.Position = UDim2.fromOffset(0, 32)
	filterRow.BackgroundTransparency = 1
	Theme.passThrough(filterRow)
	filterRow.ScrollingDirection = Enum.ScrollingDirection.X
	filterRow.Parent = view

	local filterLayout = Instance.new("UIListLayout")
	filterLayout.FillDirection = Enum.FillDirection.Horizontal
	filterLayout.SortOrder = Enum.SortOrder.LayoutOrder
	filterLayout.Padding = UDim.new(0, 4)
	filterLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	filterLayout.Parent = filterRow
	filterRow.AutomaticSize = Enum.AutomaticSize.Y

	local filterPad = Instance.new("UIPadding")
	filterPad.PaddingBottom = UDim.new(0, 6)
	filterPad.PaddingRight = UDim.new(0, 4)
	filterPad.Parent = filterRow

	-- Console -------------------------------------------------------------
	local console = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	console.Name = "Console"
	console.Size = UDim2.new(1, 0, 1, -66)
	console.Position = UDim2.fromOffset(0, 62)
	console.BackgroundColor3 = Theme.Extra.Overlay
	console.BorderSizePixel = 0
	console.Parent = view
	Theme.corner(Theme.Metrics.RadiusSmall).Parent = console
	Theme.padding(8).Parent = console
	Theme.listLayout(2).Parent = console

	-- State ---------------------------------------------------------------
	local paused = false
	local autoScroll = true
	local activeFilter: string? = nil
	local query = ""
	local renderedCount = 0

	local function passesFilter(entry): boolean
		if activeFilter and entry.category ~= activeFilter then
			return false
		end
		if #query >= 2 then
			local needle = string.lower(query)
			local haystack = string.lower(
				string.format("%s %s %s %s", entry.level, entry.category, entry.message, entry.detail or "")
			)
			if not string.find(haystack, needle, 1, true) then
				return false
			end
		end
		return true
	end

	local function atBottom(): boolean
		local maxScroll = math.max(0, console.AbsoluteCanvasSize.Y - console.AbsoluteWindowSize.Y)
		return (maxScroll - console.CanvasPosition.Y) < 40
	end

	local function scrollToBottom()
		console.CanvasPosition = Vector2.new(0, math.max(0, console.AbsoluteCanvasSize.Y - console.AbsoluteWindowSize.Y))
	end

	local function renderEntry(entry)
		local row = Instance.new("Frame")
		row.Name = "LogRow"
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundTransparency = 1
		Theme.passThrough(row)

		-- The line, the details toggle and the detail stack themselves. Parking
		-- them all at y = 0 is what made "details" paint over the log text.
		local rowLayout = Instance.new("UIListLayout")
		rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		rowLayout.Padding = UDim.new(0, 1)
		rowLayout.Parent = row

		local line = Instance.new("TextLabel")
		line.Name = "Line"
		line.RichText = true
		line.TextWrapped = true
		line.TextXAlignment = Enum.TextXAlignment.Left
		line.TextYAlignment = Enum.TextYAlignment.Top
		line.Size = UDim2.new(1, -16, 0, 0)
		line.AutomaticSize = Enum.AutomaticSize.Y
		line.BackgroundTransparency = 1
		Theme.passThrough(line)
		line.Font = Theme.Fonts.Mono
		line.TextSize = 11
		line.LayoutOrder = 1

		-- FormatLocalTime already renders in the viewer's local zone, so there is no
		-- ToLocal() step here. Calling it was both redundant and rejected by the
		-- real engine.
		local stamp = DateTime.fromUnixTimestampMillis(entry.timestamp * 1000)
			:FormatLocalTime("HH:mm:ss", "short")

		local levelText = LEVEL_KEYS[entry.level] or entry.level:sub(1, 4)
		local color = Logger.levelColor[entry.level] or Theme.Colors.SecondaryText
		local hex = string.format("#%02X%02X%02X", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255))

		local body = Redact.scrubText(entry.message):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
		line.Text = string.format(
			'<font color="#6B6377">%s</font>  <font color="%s">[%s]</font>  <font color="#F4F1F8">%s</font>',
			stamp,
			hex,
			levelText,
			body
		)
		line.Parent = row

		if entry.detail and #entry.detail > 0 then
			local detailToggle = Instance.new("TextButton")
			detailToggle.Name = "Toggle"
			detailToggle.Size = UDim2.new(1, 0, 0, 16)
			detailToggle.BackgroundTransparency = 1
			Icons.setButton(detailToggle, "ChevronRight", "details")
			detailToggle.TextXAlignment = Enum.TextXAlignment.Left
			detailToggle.TextColor3 = Theme.Extra.Muted
			detailToggle.TextSize = 10
			detailToggle.Font = Theme.Fonts.Medium
			detailToggle.LayoutOrder = 2
			detailToggle.Parent = row

			local detailLabel = Theme.autoText(Redact.scrubText(entry.detail), {
				size = 10,
				color = Theme.Extra.Muted,
			})
			detailLabel.Name = "Detail"
			detailLabel.Font = Theme.Fonts.Mono
			detailLabel.Visible = false
			detailLabel.AutomaticSize = Enum.AutomaticSize.Y
			detailLabel.LayoutOrder = 3
			detailLabel.Parent = row
			local detailIndent = Instance.new("UIPadding")
			detailIndent.PaddingLeft = UDim.new(0, 14)
			detailIndent.Parent = detailLabel

			detailToggle.MouseButton1Click:Connect(function()
				detailLabel.Visible = not detailLabel.Visible
				Icons.setButton(detailToggle, if detailLabel.Visible then "ChevronDown" else "ChevronRight", "details")
			end)
		end

		return row
	end

	local function append(entry)
		renderedCount += 1
		local row = renderEntry(entry)
		row.LayoutOrder = entry.id
		row.Parent = console
		return row
	end

	local function renderAll()
		for _, child in console:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		renderedCount = 0

		local entries = Logger.getEntries()
		for _, entry in entries do
			if passesFilter(entry) then
				append(entry)
			end
		end
		if autoScroll then
			task.defer(scrollToBottom)
		end
	end

	local function renderFilters()
		for _, child in filterRow:GetChildren() do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end

		local categories = Logger.getCategoryList()
		local all = Instance.new("TextButton")
		all.Name = "Filter_All"
		all.LayoutOrder = 0
		all.Size = UDim2.fromOffset(0, 22)
		all.AutomaticSize = Enum.AutomaticSize.X
		all.BackgroundColor3 = if activeFilter == nil then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
		all.BorderSizePixel = 0
		all.Text = "All"
		all.TextColor3 = if activeFilter == nil then Theme.Colors.Background else Theme.Colors.SecondaryText
		all.TextSize = Theme.TextSizes.Caption
		all.Font = Theme.Fonts.Medium
		all.Parent = filterRow
		Theme.corner(11).Parent = all
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		pad.Parent = all
		all.MouseButton1Click:Connect(function()
			activeFilter = nil
			renderFilters()
			renderAll()
		end)

		for index, category in categories do
			local chip = Instance.new("TextButton")
			chip.Name = "Filter_" .. category
			chip.LayoutOrder = index
			chip.Size = UDim2.fromOffset(0, 22)
			chip.AutomaticSize = Enum.AutomaticSize.X
			chip.BackgroundColor3 = if activeFilter == category then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
			chip.BorderSizePixel = 0
			chip.Text = category
			chip.TextColor3 = if activeFilter == category then Theme.Colors.Background else Theme.Colors.SecondaryText
			chip.TextSize = Theme.TextSizes.Caption
			chip.Font = Theme.Fonts.Medium
			chip.Parent = filterRow
			Theme.corner(11).Parent = chip
			local chipPad = Instance.new("UIPadding")
			chipPad.PaddingLeft = UDim.new(0, 10)
			chipPad.PaddingRight = UDim.new(0, 10)
			chipPad.Parent = chip
			chip.MouseButton1Click:Connect(function()
				activeFilter = if activeFilter == category then nil else category
				renderFilters()
				renderAll()
			end)
		end
	end

	-- Behaviour -----------------------------------------------------------
	local unsubscribe = Logger.subscribe(function(entry)
		if paused or not passesFilter(entry) then
			return
		end
		local stick = autoScroll or atBottom()
		append(entry)
		if stick then
			task.defer(scrollToBottom)
		end
	end)

	pauseButton.MouseButton1Click:Connect(function()
		paused = not paused
		Icons.setButton(pauseButton, if paused then "Play" else "Stop", if paused then "Resume" else "Pause")
		pauseButton.TextColor3 = if paused then Theme.Extra.Warning else Theme.Colors.SecondaryText
		if not paused then
			renderAll()
		end
	end)

	autoScrollButton.MouseButton1Click:Connect(function()
		autoScroll = not autoScroll
		autoScrollButton.TextColor3 = if autoScroll then Theme.Colors.Success else Theme.Extra.Muted
		if autoScroll then
			scrollToBottom()
		end
	end)

	clearButton.MouseButton1Click:Connect(function()
		Logger.clear()
		renderAll()
		renderFilters()
		EventBus.emit(EventBus.Events.Toast, { kind = "info", message = "Activity log cleared." })
	end)

	copyButton.MouseButton1Click:Connect(function()
		local copied, reason, presented = Clipboard.copy(Logger.copyAll())
		if not copied then
			if presented then return end
			EventBus.emit(EventBus.Events.Toast, {
				kind = "error",
				message = reason or "Could not copy the log.",
			})
			return
		end
		EventBus.emit(EventBus.Events.Toast, {
			kind = "success",
			message = "Log copied. API keys and sensitive values are redacted.",
		})
	end)

	local debounce: thread? = nil
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if debounce then
			task.cancel(debounce)
		end
		local snapshot = searchBox.Text
		debounce = task.spawn(function()
			task.wait(0.2)
			query = snapshot
			renderAll()
		end)
	end)

	console:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if not atBottom() and autoScroll then
			autoScroll = false
			autoScrollButton.TextColor3 = Theme.Extra.Muted
		end
	end)

	-- Roblox Instances reject new members, so the API is a plain table returned
	-- alongside the frame rather than fields hung off the Frame itself.
	local api: { [string]: any } = {
		renderAll = renderAll,
		setLevel = function(level: string)
			Logger.setLevel(level :: any)
			renderAll()
		end,
		destroy = function()
			unsubscribe()
			if debounce then
				task.cancel(debounce)
			end
		end,
	}

	renderFilters()
	renderAll()
	return view, api
end

return ActivityLogs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">AgentAccessView</string>
          <string name="Source"><![CDATA[--!strict
local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local AgentAccessView = {}
function AgentAccessView.build(): (ScrollingFrame, any)
    local scroll = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
    scroll.Name = "AgentAccess"; scroll.BackgroundTransparency = 1
    Theme.padding(6).Parent = scroll; Theme.listLayout(10).Parent = scroll
    local destroyed = false
    local busy = false
    local card, body = Components.section("Local agent access", { order = 1, subtitle = "Connect the companion terminal to use files, web research, downloads and real streaming." })
    card.Parent = scroll
    local enabled = Components.toggle("Enable local bridge", SettingsManager.getValue("bridgeEnabled") ~= false, function(value)
        if StateManager.isBusy() then return end
        SettingsManager.setValue("bridgeEnabled", value); BridgeClient.reset()
    end, { order = 0 })
    enabled.Parent = body
    local urlRow, urlHolder = Components.field("Bridge address", { order = 1 })
    urlRow.Parent = body
    local url = Theme.input("http://127.0.0.1:20129")
    url.Text = SettingsManager.getValue("bridgeUrl") or "http://127.0.0.1:20129"
    url.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight); url.Parent = urlHolder
    url.FocusLost:Connect(function()
        if StateManager.isBusy() then return end
        SettingsManager.setValue("bridgeUrl", url.Text); BridgeClient.reset()
    end)
    local tokenRow, tokenHolder = Components.field("Bridge token", { order = 2, hint = "Copy from the bridge terminal. Kept only for this Studio session." })
    tokenRow.Parent = body
    local key = Theme.input("Paste token from terminal")
    key.Name = "BridgeToken"; key.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight); key.TextTransparency = 1; key.Parent = tokenHolder
    local mask = Theme.label("Paste token from terminal", { size = 12, color = Theme.Extra.Muted })
    mask.Name = "Mask"; mask.Size = UDim2.fromScale(1, 1); mask.TextTruncate = Enum.TextTruncate.AtEnd; mask.Parent = key
    key:GetPropertyChangedSignal("Text"):Connect(function() mask.Text = if #key.Text > 0 then string.rep("•", math.min(48, #key.Text)) else "Paste token from terminal" end)
    key.FocusLost:Connect(function() if not StateManager.isBusy() then BridgeClient.setToken(key.Text) end end)
    local connect = Components.textButton("Connect bridge", { order = 3 })
    connect.Name = "ConnectBridge"; connect.Size = UDim2.new(1, 0, 0, 30); connect.Parent = body
    local status = Theme.autoText("Disconnected. Run Start-ForgePilot-Bridge for your OS, paste the token above, then connect. Setup: https://github.com/AlFarrizi-Studio/ForgePilot", { size = 12, color = Theme.Extra.Muted })
    status.Name = "BridgeStatus"; status.LayoutOrder = 4; status.Parent = body
    local function showHealth()
        local health = BridgeClient.getHealth()
        if health then
            status.TextColor3 = Theme.Colors.Success
            status.Text = "Connected · " .. (if health.fullAccess then "Full computer access" else "Workspace only") .. "\nWorkspace: " .. tostring(health.workspace) .. "\nWeb search, URLs, files, downloads, images and streaming are ready." .. (if health.fullAccess then " Terminal commands are available in Build mode." else "")
        end
    end
    connect.MouseButton1Click:Connect(function()
        if busy or StateManager.isBusy() then return end
        SettingsManager.setValue("bridgeUrl", url.Text)
        if #key.Text > 0 then BridgeClient.setToken(key.Text) end
        busy = true; connect.Text = "Connecting…"; connect.Interactable = false
        task.spawn(function()
            local health, err = BridgeClient.connect()
            if destroyed then return end
            busy = false; connect.Text = "Reconnect bridge"; connect.Interactable = true
            if health then showHealth() else status.TextColor3 = Theme.Colors.Error; status.Text = err or "Bridge connection failed." end
        end)
    end)
    local scopeCard, scopeBody = Components.section("What the agent can use", { order = 2 })
    scopeCard.Parent = scroll
    local capabilities = Theme.autoText("Plan: inspect Roblox, search/read websites, list/read/search local files, and pass images to a vision-capable model.\n\nBuild: edit Roblox and local files, download resources, and run terminal commands when full computer access is enabled. File changes keep backups in the workspace.\n\nThe launcher enables full computer access as requested. To restrict it to one folder, run npm run start:bridge -- --workspace-only. Individual tools and confirmations follow Settings > Agent.", { size = 12 })
    capabilities.Parent = scopeBody
    local routerCard, routerBody = Components.section("Provider login", { order = 3 })
    routerCard.Parent = scroll
    local routerInfo = Theme.autoText("Run Start-9Router and Start-ForgePilot-Bridge for OAuth, free-tier and API-key connections. In AI & Provider, choose a provider, then Sign in / Connect in 9Router. Complete login in the browser and refresh its status. Use Refresh models to select an account model.\n\nIf the router requires a client API key, copy it from its dashboard into the provider's 9Router API key field. ForgePilot does not store your OAuth tokens or passwords.", { size = 12 })
    routerInfo.LayoutOrder = 0
    routerInfo.Parent = routerBody
    local passwordRow, passwordHolder = Components.field("9Router dashboard password", { order = 1, hint = "Use when account status requires dashboard login. This is separate from a provider's OAuth login." })
    passwordRow.Parent = routerBody
    local password = Theme.input("Dashboard password")
    password.Name = "RouterPassword"; password.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight); password.TextTransparency = 1; password.Parent = passwordHolder
    local passwordMask = Theme.label("Dashboard password", { size = 12, color = Theme.Extra.Muted })
    passwordMask.Size = UDim2.fromScale(1, 1); passwordMask.TextTruncate = Enum.TextTruncate.AtEnd; passwordMask.Parent = password
    password:GetPropertyChangedSignal("Text"):Connect(function() passwordMask.Text = if #password.Text > 0 then string.rep("•", math.min(32, #password.Text)) else "Dashboard password" end)
    local dashboardLogin = Components.textButton("Connect 9Router dashboard", { order = 2 })
    dashboardLogin.Name = "ConnectRouter"; dashboardLogin.Size = UDim2.new(1, 0, 0, 30); dashboardLogin.Parent = routerBody
    local routerStatus = Theme.autoText("Password stays out of chat and is cleared after connection.", { size = 11, color = Theme.Extra.Muted })
    routerStatus.Name = "RouterSessionStatus"; routerStatus.LayoutOrder = 3; routerStatus.Parent = routerBody
    dashboardLogin.MouseButton1Click:Connect(function()
        if busy or StateManager.isBusy() or not BridgeClient.isConnected() then return end
        if #password.Text == 0 then routerStatus.Text = "Enter the local 9Router dashboard password first."; return end
        local value = password.Text; password.Text = ""
        busy = true; dashboardLogin.Interactable = false; dashboardLogin.Text = "Connecting…"
        task.spawn(function()
            local result, err = BridgeClient.signInRouter(value); value = ""
            if destroyed then return end
            busy = false; dashboardLogin.Interactable = true; dashboardLogin.Text = "Connect 9Router dashboard"
            routerStatus.Text = if result then result.message else err or "Dashboard connection failed."
            routerStatus.TextColor3 = if result then Theme.Colors.Success else Theme.Colors.Error
        end)
    end)
    showHealth()
    scroll.Destroying:Connect(function() destroyed = true end)
    return scroll, { destroy = function() destroyed = true end }
end
return AgentAccessView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">BuilderView</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / UI / BuilderView
	The Build Mode console: mode banner, action log, undo/redo, manual tool
	dispatch and read-only enforcement display.
]]

local ActionExecutor = require(script.Parent.Parent.Roblox.ActionExecutor)
local Components = require(script.Parent.Components)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local HistoryManager = require(script.Parent.Parent.Roblox.HistoryManager)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local JSONValidator = require(script.Parent.Parent.Utilities.JSONValidator)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local SessionManager = require(script.Parent.Parent.Core.SessionManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Theme = require(script.Parent.Parent.Utilities.Theme)
local Time = require(script.Parent.Parent.Utilities.Time)
local ToolValidator = require(script.Parent.Parent.Roblox.ToolValidator)

local BuilderView = {}

function BuilderView.build(parent: GuiObject): Frame
	local view = Instance.new("Frame")
	view.Name = "BuilderView"
	view.Size = UDim2.fromScale(1, 1)
	view.BackgroundTransparency = 1
	Theme.passThrough(view)
	view.Parent = parent

	-- Vertical stack: banner -> toolbar -> tool runner -> action log. The old
	-- version used absolute offsets (0, 0), (0, 54), (0, 86) and a log sized
	-- `1, -92`, so the log was drawn straight over the mode banner.
	local stack = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	stack.Name = "Stack"
	stack.Size = UDim2.fromScale(1, 1)
	stack.BackgroundTransparency = 1
	Theme.passThrough(stack)
	stack.Parent = view

	local stackLayout = Instance.new("UIListLayout")
	stackLayout.SortOrder = Enum.SortOrder.LayoutOrder
	stackLayout.Padding = UDim.new(0, Theme.Space.SM)
	stackLayout.Parent = stack

	local mode: string = SettingsManager.getValue("defaultMode") or "build"

	-- Mode banner ---------------------------------------------------------
	local banner = Instance.new("Frame")
	banner.Name = "ModeBanner"
	banner.Size = UDim2.new(1, 0, 0, 46)
	banner.AutomaticSize = Enum.AutomaticSize.Y
	banner.BackgroundColor3 = Theme.Extra.Surface
	banner.BorderSizePixel = 0
	banner.LayoutOrder = 1
	banner.ClipsDescendants = false
	banner.Parent = stack
	Theme.corner(Theme.Metrics.Radius).Parent = banner
	Theme.padding4(Theme.Space.SM, Theme.Space.SM, Theme.Space.SM, Theme.Space.SM).Parent = banner

	local bannerLayout = Instance.new("UIListLayout")
	bannerLayout.FillDirection = Enum.FillDirection.Vertical
	bannerLayout.SortOrder = Enum.SortOrder.LayoutOrder
	bannerLayout.Padding = UDim.new(0, Theme.Space.SM)
	bannerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	bannerLayout.Parent = banner

	local controls = Instance.new("Frame")
	controls.Name = "ModeControls"
	controls.Size = UDim2.new(1, 0, 0, 28)
	controls.LayoutOrder = 1
	Theme.passThrough(controls)
	controls.Parent = banner
	Theme.listLayout(6, Enum.FillDirection.Horizontal).Parent = controls
	local planToggle = Components.textButton("Plan", { order = 1 })
	planToggle.Size = UDim2.new(0, 0, 0, 26)
	Theme.flexItem(planToggle, 1, 1)
	planToggle.Parent = controls

	local buildToggle = Components.textButton("Build", { order = 2 })
	buildToggle.Size = UDim2.new(0, 0, 0, 26)
	Theme.flexItem(buildToggle, 1, 1)
	buildToggle.Parent = controls

	local modeNote = Theme.autoText("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Extra.Muted,
	})
	modeNote.Name = "Note"
	modeNote.AutomaticSize = Enum.AutomaticSize.Y
	modeNote.Size = UDim2.new(1, 0, 0, 0)
	modeNote.LayoutOrder = 3
	modeNote.Parent = banner

	local function setMode(next: string)
		mode = next
		planToggle.BackgroundColor3 = if next == "plan" then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
		planToggle.TextColor3 = if next == "plan" then Theme.Colors.Background else Theme.Colors.MainText
		buildToggle.BackgroundColor3 = if next == "build" then Theme.Extra.Warning else Theme.Extra.SurfaceRaised
		buildToggle.TextColor3 = if next == "build" then Theme.Colors.Background else Theme.Colors.MainText
		modeNote.Text = if next == "plan"
			then "Read-only. Inspection tools only — no object, script or lighting changes can run."
			else "Write mode enabled. Destructive and script actions still ask for approval."
	end

	planToggle.MouseButton1Click:Connect(function()
		if StateManager.isBusy() then return end
		setMode("plan")
		local conversation = SessionManager.getActive()
		if conversation then SessionManager.setConversationMeta(conversation.id, { mode = "plan" }) else EventBus.emit(EventBus.Events.ModeChanged, { mode = "plan" }) end
	end)
	buildToggle.MouseButton1Click:Connect(function()
		if StateManager.isBusy() then return end
		setMode("build")
		local conversation = SessionManager.getActive()
		if conversation then SessionManager.setConversationMeta(conversation.id, { mode = "build" }) else EventBus.emit(EventBus.Events.ModeChanged, { mode = "build" }) end
	end)

	-- Toolbar -------------------------------------------------------------
	local toolbar = Instance.new("Frame")
	toolbar.Name = "Toolbar"
	toolbar.Size = UDim2.new(1, 0, 0, 28)
	toolbar.AutomaticSize = Enum.AutomaticSize.Y
	toolbar.BackgroundTransparency = 1
	Theme.passThrough(toolbar)
	toolbar.LayoutOrder = 2
	toolbar.ClipsDescendants = false
	toolbar.Parent = stack

	local toolbarLayout = Instance.new("UIListLayout")
	toolbarLayout.FillDirection = Enum.FillDirection.Horizontal
	toolbarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toolbarLayout.Padding = UDim.new(0, Theme.Space.SM)
	toolbarLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	toolbarLayout.Parent = toolbar

	local undoButton = Theme.textButton("Undo", {
		height = 26,
		radius = Theme.Metrics.RadiusSmall,
	})
	undoButton.Name = "Undo"
	undoButton.Size = UDim2.new(0, 0, 0, 26)
	undoButton.TextSize = Theme.TextSizes.Caption
	undoButton.TextTruncate = Enum.TextTruncate.AtEnd
	undoButton.Parent = toolbar
	Icons.setButton(undoButton, "Refresh", "Undo")
	Theme.flexItem(undoButton, 1, 1)

	local redoButton = Theme.textButton("Redo", {
		height = 26,
		radius = Theme.Metrics.RadiusSmall,
	})
	redoButton.Name = "Redo"
	redoButton.Size = UDim2.new(0, 0, 0, 26)
	redoButton.TextSize = Theme.TextSizes.Caption
	redoButton.TextTruncate = Enum.TextTruncate.AtEnd
	redoButton.Parent = toolbar
	Icons.setButton(redoButton, "Refresh", "Redo")
	Theme.flexItem(redoButton, 1, 1)

	undoButton.MouseButton1Click:Connect(function()
		HistoryManager.undo()
	end)
	redoButton.MouseButton1Click:Connect(function()
		HistoryManager.redo()
	end)

	-- Manual tool runner --------------------------------------------------
	local manualToggle = Components.textButton("Run a tool", { order = 3 })
	manualToggle.Size = UDim2.new(0, 0, 0, 26)
	manualToggle.TextSize = Theme.TextSizes.Caption
	manualToggle.TextTruncate = Enum.TextTruncate.AtEnd
	manualToggle.Parent = toolbar
	Theme.flexItem(manualToggle, 1, 1)

	local manualPanel = Instance.new("Frame")
	manualPanel.Name = "ManualPanel"
	manualPanel.Size = UDim2.new(1, 0, 0, 0)
	manualPanel.AutomaticSize = Enum.AutomaticSize.Y
	manualPanel.BackgroundTransparency = 1
	Theme.passThrough(manualPanel)
	manualPanel.Visible = false
	manualPanel.LayoutOrder = 3
	manualPanel.Parent = stack

	local manualLayout = Instance.new("UIListLayout")
	manualLayout.SortOrder = Enum.SortOrder.LayoutOrder
	manualLayout.Padding = UDim.new(0, Theme.Space.MD)
	manualLayout.Parent = manualPanel

	local toolOptions: { string } = {}
	for _, tool in ToolValidator.ordered do
		toolOptions[#toolOptions + 1] = tool.name
	end

	local toolRow, setToolOptions, getTool = Components.dropdown(
		"Tool",
		toolOptions,
		function() end
	)
	toolRow.Parent = manualPanel

	local argsRow, argsHolder = Components.field("Arguments (JSON)", {
		hint = "Strictly validated. Unknown fields are ignored; invalid values are rejected.",
	})
	argsRow.Parent = manualPanel

	local argsBox = Theme.input('{"name":"Example"}', { multiLine = true })
	argsBox.Name = "Args"
	argsBox.Size = UDim2.new(1, 0, 0, 74)
	argsBox.TextYAlignment = Enum.TextYAlignment.Top
	argsBox.Font = Theme.Fonts.Code
	argsBox.TextSize = Theme.TextSizes.Small
	argsBox.Parent = argsHolder

	local runRow, runHolder = Components.field(" ")
	runRow.Parent = manualPanel

	local runButton = Components.textButton("Execute", { accent = true, order = 1 })
	runButton.Parent = runHolder

	local manualResult = Theme.label("", {
		size = Theme.TextSizes.Caption,
		color = Theme.Colors.SecondaryText,
		alignY = Enum.TextYAlignment.Top,
		wrap = true,
	})
	manualResult.Name = "Result"
	manualResult.Size = UDim2.new(1, 0, 0, 0)
	manualResult.AutomaticSize = Enum.AutomaticSize.Y
	manualResult.Parent = manualPanel

	manualToggle.MouseButton1Click:Connect(function()
		manualPanel.Visible = not manualPanel.Visible
		manualToggle.Text = if manualPanel.Visible then "Hide tool runner" else "Run a tool"
	end)

	local function toolListForMode()
		local list = {}
		for _, tool in ToolValidator.forMode(mode) do
			list[#list + 1] = tool.name
		end
		return list
	end
	setToolOptions(toolListForMode())

	local function refreshToolList()
		setToolOptions(toolListForMode())
	end

	runButton.MouseButton1Click:Connect(function()
		local toolName = getTool()
		if not toolName then
			return
		end
		if StateManager.isBusy() then
			EventBus.emit(EventBus.Events.Toast, {
				kind = "warning",
				message = "ForgePilot is busy. Stop the current task first.",
			})
			return
		end

		local argsText = StringUtil.trim(argsBox.Text)
		local arguments: any = {}
		if #argsText > 0 then
			local decoded, err = JSONValidator.decode(argsText)
			if not decoded then
				manualResult.TextColor3 = Theme.Colors.Error
				manualResult.Text = "Arguments are not valid JSON: " .. tostring(err)
				return
			end
			if type(decoded) ~= "table" then
				manualResult.TextColor3 = Theme.Colors.Error
				manualResult.Text = "Arguments must be a JSON object."
				return
			end
			arguments = decoded
		end

		local result, execError = ActionExecutor.execute(toolName, arguments, mode)
		if not result then
			manualResult.TextColor3 = Theme.Colors.Error
			manualResult.Text = execError or "The tool could not be executed."
			return
		end

		manualResult.TextColor3 = if result.verified then Theme.Colors.Success else Theme.Extra.Warning
		manualResult.Text = string.format(
			"[%s] %s\n%s  ·  %.0fms  ·  %s",
			result.toolName,
			if result.verified then "verified" else "unverified",
			result.message,
			result.durationMs,
			Time.timestamp()
		)
	end)

	-- Action log ----------------------------------------------------------
	local log = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	log.Name = "Actions"
	log.Size = UDim2.new(1, 0, 0, 220)
	log.BackgroundColor3 = Theme.Extra.Overlay
	log.BorderSizePixel = 0
	log.LayoutOrder = 4
	log.Parent = stack
	-- The action log claims the leftover height instead of being hardcoded to
	-- `1, -92`, which used to place it straight on top of the mode banner.
	Theme.corner(Theme.Metrics.RadiusSmall).Parent = log
	Theme.padding(Theme.Space.SM).Parent = log
	Theme.listLayout(3).Parent = log

	local function pushAction(text: string, color: Color3, detail: string?)
		local row = Instance.new("Frame")
		row.Name = "Action"
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundTransparency = 1
		Theme.passThrough(row)

		-- The line and its detail are stacked by a list, not by two children
		-- both parked at y = 0.
		local rowLayout = Instance.new("UIListLayout")
		rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		rowLayout.Padding = UDim.new(0, 2)
		rowLayout.Parent = row

		local label = Theme.autoText(
			string.format("%s  %s", Time.timestamp(), text),
			{ size = Theme.TextSizes.Caption, color = color }
		)
		label.Name = "Text"
		label.LayoutOrder = 1
		label.Font = Theme.Fonts.Mono
		label.Parent = row

		if detail and #detail > 0 then
			local detailLabel = Theme.autoText(detail, {
				size = 10,
				color = Theme.Extra.Muted,
			})
			detailLabel.Name = "Detail"
			detailLabel.LayoutOrder = 2
			detailLabel.Font = Theme.Fonts.Mono
			detailLabel.Parent = row
			local indent = Instance.new("UIPadding")
			indent.PaddingLeft = UDim.new(0, 14)
			indent.Parent = detailLabel
		end

		row.Parent = log
		log.CanvasPosition = Vector2.new(0, math.max(0, log.AbsoluteCanvasSize.Y - log.AbsoluteWindowSize.Y))
	end

	local unsubs: { () -> () } = {}
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ModeChanged, function(payload)
		setMode(payload.mode)
		refreshToolList()
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ConversationChanged, function()
		local conversation = SessionManager.getActive()
		setMode(conversation and conversation.mode or SettingsManager.getValue("defaultMode") or "build")
		refreshToolList()
	end)

	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ToolCallStarted, function(payload)
		pushAction(string.format("%s →", payload.summary), Theme.Extra.Warning)
	end)

	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ToolCallFinished, function(payload)
		pushAction(
			payload.toolName,
			if payload.verified then Theme.Colors.Success else Theme.Extra.Warning,
			payload.message
		)
	end)

	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ToolCallFailed, function(payload)
		pushAction(payload.toolName, Theme.Colors.Error, payload.message)
	end)

	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.BuildProgress, function(payload)
		if payload.phase == "undo" then
			pushAction("Undo requested", Theme.Extra.Info)
		elseif payload.phase == "redo" then
			pushAction("Redo requested", Theme.Extra.Info)
		end
	end)

	setMode(mode)

	pushAction("ForgePilot Builder ready.", Theme.Extra.Info, "Switch to Build Mode to allow write actions.")

	-- Roblox Instances reject new members, so the API is a plain table returned
	-- alongside the frame rather than fields hung off the Frame itself.
	local api: { [string]: any } = {
		setMode = function(next: string)
			setMode(next)
			refreshToolList()
		end,
		getMode = function()
			return mode
		end,
		destroy = function()
			for _, unsubscribe in unsubs do
				unsubscribe()
			end
		end,
	}

	return view, api
end

return BuilderView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">ChatInput</string>
          <string name="Source"><![CDATA[--!strict
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")
local AttachmentEncoder = require(script.Parent.Parent.AI.AttachmentEncoder)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local ProviderLogo = require(script.Parent.Parent.Utilities.ProviderLogo)

local ChatInput = {}
function ChatInput.build(options: any): (Frame, any)
	local frame = Instance.new("Frame")
	frame.Name = "ChatInput"
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.BackgroundColor3 = Theme.Colors.Secondary
	frame.BorderSizePixel = 0
	Theme.corner(14).Parent = frame
	local stroke = Theme.stroke(Theme.Extra.BorderStrong)
	stroke.Parent = frame
	Theme.padding(8).Parent = frame
	Theme.listLayout(6).Parent = frame

	local attachments = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	attachments.Name = "Attachments"
	attachments.Size = UDim2.new(1, 0, 0, 28)
	attachments.LayoutOrder = 1
	attachments.Visible = false
	attachments.Active = true
	attachments.Parent = frame
	Theme.listLayout(4).Parent = attachments

	local box = Theme.input("Ask ForgePilot anything about your place…", { multiLine = true, height = 54 })
	box.Name = "Input"
	-- Let Studio submit Return natively, even if its docked window does not
	-- forward InputBegan. Shift+Return inserts a newline explicitly below.
	box.MultiLine = false
	box.BackgroundTransparency = 1
	box.TextSize = Theme.TextSizes.Body
	box.LayoutOrder = 2
	box.Parent = frame
	local innerStroke = box:FindFirstChildOfClass("UIStroke")
	if innerStroke then innerStroke.Transparency = 1 end

	local toolbar = Instance.new("Frame")
	toolbar.Name = "Toolbar"
	toolbar.Size = UDim2.new(1, 0, 0, 32)
	Theme.passThrough(toolbar)
	toolbar.LayoutOrder = 3
	toolbar.Parent = frame
	local layout = Theme.listLayout(4, Enum.FillDirection.Horizontal)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = toolbar
	local function tool(name: string, text: string, width: number, order: number): TextButton
		local button = Theme.textButton(text, { height = 28, width = UDim2.fromOffset(width, 28) })
		button.Name = name
		button.TextSize = 11
		button.BackgroundTransparency = 1
		button.TextColor3 = Theme.Colors.SecondaryText
		button.LayoutOrder = order
		button.Parent = toolbar
		Theme.flexItem(button, 0, 0)
		return button
	end
	local attach = tool("Attach", "", 28, 1)
	Icons.setButton(attach, "Attach")
	attach.TextSize = 22
	local modeButton = tool("Mode", "Plan", 62, 2)
	Icons.setButton(modeButton, "ChevronDown", "Plan")
	modeButton.BackgroundTransparency = 0
	modeButton.BackgroundColor3 = Theme.Extra.SurfaceRaised
	local provider = tool("Provider", "Set up AI", 0, 3)
	provider.TextTruncate = Enum.TextTruncate.AtEnd
	provider.TextXAlignment = Enum.TextXAlignment.Left
	Theme.flexItem(provider, 1, 1)
	Icons.setButton(provider, "ProviderCustom", "Set up AI")
	local action = tool("Send", "", 32, 4)
	Icons.setButton(action, "Send")
	action.Size = UDim2.fromOffset(32, 32)
	action.BackgroundTransparency = 0
	action.TextSize = 21
	Theme.corner(10).Parent = action

	local hint = Theme.label("Enter to send · Shift+Enter for a new line", { size = 10, color = Theme.Extra.Muted })
	hint.Name = "Hint"
	hint.Size = UDim2.new(1, 0, 0, 14)
	hint.LayoutOrder = 4
	hint.Parent = frame

	local mode = "build"
	local submitting = false
	local enabled = true
	local busyOverride = false
	local destroyed = false
	local leftShiftDown, rightShiftDown = false, false
	local maxHeight = 110
	local function busy(): boolean return busyOverride or StateManager.isBusy() end
	local function setMode(value: string)
		mode = if value:lower() == "build" then "build" else "plan"
		Icons.setButton(modeButton, "ChevronDown", if mode == "build" then "Build" else "Plan")
		modeButton.TextColor3 = if mode == "build" then Theme.Extra.Warning else Theme.Colors.SecondaryText
	end
	local function resize()
		local width = math.max(120, box.AbsoluteSize.X - 20)
		local text = if #box.Text > 0 then box.Text else " "
		local bounds = TextService:GetTextSize(text, box.TextSize, box.Font, Vector2.new(width, 100000))
		local height = math.clamp(bounds.Y + 16, 48, maxHeight)
		if box.Size.Y.Offset ~= height then box.Size = UDim2.new(1, 0, 0, height) end
	end
	local function refresh()
		if destroyed then return end
		local working = busy()
		local hasText = StringUtil.trim(box.Text) ~= ""
		action.Name = if working then "Stop" else "Send"
		Icons.setButton(action, if working then "Stop" else "Send")
		action.TextSize = if working then 12 else 21
		action.BackgroundColor3 = if working then Theme.Extra.SurfaceRaised elseif hasText then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
		action.TextColor3 = if working or not hasText then Theme.Colors.SecondaryText else Theme.Colors.Background
		action.Active = working or (enabled and hasText)
		action.Selectable = action.Active
		attach.Active = enabled and not working
		modeButton.Active = enabled and not working
		provider.Active = enabled and not working
		stroke.Color = if box:IsFocused() then Theme.Colors.Highlight else Theme.Extra.BorderStrong
	end
	local function send(textOverride: string?)
		if destroyed or submitting or busy() or not enabled then return end
		local text = StringUtil.trim(textOverride or box.Text)
		if text == "" then return end
		submitting = true
		local ok, accepted = pcall(options.onSend, text)
		if ok and accepted ~= false then
			box.Text = ""
		elseif not ok then
			EventBus.emit(EventBus.Events.Toast, { kind = "error", message = "Could not send the message. " .. tostring(accepted) })
		end
		submitting = false
		resize()
		refresh()
	end
	local function isShift(): boolean
		return leftShiftDown or rightShiftDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	end
	local keyboardConnections: { RBXScriptConnection } = {}
	local boundGui: Instance? = nil
	local enterPending = false
	local function enter(newLine: boolean)
		if destroyed or enterPending then return end
		enterPending = true
		local text = box.Text
		local cursor = if box.CursorPosition > 0 then math.clamp(box.CursorPosition, 1, #text + 1) else #text + 1
		local selection = box.SelectionStart
		local first, last = cursor, cursor
		if selection and selection > 0 then
			selection = math.clamp(selection, 1, #text + 1)
			first, last = math.min(cursor, selection), math.max(cursor, selection)
		end
		-- Release before the native text edit, then apply exactly one action.
		-- This also deduplicates TextBox, PluginGui and FocusLost delivery.
		box:ReleaseFocus(false)
		task.defer(function()
			if not destroyed then
				if newLine then
					box.Text = text:sub(1, first - 1) .. "\n" .. text:sub(last)
					box:CaptureFocus()
					box.CursorPosition = first + 1
					box.SelectionStart = -1
				else
					send(text)
				end
			end
			enterPending = false
		end)
	end
	local function inputBegan(key: InputObject)
		if key.KeyCode == Enum.KeyCode.LeftShift then leftShiftDown = true end
		if key.KeyCode == Enum.KeyCode.RightShift then rightShiftDown = true end
		if (key.KeyCode == Enum.KeyCode.Return or key.KeyCode == Enum.KeyCode.KeypadEnter) and box:IsFocused() then
			enter(isShift())
		end
	end
	local function inputEnded(key: InputObject)
		if key.KeyCode == Enum.KeyCode.LeftShift then leftShiftDown = false end
		if key.KeyCode == Enum.KeyCode.RightShift then rightShiftDown = false end
	end
	box.InputBegan:Connect(inputBegan)
	box.InputEnded:Connect(inputEnded)
	keyboardConnections[#keyboardConnections + 1] = UserInputService.InputBegan:Connect(inputBegan)
	keyboardConnections[#keyboardConnections + 1] = UserInputService.InputEnded:Connect(inputEnded)
	local globalKeyboardConnections = keyboardConnections
	keyboardConnections = {}
	local function bindKeyboard()
		local gui = frame:FindFirstAncestorWhichIsA("PluginGui")
		if gui == boundGui then return end
		for _, connection in keyboardConnections do connection:Disconnect() end
		keyboardConnections = {}
		boundGui = gui
		if gui then
			keyboardConnections[#keyboardConnections + 1] = (gui :: any).InputBegan:Connect(inputBegan)
			keyboardConnections[#keyboardConnections + 1] = (gui :: any).InputEnded:Connect(inputEnded)
		end
	end
	frame.AncestryChanged:Connect(bindKeyboard)

	box.FocusLost:Connect(function(enterPressed)
		if enterPressed and not enterPending then enter(isShift()) end
		if not enterPending then leftShiftDown, rightShiftDown = false, false end
		refresh()
	end)
	box.Focused:Connect(refresh)
	box:GetPropertyChangedSignal("Text"):Connect(function() resize(); refresh() end)
	box:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	action.MouseButton1Click:Connect(function()
		if busy() then options.onStop() else send() end
	end)
	attach.MouseButton1Click:Connect(function() if enabled and not busy() then options.onPickFiles() end end)
	provider.MouseButton1Click:Connect(function() if not busy() then options.onOpenSettings() end end)
	modeButton.MouseButton1Click:Connect(function()
		if not enabled or busy() then return end
		setMode(if mode == "plan" then "build" else "plan")
		options.onModeChange(mode)
	end)

	local function renderAttachments()
		for _, child in attachments:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
		local count = 0
		for _, attachment in AttachmentEncoder.getAll() do
			if not attachment.accepted then continue end
			count += 1
			local row = Instance.new("Frame")
			row.Name = "Attachment_" .. attachment.id
			row.Size = UDim2.new(1, -6, 0, 24)
			row.LayoutOrder = count
			row.BorderSizePixel = 0
			row.BackgroundColor3 = Theme.Extra.SurfaceRaised
			row.Parent = attachments
			Theme.corner(6).Parent = row
			local label = Theme.label(attachment.name, { size = 11 })
			label.Position = UDim2.fromOffset(8, 0)
			label.Size = UDim2.new(1, -38, 1, 0)
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.Parent = row
			local remove = Theme.textButton("", { height = 22, width = UDim2.fromOffset(24, 22) })
			Icons.setButton(remove, "Close")
			remove.Name = "Remove"
			remove.BackgroundTransparency = 1
			remove.AnchorPoint = Vector2.new(1, 0)
			remove.Position = UDim2.new(1, -2, 0, 1)
			remove.Parent = row
			remove.MouseButton1Click:Connect(function() if not busy() then AttachmentEncoder.remove(attachment.id) end end)
		end
		attachments.Visible = count > 0
		attachments.Size = UDim2.new(1, 0, 0, math.min(80, count * 28 - 4))
	end
	local unsubs = {
		EventBus.on(EventBus.Events.AttachmentsChanged, renderAttachments),
		EventBus.on(EventBus.Events.StateChanged, refresh),
	}
	setMode("build")
	refresh()
	renderAttachments()
	return frame, {
		frame = frame, focus = function() box:CaptureFocus() end,
		setText = function(text: string) box.Text = text end,
		getText = function() return box.Text end, setMode = setMode,
		setBusy = function(value: boolean) busyOverride = value; refresh() end,
		setMaxHeight = function(value: number) maxHeight = math.max(48, value); resize() end,
		setProvider = function(text: string, color: Color3, iconId: string?)
			provider.Text = text; provider.TextColor3 = color
			local content = provider:FindFirstChild("ButtonContent")
			local icon = content and content:FindFirstChild("ButtonIcon")
			if icon then
				local old = icon:FindFirstChild("ProviderMark"); if old then old:Destroy() end
				local drawing = icon:FindFirstChild("Drawing"); if drawing then drawing.Visible = not iconId end
				if iconId then
					local mark = ProviderLogo.build(iconId, 16); mark.Name = "ProviderMark"; mark.Parent = icon
				end
			end
		end,
		setEnabled = function(value: boolean) enabled = value; refresh() end,
		setPlaceholder = function(text: string) box.PlaceholderText = text end,
		refreshAttachments = renderAttachments,
		destroy = function() destroyed = true; for _, unsubscribe in unsubs do unsubscribe() end; for _, connection in keyboardConnections do connection:Disconnect() end; for _, connection in globalKeyboardConnections do connection:Disconnect() end end,
	}
end
return ChatInput
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">ChatView</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
local AgentController = require(script.Parent.Parent.AI.AgentController)
local AccessAdvisor = require(script.Parent.Parent.AI.AccessAdvisor)
local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local AttachmentEncoder = require(script.Parent.Parent.AI.AttachmentEncoder)
local ChatInput = require(script.Parent.ChatInput)
local Clipboard = require(script.Parent.Parent.Utilities.Clipboard)
local Components = require(script.Parent.Components)
local ContextManager = require(script.Parent.Parent.AI.ContextManager)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Icons = require(script.Parent.Parent.Utilities.Icons)
local MessageRenderer = require(script.Parent.MessageRenderer)
local ModelCapabilityDetector = require(script.Parent.Parent.AI.ModelCapabilityDetector)
local QuestionCard = require(script.Parent.QuestionCard)
local RetryStatusUI = require(script.Parent.RetryStatusUI)
local SessionManager = require(script.Parent.Parent.Core.SessionManager)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local StreamingManager = require(script.Parent.Parent.AI.StreamingManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)
local Theme = require(script.Parent.Parent.Utilities.Theme)
local ThinkingIndicator = require(script.Parent.ThinkingIndicator)
local UniversalProviderRegistry = require(script.Parent.Parent.AI.UniversalProviderRegistry)
local TokenMeter = require(script.Parent.TokenMeter)

local ChatView = {}
function ChatView.build(parent: GuiObject, hooks: any): (Frame, any)
	local view = Instance.new("Frame")
	view.Name = "ChatView"
	view.Size = UDim2.fromScale(1, 1)
	Theme.passThrough(view)
	view.ClipsDescendants = true
	view.Parent = parent
	local stack = Instance.new("Frame")
	stack.Name = "Stack"
	stack.Size = UDim2.fromScale(1, 1)
	Theme.passThrough(stack)
	stack.Parent = view
	Theme.padding4(8, 2, 4, 2).Parent = stack
	Theme.listLayout(6).Parent = stack
	local top = Instance.new("Frame")
	top.Name = "ChatToolbar"
	top.Size = UDim2.new(1, 0, 0, 28)
	top.LayoutOrder = 1
	Theme.passThrough(top)
	top.Parent = stack
	local title = Theme.label("New chat", { size = 12, font = Theme.Fonts.Medium, color = Theme.Colors.SecondaryText })
	title.Name = "ConversationTitle"
	title.Size = UDim2.new(1, -88, 1, 0)
	title.Position = UDim2.fromOffset(8, 0)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Parent = top
	local newChat = Theme.textButton("+  New chat", { height = 28, width = UDim2.fromOffset(80, 28) })
	newChat.Name = "NewChat"
	newChat.AnchorPoint = Vector2.new(1, 0)
	newChat.Position = UDim2.fromScale(1, 0)
	newChat.BackgroundTransparency = 1
	newChat.TextColor3 = Theme.Colors.SecondaryText
	newChat.TextSize = 11
	newChat.Parent = top
	local accessNotice = Theme.autoText("Local access is disconnected. Web and local files need the bridge. Setup: " .. AccessAdvisor.setupUrl, { size = 11, color = Theme.Extra.Warning })
	accessNotice.Name = "AccessNotice"
	accessNotice.LayoutOrder = 1
	accessNotice.Visible = not BridgeClient.isConnected()
	accessNotice.Parent = stack
	top.LayoutOrder = 0
	local transcript = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	transcript.Name = "Transcript"
	transcript.Size = UDim2.new(1, 0, 0, 0)
	transcript.LayoutOrder = 2
	transcript.Active = true
	transcript.Parent = stack
	Theme.flexItem(transcript, 1, 1)
	Theme.padding4(6, 4, 12, 10).Parent = transcript
	Theme.listLayout(14).Parent = transcript
	local cards = Instance.new("Frame")
	cards.Name = "QuestionCards"
	cards.Size = UDim2.new(1, 0, 0, 0)
	cards.AutomaticSize = Enum.AutomaticSize.Y
	cards.LayoutOrder = 10000
	Theme.passThrough(cards)
	cards.Parent = transcript
	Theme.listLayout(8).Parent = cards
	local latest = Theme.textButton("↓  Latest message", { height = 26 })
	latest.Name = "ScrollToBottom"
	latest.Size = UDim2.new(1, 0, 0, 26)
	latest.LayoutOrder = 3
	latest.Visible = false
	latest.TextSize = 11
	latest.Parent = stack
	local thinkingFrame, thinking = ThinkingIndicator.build()
	thinkingFrame.LayoutOrder = 4
	thinkingFrame.Parent = stack
	local editRow = Instance.new("Frame")
	editRow.Name = "Editing"
	editRow.Size = UDim2.new(1, 0, 0, 24)
	editRow.LayoutOrder = 5
	editRow.Visible = false
	Theme.passThrough(editRow)
	editRow.Parent = stack
	local editLabel = Theme.label("Editing message", { size = 11, color = Theme.Colors.Highlight })
	editLabel.Size = UDim2.new(1, -66, 1, 0)
	editLabel.Parent = editRow
	local cancelEdit = Theme.textButton("Cancel", { height = 24, width = UDim2.fromOffset(60, 24) })
	cancelEdit.Name = "CancelEdit"
	cancelEdit.BackgroundTransparency = 1
	cancelEdit.TextSize = 11
	cancelEdit.AnchorPoint = Vector2.new(1, 0)
	cancelEdit.Position = UDim2.fromScale(1, 0)
	cancelEdit.Parent = editRow

	local mode = SettingsManager.getValue("defaultMode") or "build"
	local input: any = nil
	local reconcile: (boolean?) -> () = nil :: any
	local rendered: { [string]: any } = {}
	local questionCards: { [string]: Frame } = {}
	local activeId: string? = nil
	local editingId: string? = nil
	local running = false
	local destroyed = false
	local follow = true
	local retryApi: any = nil
	local approvalCard: Frame? = nil
	local landing: Frame? = nil
	local function toast(kind: string, message: string)
		EventBus.emit(EventBus.Events.Toast, { kind = kind, message = message })
	end
	local function openSettings()
		if hooks.onNavigate then hooks.onNavigate("settings") end
		EventBus.emit(EventBus.Events.Navigate, { section = "settings", tab = "AI & Provider" })
	end
	local function idle(): boolean
		if running or StateManager.isBusy() then
			toast("info", "Stop the current task and wait for it to finish first.")
			return false
		end
		return true
	end
	local function configured(): any?
		local profile = SettingsManager.getActiveProvider()
		if not profile then toast("warning", "Choose an AI provider in Settings to start chatting."); openSettings(); return nil end
		if StringUtil.trim(profile.modelId or "") == "" then toast("warning", "Enter a model ID in your provider settings."); openSettings(); return nil end
		if profile.authStyle ~= "none" and not profile.viaRouter and not CredentialStore.has(profile.id) then
			toast("warning", "Enter this provider's API key in Settings."); openSettings(); return nil
		end
		return profile
	end
	local function maxScroll(): number
		return math.max(0, transcript.AbsoluteCanvasSize.Y - transcript.AbsoluteWindowSize.Y)
	end
	local function scrollBottom()
		if destroyed then return end
		follow = true
		transcript.CanvasPosition = Vector2.new(0, maxScroll())
		latest.Visible = false
	end
	local function removeRetry()
		if retryApi then retryApi.destroy(); retryApi = nil end
	end
	local function clearEditing()
		editingId = nil
		editRow.Visible = false
		input.setPlaceholder("Ask ForgePilot anything about your place…")
	end
	local function run(conversation: any)
		running = true
		input.setBusy(true)
		thinking.show()
		removeRetry()
		follow = true
		task.defer(scrollBottom)
		task.spawn(function()
			local ok, result = pcall(function()
				return AgentController.runTask({
					userText = "", mode = mode, conversation = conversation,
					onRetryWait = function(seconds: number, decision: any, attempt: number)
						if destroyed then return end
						if not retryApi then
							local profile = SettingsManager.getActiveProvider()
							local card
							card, retryApi = RetryStatusUI.build({
								operationId = StateManager.getTaskId() or conversation.id, providerName = profile and profile.displayName or "Provider",
								model = profile and profile.modelId or "", category = decision.category or "RATE_LIMITED",
								reason = decision.reason or "The provider is temporarily unavailable.",
								maxRetries = SettingsManager.get().smartRetry.maxRetries,
								providerId = profile and profile.id, endpoint = profile and profile.baseUrl,
								attempt = attempt, delaySeconds = seconds, paused = false,
								onCancel = function()
									StateManager.cancel()
									StreamingManager.cancelAll()
									thinking.setActivity("Stopping…")
								end,
							})
							card.LayoutOrder = 9900
							card.Parent = cards
							follow = true
						end
						retryApi.setAttempt(attempt, seconds)
					end,
					onRetryError = function(normalised: any)
						if retryApi then retryApi.setCategory(normalised.category, normalised.message) end
					end,
				})
			end)
			if destroyed then return end
			running = false
			input.setBusy(false)
			thinking.stop()
			removeRetry()
			if approvalCard then approvalCard:Destroy(); approvalCard = nil end
			if not ok then
				StateManager.transition("FAILED", { force = true })
				toast("error", "The task stopped: " .. tostring(result))
			elseif result and not result.ok and result.message ~= "Cancelled" and result.message ~= "Provider failure" then
				toast("error", result.message or "The task could not finish.")
			end
			reconcile()
		end)
	end

	local inputFrame
	inputFrame, input = ChatInput.build({
		onSend = function(text: string): boolean
			if not idle() then return false end
			local profile = configured()
			if not profile then return false end
			local notice = AccessAdvisor.notice(text, ModelCapabilityDetector.getOrBuildReport(profile))
			if notice then toast("warning", notice) end
			local conversation = SessionManager.ensureConversation()
			SessionManager.setConversationMeta(conversation.id, { mode = mode, providerId = profile.id, model = profile.modelId })
			if editingId then
				SessionManager.truncateAfter(editingId)
				SessionManager.updateMessage(editingId, { content = text, attachments = AttachmentEncoder.manifest() })
			else
				SessionManager.addMessage("user", text, { attachments = AttachmentEncoder.manifest() })
			end
			clearEditing()
			-- Fresh editor context stays separate from the summarised chat history.
			conversation.editorContext = AgentController.gatherContext(mode)
			run(conversation)
			return true
		end,
		onStop = function()
			StateManager.cancel()
			StreamingManager.cancelAll()
			thinking.setActivity("Stopping…")
		end,
		onModeChange = function(value: string)
			mode = value
			local conversation = SessionManager.getActive()
			if conversation then SessionManager.setConversationMeta(conversation.id, { mode = mode }) end
		end,
		onPickFiles = function()
			local profile = SettingsManager.getActiveProvider()
			local report = if profile then ModelCapabilityDetector.getOrBuildReport(profile) else nil
			local files = AttachmentEncoder.pickFiles(true)
			if #files == 0 then return end
			local result = AttachmentEncoder.load(files, report, profile and profile.protocol)
			for _, rejected in result.rejected do toast("warning", rejected.name .. ": " .. rejected.reason) end
		end,
		onOpenSettings = openSettings,
	})
	inputFrame.Name = "Composer"
	inputFrame.LayoutOrder = 6
	inputFrame.Parent = stack
	input.setMode(mode)
	local tokenFrame, tokenMeter = TokenMeter.build()
	tokenFrame.LayoutOrder = 7
	tokenFrame.Parent = stack

	local function rerun(messageId: string)
		if not idle() or not configured() then return end
		local conversation = SessionManager.getActive()
		if not conversation then return end
		local index: number? = nil
		for position, message in conversation.messages do if message.id == messageId then index = position; break end end
		if not index then return end
		for position = index - 1, 1, -1 do
			if conversation.messages[position].role == "user" then
				SessionManager.truncateAfter(conversation.messages[position].id)
				clearEditing()
				run(conversation)
				return
			end
		end
	end
	local rendererOptions: MessageRenderer.RenderOptions = {
		onCopy = function(text: string)
			local copied, reason, presented = Clipboard.copy(text)
			if presented then return end
			toast(if copied then "success" else "warning", if copied then "Copied." else reason or "Clipboard unavailable.")
		end,
		onRegenerate = rerun, onRetry = rerun,
		onEdit = function(id: string)
			if not idle() then return end
			local message = SessionManager.findMessage(id)
			if not message then return end
			editingId = id
			editRow.Visible = true
			input.setText(message.content)
			input.setPlaceholder("Edit your message…")
			input.focus()
		end,
		onSwitchToBuild = function()
			if not idle() then return end
			mode = "build"
			input.setMode(mode)
			input.setText("Build the plan above in this place.")
			input.focus()
		end,
		onPlanAction = function(_, action: string)
			if action == "revise" and idle() then input.setPlaceholder("Describe what to change in the plan…"); input.focus() end
		end,
	}
	local function signature(message: any): string
		local ok, extras = pcall(function() return HttpService:JSONEncode({ message.usage, message.toolCalls, message.attachments, message.plan }) end)
		return table.concat({ message.content or "", tostring(message.streaming), message.reasoning or "", message.error or "", tostring(message.elapsedMs), if ok then extras else "" }, "\0")
	end
	local function upsert(message: any, index: number)
		if message.internal then return end
		local mark = signature(message)
		local previous = rendered[message.id]
		if previous and previous.signature == mark then previous.frame.LayoutOrder = index; return end
		if previous then previous.api.destroy(); previous.frame:Destroy() end
		message.plan = message.plan or (message.role == "assistant" and (message.content or ""):find("PLAN_READY", 1, true) ~= nil)
		local frame, api = MessageRenderer.render(message, rendererOptions)
		frame.LayoutOrder = index
		frame.Parent = transcript
		rendered[message.id] = { frame = frame, api = api, signature = signature(message) }
	end
	local function buildLanding()
		local frame = Instance.new("Frame")
		frame.Name = "Welcome"
		frame.Size = UDim2.new(1, 0, 0, 0)
		frame.AutomaticSize = Enum.AutomaticSize.Y
		Theme.passThrough(frame)
		Theme.padding4(18, 12, 16, 12).Parent = frame
		Theme.listLayout(12).Parent = frame
		local mark = Icons.brandMark(32)
		mark.LayoutOrder = 1
		mark.Parent = frame
		local heading = Theme.autoText("What would you like to create?", { size = 22, font = Theme.Fonts.Bold, color = Theme.Colors.MainText })
		heading.LayoutOrder = 2
		heading.Parent = frame
		local note = Theme.autoText("Plan an idea, understand your scripts, or build something in Roblox Studio.", { size = 13 })
		note.LayoutOrder = 3
		note.Parent = frame
		local suggestions = {
			{ "Plan a game", "Help me plan a Roblox game with a clear gameplay loop." },
			{ "Review my selection", "Explain the objects and scripts I have selected, and suggest improvements." },
			{ "Improve my UI", "Review the UI in this place and suggest a cleaner layout." },
		}
		for index, suggestion in suggestions do
			local button = Theme.textButton(suggestion[1] .. "  →", { height = 38 })
			button.Name = "Suggestion_" .. index
			button.TextXAlignment = Enum.TextXAlignment.Left
			button.TextSize = 12
			button.LayoutOrder = 3 + index
			Theme.padding4(0, 12, 0, 12).Parent = button
			button.Parent = frame
			button.MouseButton1Click:Connect(function() input.setText(suggestion[2]); input.focus() end)
		end
		if not SettingsManager.getActiveProvider() then
			local button = Components.textButton("Connect your AI provider", { accent = true, order = 9 })
			button.Parent = frame
			button.MouseButton1Click:Connect(openSettings)
		end
		frame.Parent = transcript
		return frame
	end
	reconcile = function(forceBottom: boolean?)
		if destroyed then return end
		local conversation = SessionManager.getActive()
		local id = conversation and conversation.id
		if id ~= activeId then
			for _, entry in rendered do entry.api.destroy(); entry.frame:Destroy() end
			rendered = {}
			for _, child in cards:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
			questionCards = {}
			activeId = id
			clearEditing()
			mode = conversation and conversation.mode or SettingsManager.getValue("defaultMode") or "build"
			input.setMode(mode)
			follow = true
		end
		title.Text = conversation and conversation.title or "New chat"
		if not conversation or #conversation.messages == 0 then
			if not landing then landing = buildLanding() end
		else
			if landing then landing:Destroy(); landing = nil end
			local keep: { [string]: boolean } = {}
			for index, message in conversation.messages do keep[message.id] = true; upsert(message, index) end
			for key, entry in rendered do
				if not keep[key] then entry.api.destroy(); entry.frame:Destroy(); rendered[key] = nil end
			end
		end
		if forceBottom then follow = true end
		if follow then task.defer(scrollBottom) end
	end
	local function refreshProvider()
		local profile = SettingsManager.getActiveProvider()
		input.setProvider(if profile then profile.modelId or profile.displayName else "Set up AI", if profile then Theme.Colors.SecondaryText else Theme.Colors.Highlight, if profile then profile.iconId or (UniversalProviderRegistry.getPreset(profile.presetId) or {}).iconId else nil)
		if landing then landing:Destroy(); landing = nil; reconcile() end
	end
	local unsubs = {}
	unsubs[#unsubs + 1] = EventBus.on("BridgeChanged", function() accessNotice.Visible = not BridgeClient.isConnected() end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.MessageStarted, function(payload)
		if payload.conversationId == nil or payload.conversationId == SessionManager.getActiveId() then reconcile() end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.MessageUpdated, function(payload)
		if payload.conversationId == SessionManager.getActiveId() then reconcile() end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.MessageDelta, function(payload)
		local entry = rendered[payload.messageId]
		if entry then entry.api.appendDelta(payload.delta, payload.channel) end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ConversationChanged, function() reconcile(true) end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ConversationRenamed, function() reconcile() end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ModeChanged, function(payload)
		if not running then mode = payload.mode; input.setMode(mode) end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ProvidersChanged, refreshProvider)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ActiveProviderChanged, refreshProvider)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.QuestionAsked, function(payload)
		local frame = QuestionCard.build(payload.question)
		frame.LayoutOrder = 9000
		frame.Parent = cards
		questionCards[payload.question.id] = frame
		follow = true
		task.defer(scrollBottom)
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.QuestionAnswered, function(payload)
		local card = questionCards[payload.questionId]
		if card then QuestionCard.markAnswered(card, payload.answer) end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.QuestionCancelled, function(payload)
		local card = questionCards[payload.questionId]
		if card then card:Destroy(); questionCards[payload.questionId] = nil end
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.ApprovalRequested, function(payload)
		if approvalCard then approvalCard:Destroy() end
		local card, body = Components.section(payload.summary or "Approve action", { subtitle = "Review this change before it runs." })
		approvalCard = card
		card.LayoutOrder = 9100
		card.Parent = cards
		local row, add = Components.buttonRow({ columns = 2 })
		row.Parent = body
		local answered = false
		local function answer(value: boolean)
			if answered then return end
			answered = true
			AgentController.resolveApproval(value)
			card:Destroy()
			approvalCard = nil
		end
		add("Approve", { accent = true, order = 1 }).MouseButton1Click:Connect(function() answer(true) end)
		add("Decline", { order = 2 }).MouseButton1Click:Connect(function() answer(false) end)
		follow = true
		task.defer(scrollBottom)
	end)
	unsubs[#unsubs + 1] = EventBus.on(EventBus.Events.Toast, function(payload) Components.toast(view, payload.kind, payload.message) end)
	transcript:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		follow = maxScroll() - transcript.CanvasPosition.Y < 48
		latest.Visible = not follow
	end)
	transcript:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
		if follow then task.defer(scrollBottom) else latest.Visible = true end
	end)
	latest.MouseButton1Click:Connect(scrollBottom)
	newChat.MouseButton1Click:Connect(function()
		if not idle() then return end
		AttachmentEncoder.clear()
		input.setText("")
		SessionManager.createConversation({ mode = mode })
	end)
	cancelEdit.MouseButton1Click:Connect(function() clearEditing(); input.setText("") end)
	local function resize()
		input.setMaxHeight(math.clamp(view.AbsoluteSize.Y * 0.22, 48, 110))
		tokenFrame.Visible = view.AbsoluteSize.Y >= 290
	end
	view:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	refreshProvider()
	reconcile()
	resize()
	return view, {
		destroy = function()
			destroyed = true
			removeRetry()
			for _, unsubscribe in unsubs do unsubscribe() end
			for _, entry in rendered do entry.api.destroy() end
			input.destroy(); thinking.destroy(); tokenMeter.destroy()
		end,
		input = input, transcript = transcript,
	}
end
return ChatView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">Components</string>
          <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
--[[
	ForgePilot / UI / Components
	Small reusable widgets shared across every view: sections, labelled fields,
	text inputs, toggles, chips, empty states and buttons.
]]

local Theme = require(script.Parent.Parent.Utilities.Theme)
local Icons = require(script.Parent.Parent.Utilities.Icons)

local Components = {}

--=============================================================================
-- SECTION
--=============================================================================

--- A titled card with a body frame. Returns (card, body).
---
--- The card is a vertical UIListLayout. Title, subtitle and body each own their
--- height, so a three-line section description can never be painted over the
--- first control inside the body.
function Components.section(title: string, options: { subtitle: string?, order: number?, padded: boolean? }?): (Frame, Frame)
	local o = options or {}
	local card = Instance.new("Frame")
	card.Name = "Section_" .. title:gsub("%s+", "")
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Theme.Extra.Surface
	card.BorderSizePixel = 0
	card.LayoutOrder = o.order or 0
	card.ClipsDescendants = false
	Theme.corner(Theme.Metrics.Radius).Parent = card
	Theme.stroke(Theme.Extra.Border, 1, 0.45).Parent = card
	Theme.padding4(Theme.Space.MD, Theme.Space.MD, Theme.Space.MD, Theme.Space.MD).Parent = card

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.Space.XS)
	layout.Parent = card

	local titleLabel = Theme.autoText(title, {
		size = Theme.TextSizes.Small,
		font = Theme.Fonts.Medium,
		color = Theme.Colors.MainText,
	})
	titleLabel.Name = "Title"
	titleLabel.LayoutOrder = 1
	titleLabel.AutomaticSize = Enum.AutomaticSize.Y
	titleLabel.Parent = card
	Theme.minSize(titleLabel, Vector2.new(0, 16))

	if o.subtitle then
		local subtitleLabel = Theme.autoText(o.subtitle, {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
		})
		subtitleLabel.Name = "Subtitle"
		subtitleLabel.LayoutOrder = 2
		subtitleLabel.AutomaticSize = Enum.AutomaticSize.Y
		subtitleLabel.Parent = card
	end

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.BackgroundTransparency = 1
	Theme.passThrough(body)
	body.LayoutOrder = 10
	body.ClipsDescendants = false
	body.Parent = card

	if o.padded ~= false then
		Theme.padding(0).Parent = body
	end

	Theme.listLayout(Theme.Space.MD).Parent = body

	return card, body
end

--=============================================================================
-- FIELD
--=============================================================================

--- A labelled row. Returns (row, valueHolderFrame).
---
--- The row stacks label -> hint -> control, each sized by its own content. It is
--- the *stacked* form: the control sits under its label and uses the full width,
--- which is the only arrangement that survives a 320px window. `Components.toggle`
--- is the side-by-side variant and builds its own row rather than reusing this.
function Components.field(label: string, options: { hint: string?, order: number? }?): (Frame, Frame)
	local o = options or {}
	local row = Instance.new("Frame")
	row.Name = "Field_" .. label:gsub("%s+", "")
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	Theme.passThrough(row)
	row.ClipsDescendants = false
	row.LayoutOrder = o.order or 0

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.Space.XS)
	layout.Parent = row

	local labelText = Theme.autoText(label, {
		size = Theme.TextSizes.Small,
		color = Theme.Colors.SecondaryText,
		font = Theme.Fonts.Medium,
	})
	labelText.Name = "Label"
	labelText.LayoutOrder = 1
	labelText.Parent = row

	if o.hint then
		local hint = Theme.autoText(o.hint, {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
		})
		hint.Name = "Hint"
		hint.LayoutOrder = 20
		hint.Parent = row
	end

	local holder = Instance.new("Frame")
	holder.Name = "Value"
	holder.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.BackgroundTransparency = 1
	Theme.passThrough(holder)
	holder.ClipsDescendants = false
	holder.LayoutOrder = 10
	holder.Parent = row

	-- A field can hold more than one control (the API-key row has a textbox, a
	-- reveal button and a status line). Without a layout they all default to
	-- Position (0,0) and stack on top of each other, which is exactly what
	-- Roblox renders.
	local holderLayout = Instance.new("UIListLayout")
	holderLayout.SortOrder = Enum.SortOrder.LayoutOrder
	holderLayout.Padding = UDim.new(0, Theme.Space.XS)
	holderLayout.Parent = holder

	return row, holder
end

--=============================================================================
-- INPUTS
--=============================================================================

function Components.textInput(placeholder: string, options: { multiLine: boolean?, height: number?, secret: boolean? }?): TextBox
	local o = options or {}
	local box = Theme.input(placeholder, { multiLine = o.multiLine, height = o.height })
	if o.secret then
		-- Masked by default. The caller toggles TextTransparency-based masking.
		box.Text = ""
	end
	return box
end

function Components.textButton(text: string, options: { order: number?, accent: boolean?, height: number?, width: UDim2? }?): TextButton
	local o = options or {}
	local button = Theme.textButton(text, {
		size = Theme.TextSizes.Small,
		height = o.height or Theme.Metrics.ButtonHeight,
		width = o.width,
		color = if o.accent then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised,
		textColor = if o.accent then Theme.Colors.Background else Theme.Colors.MainText,
		font = if o.accent then Theme.Fonts.Bold else Theme.Fonts.Medium,
		radius = Theme.Metrics.RadiusSmall,
	})
	button.Name = text:gsub("%s+", "")
	-- Buttons inside a row are sized by UIFlexItem, never by AutomaticSize.X.
	-- An intrinsically-sized button in a horizontal UIListLayout overflows the
	-- window as soon as the labels get long or the window gets narrow.
	button.AutomaticSize = Enum.AutomaticSize.None
	button.LayoutOrder = o.order or 0
	return button
end

--- A row of buttons that shrinks instead of overflowing.
---
--- Every button is a flex item, so a row of six actions ("Test connection",
--- "Test chat", "Detect capabilities", ...) always fits inside its parent —
--- shrinking to a readable minimum rather than running off the right edge.
---
--- Pass `columns` when even a shrunk button would be too narrow to read. The
--- row then becomes a fixed-column grid that wraps, so a 320px window shows the
--- actions on three lines of two instead of six buttons crushed into 40px each.
function Components.buttonRow(options: {
	order: number?,
	padding: number?,
	align: Enum.HorizontalAlignment?,
	columns: number?,
}?): (Frame, any)
	local o = options or {}
	local columns = o.columns
	local padding = o.padding or Theme.Space.SM
	local height = Theme.Metrics.ButtonHeight
	local row = Instance.new("Frame")
	row.Name = "ButtonRow"
	row.Size = UDim2.new(1, 0, 0, height)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	Theme.passThrough(row)
	row.ClipsDescendants = false
	row.LayoutOrder = o.order or 0

	if columns and columns > 1 then
		local grid = Instance.new("UIGridLayout")
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.CellSize = UDim2.new(1 / columns, -padding * (columns - 1) / columns, 0, height)
		grid.CellPadding = UDim2.fromOffset(padding, padding)
		grid.FillDirectionMaxCells = columns
		grid.FillDirection = Enum.FillDirection.Horizontal
		grid.HorizontalAlignment = o.align or Enum.HorizontalAlignment.Left
		grid.VerticalAlignment = Enum.VerticalAlignment.Center
		grid.Parent = row
		row.AutomaticSize = Enum.AutomaticSize.None
	else
		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, padding)
		layout.HorizontalAlignment = o.align or Enum.HorizontalAlignment.Left
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.Parent = row
	end

	local count = 0
	return row, function(text: string, buttonOptions: { accent: boolean?, order: number?, height: number? }?)
		local bo = buttonOptions or {}
		local buttonHeight = bo.height or height
		local button = Components.textButton(text, {
			accent = bo.accent,
			order = bo.order,
			height = buttonHeight,
		})
		if columns and columns > 1 then
			count += 1
			local rows = math.ceil(count / columns)
			row.Size = UDim2.new(1, 0, 0, rows * height + (rows - 1) * padding)
			-- Fill the grid cell it lands in; the grid decides the wrap.
			button.Size = UDim2.new(1, 0, 0, buttonHeight)
			Theme.minSize(button, Vector2.new(0, buttonHeight))
		else
			-- FlexMode.Fill lets the UIListLayout hand the row's spare width to
			-- the buttons in proportion to their GrowRatio, and take it back
			-- when the window narrows. The button therefore always fits and
			-- never overlaps its neighbour.
			button.Size = UDim2.new(0, 0, 0, buttonHeight)
			Theme.flexItem(button, 1, 1)
			Theme.minSize(button, Vector2.new(0, buttonHeight))
		end
		button.Parent = row
		return button
	end
end

function Components.iconButton(iconKey: string, tooltip: string, order: number?): TextButton
	local button = Theme.textButton("", { height = 24, width = UDim2.fromOffset(26, 24) })
	button.Name = "IconButton_" .. iconKey
	button.LayoutOrder = order or 0
	Icons.setButton(button, iconKey)
	button.TextSize = 14
	button.TextColor3 = Theme.Colors.SecondaryText
	return button
end

--- A toggle switch. Returns (row, getValue).
---
--- Label and description on the left, switch flush right and vertically centred
--- in the row. This is deliberately NOT built on Components.field: a field
--- stacks the control under its label, which is why switches used to appear
--- below the text they belong to, at an arbitrary offset, never aligned with
--- each other.
function Components.toggle(label: string, initial: boolean, onChange: (boolean) -> (), options: { hint: string?, order: number? }?): (Frame, () -> boolean, (boolean) -> ())
	local o = options or {}

	local row = Instance.new("Frame")
	row.Name = "ToggleRow"
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	Theme.passThrough(row)
	row.ClipsDescendants = false
	row.LayoutOrder = o.order or 0

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.Space.SM)
	-- Horizontal, so the label column and the switch share one row; Right, so
	-- the switch is flush against the edge instead of being guessed at. Without
	-- an explicit FillDirection this defaults to Vertical and the switch drops
	-- BELOW its own label.
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	-- Vertical centring is declarative: the switch stays vertically aligned with
	-- its label whether the description is one line or four.
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = row

	local textColumn = Instance.new("Frame")
	textColumn.Name = "Text"
	textColumn.Size = UDim2.new(1, -(Theme.Metrics.ToggleWidth + Theme.Space.SM), 0, 0)
	textColumn.AutomaticSize = Enum.AutomaticSize.Y
	textColumn.BackgroundTransparency = 1
	Theme.passThrough(textColumn)
	textColumn.ClipsDescendants = false
	textColumn.LayoutOrder = 1
	textColumn.Parent = row

	local textLayout = Instance.new("UIListLayout")
	textLayout.SortOrder = Enum.SortOrder.LayoutOrder
	textLayout.Padding = UDim.new(0, 2)
	textLayout.Parent = textColumn

	local labelText = Theme.autoText(label, {
		size = Theme.TextSizes.Small,
		color = Theme.Colors.MainText,
		font = Theme.Fonts.Medium,
	})
	labelText.Name = "Label"
	labelText.LayoutOrder = 1
	labelText.Parent = textColumn

	if o.hint then
		local hint = Theme.autoText(o.hint, {
			size = Theme.TextSizes.Caption,
			color = Theme.Extra.Muted,
		})
		hint.Name = "Hint"
		hint.LayoutOrder = 2
		hint.Parent = textColumn
	end

	-- The switch is a top-level sibling of the text column. The row's
	-- VerticalAlignment.Center does the centring, so the track is never placed
	-- with a guessed Y offset.
	local switchHolder = Instance.new("Frame")
	switchHolder.Name = "SwitchHolder"
	switchHolder.Size = UDim2.new(0, Theme.Metrics.ToggleWidth, 0, Theme.Metrics.ToggleHeight)
	switchHolder.BackgroundTransparency = 1
	Theme.passThrough(switchHolder)
	switchHolder.ClipsDescendants = false
	switchHolder.LayoutOrder = 2
	switchHolder.Parent = row

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.fromScale(1, 1)
	track.BackgroundColor3 = if initial then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised
	track.BorderSizePixel = 0
	track.Parent = switchHolder
	Theme.corner(math.floor(Theme.Metrics.ToggleHeight / 2)).Parent = track
	local trackStroke = Theme.stroke(Theme.Extra.Border)
	trackStroke.Parent = track

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.fromOffset(Theme.Metrics.ToggleKnob, Theme.Metrics.ToggleKnob)
	knob.Position = if initial then UDim2.fromOffset(Theme.Metrics.ToggleWidth - Theme.Metrics.ToggleKnob - 2, 2)
		else UDim2.fromOffset(2, 2)
	knob.BackgroundColor3 = Theme.Colors.MainText
	knob.BorderSizePixel = 0
	knob.Parent = track
	Theme.corner(math.floor(Theme.Metrics.ToggleKnob / 2)).Parent = knob

	-- The whole track is the hit target.
	local hitArea = Instance.new("TextButton")
	hitArea.Name = "Hit"
	hitArea.Size = UDim2.fromScale(1, 1)
	hitArea.BackgroundTransparency = 1
	hitArea.Text = ""
	hitArea.ZIndex = track.ZIndex + 1
	hitArea.Parent = switchHolder

	local state = { value = initial }

	local function apply()
		Theme.tween(track, {
			BackgroundColor3 = if state.value then Theme.Colors.Highlight else Theme.Extra.SurfaceRaised,
		}, Theme.Motion.Fast):Play()
		trackStroke.Color = if state.value then Theme.withAlpha(Theme.Colors.Highlight, 0.5) else Theme.Extra.Border
		Theme.tween(knob, {
			Position = if state.value
				then UDim2.fromOffset(Theme.Metrics.ToggleWidth - Theme.Metrics.ToggleKnob - 2, 2)
				else UDim2.fromOffset(2, 2),
		}, Theme.Motion.Fast):Play()
	end

	hitArea.MouseButton1Click:Connect(function()
		state.value = not state.value
		apply()
		onChange(state.value)
	end)

	return row, function()
		return state.value
	end, function(value: boolean)
		state.value = value == true
		apply()
	end
end

--- A dropdown built from a fixed list. Returns (row, setOptions, getSelected).
---
--- The option list is NOT parented to the button. It is reparented into the
--- window's overlay layer and positioned from the button's AbsolutePosition, so
--- a ScrollingFrame between the button and the window edge cannot clip it, and
--- the list can never render over the Settings navigation it belongs to.
local closeActiveMenu: (() -> ())? = nil
function Components.closeMenus()
	if closeActiveMenu then closeActiveMenu() end
end

-- A compact, persistent tab bar. All tabs remain visible in a narrow dock.
function Components.tabBar(labels: { string }, onSelect: (string) -> ()): (Frame, (string) -> ())
	local row = Instance.new("Frame")
	row.Name = "TabBar"
	row.Size = UDim2.new(1, 0, 0, 32)
	Theme.passThrough(row)
	local layout = Theme.listLayout(2)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = row
	local buttons: { [string]: TextButton } = {}
	local marks: { [string]: Frame } = {}
	local current = labels[1]
	local function select(value: string)
		current = value
		for name, button in buttons do
			local active = name == value
			button.TextColor3 = if active then Theme.Colors.MainText else Theme.Extra.Muted
			button.BackgroundColor3 = if active then Theme.Extra.SurfaceRaised else Theme.Colors.Background
			marks[name].Visible = active
		end
	end
	for index, name in labels do
		local button = Theme.textButton(name, {
			height = 30, size = Theme.TextSizes.Small, radius = Theme.Metrics.RadiusSmall,
			color = Theme.Colors.Background, truncate = true,
		})
		button.Name = "Tab_" .. name
		button.Size = UDim2.new(0, 0, 0, 30)
		button.LayoutOrder = index
		Theme.flexItem(button, 1, 1)
		button.Parent = row
		local stroke = button:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Transparency = 1 end
		local mark = Instance.new("Frame")
		mark.Name = "Selection"
		mark.AnchorPoint = Vector2.new(0, 1)
		mark.Position = UDim2.new(0, 8, 1, 0)
		mark.Size = UDim2.new(1, -16, 0, 2)
		mark.BorderSizePixel = 0
		mark.BackgroundColor3 = Theme.Colors.Highlight
		mark.Parent = button
		buttons[name] = button
		marks[name] = mark
		button.MouseButton1Click:Connect(function()
			Components.closeMenus()
			select(name)
			onSelect(name)
		end)
		button.MouseLeave:Connect(function() select(current) end)
	end
	select(current)
	return row, select
end

function Components.dropdown(label: string, options: { string }, onSelect: (string) -> (), options_meta: any?): (Frame, any, any, any)
	local o = options_meta or {}
	local row, holder = Components.field(label, { hint = o.hint, order = o.order })
	local list = table.clone(options)
	local current: string? = list[1]
	local button = Theme.textButton(current or "Select…", { height = Theme.Metrics.InputHeight, truncate = true })
	button.Name = "Dropdown"
	button.Size = UDim2.new(1, 0, 0, Theme.Metrics.InputHeight)
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Parent = holder
	Theme.padding4(0, 28, 0, 10).Parent = button
	local chevron = Icons.glyph("ChevronDown", 12)
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, 20, 0.5, 0)
	chevron.Size = UDim2.fromOffset(14, 14)
	chevron.Parent = button

	local menu = Theme.scrollingFrame({ automaticCanvasSize = Enum.AutomaticSize.Y })
	menu.Name = "Menu"
	menu.AutomaticSize = Enum.AutomaticSize.None
	menu.Visible = false
	menu.Active = true
	menu.BackgroundTransparency = 0
	menu.BackgroundColor3 = Theme.Extra.SurfaceRaised
	menu.ZIndex = Theme.OverlayZIndex + 2
	Theme.corner(8).Parent = menu
	Theme.stroke(Theme.Extra.BorderStrong).Parent = menu
	Theme.padding(4).Parent = menu
	Theme.listLayout(2).Parent = menu
	local dismiss = Instance.new("TextButton")
	dismiss.Name = "MenuDismiss"
	dismiss.Size = UDim2.fromScale(1, 1)
	dismiss.BackgroundTransparency = 1
	dismiss.Text = ""
	dismiss.ZIndex = Theme.OverlayZIndex + 1
	dismiss.Active = true
	dismiss.Visible = false
	local host: Frame? = nil
	local connections: { RBXScriptConnection } = {}
	local function close()
		menu.Visible = false
		dismiss.Visible = false
		if closeActiveMenu == close then closeActiveMenu = nil end
	end
	local function place()
		if not host then return end
		local origin, area = host.AbsolutePosition, host.AbsoluteSize
		local localX = button.AbsolutePosition.X - origin.X
		local localY = button.AbsolutePosition.Y - origin.Y
		local width = math.max(1, math.min(math.max(button.AbsoluteSize.X, o.menuWidth or 0), area.X - 16))
		local x = math.clamp(localX, 8, math.max(8, area.X - width - 8))
		local below = localY + button.AbsoluteSize.Y + 4
		local roomBelow = math.max(0, area.Y - below - 8)
		local roomAbove = math.max(0, localY - 12)
		local wanted = math.min(240, math.max(1, #list) * 30 + 8)
		local down = roomBelow >= wanted or roomBelow >= roomAbove
		local available = if down then roomBelow else roomAbove
		local height = math.min(wanted, math.max(30, available), math.max(1, area.Y - 16))
		local y = if down then below else localY - height - 4
		menu.Size = UDim2.fromOffset(width, height)
		menu.Position = UDim2.fromOffset(x, math.clamp(y, 8, math.max(8, area.Y - height - 8)))
	end
	local function rebuild()
		for _, child in menu:GetChildren() do if child:IsA("GuiObject") then child:Destroy() end end
		for index, entry in list do
			local choice = Theme.textButton(entry, { height = 28, truncate = true, alignX = Enum.TextXAlignment.Left })
			choice.Name = "Option"
			choice.LayoutOrder = index
			choice.BackgroundTransparency = if entry == current then 0 else 1
			choice.Size = UDim2.new(1, -4, 0, 28)
			Theme.padding4(0, 8, 0, 8).Parent = choice
			choice.Parent = menu
			choice.MouseButton1Click:Connect(function()
				current = entry
				button.Text = entry
				close()
				onSelect(entry)
			end)
		end
	end
	button.MouseButton1Click:Connect(function()
		if menu.Visible then close(); return end
		Components.closeMenus()
		host = Theme.overlayHost(row)
		if menu.Parent ~= host then
			menu.Parent = host
			dismiss.Parent = host
			connections[#connections + 1] = host:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if menu.Visible then place() end end)
		end
		rebuild()
		place()
		dismiss.Visible = true
		menu.Visible = true
		closeActiveMenu = close
	end)
	dismiss.MouseButton1Click:Connect(close)
	connections[#connections + 1] = button:GetPropertyChangedSignal("AbsolutePosition"):Connect(function() if menu.Visible then place() end end)
	connections[#connections + 1] = button:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if menu.Visible then place() end end)
	row.Destroying:Connect(function()
		close()
		for _, connection in connections do connection:Disconnect() end
		menu:Destroy(); dismiss:Destroy()
	end)
	local function select(value: string?)
		current = value
		button.Text = value or "Select…"
	end
	return row, function(newOptions: { string })
		list = table.clone(newOptions or {})
		if not table.find(list, current) then select(list[1]) end
		if menu.Visible then rebuild(); place() end
	end, function() return current end, select
end

--=============================================================================
-- CHIPS / STATES
--=============================================================================

function Components.chip(text: string, color: Color3, order: number?): TextLabel
	local label = Theme.label(text, {
		size = Theme.TextSizes.Caption,
		color = color,
		font = Theme.Fonts.Medium,
		alignX = Enum.TextXAlignment.Center,
	})
	label.Name = "Chip"
	label.LayoutOrder = order or 0
	label.AutomaticSize = Enum.AutomaticSize.X
	label.BackgroundColor3 = Theme.withAlpha(color, 0.14)
	label.Size = UDim2.new(0, 0, 0, 20)
	label.BackgroundTransparency = 0
	label.ClipsDescendants = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	Theme.corner(10).Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = label
	return label
end

function Components.emptyState(iconKey: string, title: string, detail: string, actionText: string?, onAction: (() -> ())?): Frame
	local frame = Instance.new("Frame")
	frame.Name = "EmptyState"
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.BackgroundTransparency = 1
	Theme.passThrough(frame)
	frame.ClipsDescendants = false

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Theme.Space.SM)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = frame

	local iconHolder = Instance.new("Frame")
	iconHolder.Name = "IconHolder"
	iconHolder.Size = UDim2.fromOffset(34, 34)
	iconHolder.BackgroundTransparency = 1
	Theme.passThrough(iconHolder)
	iconHolder.LayoutOrder = 1
	iconHolder.Parent = frame

	local icon = Icons.glyph(iconKey, 26, Theme.Extra.BorderStrong)
	icon.Name = "Icon"
	icon.Size = UDim2.fromOffset(34, 34)
	icon.Parent = iconHolder

	local heading = Theme.autoText(title, {
		size = Theme.TextSizes.Body,
		font = Theme.Fonts.Bold,
		alignX = Enum.TextXAlignment.Center,
	})
	heading.Name = "Title"
	heading.LayoutOrder = 2
	heading.Parent = frame
	Theme.padding4(0, Theme.Space.MD, 0, Theme.Space.MD).Parent = heading

	local body = Theme.autoText(detail, {
		size = Theme.TextSizes.Small,
		color = Theme.Colors.SecondaryText,
		alignX = Enum.TextXAlignment.Center,
	})
	body.Name = "Detail"
	body.LayoutOrder = 3
	body.Parent = frame
	Theme.padding4(0, Theme.Space.LG, 0, Theme.Space.LG).Parent = body

	if actionText and onAction then
		local button = Components.textButton(actionText, { accent = true, height = Theme.Metrics.ButtonHeight })
		button.Name = "Action"
		button.LayoutOrder = 4
		button.Size = UDim2.fromOffset(160, Theme.Metrics.ButtonHeight)
		button.Parent = frame
		button.MouseButton1Click:Connect(onAction)
	end

	return frame
end

function Components.divider(order: number?): Frame
	local line = Theme.separator()
	line.LayoutOrder = order or 0
	line.AutomaticSize = Enum.AutomaticSize.None
	return line
end

--=============================================================================
-- TOASTS
--=============================================================================

function Components.toast(parent: GuiObject, kind: string, message: string)
	local colors = {
		info = Theme.Extra.Info,
		success = Theme.Colors.Success,
		warning = Theme.Extra.Warning,
		error = Theme.Colors.Error,
	}
	local color = colors[kind] or Theme.Extra.Info

	-- Toasts live in the overlay layer: they must be able to clear the
	-- navigation and must never be clipped by a ScrollingFrame inside a page.
	local host = Theme.overlayHost(parent)
	local layer = host:FindFirstChild("ToastLayer")
	if not layer then
		layer = Instance.new("Frame")
		layer.Name = "ToastLayer"
		layer.Size = UDim2.fromScale(1, 1)
		layer.BackgroundTransparency = 1
		Theme.passThrough(layer)
		layer.BorderSizePixel = 0
		layer.ZIndex = Theme.OverlayZIndex + 10
		layer.ClipsDescendants = false
		layer.Parent = host

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, Theme.Space.SM)
		layout.VerticalAlignment = Enum.VerticalAlignment.Top
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = layer
	end

	local container = Instance.new("Frame")
	container.Name = "Toast"
	container.Size = UDim2.new(1, -(Theme.Space.XL * 2), 0, 0)
	container.AutomaticSize = Enum.AutomaticSize.Y
	container.BackgroundColor3 = Theme.Extra.SurfacePressed
	container.BorderSizePixel = 0
	container.BackgroundTransparency = 1
	Theme.passThrough(container)
	container.ZIndex = layer.ZIndex + 1
	container.ClipsDescendants = true
	container.LayoutOrder = 9000 + (math.floor(os.clock() * 1000) % 1000)
	container.Parent = layer
	Theme.corner(Theme.Metrics.Radius).Parent = container
	local stroke = Theme.stroke(Theme.withAlpha(color, 0.55))
	stroke.Parent = container
	Theme.padding(Theme.Space.SM).Parent = container

	-- icon | text, side by side, both centred on each other
	local row = Instance.new("Frame")
	row.Name = "Row"
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	Theme.passThrough(row)
	row.ClipsDescendants = false
	row.LayoutOrder = 1
	row.Parent = container

	local rowLayout = Instance.new("UIListLayout")
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Padding = UDim.new(0, Theme.Space.SM)
	rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rowLayout.Parent = row

	local icon = Icons.glyph(
		if kind == "error" then "Error" elseif kind == "warning" then "Warning" elseif kind == "success" then "Check" else "Info",
		14,
		color
	)
	icon.Name = "Icon"
	icon.Size = UDim2.fromOffset(16, 16)
	icon.LayoutOrder = 1
	icon.Parent = row

	local label = Theme.autoText(message, {
		size = Theme.TextSizes.Small,
		color = Theme.Colors.MainText,
	})
	label.Name = "Text"
	label.LayoutOrder = 2
	label.Size = UDim2.new(0, 0, 0, 0)
	Theme.flexItem(label, 1, 1)
	label.Parent = row

	Theme.tween(container, { BackgroundTransparency = 0 }, Theme.Motion.Normal):Play()

	task.delay(5, function()
		if container.Parent then
			local fade = Theme.tween(container, { BackgroundTransparency = 1 }, Theme.Motion.Slow)
			fade.Completed:Connect(function()
				if container.Parent then
					container:Destroy()
				end
			end)
			fade:Play()
		end
	end)

	-- Keep at most three toasts on screen.
	local siblings = 0
	for _, child in layer:GetChildren() do
		if child.Name == "Toast" then
			siblings += 1
		end
	end
	if siblings > 3 then
		for _, child in layer:GetChildren() do
			if child.Name == "Toast" then
				child:Destroy()
				break
			end
		end
	end
end

return Components
]]></string>
        </Properties>
