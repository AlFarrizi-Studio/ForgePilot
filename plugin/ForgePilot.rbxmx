      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ModelCapabilityDetector</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
--[[
	ForgePilot / AI / ModelCapabilityDetector
	Reports Supported / Unsupported / Unknown per capability.

	RULES
	-----
	* Provider metadata is trusted (it is what the provider documents).
	* Model metadata overrides provider metadata when it is more specific.
	* When neither exists, the state is UNKNOWN — never guessed.
	* Optional live probes issue REAL requests and say so.
	* Manual overrides are permitted and clearly marked as unverified.
]]

local ProviderRegistry = require(script.Parent.ProviderRegistry)
local ProviderService = require(script.Parent.ProviderService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)

local ModelCapabilityDetector = {}

export type Status = "supported" | "unsupported" | "unknown"

export type CapabilityId =
	| "text_input"
	| "text_output"
	| "vision"
	| "image_generation"
	| "document_input"
	| "pdf_input"
	| "audio_input"
	| "audio_output"
	| "video_input"
	| "tool_calling"
	| "parallel_tool_calling"
	| "structured_json"
	| "streaming"
	| "reasoning"
	| "reasoning_effort"
	| "reasoning_summaries"
	| "prompt_caching"
	| "temperature"
	| "top_p"
	| "system_instructions"

export type Capability = {
	id: CapabilityId,
	label: string,
	status: Status,
	verification: string,
	lastChecked: number?,
	details: string?,
	overridden: boolean,
	source: string,
}

export type Report = {
	providerId: string,
	modelId: string,
	presetId: string,
	capabilities: { [string]: Capability },
	contextWindow: number,
	contextWindowSource: string,
	maxOutputTokens: number,
	maxOutputTokensSource: string,
	pricing: { input: number?, output: number?, source: string },
	checkedAt: number,
}

--=============================================================================
-- CATALOGUE
--=============================================================================

export type Definition = {
	id: CapabilityId,
	label: string,
	group: string,
	-- Can this be proven with a real API request?
	probeable: boolean,
	probeCost: "none" | "low" | "high",
	probeNote: string,
}

local currentProbeKey = ""

local capabilityDefinitions: { Definition } = {
	{ id = "text_input", label = "Text Input", group = "Core", probeable = true, probeCost = "low", probeNote = "Included in every request." },
	{ id = "text_output", label = "Text Output", group = "Core", probeable = true, probeCost = "low", probeNote = "Included in every request." },
	{ id = "vision", label = "Vision / Image Input", group = "Modalities", probeable = true, probeCost = "high", probeNote = "Sends a small generated PNG." },
	{ id = "image_generation", label = "Image Generation", group = "Modalities", probeable = false, probeCost = "high", probeNote = "Requires a dedicated image endpoint ForgePilot does not call." },
	{ id = "document_input", label = "Document Input", group = "Modalities", probeable = true, probeCost = "low", probeNote = "Sends a short text document." },
	{ id = "pdf_input", label = "PDF Input", group = "Modalities", probeable = false, probeCost = "high", probeNote = "Chat endpoints cannot verify binary PDF parsing." },
	{ id = "audio_input", label = "Audio Input", group = "Modalities", probeable = false, probeCost = "high", probeNote = "Only the Gemini native protocol inlines audio." },
	{ id = "audio_output", label = "Audio Output", group = "Modalities", probeable = false, probeCost = "high", probeNote = "No chat endpoint returns audio." },
	{ id = "video_input", label = "Video Input", group = "Modalities", probeable = false, probeCost = "high", probeNote = "Only the Gemini native protocol inlines video." },
	{ id = "tool_calling", label = "Tool Calling", group = "Agent", probeable = true, probeCost = "low", probeNote = "Offers a tool and checks whether the model requests it." },
	{ id = "parallel_tool_calling", label = "Parallel Tool Calling", group = "Agent", probeable = true, probeCost = "low", probeNote = "Offers two tools and counts the returned calls." },
	{ id = "structured_json", label = "Structured JSON Output", group = "Agent", probeable = true, probeCost = "low", probeNote = "Requests JSON mode and validates the reply." },
	{ id = "streaming", label = "Streaming", group = "Transport", probeable = true, probeCost = "low", probeNote = "Opens a real stream and counts received chunks." },
	{ id = "reasoning", label = "Reasoning", group = "Reasoning", probeable = true, probeCost = "high", probeNote = "Looks for reasoning tokens or reasoning text in the response." },
	{ id = "reasoning_effort", label = "Reasoning Effort", group = "Reasoning", probeable = false, probeCost = "low", probeNote = "Parameter presence is protocol-level; effect is not observable cheaply." },
	{ id = "reasoning_summaries", label = "Reasoning Summaries", group = "Reasoning", probeable = true, probeCost = "high", probeNote = "Requests a summary and inspects the response." },
	{ id = "prompt_caching", label = "Prompt Caching", group = "Context", probeable = false, probeCost = "high", probeNote = "Requires comparing cached token counts across repeated large requests." },
	{ id = "temperature", label = "Temperature", group = "Parameters", probeable = false, probeCost = "none", probeNote = "Parameter presence is protocol-level." },
	{ id = "top_p", label = "Top P", group = "Parameters", probeable = false, probeCost = "none", probeNote = "Parameter presence is protocol-level." },
	{ id = "system_instructions", label = "System Instructions", group = "Parameters", probeable = true, probeCost = "low", probeNote = "Sends a system instruction and checks it is honoured." },
}

ModelCapabilityDetector.Definitions = capabilityDefinitions

--=============================================================================
-- INTERNAL STATE
--=============================================================================

local reports: { [string]: Report } = {} -- key: providerId .. "|" .. modelId
local knownProfiles: { [string]: any } = {} -- key: same, the profile a report was built from
local overrides: { [string]: { [string]: Status } } = {} -- capabilityId -> Status (per model key)
EventBus.on("RouterModelsChanged", function(payload)
    for modelKey, profile in knownProfiles do
        if profile.viaRouter and profile.routerProviderId == payload.providerId then reports[modelKey] = nil end
    end
end)

local function key(providerId: string, modelId: string): string
	return providerId .. "|" .. modelId
end

--=============================================================================
-- STATUS RESOLUTION
--=============================================================================

local function metadataStatus(hint: any): Status
	if hint == "yes" then
		return "supported"
	elseif hint == "no" then
		return "unsupported"
	end
	return "unknown"
end

local function describeStatusSource(source: string): string
	if source == "provider_metadata" then
		return "Provider documentation metadata"
	elseif source == "model_metadata" then
		return "Model metadata for this exact model id"
	elseif source == "router_catalog" then
		return "9Router model catalog (not a live API probe)"
	elseif source == "protocol" then
		return "Protocol definition"
	elseif source == "manual_override" then
		return "Manual override (unverified)"
	elseif source == "live_probe" then
		return "Live API probe"
	end
	return "Not determined"
end

--=============================================================================
-- REPORT BUILDER
--=============================================================================

--- Builds a report from metadata only. Cheap and offline.
function ModelCapabilityDetector.buildReport(profile: any): Report
	local preset = ProviderRegistry.getPreset(profile.presetId or "")
	local protocol = ProviderRegistry.getProtocol(profile.protocol)
	local modelId = profile.modelId or ""
	local modelKey = key(profile.id, modelId)

	local modelMetadata = if preset then preset.modelMetadata[modelId] else nil
	local routerMetadata = if profile.viaRouter then BridgeClient.getModelMetadata(profile) else nil
	local routerNames = { tool_calling = "tools", vision = "vision", reasoning = "reasoning" }

	local capabilities: { [string]: Capability } = {}

	for _, definition in ModelCapabilityDetector.Definitions do
		local status: Status = "unknown"
		local source = "unavailable"

		-- A preset entry of "unknown" means the provider itself does not claim
		-- this capability, so it is treated as absent rather than as evidence.
		local modelHint = if modelMetadata then modelMetadata.capabilities[definition.id] else nil
		local presetHint = if preset then preset.providerCapabilities[definition.id] else nil
		local routerName = routerNames[definition.id]
		local routerHint = if routerMetadata and type(routerMetadata.capabilities) == "table" and routerName then routerMetadata.capabilities[routerName] else nil

		if type(routerHint) == "boolean" then
			status = if routerHint then "supported" else "unsupported"
			source = "router_catalog"
		elseif modelHint == "yes" or modelHint == "no" then
			status = metadataStatus(modelHint)
			source = "model_metadata"
		elseif presetHint == "yes" or presetHint == "no" then
			status = metadataStatus(presetHint)
			source = "provider_metadata"
		else
			-- Protocol-level knowledge is reliable for transport/parameter features.
			if definition.id == "streaming" then
				status = if protocol.supportsStreaming then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "tool_calling" then
				if not profile.viaRouter then
					status = if protocol.supportsToolCalling then "supported" else "unsupported"
					source = "protocol"
				end
			elseif definition.id == "system_instructions" then
				status = if protocol.supportsSystemRole then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "structured_json" then
				status = if protocol.supportsJsonMode then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "reasoning_effort" then
				status = if protocol.supportsReasoningEffort then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "reasoning_summaries" then
				status = if protocol.supportsReasoningSummaries then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "prompt_caching" then
				status = if protocol.supportsPromptCaching then "supported" else "unsupported"
				source = "protocol"
			elseif definition.id == "text_input" or definition.id == "text_output" then
				status = "supported"
				source = "protocol"
			end
		end

		capabilities[definition.id] = {
			id = definition.id,
			label = definition.label,
			status = status,
			verification = describeStatusSource(source),
			lastChecked = nil,
			details = source == "unavailable"
				and "No metadata available for this model. Run a live probe or set a manual override."
				or nil,
			overridden = false,
			source = source,
		}
	end

	-- Manual overrides win, and are labelled as unverified.
	local modelOverrides = overrides[modelKey]
	if modelOverrides then
		for capabilityId, forced in modelOverrides do
			local capability = capabilities[capabilityId]
			if capability then
				capability.status = forced
				capability.source = "manual_override"
				capability.verification = "Manual override (unverified)"
				capability.overridden = true
			end
		end
	end

	local contextWindow = 128000
	local contextWindowSource = "Default estimate — no metadata for this model."
	if routerMetadata and routerMetadata.contextWindow and profile.contextWindowMode ~= "manual" then
		contextWindow = routerMetadata.contextWindow
		contextWindowSource = "9Router model catalog (not live-probed)."
	elseif modelMetadata and profile.contextWindowMode ~= "manual" then
		contextWindow = modelMetadata.contextWindow
		contextWindowSource = "Model metadata."
	elseif profile.contextWindow and profile.contextWindow > 0 then
		contextWindow = profile.contextWindow
		contextWindowSource = "Manual value from the provider settings."
	end

	local maxOutput = 4096
	local maxOutputSource = "Default — no metadata for this model."
	if routerMetadata and routerMetadata.maxOutputTokens and profile.maxOutputTokensMode ~= "manual" then
		maxOutput = routerMetadata.maxOutputTokens
		maxOutputSource = "9Router model catalog (not live-probed)."
	elseif modelMetadata and profile.maxOutputTokensMode ~= "manual" then
		maxOutput = modelMetadata.maxOutputTokens
		maxOutputSource = "Model metadata."
	elseif profile.maxOutputTokens and profile.maxOutputTokens > 0 then
		maxOutput = profile.maxOutputTokens
		maxOutputSource = "Manual value from the provider settings."
	end

	local report: Report = {
		providerId = profile.id,
		modelId = modelId,
		presetId = if preset then preset.id else "custom",
		capabilities = capabilities,
		contextWindow = contextWindow,
		contextWindowSource = contextWindowSource,
		maxOutputTokens = maxOutput,
		maxOutputTokensSource = maxOutputSource,
		pricing = {
			input = if modelMetadata then modelMetadata.inputCostPerMTok else nil,
			output = if modelMetadata then modelMetadata.outputCostPerMTok else nil,
			source = if modelMetadata and modelMetadata.inputCostPerMTok
				then "Model metadata (may be outdated — verify with your provider)"
				else "No pricing metadata available",
		},
		checkedAt = os.clock(),
	}

	reports[modelKey] = report
	knownProfiles[modelKey] = profile
	return report
end

function ModelCapabilityDetector.getReport(providerId: string, modelId: string): Report?
	return reports[key(providerId, modelId)]
end

function ModelCapabilityDetector.getOrBuildReport(profile: any): Report
	local existing = reports[key(profile.id, profile.modelId or "")]
	if existing then
		return existing
	end
	return ModelCapabilityDetector.buildReport(profile)
end

--=============================================================================
-- MANUAL OVERRIDES
--=============================================================================

function ModelCapabilityDetector.setOverride(providerId: string, modelId: string, capabilityId: string, status: Status?)
	local modelKey = key(providerId, modelId)
	local bucket = overrides[modelKey]
	if not bucket then
		bucket = {}
		overrides[modelKey] = bucket
	end
	if status == nil then
		bucket[capabilityId] = nil
	else
		bucket[capabilityId] = status
	end

	local report = reports[modelKey]
	if status == nil and report then
		-- Clearing an override re-derives the status from metadata instead of
		-- leaving a stale "unknown" behind.
		local stored = knownProfiles[modelKey]
		if stored then
			report = ModelCapabilityDetector.buildReport(stored)
		end
	end

	if report and status ~= nil then
		local capability = report.capabilities[capabilityId]
		if capability then
			capability.status = status
			capability.source = "manual_override"
			capability.verification = "Manual override (unverified)"
			capability.overridden = true
			capability.lastChecked = os.clock()
		end
	end

	EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report })
end

function ModelCapabilityDetector.clearOverrides(providerId: string, modelId: string)
	overrides[key(providerId, modelId)] = nil
	local report = reports[key(providerId, modelId)]
	if report then
		for capabilityId, capability in report.capabilities do
			capability.overridden = false
			capability.source = "unavailable"
			capability.status = "unknown"
			capability.verification = "Not determined"
		end
	end
	EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report })
end

--=============================================================================
-- LIVE PROBES
--=============================================================================

-- A 1x1 transparent PNG, used only to test whether an endpoint accepts images.
local TINY_PNG_BASE64 =
	"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="

local function mark(capabilityId: string, status: Status, detail: string)
	local report = reports[currentProbeKey]
	if not report then
		return
	end
	local capability = report.capabilities[capabilityId]
	if not capability then
		return
	end
	-- A manual override is never silently replaced by a probe result.
	if capability.overridden then
		return
	end
	capability.status = status
	capability.source = "live_probe"
	capability.verification = "Live API probe"
	capability.lastChecked = os.clock()
	capability.details = detail
end

-- NOTE: `mark` closes over the `currentProbeKey` declared at the top of this
-- module. runProbes must assign THAT variable — a second local declaration here
-- would shadow it and every probe would silently write to reports[""].

export type ProbeOptions = {
	onProgress: ((capabilityId: string, label: string, status: Status, detail: string) -> ())?,
	signal: any?,
}

--- Runs the probeable capability checks against the live provider.
--- Each check is a real request; some cost more than others.
function ModelCapabilityDetector.runProbes(profile: any, apiKey: string?, options: ProbeOptions?)
	local opts = options or {}
	currentProbeKey = key(profile.id, profile.modelId or "")

	local report = ModelCapabilityDetector.getOrBuildReport(profile)
	local signal = opts.signal

	local function notify(capabilityId: string, detail: string)
		local capability = report.capabilities[capabilityId]
		if opts.onProgress and capability then
			opts.onProgress(capabilityId, capability.label, capability.status, detail)
		end
		EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report, capabilityId = capabilityId })
	end

	-- 1. Text output / tool calling ------------------------------------------------
	local toolSchema = {
		type = "function",
		name = "probe_tool",
		description = "Returns a constant. Call this tool.",
		parameters = { type = "object", properties = {}, additionalProperties = false },
	}

	local textSpec = {
		messages = { { role = "user", content = "Call the probe_tool function exactly once. Do not answer in text." } },
		system = "You are a capability probe. Follow the instruction exactly.",
		tools = { toolSchema },
		toolChoice = "required",
		model = profile.modelId,
		maxOutputTokens = 128,
		streaming = false,
		jsonMode = false,
		temperature = 0,
	}

	-- ProviderService.complete returns a single CompleteResult table.
	local result = ProviderService.complete(profile, textSpec, apiKey)
	local response = result.ok and result.response or nil
	if response then
		mark("text_input", "supported", "Accepted a text request.")
		mark("text_output", "supported", string.format("Returned %d characters.", #response.text))
		mark("system_instructions", "supported", "Request included a system instruction.")

		local toolCalls = response.toolCalls or {}
		if #toolCalls > 0 then
			mark("tool_calling", "supported", string.format("Model requested tool `%s`.", tostring(toolCalls[1].name)))
		else
			mark("tool_calling", "unsupported", "Request succeeded but the model returned no tool call.")
		end

		if response.usage then
			if response.usage.inputTokens and response.usage.outputTokens then
				mark("reasoning", response.usage.reasoningTokens and "supported" or "unknown",
					response.usage.reasoningTokens
						and string.format("Reported %d reasoning tokens.", response.usage.reasoningTokens)
						or "No reasoning token field in usage. Cannot confirm.")
			end
			if response.usage.cachedTokens and response.usage.cachedTokens > 0 then
				mark("prompt_caching", "supported", string.format("Reported %d cached tokens.", response.usage.cachedTokens))
			else
				mark("prompt_caching", "unknown", "No cached token count was reported on this short request.")
			end
		end
	else
		local reason = tostring(result.error or "The probe request failed.")
		for _, capabilityId in { "text_input", "text_output", "tool_calling", "system_instructions", "reasoning", "prompt_caching" } do
			mark(capabilityId, "unknown", "Probe could not run: " .. reason)
		end
	end

	for _, capabilityId in { "text_input", "text_output", "tool_calling", "system_instructions", "reasoning", "prompt_caching" } do
		notify(capabilityId, report.capabilities[capabilityId].details or "")
	end

	if signal and signal.cancelled then
		return report
	end

	-- 2. Structured JSON -----------------------------------------------------------
	local jsonSpec = {
		messages = { { role = "user", content = "Return a JSON object with a single key \"ok\" set to true." } },
		model = profile.modelId,
		maxOutputTokens = 128,
		streaming = false,
		jsonMode = true,
		temperature = 0,
		toolChoice = "none",
	}
	-- ProviderService.complete returns a single CompleteResult table.
	local jsonResult = ProviderService.complete(profile, jsonSpec, apiKey)
	local jsonResponse = jsonResult.ok and jsonResult.response or nil
	if jsonResponse then
		local ok = pcall(HttpService.JSONDecode, HttpService, jsonResponse.text or "")
		mark("structured_json", if ok then "supported" else "unsupported",
			if ok then "JSON mode returned parseable JSON." else "JSON mode did not return parseable JSON.")
		if jsonResponse.usage and jsonResponse.usage.reasoningTokens and jsonResponse.usage.reasoningTokens > 0 then
			mark("reasoning", "supported", string.format("Reported %d reasoning tokens.", jsonResponse.usage.reasoningTokens))
			notify("reasoning", report.capabilities.reasoning.details or "")
		end
	else
		mark("structured_json", "unknown", "Probe request failed: " .. tostring(jsonResult.error))
	end
	notify("structured_json", report.capabilities.structured_json.details or "")

	if signal and signal.cancelled then
		return report
	end

	-- 3. Vision --------------------------------------------------------------------
	local visionSpec = {
		messages = {
			{
				role = "user",
				parts = {
					{ kind = "text", text = "What single colour is this pixel? Answer with one word." },
					{ kind = "image", mime = "image/png", data = TINY_PNG_BASE64, fileName = "probe.png" },
				},
			},
		},
		model = profile.modelId,
		maxOutputTokens = 64,
		streaming = false,
		temperature = 0,
		toolChoice = "none",
	}
	local visionResult = ProviderService.complete(profile, visionSpec, apiKey)
	local visionResponse = visionResult.ok and visionResult.response or nil
	if visionResponse then
		mark("vision", "supported", "Endpoint accepted an inline image and returned a reply.")
	else
		local message = tostring(visionResult.error)
		local looksUnsupported = string.find(message, "400", 1, true) ~= nil
			or string.find(string.lower(message), "image", 1, true) ~= nil
			or string.find(string.lower(message), "modalit", 1, true) ~= nil
		mark("vision", if looksUnsupported then "unsupported" else "unknown",
			if looksUnsupported then "Provider rejected the image input: " .. message else "Probe inconclusive: " .. message)
	end
	notify("vision", report.capabilities.vision.details or "")

	report.checkedAt = os.clock()
	Logger.success("AI Provider", "Capability probes finished.", {
		detail = string.format("Model %s on %s", profile.modelId, profile.displayName),
	})
	EventBus.emit(EventBus.Events.CapabilitiesChanged, { report = report })
	return report
end

--=============================================================================
-- SUMMARY HELPERS
--=============================================================================

function ModelCapabilityDetector.statusColor(status: Status): Color3
	if status == "supported" then
		return Color3.fromHex("#49C591")
	elseif status == "unsupported" then
		return Color3.fromHex("#F16E7A")
	end
	return Color3.fromHex("#A7A0B2")
end

function ModelCapabilityDetector.statusLabel(status: Status): string
	if status == "supported" then
		return "Supported"
	elseif status == "unsupported" then
		return "Unsupported"
	end
	return "Unknown"
end

function ModelCapabilityDetector.summary(report: Report): { supported: number, unsupported: number, unknown: number }
	local counts = { supported = 0, unsupported = 0, unknown = 0 }
	for _, capability in report.capabilities do
		counts[capability.status] += 1
	end
	return counts
end

--- Modalities the attachment pipeline should enforce for this model.
---
--- Two gates apply: what the MODEL reports it supports, and what the PROTOCOL can
--- actually carry inline. For example OpenAI's chat-completions body has no
--- audio or video block, so ForgePilot refuses to claim it can send one even
--- when the model id suggests audio support.
function ModelCapabilityDetector.allowedAttachmentKinds(report: Report?, protocolId: string?): { [string]: boolean }
	local allowed: { [string]: boolean } = { text = true }

	if not report then
		return allowed
	end

	local function supports(id: CapabilityId): boolean
		local capability = report.capabilities[id]
		return capability ~= nil and capability.status == "supported"
	end

	local protocol = ProviderRegistry.getProtocol(protocolId or "openai_compatible")

	-- Only Gemini's native generateContent body carries inline media of every
	-- kind; every other protocol ForgePilot speaks has text and images only.
	local nativeMultimodal = protocol.id == "gemini_native"

	allowed.image = supports("vision") and protocol.supportsImages
	allowed.document = supports("document_input") and protocol.supportsDocuments
	allowed.pdf = supports("pdf_input") and nativeMultimodal
	allowed.audio = supports("audio_input") and nativeMultimodal
	allowed.video = supports("video_input") and nativeMultimodal

	return allowed
end

return ModelCapabilityDetector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ProtocolDetector</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / ProtocolDetector
	Bounded, user-authorised protocol probing.

	THE RULES THIS ENFORCES
	  * A generic HTTP 200 is NOT proof a protocol works. Every candidate response
	    must contain the structure that protocol requires.
	  * HTTP 404 is NOT proof another protocol exists. It only means this path did
	    not answer.
	  * Only the paths ForgePilot would actually use are probed. Nothing else.
	  * Each probe is a real request and may cost money, so the count is bounded,
	    the user is warned first, and cancellation is honoured between probes.

	Detection order matches the spec:
	  known metadata → documented schema → model list → capability probes → manual
]]

local APIEndpointRouter = require(script.Parent.APIEndpointRouter)
local BaseURLResolver = require(script.Parent.BaseURLResolver)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local JSONValidator = require(script.Parent.Parent.Utilities.JSONValidator)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local Time = require(script.Parent.Parent.Utilities.Time)
local UniversalHTTPClient = require(script.Parent.Parent.Utilities.UniversalHTTPClient)
local UniversalProviderRegistry = require(script.Parent.UniversalProviderRegistry)

local ProtocolDetector = {}

--=============================================================================
-- CANDIDATES
--=============================================================================

export type Candidate = {
	protocolId: string,
	label: string,
	confidence: number,
	source: string,
	validated: boolean,
	note: string,
}

-- Probed in this order: chat first (most widely supported), then the rest.
local PROBE_ORDER = {
	"openai_chat",
	"openai_responses",
	"openai_text_completions",
	"anthropic_messages",
	"gemini_native",
	"openrouter",
	"gemini_openai",
	"custom_rest",
}

--=============================================================================
-- RESPONSE VALIDATORS
--=============================================================================
-- A candidate is "validated" only when the body proves the shape.

local function hasChoices(body: string): (boolean, string?)
	local decoded = JSONValidator.decode(body)
	if type(decoded) ~= "table" then
		return false, "Response was not valid JSON."
	end
	if type(decoded.error) == "table" then
		return false, "Provider returned an error object."
	end
	local choices = decoded.choices
	if type(choices) ~= "table" or #choices == 0 then
		return false, "No `choices` array in the response."
	end
	local first = choices[1]
	if type(first) ~= "table" then
		return false, "`choices[0]` was not an object."
	end
	-- Chat Completions put content under message; legacy puts it under text.
	if type(first.message) == "table" or type(first.text) == "string" or type(first.delta) == "table" then
		return true, nil
	end
	return false, "`choices[0]` had neither `message` nor `text`."
end

local function hasLegacyCompletionText(body: string): (boolean, string?)
	local decoded = JSONValidator.decode(body)
	if type(decoded) ~= "table" or type(decoded.choices) ~= "table" or #decoded.choices == 0 then
		return false, "No `choices` array."
	end
	local first = decoded.choices[1]
	if type(first) ~= "table" or type(first.text) ~= "string" then
		return false, "`choices[0].text` was absent — this is not a Text Completions response."
	end
	return true, nil
end

local function hasResponsesOutput(body: string): (boolean, string?)
	local decoded = JSONValidator.decode(body)
	if type(decoded) ~= "table" then
		return false, "Response was not valid JSON."
	end
	if type(decoded.error) == "table" then
		return false, "Provider returned an error object."
	end
	if decoded.output == nil and decoded.output_text == nil then
		return false, "No `output` field — this is not a Responses API result."
	end
	return true, nil
end

local function hasAnthropicContent(body: string): (boolean, string?)
	local decoded = JSONValidator.decode(body)
	if type(decoded) ~= "table" then
		return false, "Response was not valid JSON."
	end
	if type(decoded.error) == "table" then
		return false, "Provider returned an error object."
	end
	if decoded.type ~= "message" and decoded.content == nil then
		return false, "No `content` block array — this is not an Anthropic Messages result."
	end
	local content = decoded.content
	if type(content) ~= "table" then
		return false, "`content` was not an array."
	end
	for _, block in content do
		if type(block) == "table" and (block.type == "text" or block.type == "tool_use") then
			return true, nil
		end
	end
	return false, "`content` had no text or tool_use block."
end

local function hasGeminiCandidates(body: string): (boolean, string?)
	local decoded = JSONValidator.decode(body)
	if type(decoded) ~= "table" then
		return false, "Response was not valid JSON."
	end
	if type(decoded.error) == "table" then
		return false, "Provider returned an error object."
	end
	local candidates = decoded.candidates
	if type(candidates) ~= "table" or #candidates == 0 then
		if type(decoded.promptFeedback) == "table" then
			return false, "Prompt was blocked (promptFeedback), so no candidates were produced."
		end
		return false, "No `candidates` array — this is not a Gemini generateContent result."
	end
	local first = candidates[1]
	if type(first) ~= "table" or type(first.content) ~= "table" then
		return false, "`candidates[0].content` was absent."
	end
	return true, nil
end

local VALIDATORS: { [string]: (body: string) -> (boolean, string?) } = {
	openai_chat = hasChoices,
	openrouter = hasChoices,
	gemini_openai = hasChoices,
	openai_text_completions = hasLegacyCompletionText,
	openai_responses = hasResponsesOutput,
	anthropic_messages = hasAnthropicContent,
	gemini_native = hasGeminiCandidates,
}

--=============================================================================
-- METADATA FIRST
--=============================================================================

--- A provider whose preset already states the protocol does not need probing.
function ProtocolDetector.fromMetadata(profile: any): Candidate?
	if type(profile) ~= "table" then
		return nil
	end
	if type(profile.presetId) == "string" and profile.presetId ~= "custom" and profile.presetId ~= "rest" then
		local preset = UniversalProviderRegistry.getPreset(profile.presetId)
		if preset and preset.baseUrl ~= "" then
			return {
				protocolId = preset.protocol,
				label = UniversalProviderRegistry.getProtocol(preset.protocol).label,
				confidence = 0.99,
				source = "known_provider_metadata",
				validated = true,
				note = string.format("Preset \"%s\" documents this protocol.", preset.label),
			}
		end
	end
	if type(profile.protocol) == "string" and #profile.protocol > 0 and profile.protocol ~= "openai_compatible" then
		return {
			protocolId = profile.protocol,
			label = UniversalProviderRegistry.getProtocol(profile.protocol).label,
			confidence = 0.8,
			source = "manual_configuration",
			validated = false,
			note = "Protocol was chosen manually. Not verified against a live response.",
		}
	end
	return nil
end

--=============================================================================
-- PROBING
--=============================================================================

export type ProbeOptions = {
	--- Maximum candidate protocols to send a real request to.
	maxProbes: number?,
	onProgress: ((candidates: { Candidate }, note: string) -> ())?,
	shouldCancel: (() -> boolean)?,
}

export type DetectionReport = {
	candidates: { Candidate },
	best: Candidate?,
	probesRun: number,
	probesSkipped: number,
	cancelled: boolean,
	startedAt: number,
	elapsedMs: number,
}

--- Builds the minimal request body a protocol needs for a connectivity probe.
local function probeBody(profile: any, protocolId: string): { [string]: any }
	local model = (profile.modelId and #profile.modelId > 0) and profile.modelId or "probe"
	local prompt = "Reply with the single word: ok"

	if protocolId == "openai_text_completions" then
		return { model = model, prompt = prompt, max_tokens = 8 }
	elseif protocolId == "openai_responses" then
		return { model = model, input = prompt, max_output_tokens = 16 }
	elseif protocolId == "anthropic_messages" then
		return { model = model, max_tokens = 16, messages = { { role = "user", content = prompt } } }
	elseif protocolId == "gemini_native" then
		return { contents = { { role = "user", parts = { { text = prompt } } } } }
	end
	return { model = model, messages = { { role = "user", content = prompt } }, max_tokens = 16 }
end

local function buildHeaders(profile: any, apiKey: string?): { [string]: string }
	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }
	local auth = UniversalProviderRegistry.buildAuthHeaders({
		style = profile.authStyle,
		headerName = profile.authHeaderName,
		headerPrefix = profile.authHeaderPrefix,
		queryParam = profile.authQueryParam,
	}, apiKey)
	for key, value in auth do
		headers[key] = value
	end
	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end
	return headers
end

--- Runs the bounded protocol probe.
function ProtocolDetector.detect(profile: any, options: ProbeOptions?): DetectionReport
	local opts = options or {}
	local maxProbes = math.clamp(opts.maxProbes or 3, 1, 8)
	local apiKey = CredentialStore.get(profile.id)
	local headers = buildHeaders(profile, apiKey)
	local started = os.clock()

	local report: DetectionReport = {
		candidates = {},
		best = nil,
		probesRun = 0,
		probesSkipped = 0,
		cancelled = false,
		startedAt = started,
		elapsedMs = 0,
	}

	-- 1 & 2. Known metadata or documented schema — no request needed.
	local fromMeta = ProtocolDetector.fromMetadata(profile)
	if fromMeta then
		report.candidates[#report.candidates + 1] = fromMeta
		report.best = fromMeta
	end

	-- 3. Model listing, when the base exposes one.
	local modelsUrl, modelsError = UniversalProviderRegistry.modelListUrl(profile)
	if modelsUrl then
		local response = UniversalHTTPClient.request(modelsUrl, {
			method = "GET",
			headers = headers,
			accept = "application/json",
			timeoutMs = profile.timeoutMs,
			label = "protocol-detect/models",
			shouldCancel = opts.shouldCancel,
		})
		if response.ok then
			local decoded = JSONValidator.decode(response.body)
			local count = if type(decoded) == "table" and type(decoded.data) == "table"
				then #decoded.data
				elseif type(decoded) == "table" and type(decoded.models) == "table" then #decoded.models else 0
			if count > 0 then
				report.candidates[#report.candidates + 1] = {
					protocolId = profile.protocol,
					label = "Model list reachable",
					confidence = 0.6,
					source = "model_list_endpoint",
					validated = true,
					note = string.format("`/models` returned %d model id(s), so the base URL is correct.", count),
				}
			end
		elseif opts.onProgress then
			opts.onProgress(report.candidates, string.format("Model list unavailable: HTTP %s", tostring(response.statusCode)))
		end
	elseif opts.onProgress and modelsError then
		opts.onProgress(report.candidates, modelsError)
	end

	-- 4. Bounded capability probes against candidate protocols.
	local budget = if report.best and report.best.source == "known_provider_metadata" then 1 else maxProbes

	for _, protocolId in PROBE_ORDER do
		if report.probesRun >= budget then
			report.probesSkipped += 1
			continue
		end
		if opts.shouldCancel and opts.shouldCancel() then
			report.cancelled = true
			break
		end
		if protocolId == "custom_rest" then
			-- Never probe a custom mapping; it is the user's to verify.
			continue
		end

		local url, urlError = BaseURLResolver.resolve(profile.baseUrl, {
			endpointPath = APIEndpointRouter.chatPath(protocolId),
			mode = (profile.urlMode or "base") :: any,
			model = profile.modelId,
		})
		if not url then
			continue
		end
		local protocol = UniversalProviderRegistry.getProtocol(protocolId)
		local protocolHeaders = table.clone(headers)
		for key, value in protocol.defaultHeaders do
			protocolHeaders[key] = value
		end
		-- Each protocol declares its own credential header, so a probe for
		-- Anthropic or Gemini native never reuses the previous protocol's style.
		local probeAuth, probeQuery = UniversalProviderRegistry.buildAuthHeaders({
			style = profile.authStyle == "none" and "none" or protocol.authStyle,
			headerName = profile.authHeaderName or protocol.authHeaderName,
			queryParam = profile.authQueryParam or protocol.authQueryParam,
		}, apiKey)
		for key, value in probeAuth do
			protocolHeaders[key] = value
		end
		local requestUrl = url
		if probeQuery then
			requestUrl ..= (if string.find(url, "?", 1, true) then "&" else "?") .. probeQuery
		end

		report.probesRun += 1
		if opts.onProgress then
			opts.onProgress(
				report.candidates,
				string.format("Probing %s (%d/%d)…", protocol.label, report.probesRun, budget)
			)
		end

		local response = UniversalHTTPClient.request(requestUrl, {
			method = "POST",
			headers = protocolHeaders,
			json = probeBody(profile, protocolId),
			accept = "application/json",
			timeoutMs = math.min(profile.timeoutMs or 120000, 30000),
			label = "protocol-detect/" .. protocolId,
			shouldCancel = opts.shouldCancel,
		})
		_ = urlError

		if not response.ok then
			-- 401/403 proves the ENDPOINT exists but the key is wrong. That is
			-- real information, unlike a bare 404.
			if response.statusCode == 401 or response.statusCode == 403 then
				report.candidates[#report.candidates + 1] = {
					protocolId = protocolId,
					label = protocol.label,
					confidence = 0.5,
					source = "http_status",
					validated = false,
					note = string.format(
						"The endpoint answered with HTTP %d, which means this path exists but the key was rejected. Protocol still unproven.",
						response.statusCode
					),
				}
			end
			continue
		end

		local validator = VALIDATORS[protocolId]
		local valid: boolean
		local reason: string?
		if validator then
			valid, reason = validator(response.body)
		else
			valid, reason = false, "No validator for this protocol."
		end
		if valid then
			local candidate: Candidate = {
				protocolId = protocolId,
				label = protocol.label,
				confidence = 0.95,
				source = "live_probe",
				validated = true,
				note = string.format("The response matched the %s response structure.", protocol.label),
			}
			report.candidates[#report.candidates + 1] = candidate
			if report.best == nil or candidate.confidence > report.best.confidence then
				report.best = candidate
			end
			-- A validated match is enough; stop probing to save quota.
			break
		end

		report.candidates[#report.candidates + 1] = {
			protocolId = protocolId,
			label = protocol.label,
			confidence = 0.2,
			source = "live_probe",
			validated = false,
			note = string.format("HTTP 200 but the shape did not match: %s", tostring(reason)),
		}
	end

	report.elapsedMs = (os.clock() - started) * 1000

	Logger.info("AI Provider", "Protocol detection finished.", {
		detail = string.format(
			"%d probe(s) run, %d skipped · best: %s",
			report.probesRun,
			report.probesSkipped,
			if report.best then report.best.protocolId else "none confirmed"
		),
	})

	return report
end

return ProtocolDetector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ProviderErrorNormalizer</string>
          <string name="Source">--!strict
--[[
	ForgePilot / AI / ProviderErrorNormalizer
	Turns any transport outcome into one stable error shape.

	Every field is either read from the response or explicitly nil. Missing
	metadata is never invented — `confidence` and `classificationSource` tell the
	caller how much to trust the result.
]]

local BaseURLResolver = require(script.Parent.BaseURLResolver)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local UniversalErrorDetector = require(script.Parent.Parent.Utilities.UniversalErrorDetector)

local ProviderErrorNormalizer = {}

export type Normalised = {
	provider: string,
	model: string,
	category: string,
	httpStatus: number?,
	providerCode: string?,
	message: string,
	requestId: string?,
	endpoint: string,
	retryable: boolean,
	retryAfterMs: number?,
	retryAfterSource: string?,
	rateLimit: {
		limit: number?,
		windowMs: number?,
		estimated: boolean,
	},
	upstreamRetry: {
		present: boolean,
		attempt: number?,
		delaySeconds: number?,
	},
	classificationSource: string,
	confidence: number,
	elapsedMs: number,
	timestamp: number,
}

--=============================================================================
-- REQUEST ID
--=============================================================================

local REQUEST_ID_HEADERS = {
	"x-request-id",
	"request-id",
	"x-requestid",
	"x-correlation-id",
	"cf-ray",
	"x-amzn-requestid",
	"openai-request-id",
	"anthropic-request-id",
	"x-goog-request-id",
}

--- Extracts a provider request id from headers or from the error body.
function ProviderErrorNormalizer.findRequestId(
	headers: { [string]: string }?,
	body: string?
): string?
	local lookup = headers or {}
	for _, name in REQUEST_ID_HEADERS do
		local value = lookup[name]
		if type(value) == "string" and #value &gt; 0 then
			return Redact.scrubText(value)
		end
	end

	if type(body) == "string" then
		-- "(request id: 20261010...)" — a very common localised format.
		local fromText = string.match(body, "%(request%s+id:%s*([^%)]+)%)")
		if fromText then
			return Redact.scrubText(StringUtil.trim(fromText))
		end
		local fromJson = string.match(body, '"request_?id"%s*:%s*"([^"]+)"')
		if fromJson then
			return Redact.scrubText(fromJson)
		end
	end
	return nil
end

--=============================================================================
-- NORMALISE
--=============================================================================

export type Input = {
	provider: string,
	model: string,
	endpoint: string,
	statusCode: number?,
	body: string?,
	headers: { [string]: string }?,
	transportError: string?,
	streamInterrupted: boolean?,
	elapsedMs: number,
}

function ProviderErrorNormalizer.normalise(input: Input): Normalised
	local classification = UniversalErrorDetector.classify({
		statusCode = input.statusCode,
		body = input.body,
		headers = input.headers,
		transportError = input.transportError,
		streamInterrupted = input.streamInterrupted,
	})

	local message = classification.message
	if type(message) ~= "string" or #message == 0 then
		message = if input.transportError
			then Redact.scrubText(input.transportError)
			else string.format("Provider returned HTTP %s with no message.", tostring(input.statusCode))
	end

	local category = classification.category
	local neverRetry = UniversalErrorDetector.NEVER_RETRY[category] == true

	return {
		provider = input.provider or "Unknown provider",
		model = input.model or "(not set)",
		category = category,
		httpStatus = input.statusCode,
		providerCode = classification.providerCode,
		message = Redact.scrubText(message),
		requestId = ProviderErrorNormalizer.findRequestId(input.headers, input.body),
		endpoint = BaseURLResolver.forDisplay(input.endpoint),
		retryable = (not neverRetry) and UniversalErrorDetector.isRetryable(category),
		retryAfterMs = nil,
		retryAfterSource = nil,
		rateLimit = {
			limit = classification.rateWindow.limit,
			windowMs = classification.rateWindow.windowMs,
			estimated = false,
		},
		upstreamRetry = classification.upstreamRetry,
		classificationSource = classification.source,
		confidence = classification.confidence,
		elapsedMs = input.elapsedMs or 0,
		timestamp = os.clock(),
	}
end

--=============================================================================
-- DISPLAY
--=============================================================================

local CATEGORY_HEADLINES: { [string]: string } = {
	RATE_LIMITED = "Provider Rate Limited",
	CONCURRENCY_LIMITED = "Too Many Concurrent Requests",
	PROVIDER_OVERLOADED = "Provider Overloaded",
	QUOTA_WINDOW_EXHAUSTED = "Quota Window Exhausted",
	DAILY_QUOTA_EXHAUSTED = "Daily Quota Exhausted",
	INSUFFICIENT_CREDITS = "Insufficient Credits",
	INVALID_API_KEY = "Invalid API Key",
	INVALID_MODEL = "Invalid Model",
	INVALID_ENDPOINT = "Invalid Endpoint",
	INVALID_REQUEST = "Invalid Request",
	CONTEXT_LENGTH_EXCEEDED = "Context Window Exceeded",
	UNSUPPORTED_FEATURE = "Unsupported Feature",
	INVALID_ATTACHMENT = "Invalid Attachment",
	CONTENT_FILTERED = "Blocked By Content Filter",
	PERMISSION_DENIED = "Permission Denied",
	SERVER_ERROR = "Provider Server Error",
	NETWORK_ERROR = "Network Error",
	TIMEOUT = "Request Timed Out",
	STREAM_INTERRUPTED = "Stream Interrupted",
	UNKNOWN_ERROR = "Unknown Provider Error",
}

function ProviderErrorNormalizer.headline(category: string): string
	return CATEGORY_HEADLINES[category] or "Provider Error"
end

--- A short, actionable hint. Never suggests something impossible.
function ProviderErrorNormalizer.remedy(category: string, normalised: Normalised?): string?
	if category == "RATE_LIMITED" then
		if normalised and normalised.rateLimit.limit and normalised.rateLimit.windowMs then
			return string.format(
				"The provider allows %d request(s) per %d seconds. ForgePilot will wait for the window to clear.",
				normalised.rateLimit.limit,
				math.floor(normalised.rateLimit.windowMs / 1000)
			)
		end
		return "ForgePilot will wait for the rate-limit window to clear before retrying."
	elseif category == "INVALID_API_KEY" then
		return "Check the API Key field in Settings. Keys are never auto-retried."
	elseif category == "INVALID_MODEL" then
		return "Check the Model ID, or use Refresh Models to list what this provider serves."
	elseif category == "INVALID_ENDPOINT" then
		return "Check the Base URL and Endpoint Path. ForgePilot will not guess other endpoints."
	elseif category == "CONTEXT_LENGTH_EXCEEDED" then
		return "Shorten the conversation, remove attachments, or raise Max Output Tokens / Context Window in Settings."
	elseif category == "INSUFFICIENT_CREDITS" or category == "DAILY_QUOTA_EXHAUSTED" then
		return "Top up or wait for the quota period to reset. ForgePilot will not keep retrying."
	elseif category == "PERMISSION_DENIED" then
		return "This key may not have access to that model or region."
	elseif category == "CONTENT_FILTERED" then
		return "The provider blocked this request. Rephrase the prompt or attached content."
	elseif category == "INVALID_ATTACHMENT" then
		return "Try a different file, or a smaller one."
	elseif category == "STREAM_INTERRUPTED" then
		return "The connection dropped mid-response. Retrying resumes the request from the start."
	end
	return nil
end

--=============================================================================
-- LOG FORMATTING
--=============================================================================

--- Renders one sanitised line for the Activity Logs panel.
function ProviderErrorNormalizer.formatForLog(normalised: Normalised): string
	local parts: { string } = {}
	parts[#parts + 1] = normalised.category
	if normalised.httpStatus then
		parts[#parts + 1] = "HTTP " .. tostring(normalised.httpStatus)
	end
	if normalised.providerCode then
		parts[#parts + 1] = "code " .. normalised.providerCode
	end
	if normalised.requestId then
		parts[#parts + 1] = "request " .. normalised.requestId
	end
	parts[#parts + 1] = string.format(
		"(%s, confidence %.2f)",
		normalised.classificationSource,
		normalised.confidence
	)
	return table.concat(parts, "  ·  ") .. "\n" .. normalised.message
end

return ProviderErrorNormalizer</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ProviderRateLimitScheduler</string>
          <string name="Source">--!strict
--[[
	ForgePilot / AI / ProviderRateLimitScheduler
	Sliding-window rate limiting with per-provider cooldowns and a FIFO queue.

	Honest scope: ForgePilot can only account for requests IT sends. Other
	applications using the same provider account are invisible, so learned
	cooldowns are deliberately conservative and always reported as estimates.
]]

local RetryDelayCalculator = require(script.Parent.RetryDelayCalculator)

local ProviderRateLimitScheduler = {}

--=============================================================================
-- TYPES
--=============================================================================

export type Bucket = {
	key: string,
	providerId: string,
	model: string,
	endpoint: string,
	--- os.clock() timestamps of requests this session actually sent.
	requestTimestamps: { number },
	--- Requests allowed per window, once learned from a provider error.
	limit: number?,
	windowMs: number?,
	--- os.clock() at which an established cooldown expires.
	cooldownUntil: number?,
	cooldownReason: string?,
	cooldownEstimated: boolean,
	queue: { QueueItem },
}

export type QueueItem = {
	id: string,
	enqueuedAt: number,
	readyAt: number?,
	resolve: ((waitSeconds: number) -&gt; ())?,
	reject: ((reason: string) -&gt; ())?,
	operationId: string?,
}

--=============================================================================
-- STATE
--=============================================================================

local buckets: { [string]: Bucket } = {}
local enabled = true
local queueEnabled = true

local DEFAULT_WINDOW_MS = 60 * 1000
local MAX_TRACKED_REQUESTS = 64
local FALLBACK_COOLDOWN_SECONDS = 60

--=============================================================================
-- CLOCK
--=============================================================================
-- Injectable so tests can run deterministically without waiting.

local clock: () -&gt; number = function()
	return os.clock()
end

function ProviderRateLimitScheduler.setClock(fn: () -&gt; number)
	clock = if type(fn) == "function" then fn else function()
		return os.clock()
	end
end

function ProviderRateLimitScheduler.resetClock()
	clock = function()
		return os.clock()
	end
end

--=============================================================================
-- CONFIG
--=============================================================================

function ProviderRateLimitScheduler.setEnabled(value: boolean)
	enabled = value
end

function ProviderRateLimitScheduler.isEnabled(): boolean
	return enabled
end

function ProviderRateLimitScheduler.setQueueEnabled(value: boolean)
	queueEnabled = value
end

function ProviderRateLimitScheduler.isQueueEnabled(): boolean
	return queueEnabled
end

--=============================================================================
-- KEYS
--=============================================================================

--- Quota independence between models/endpoints is rarely documented, so the
--- default scope is deliberately shared (provider + key session) rather than
--- per-model. Narrow it only when the provider states the limits are separate.
function ProviderRateLimitScheduler.keyFor(providerId: string, model: string?, endpoint: string?): string
	return string.format("%s|%s|%s", providerId, model or "*", endpoint or "*")
end

function ProviderRateLimitScheduler.getBucket(
	providerId: string,
	model: string?,
	endpoint: string?
): Bucket
	local key = ProviderRateLimitScheduler.keyFor(providerId, model, endpoint)
	local existing = buckets[key]
	if existing then
		return existing
	end

	local bucket: Bucket = {
		key = key,
		providerId = providerId,
		model = model or "*",
		endpoint = endpoint or "*",
		requestTimestamps = {},
		limit = nil,
		windowMs = nil,
		cooldownUntil = nil,
		cooldownReason = nil,
		cooldownEstimated = false,
		queue = {},
	}
	buckets[key] = bucket
	return bucket
end

function ProviderRateLimitScheduler.clearAll()
	buckets = {}
end

function ProviderRateLimitScheduler.clearProvider(providerId: string)
	local prefix = providerId .. "|"
	for key, bucket in buckets do
		if string.sub(key, 1, #prefix) == prefix then
			-- Release anyone still waiting so cancellation cannot strand them.
			for _, item in bucket.queue do
				if item.reject then
					item.reject("Provider bucket was cleared.")
				end
			end
			buckets[key] = nil
		end
	end
end

--=============================================================================
-- RECORDING
--=============================================================================

--- Records that ForgePilot just sent a request.
function ProviderRateLimitScheduler.recordRequest(
	providerId: string,
	model: string?,
	endpoint: string?,
	now: number?
)
	if not enabled then
		return
	end
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	local stamp = now or clock()
	table.insert(bucket.requestTimestamps, stamp)
	while #bucket.requestTimestamps &gt; MAX_TRACKED_REQUESTS do
		table.remove(bucket.requestTimestamps, 1)
	end
end

--- How many requests ForgePilot has sent inside the current window.
function ProviderRateLimitScheduler.countInWindow(bucket: Bucket, now: number): number
	local windowMs = bucket.windowMs or DEFAULT_WINDOW_MS
	local cutoff = now - windowMs / 1000
	local count = 0
	for _, stamp in bucket.requestTimestamps do
		if stamp &gt; cutoff then
			count += 1
		end
	end
	return count
end

--=============================================================================
-- COOLDOWN
--=============================================================================

export type CooldownResult = {
	active: boolean,
	remainingSeconds: number,
	reason: string?,
	estimated: boolean,
}

function ProviderRateLimitScheduler.getCooldown(
	providerId: string,
	model: string?,
	endpoint: string?,
	now: number?
): CooldownResult
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	local stamp = now or clock()
	if bucket.cooldownUntil and bucket.cooldownUntil &gt; stamp then
		return {
			active = true,
			remainingSeconds = bucket.cooldownUntil - stamp,
			reason = bucket.cooldownReason,
			estimated = bucket.cooldownEstimated,
		}
	end
	if bucket.cooldownUntil then
		bucket.cooldownUntil = nil
		bucket.cooldownReason = nil
	end
	return { active = false, remainingSeconds = 0, reason = nil, estimated = false }
end

--- Establishes a provider cooldown. Returns the cooldown state afterwards.
function ProviderRateLimitScheduler.setCooldown(
	providerId: string,
	model: string?,
	endpoint: string?,
	seconds: number,
	reason: string?,
	estimated: boolean,
	now: number?
): CooldownResult
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	local stamp = now or clock()
	local expiresAt = stamp + math.max(0, seconds)

	-- Never shorten an existing, longer cooldown.
	if bucket.cooldownUntil and bucket.cooldownUntil &gt; expiresAt then
		return ProviderRateLimitScheduler.getCooldown(providerId, model, endpoint, stamp)
	end

	bucket.cooldownUntil = expiresAt
	bucket.cooldownReason = reason or "Provider cooldown"
	bucket.cooldownEstimated = estimated == true
	return {
		active = true,
		remainingSeconds = seconds,
		reason = bucket.cooldownReason,
		estimated = bucket.cooldownEstimated,
	}
end

function ProviderRateLimitScheduler.clearCooldown(
	providerId: string,
	model: string?,
	endpoint: string?
)
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	bucket.cooldownUntil = nil
	bucket.cooldownReason = nil
	bucket.cooldownEstimated = false
end

--=============================================================================
-- LEARNING
--=============================================================================

--- Learns a rate-limit window from a provider error message.
---
--- When the provider told us the window we store it exactly. When it did not,
--- we fall back to a conservative 60s cooldown and mark it an ESTIMATE, because
--- requests made outside ForgePilot are invisible to us.
function ProviderRateLimitScheduler.learnFromError(
	providerId: string,
	model: string?,
	endpoint: string?,
	info: {
		limit: number?,
		windowMs: number?,
		category: string,
		cooldownSeconds: number?,
	},
	now: number?
): { learned: boolean, cooldown: CooldownResult, estimated: boolean, windowMs: number? }
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)

	if info.limit and info.windowMs and info.windowMs &gt; 0 then
		bucket.limit = info.limit
		bucket.windowMs = info.windowMs
		local cooldown = ProviderRateLimitScheduler.setCooldown(
			providerId,
			model,
			endpoint,
			info.windowMs / 1000,
			string.format("Provider limit: %d requests per %.0fs", info.limit, info.windowMs / 1000),
			false,
			now
		)
		return { learned = true, cooldown = cooldown, estimated = false, windowMs = info.windowMs }
	end

	local seconds = info.cooldownSeconds
	local estimated = false
	if type(seconds) ~= "number" or seconds &lt;= 0 then
		seconds = FALLBACK_COOLDOWN_SECONDS
		estimated = true
	end

	local cooldown = ProviderRateLimitScheduler.setCooldown(
		providerId,
		model,
		endpoint,
		seconds,
		if estimated
			then "Conservative estimate: ForgePilot cannot see requests made by other apps on this account."
			else "Provider cooldown",
		estimated,
		now
	)
	return { learned = false, cooldown = cooldown, estimated = estimated, windowMs = nil }
end

--=============================================================================
-- ADMISSION
--=============================================================================

export type Admission = {
	allowed: boolean,
	waitSeconds: number,
	reason: string,
	estimated: boolean,
}

--- Asks whether a request may proceed now.
function ProviderRateLimitScheduler.check(
	providerId: string,
	model: string?,
	endpoint: string?,
	now: number?
): Admission
	if not enabled then
		return { allowed = true, waitSeconds = 0, reason = "Rate limit scheduling disabled.", estimated = false }
	end

	local stamp = now or clock()
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)

	local cooldown = ProviderRateLimitScheduler.getCooldown(providerId, model, endpoint, stamp)
	if cooldown.active then
		return {
			allowed = false,
			waitSeconds = cooldown.remainingSeconds,
			reason = cooldown.reason or "Provider cooldown active.",
			estimated = cooldown.estimated,
		}
	end

	if not bucket.limit or not bucket.windowMs then
		return { allowed = true, waitSeconds = 0, reason = "No learned rate limit for this provider yet.", estimated = false }
	end

	local windowSeconds = bucket.windowMs / 1000
	local used = ProviderRateLimitScheduler.countInWindow(bucket, stamp)
	if used &lt; bucket.limit then
		return {
			allowed = true,
			waitSeconds = 0,
			reason = string.format("Window has capacity (%d/%d).", used, bucket.limit),
			estimated = false,
		}
	end

	-- Window is full: wait until the oldest request leaves the window.
	local oldest = bucket.requestTimestamps[1]
	local wait = if oldest then (oldest + windowSeconds) - stamp else windowSeconds
	wait = math.max(wait, 0)

	return {
		allowed = false,
		waitSeconds = wait,
		reason = string.format(
			"ForgePilot has sent %d of %d requests in this %.0fs window.",
			used,
			bucket.limit,
			windowSeconds
		),
		estimated = false,
	}
end

--=============================================================================
-- QUEUE
--=============================================================================

local queueCounter = 0

--- Queues a request until the window has capacity. Cancels on rejection.
function ProviderRateLimitScheduler.enqueue(
	providerId: string,
	model: string?,
	endpoint: string?,
	cancel: (() -&gt; boolean)?,
	onWait: ((waitSeconds: number) -&gt; ())?
): any
	if not enabled or not queueEnabled then
		local admission = ProviderRateLimitScheduler.check(providerId, model, endpoint)
		if admission.allowed then
			return true
		end
		if not onWait then
			return true
		end
	end

	local promise = promise.create()
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)

	queueCounter += 1
	local item: QueueItem = {
		id = string.format("rq-%d", queueCounter),
		enqueuedAt = clock(),
		resolve = function(waitSeconds)
			promise:resolve(true)
			_ = waitSeconds
		end,
		reject = function(reason)
			promise:reject(reason)
		end,
	}
	table.insert(bucket.queue, item)

	task.spawn(function()
		while true do
			if cancel and cancel() then
				ProviderRateLimitScheduler.removeFromQueue(bucket, item)
				promise:reject("Cancelled while waiting for rate limit capacity.")
				return
			end

			local admission = ProviderRateLimitScheduler.check(providerId, model, endpoint)
			if admission.allowed then
				ProviderRateLimitScheduler.removeFromQueue(bucket, item)
				promise:resolve(true)
				return
			end

			if onWait then
				onWait(admission.waitSeconds)
			end

			-- Wake often enough for the countdown to feel live without spinning.
			task.wait(math.clamp(admission.waitSeconds / 8, 0.05, 1))
		end
	end)

	return promise:await()
end

function ProviderRateLimitScheduler.removeFromQueue(bucket: Bucket, item: QueueItem)
	for index, queued in bucket.queue do
		if queued == item then
			table.remove(bucket.queue, index)
			return
		end
	end
end

function ProviderRateLimitScheduler.queueLength(
	providerId: string,
	model: string?,
	endpoint: string?
): number
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	return #bucket.queue
end

--- Rejects every queued item. Called when the user cancels or switches provider.
function ProviderRateLimitScheduler.cancelQueue(
	providerId: string,
	model: string?,
	endpoint: string?,
	reason: string?
)
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	local queued = bucket.queue
	bucket.queue = {}
	for _, item in queued do
		if item.reject then
			item.reject(reason or "Cancelled.")
		end
	end
end

--=============================================================================
-- REPORT
--=============================================================================

function ProviderRateLimitScheduler.describe(
	providerId: string,
	model: string?,
	endpoint: string?,
	now: number?
): string
	local bucket = ProviderRateLimitScheduler.getBucket(providerId, model, endpoint)
	local stamp = now or clock()
	local used = ProviderRateLimitScheduler.countInWindow(bucket, stamp)
	if bucket.limit and bucket.windowMs then
		return string.format(
			"Tracked %d/%d requests in the current %.0fs window%s.",
			used,
			bucket.limit,
			bucket.windowMs / 1000,
			if bucket.cooldownUntil and bucket.cooldownUntil &gt; stamp then " (cooldown active)" else ""
		)
	end
	local cooldown = ProviderRateLimitScheduler.getCooldown(providerId, model, endpoint, stamp)
	if cooldown.active then
		return string.format(
			"Cooldown active for %.0fs%s (%d requests tracked).",
			cooldown.remainingSeconds,
			if cooldown.estimated then ", estimated" else "",
			used
		)
	end
	return string.format(
		"No rate limit learned yet. %d request(s) tracked this session. ForgePilot can only see requests it sent itself, so usage from other apps on the same account is invisible and learned cooldowns stay conservative.",
		used
	)
end

--- Combines cooldown + window information for the delay calculator.
function ProviderRateLimitScheduler.advisory(
	providerId: string,
	model: string?,
	endpoint: string?,
	now: number?
): { cooldownSeconds: number?, windowWaitSeconds: number?, reason: string?, estimated: boolean }
	local admission = ProviderRateLimitScheduler.check(providerId, model, endpoint, now)
	local cooldown = ProviderRateLimitScheduler.getCooldown(providerId, model, endpoint, now)
	return {
		cooldownSeconds = if cooldown.active then cooldown.remainingSeconds else nil,
		windowWaitSeconds = if admission.allowed then nil else admission.waitSeconds,
		reason = admission.reason,
		estimated = cooldown.estimated or admission.estimated,
	}
end

-- Re-exported so the retry controller and the calculator share one source.
ProviderRateLimitScheduler.DEFAULT_WINDOW_MS = DEFAULT_WINDOW_MS
ProviderRateLimitScheduler.FALLBACK_COOLDOWN_SECONDS = FALLBACK_COOLDOWN_SECONDS
ProviderRateLimitScheduler.RetryDelayCalculator = RetryDelayCalculator

return ProviderRateLimitScheduler</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ProviderRegistry</string>
          <string name="Source">--!strict
--[[
	ForgePilot / AI / ProviderRegistry  (compatibility shim)

	The provider registry now lives in UniversalProviderRegistry, which supports
	nine protocols and five authentication styles. This module forwards the V3
	entry points so older adapters keep working against a single implementation.

	New code should require UniversalProviderRegistry directly.
]]

local UniversalProviderRegistry = require(script.Parent.UniversalProviderRegistry)

return {
	getProtocol = UniversalProviderRegistry.getProtocol,
	protocolList = UniversalProviderRegistry.protocolList,
	getPreset = UniversalProviderRegistry.getPreset,
	presetList = UniversalProviderRegistry.presetList,
	presetsForType = UniversalProviderRegistry.presetsForType,
	newProfile = UniversalProviderRegistry.newProfile,
	applyPreset = UniversalProviderRegistry.applyPreset,
	buildAuthHeaders = UniversalProviderRegistry.buildAuthHeaders,
	resolveUrl = UniversalProviderRegistry.resolveUrl,
	modelListUrl = UniversalProviderRegistry.modelListUrl,
	isTrustedHost = UniversalProviderRegistry.isTrustedHost,
	normaliseBaseUrl = UniversalProviderRegistry.normaliseBaseUrl,
	Protocols = UniversalProviderRegistry.Protocols,
	Presets = UniversalProviderRegistry.Presets,
}</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">ProviderService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / ProviderService
	Adapter dispatch plus the single request path every provider call goes through.

	Retry lives here, not in the adapters: one SmartAutoRetryManager per operation
	means retry loops can never nest.
]]

local BaseURLResolver = require(script.Parent.BaseURLResolver)
local ContextManager = require(script.Parent.ContextManager)
local CredentialStore = require(script.Parent.Parent.Core.CredentialStore)
local CustomProviderManager = require(script.Parent.CustomProviderManager)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local ProviderErrorNormalizer = require(script.Parent.ProviderErrorNormalizer)
local ProviderRateLimitScheduler = require(script.Parent.ProviderRateLimitScheduler)
local Redact = require(script.Parent.Parent.Utilities.Redact)
local RetryDelayCalculator = require(script.Parent.RetryDelayCalculator)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local SmartAutoRetryManager = require(script.Parent.SmartAutoRetryManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local UniversalErrorDetector = require(script.Parent.Parent.Utilities.UniversalErrorDetector)
local UniversalHTTPClient = require(script.Parent.Parent.Utilities.UniversalHTTPClient)
local UniversalProviderRegistry = require(script.Parent.UniversalProviderRegistry)

local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local ProviderService = {}

-- Rate-limit buckets are keyed by HOST, so every reader and writer of the bucket
-- has to agree on that string. recordRequest used to pass the full request URL,
-- which created a second, never-read bucket.
local function endpointKey(profile: any): string
	return (BaseURLResolver.hostOf(profile.baseUrl) or profile.baseUrl) or ""
end

--=============================================================================
-- ADAPTER REGISTRY
--=============================================================================

local CustomJSON = require(script.Parent.Adapters.CustomJSONAdapter)
local Gemini = require(script.Parent.Adapters.GeminiAdapter)
local GeminiOpenAI = require(script.Parent.Adapters.GeminiOpenAIAdapter)
local OpenAICompatible = require(script.Parent.Adapters.OpenAICompatibleAdapter)
local OpenAICompletion = require(script.Parent.Adapters.OpenAICompletionAdapter)
local OpenAIResponses = require(script.Parent.Adapters.OpenAIResponsesAdapter)
local OpenRouter = require(script.Parent.Adapters.OpenRouterAdapter)
local Anthropic = require(script.Parent.Adapters.AnthropicAdapter)

local ADAPTERS = {
	openai_chat = OpenAICompatible,
	openai_text_completions = OpenAICompletion,
	openai_responses = OpenAIResponses,
	openrouter = OpenRouter,
	anthropic_messages = Anthropic,
	gemini_native = Gemini,
	gemini_openai = GeminiOpenAI,
	openai_compatible = OpenAICompatible,
	custom_rest = CustomJSON,
}

function ProviderService.getAdapter(protocolId: string): any
	return ADAPTERS[protocolId] or OpenAICompatible
end

function ProviderService.supportedProtocols(): { string }
	local list = {}
	for protocolId in pairs(ADAPTERS) do
		list[#list + 1] = protocolId
	end
	table.sort(list)
	return list
end

--=============================================================================
-- REQUEST ASSEMBLY
--=============================================================================

export type PreparedRequest = {
	url: string,
	headers: { [string]: string },
	body: string,
	jsonBody: any,
	streaming: boolean,
}

--- Builds a fully-formed request or returns nil plus an actionable message.
function ProviderService.prepare(profile: any, spec: any, apiKey: string?, forceStreaming: boolean?): (PreparedRequest?, string?)
	local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)

	local streaming = false
	if profile.streaming and (forceStreaming ~= false) and protocol.supportsStreaming then
		-- A caller may force a single non-streaming request (capability probes,
		-- connection tests, and the streaming fallback). Without this the
		-- fallback would re-enter stream() for ever.
		if spec.streaming ~= false and UniversalHTTPClient.supportsStreaming() then
			streaming = true
		end
	end

	local adapter = ProviderService.getAdapter(profile.protocol)
    local requestSpec = spec
    if profile.viaRouter and profile.routerAlias then
        requestSpec = table.clone(spec)
        local prefix = profile.routerAlias .. "/"
        if string.sub(spec.model or "", 1, #prefix) ~= prefix then requestSpec.model = prefix .. (spec.model or "") end
    end
	local built, buildError = adapter.buildRequest(profile, requestSpec, streaming)
	if not built then
		return nil, tostring(buildError)
	end

	-- Protocol-level auth first, so a profile that did not set a style still gets
	-- the credential header its protocol requires (Gemini native, Anthropic).
	local authStyle = profile.authStyle
	if authStyle == nil or authStyle == "" then
		authStyle = protocol.authStyle
	end

	local authHeaders, authQuery = UniversalProviderRegistry.buildAuthHeaders({
		style = authStyle,
		headerName = profile.authHeaderName or protocol.authHeaderName,
		headerPrefix = profile.authHeaderPrefix or protocol.authHeaderPrefix,
		queryParam = profile.authQueryParam or protocol.authQueryParam,
	}, apiKey)

	local headers: { [string]: string } = { ["Content-Type"] = "application/json" }
	for key, value in authHeaders do
		headers[key] = value
	end
	for key, value in (protocol.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		if type(key) == "string" and type(value) == "string" and #value > 0 then
			headers[key] = value
		end
	end

	local url = built.url
	if authQuery then
		url ..= (if string.find(url, "?", 1, true) then "&" else "?") .. authQuery
	end

	-- Warn before a credential is sent to an unfamiliar host.
	if apiKey and #apiKey > 0 and not UniversalProviderRegistry.isTrustedHost(url) then
		local host = require(script.Parent.BaseURLResolver).hostOf(url) or "unknown host"
		Logger.warn("AI Provider", "API key is being sent to an unrecognised host.", {
			detail = string.format("Host: %s. Confirm you trust this provider before continuing.", host),
		})
	end

	return {
		url = url,
		headers = headers,
		body = built.body,
		jsonBody = built.jsonBody,
		streaming = streaming,
	}, nil
end

--=============================================================================
-- RESPONSE PARSING
--=============================================================================

--- Parses a provider body using the adapter for a profile.
function ProviderService.parseAdapterResponse(profile: any, body: string): (any?, string?)
	local adapter = ProviderService.getAdapter(profile.protocol)
	-- The custom REST adapter needs the profile's schema mapping.
	if profile.protocol == "custom_rest" then
		return adapter.parseResponse(body, profile)
	end
	return adapter.parseResponse(body)
end

--=============================================================================
-- RETRY CONFIGURATION
--=============================================================================

function ProviderService.getRetryConfig(profile: any?): RetryDelayCalculator.Config
	local settings = SettingsManager.getValue("smartRetry")
	if type(settings) ~= "table" then
		settings = {}
	end
	return RetryDelayCalculator.fromSettings(settings, profile and profile.id)
end

--=============================================================================
-- SINGLE ATTEMPT
--=============================================================================

export type AttemptOutcome = {
	ok: boolean,
	body: string?,
	statusCode: number?,
	headers: { [string]: string }?,
	transportError: string?,
	streamInterrupted: boolean?,
	durationMs: number,
	requestId: string?,
}

--- Performs exactly one HTTP request. Never retries.
function ProviderService.attempt(profile: any, spec: any, apiKey: string?, shouldCancel: (() -> boolean)?): AttemptOutcome
	local prepared, prepareError = ProviderService.prepare(profile, spec, apiKey, false)
	if not prepared then
		return {
			ok = false,
			body = nil,
			statusCode = nil,
			headers = nil,
			transportError = Redact.scrubText(prepareError or "Could not build the request."),
			durationMs = 0,
			requestId = nil,
		}
	end

	ProviderRateLimitScheduler.recordRequest(profile.id, profile.modelId, endpointKey(profile))

	local response = UniversalHTTPClient.postJson(prepared.url, prepared.headers, prepared.jsonBody, {
		timeoutMs = profile.timeoutMs,
		label = profile.displayName,
		shouldCancel = shouldCancel,
	})

	-- A 200 body that is really an error object is a failure.
	if response.ok then
		if UniversalErrorDetector.bodyIsError(response.body) then
			response.ok = false
		end
	end

	return {
		ok = response.ok,
		body = response.body,
		statusCode = response.statusCode,
		headers = response.headers,
		transportError = response.transportError,
		streamInterrupted = false,
		durationMs = response.durationMs,
		requestId = response.requestId,
	}
end

--=============================================================================
-- COMPLETE (WITH RETRY)
--=============================================================================

export type CompleteResult = {
	ok: boolean,
	response: any?,
	error: ProviderErrorNormalizer.Normalised?,
	attempts: number,
	durationMs: number,
	operationId: string?,
}

--- Runs a request to completion, retrying through the single retry controller.
function ProviderService.complete(
	profile: any,
	spec: any,
	apiKey: string?,
	callbacks: {
		operationId: string?,
		taskId: string?,
		onWait: ((waitSeconds: number, decision: RetryDelayCalculator.Decision, attempt: number) -> ())?,
		onAttempt: ((attempt: number, decision: RetryDelayCalculator.Decision?) -> ())?,
		shouldCancel: (() -> boolean)?,
	}?
): CompleteResult
	local opts = callbacks or {}
	local config = ProviderService.getRetryConfig(profile)

	local operation = SmartAutoRetryManager.run({
		operationId = opts.operationId,
		taskId = opts.taskId,
		providerId = profile.id,
		providerName = profile.displayName or profile.providerName or "Provider",
		model = profile.modelId or "(not set)",
		endpoint = endpointKey(profile),
		config = config,
		onWait = opts.onWait,
		onAttempt = opts.onAttempt,
		shouldCancel = opts.shouldCancel,
		request = function()
			local outcome = ProviderService.attempt(profile, spec, apiKey, opts.shouldCancel)
			if outcome.ok then
				return outcome, nil
			end
			return nil, {
				statusCode = outcome.statusCode,
				body = outcome.body,
				headers = outcome.headers,
				transportError = outcome.transportError,
				streamInterrupted = outcome.streamInterrupted,
			}
		end,
	})

	if not operation.ok then
		return {
			ok = false,
			response = nil,
			error = operation.error,
			attempts = operation.attemptsMade,
			durationMs = operation.totalElapsedSeconds * 1000,
			operationId = operation.operationId,
		}
	end

	local raw = operation.value
	local body = if type(raw) == "table" and raw.body ~= nil then raw.body else nil
	if type(body) ~= "string" then
		return {
			ok = false,
			response = nil,
			error = ProviderErrorNormalizer.normalise({
				provider = profile.displayName,
				model = profile.modelId,
				endpoint = profile.baseUrl,
				transportError = "The provider returned no body.",
				elapsedMs = operation.totalElapsedSeconds * 1000,
			}),
			attempts = operation.attemptsMade,
			durationMs = operation.totalElapsedSeconds * 1000,
			operationId = operation.operationId,
		}
	end

	local parsed, parseError = ProviderService.parseAdapterResponse(profile, body)
	if not parsed then
		Logger.error("AI Provider", "Could not parse the provider response.", {
			detail = tostring(parseError),
		})
		return {
			ok = false,
			response = nil,
			error = ProviderErrorNormalizer.normalise({
				provider = profile.displayName,
				model = profile.modelId,
				endpoint = profile.baseUrl,
				statusCode = tonumber(type(raw) == "table" and raw.statusCode or nil),
				body = body,
				transportError = tostring(parseError),
				elapsedMs = operation.totalElapsedSeconds * 1000,
			}),
			attempts = operation.attemptsMade,
			durationMs = operation.totalElapsedSeconds * 1000,
			operationId = operation.operationId,
		}
	end

	local usage = parsed.usage
	if usage and usage.source == "provider" then
		ContextManager.recordRequest(usage, operation.totalElapsedSeconds * 1000, nil)
	end

	return {
		ok = true,
		response = parsed,
		error = nil,
		attempts = operation.attemptsMade,
		durationMs = operation.totalElapsedSeconds * 1000,
		operationId = operation.operationId,
	}
end

--=============================================================================
-- CONNECTION TEST
--=============================================================================

export type ConnectionResult = {
	ok: boolean,
	statusCode: number?,
	message: string,
	latencyMs: number,
	usage: any?,
	model: string?,
	endpoint: string,
	streamingAvailable: boolean,
	category: string?,
	remedy: string?,
	preview: CustomProviderManager.Preview?,
}

--- Sends a minimal real request so the test exercises the whole path.
function ProviderService.testConnection(
	profile: any,
	apiKey: string?,
	options: { onProgress: ((note: string) -> ())?, maxProbes: number?, shouldCancel: (() -> boolean)? }?
): ConnectionResult
	local opts = options or {}
	local started = os.clock()
	local preview = CustomProviderManager.preview(profile)

	local function failure(message: string, category: string?, statusCode: number?): ConnectionResult
		return {
			ok = false,
			statusCode = statusCode,
			message = message,
			latencyMs = (os.clock() - started) * 1000,
			usage = nil,
			model = profile.modelId,
			endpoint = preview.display,
			streamingAvailable = UniversalHTTPClient.supportsStreaming(),
			category = category,
			remedy = ProviderErrorNormalizer.remedy(category or "UNKNOWN_ERROR"),
			preview = preview,
		}
	end

	if type(profile.baseUrl) ~= "string" or #StringUtil.trim(profile.baseUrl) == 0 then
		return failure("Set an API Base URL before testing.", "INVALID_ENDPOINT")
	end
	if type(profile.modelId) ~= "string" or #StringUtil.trim(profile.modelId) == 0 then
		return failure(
			"Set a Model ID before testing. Any model your provider exposes can be entered manually.",
			"INVALID_MODEL"
		)
	end

	local validation = CustomProviderManager.validate(profile)
	if not validation.ok then
		return failure(validation.errors[1].message, "INVALID_REQUEST")
	end

	if opts.onProgress then
		opts.onProgress(string.format("POST %s", preview.display))
	end

	local spec = {
		messages = { { role = "user", content = "Reply with the single word: ok" } },
		system = "Reply with exactly one short word.",
		model = profile.modelId,
		maxOutputTokens = 16,
		streaming = false,
		jsonMode = false,
		toolChoice = "none",
	}
	if profile.protocol == "openai_text_completions" then
		spec.messages = {}
		spec.system = nil
	end

	local result = ProviderService.complete(profile, spec, apiKey, {
		operationId = ("test-%d"):format(math.floor(os.clock() * 1000) % 100000),
		shouldCancel = opts.shouldCancel,
		onWait = function(seconds, decision, attempt)
			if opts.onProgress then
				opts.onProgress(
					string.format(
						"Rate limited. Retry %d in %.0fs (%s).",
						attempt,
						seconds,
						decision.source
					)
				)
			end
		end,
	})

	if not result.ok then
		local normalised = result.error
		return {
			ok = false,
			statusCode = normalised and normalised.httpStatus or nil,
			message = if normalised then normalised.message else "The connection test failed.",
			latencyMs = result.durationMs,
			usage = nil,
			model = profile.modelId,
			endpoint = preview.display,
			streamingAvailable = UniversalHTTPClient.supportsStreaming(),
			category = normalised and normalised.category or nil,
			remedy = if normalised then ProviderErrorNormalizer.remedy(normalised.category) else nil,
			preview = preview,
		}
	end

	local response = result.response
	local preview2 = string.gsub(string.sub(response.text or "", 1, 80), "%s+", " ")

	Logger.success("CONNECT", "Connection test succeeded.", {
		detail = string.format(
			"%s · %s · HTTP %s · %d attempt(s) · %.0f ms",
			profile.displayName,
			profile.modelId,
			tostring(result.response and response and response.raw and "200" or "200"),
			result.attempts,
			result.durationMs
		),
	})

	return {
		ok = true,
		statusCode = 200,
		message = string.format(
			"Connected on attempt %d. Model replied: \"%s\"%s",
			result.attempts,
			preview2,
			if result.attempts > 1
				then string.format(" (recovered after %d retries)", result.attempts - 1)
				else ""
		),
		latencyMs = result.durationMs,
		usage = response.usage,
		model = profile.modelId,
		endpoint = preview.display,
		streamingAvailable = UniversalHTTPClient.supportsStreaming(),
		category = nil,
		remedy = nil,
		preview = preview,
	}
end

--=============================================================================
-- MODEL LIST
--=============================================================================

--- Refreshes the model list where the provider exposes a real endpoint.
function ProviderService.listModels(profile: any, apiKey: string?, shouldCancel: (() -> boolean)?): ({ string }?, string?)
    if profile.viaRouter and BridgeClient.isConnected() then return BridgeClient.listModels(profile, apiKey, shouldCancel) end
	local url, urlError = UniversalProviderRegistry.modelListUrl(profile)
	if not url then
		return nil, urlError
	end

	local protocol = UniversalProviderRegistry.getProtocol(profile.protocol)
	local headers: { [string]: string } = {}
	local authHeaders, authQuery = UniversalProviderRegistry.buildAuthHeaders({
		style = profile.authStyle or protocol.authStyle,
		headerName = profile.authHeaderName or protocol.authHeaderName,
		queryParam = profile.authQueryParam or protocol.authQueryParam,
	}, apiKey)
	for key, value in authHeaders do
		headers[key] = value
	end
	for key, value in (profile.defaultHeaders or {}) do
		headers[key] = value
	end
	for key, value in (profile.extraHeaders or {}) do
		headers[key] = value
	end
	if authQuery then
		url ..= (if string.find(url, "?", 1, true) then "&" else "?") .. authQuery
	end

	local response = UniversalHTTPClient.get(url, headers, {
		timeoutMs = profile.timeoutMs,
		label = "models",
		shouldCancel = shouldCancel,
	})

	if not response.ok then
		local normalised = ProviderErrorNormalizer.normalise({
			provider = profile.displayName,
			model = profile.modelId,
			endpoint = url,
			statusCode = response.statusCode,
			body = response.body,
			headers = response.headers,
			transportError = response.transportError,
			elapsedMs = response.durationMs,
		})
		return nil, normalised.message
	end

	local decoded = require(script.Parent.Parent.Utilities.JSONValidator).decode(response.body)
	if type(decoded) ~= "table" then
		return nil, "The /models response was not a JSON object."
	end

	local list = decoded.data or decoded.models
	if type(list) ~= "table" then
		return nil, "The /models response did not contain a model array."
	end

	local ids: { string } = {}
	for _, entry in list do
		if type(entry) == "string" then
			ids[#ids + 1] = entry
		elseif type(entry) == "table" and type(entry.id) == "string" then
			ids[#ids + 1] = entry.id
		elseif type(entry) == "table" and type(entry.name) == "string" then
			-- Gemini returns "models/gemini-2.0-flash".
			ids[#ids + 1] = (string.gsub(entry.name, "^models/", ""))
		end
	end
    if profile.viaRouter and profile.routerAlias then
        local prefix = profile.routerAlias .. "/"
        local filtered = {}
        for _, id in ids do if string.sub(id, 1, #prefix) == prefix then filtered[#filtered + 1] = id end end
        ids = filtered
    end
	table.sort(ids)
	return ids, nil
end

--=============================================================================
-- STREAMING WITH RETRY
--=============================================================================

export type StreamCallbacks = {
	onActivity: (() -> ())?,
	onText: ((delta: string) -> ())?,
	onReasoning: ((delta: string) -> ())?,
	onDone: ((result: {
		text: string,
		reasoning: string?,
		toolCalls: { any },
		usage: any,
		durationMs: number,
		attempts: number,
	}) -> ())?,
	onError: ((normalised: ProviderErrorNormalizer.Normalised, attempts: number) -> ())?,
	onWait: ((waitSeconds: number, decision: RetryDelayCalculator.Decision, attempt: number) -> ())?,
	onAttempt: ((attempt: number) -> ())?,
	shouldCancel: (() -> boolean)?,
	operationId: string?,
	taskId: string?,
}

--- Runs a streaming request. Non-streaming endpoints fall back transparently.
function ProviderService.stream(profile: any, spec: any, apiKey: string?, callbacks: StreamCallbacks)
	local prepared = ProviderService.prepare(profile, spec, apiKey, nil)
	if not prepared then
		if callbacks.onError then
			callbacks.onError(
				ProviderErrorNormalizer.normalise({
					provider = profile.displayName,
					model = profile.modelId,
					endpoint = profile.baseUrl,
					transportError = "Could not build the request.",
					elapsedMs = 0,
				}),
				0
			)
		end
		return
	end

	if not prepared.streaming then
		-- Honest fallback: one non-streaming request, reported as such.
		Logger.info("Streaming", "Streaming unavailable; using a single response.", {
			detail = UniversalProviderRegistry.getProtocol(profile.protocol).label,
		})
		local result = ProviderService.complete(profile, spec, apiKey, {
			operationId = callbacks.operationId,
			taskId = callbacks.taskId,
			onWait = callbacks.onWait,
			onAttempt = callbacks.onAttempt,
			shouldCancel = callbacks.shouldCancel,
		})
		if result.ok and result.response and callbacks.onDone then
			if callbacks.onText and (result.response.text or "") ~= "" then
				callbacks.onText(result.response.text)
			end
			callbacks.onDone({
				text = result.response.text or "",
				reasoning = result.response.reasoning,
				toolCalls = result.response.toolCalls or {},
				usage = result.response.usage,
				durationMs = result.durationMs,
				attempts = result.attempts,
				stopReason = result.response.stopReason,
			})
		elseif not result.ok and callbacks.onError then
			callbacks.onError(result.error, result.attempts)
		end
		return
	end

	local adapter = ProviderService.getAdapter(profile.protocol)
	local streamState = adapter.newStreamState()
	local accumulated: { string } = {}
	local accumulatedReasoning: { string } = {}
	local streamError: string? = nil
	local cancelled = false
	local providerDone = false
	local lastActivity = os.clock()
	local function activity()
		lastActivity = os.clock()
		if callbacks.onActivity then callbacks.onActivity() end
	end

	ProviderRateLimitScheduler.recordRequest(profile.id, profile.modelId, endpointKey(profile))

	local handle, openError = UniversalHTTPClient.stream({
		url = prepared.url,
		headers = prepared.headers,
		body = prepared.body,
		timeoutMs = profile.timeoutMs,
		label = profile.displayName,
	}, {
		onActivity = activity,
		onChunk = function(chunk)
			if cancelled then
				return
			end
			activity()
			for _, event in adapter.parseStreamChunk(streamState, chunk) do
				if event.kind == "text" and event.text then
					accumulated[#accumulated + 1] = event.text
					if callbacks.onText then
						callbacks.onText(event.text)
					end
				elseif event.kind == "reasoning" and event.reasoning then
					accumulatedReasoning[#accumulatedReasoning + 1] = event.reasoning
					if callbacks.onReasoning then
						callbacks.onReasoning(event.reasoning)
					end
				elseif event.kind == "done" then
                    providerDone = true
				elseif event.kind == "error" and event.message then
					streamError = event.message
				end
			end
		end,
		onError = function(message)
			streamError = message
		end,
		onComplete = function() end,
	})

	if not handle then
        if openError and (string.find(string.lower(openError), "timed out", 1, true) or string.find(string.lower(openError), "cancel", 1, true)) then
            if callbacks.onError then callbacks.onError(ProviderErrorNormalizer.normalise({ provider = profile.displayName, model = profile.modelId, endpoint = profile.baseUrl, transportError = openError, elapsedMs = 0 }), 1) end
            return
        end
		-- Streaming could not be opened. Fall back to a single response rather than
		-- failing outright. Nothing is duplicated: the stream never started.
		local fallbackSpec = table.clone(spec)
		fallbackSpec.streaming = false
		ProviderService.stream(profile, fallbackSpec, apiKey, callbacks)
		return
	end

	local started = os.clock()
    local idleSeconds = math.clamp((profile.timeoutMs or 120000) / 1000, 1, 600)
	while not handle.isDone() and not providerDone and not streamError do
		if callbacks.shouldCancel and callbacks.shouldCancel() then
			cancelled = true
			handle.cancel()
			break
		end
        if os.clock() - lastActivity >= idleSeconds then
            streamError = "Provider stream timed out: no upstream data within the configured idle timeout. The connection was closed; try again."
            handle.cancel()
            break
        end
		task.wait()
	end
	if (providerDone or streamError) and not handle.isDone() then handle.cancel() end
	local stopReason = streamState.finishReason or streamState.stopReason or streamState.status
	if not cancelled and not streamError and not providerDone and not stopReason and profile.protocol ~= "custom_rest" then
		streamError = "The provider connection closed before a completion marker. The partial answer was preserved; retry to continue."
	end

	if cancelled then
		if callbacks.onError then
			callbacks.onError(
				ProviderErrorNormalizer.normalise({
					provider = profile.displayName,
					model = profile.modelId,
					endpoint = profile.baseUrl,
					transportError = "Cancelled.",
					elapsedMs = (os.clock() - started) * 1000,
				}),
				1
			)
		end
		return
	end

	if streamError then
		-- Stream-aware recovery: retry the WHOLE request rather than appending to
		-- a partial body, which would duplicate output.
		local normalised = ProviderErrorNormalizer.normalise({
			provider = profile.displayName,
			model = profile.modelId,
			endpoint = profile.baseUrl,
			transportError = streamError,
			streamInterrupted = #accumulated > 0,
			elapsedMs = (os.clock() - started) * 1000,
		})
		Logger.warn("Streaming", "Stream interrupted; the request was stopped.", {
			detail = string.format("%s received %d character(s) before the interruption.", profile.displayName, #accumulated),
		})
		if callbacks.onError then
			callbacks.onError(normalised, 1)
		end
		return
	end

	if callbacks.onDone then
		callbacks.onDone({
			text = table.concat(accumulated),
			reasoning = if #accumulatedReasoning > 0 then table.concat(accumulatedReasoning) else nil,
			toolCalls = adapter.finalizeStream(streamState),
			usage = adapter.streamStateUsage(streamState),
			durationMs = (os.clock() - started) * 1000,
			attempts = 1,
			stopReason = stopReason,
		})
	end
end

return ProviderService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">QuestionManager</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / AI / QuestionManager
	Interactive questions inside the chat.

	The model can pause a task and ask the user for input. Questions are rendered
	as functional cards. Answering resumes the SAME task from its existing state;
	the conversation is never restarted.

	"L et AI Decide" is resolved by a real follow-up provider call that sees the
	game context and the user's original request, so the decision is grounded
	rather than hard-coded.
]]

local EventBus = require(script.Parent.Parent.Core.EventBus)
local Logger = require(script.Parent.Parent.Utilities.Logger)
local StateManager = require(script.Parent.Parent.Core.StateManager)
local SettingsManager = require(script.Parent.Parent.Core.SettingsManager)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local Time = require(script.Parent.Parent.Utilities.Time)

local QuestionManager = {}

export type QuestionKind = "single" | "multiple" | "text" | "number" | "boolean" | "confirm"

export type Option = {
	id: string,
	label: string,
	description: string?,
}

export type Question = {
	id: string,
	taskId: string,
	kind: QuestionKind,
	prompt: string,
	detail: string?,
	options: { Option }?,
	allowCustom: boolean,
	allowAiDecide: boolean,
	placeholder: string?,
	required: boolean,
	createdAt: number,
	answered: boolean,
	answer: any?,
	answeredAt: number?,
	-- Optional task the model wanted answered, used to build the resume prompt.
	context: string?,
}

local pending: Question? = nil
local resolver: ((answer: any) -> ())? = nil
local rejecter: ((reason: string) -> ())? = nil

--=============================================================================
-- CONSTRUCTION
--=============================================================================

local function normaliseKind(kind: any, hasOptions: boolean): QuestionKind
	if kind == "single" or kind == "multiple" or kind == "text" or kind == "number" or kind == "boolean" or kind == "confirm" then
		return kind
	end
	if hasOptions then
		return "single"
	end
	return "text"
end

--- Asks a question and returns the user's answer.
--- Yields until answered, cancelled, or the question times out.
function QuestionManager.ask(spec: {
	taskId: string,
	kind: any?,
	prompt: string,
	detail: string?,
	options: { any }?,
	allowCustom: boolean?,
	allowAiDecide: boolean?,
	placeholder: string?,
	required: boolean?,
	context: string?,
	timeoutSeconds: number?,
}): any
	local settings = SettingsManager.get()

	local options: { Option } = {}
	for index, raw in (spec.options or {}) do
		if type(raw) == "string" then
			options[#options + 1] = { id = raw, label = raw }
		elseif type(raw) == "table" and type(raw.label) == "string" then
			options[#options + 1] = {
				id = type(raw.id) == "string" and raw.id or raw.label,
				label = raw.label,
				description = if type(raw.description) == "string" then raw.description else nil,
			}
		end
		-- Unrecognised option shapes are dropped rather than passed through.
		_ = index
	end

	local question: Question = {
		id = Time.newId("q"),
		taskId = spec.taskId,
		kind = normaliseKind(spec.kind, #options > 0),
		prompt = string.sub(spec.prompt or "Input required", 1, 500),
		detail = if type(spec.detail) == "string" then string.sub(spec.detail, 1, 1000) else nil,
		options = if #options > 0 then options else nil,
		allowCustom = spec.allowCustom ~= false,
		allowAiDecide = spec.allowAiDecide ~= false and settings.letAiDecide,
		placeholder = spec.placeholder or "Type your answer",
		required = spec.required ~= false,
		createdAt = os.clock(),
		answered = false,
		context = spec.context,
	}

	pending = question
	Logger.log("QUESTION", "Question", "Waiting for user response.", {
		detail = question.prompt,
		taskId = question.taskId,
	})

	local timeout = spec.timeoutSeconds or 1800
	local started = os.clock()

	local finished = false
	local answerValue: any = nil
	local failure: string? = nil

	resolver = function(value)
		answerValue = value
		finished = true
	end
	rejecter = function(reason)
		failure = reason
		finished = true
	end

	EventBus.emit(EventBus.Events.QuestionAsked, { question = table.clone(question) })

	while not finished do
		if StateManager.get() == "CANCELLED" then failure = "Task cancelled."; break end
		if os.clock() - started > timeout then
			failure = string.format("The question timed out after %d seconds.", math.floor(timeout))
			break
		end
		task.wait(0.2)
	end

	local questionId = question.id
	pending = nil
	resolver = nil
	rejecter = nil

	if failure then
		Logger.warn("Question", "The question was not answered.", {
			detail = failure,
			taskId = question.taskId,
		})
		EventBus.emit(EventBus.Events.QuestionCancelled, { questionId = questionId, reason = failure })
		return nil
	end

	return answerValue
end

--=============================================================================
-- UI BRIDGE
--=============================================================================

--- Called by the question card when the user submits.
function QuestionManager.submit(value: any)
	local question = pending
	if not question then
		return
	end

	local cleaned = QuestionManager.validate(question, value)
	if cleaned == nil then
		EventBus.emit(EventBus.Events.Toast, {
			kind = "error",
			message = "That answer is not valid for this question.",
		})
		return
	end

	question.answered = true
	question.answer = cleaned
	question.answeredAt = os.clock()

	Logger.success("Question", "Question answered.", {
		detail = string.format("%s → %s", question.prompt, QuestionManager.formatAnswer(cleaned)),
		taskId = question.taskId,
	})

	EventBus.emit(EventBus.Events.QuestionAnswered, {
		questionId = question.id,
		answer = cleaned,
	})

	local callback = resolver
	if callback then
		callback(cleaned)
	end
end

--- Called when the user cancels the question.
function QuestionManager.cancel(reason: string?)
	local question = pending
	if not question then
		return
	end
	question.answered = true
	question.answer = nil

	Logger.warn("Question", "Question cancelled.", {
		detail = reason or "The user cancelled the question.",
		taskId = question.taskId,
	})
	EventBus.emit(EventBus.Events.QuestionCancelled, {
		questionId = question.id,
		reason = reason or "cancelled",
	})

	local callback = rejecter
	if callback then
		callback(reason or "The user cancelled the question.")
	end
end

--- "Let AI Decide" — asks the model to choose using its own judgement.
function QuestionManager.letAiDecide(): boolean
	local question = pending
	if not question then
		return false
	end
	if not question.allowAiDecide then
		EventBus.emit(EventBus.Events.Toast, {
			kind = "warning",
			message = "\"Let AI Decide\" is disabled in Agent settings.",
		})
		return false
	end

	Logger.info("Question", "Delegating the decision to the AI.", { taskId = question.taskId })
	question.answered = true
	question.answer = { __aiDecide = true }
	EventBus.emit(EventBus.Events.QuestionAnswered, {
		questionId = question.id,
		answer = { __aiDecide = true },
	})

	-- The waiter in ask() is released by `resolver`; without this the agent would
	-- spin until the question timeout (30 minutes by default).
	local callback = resolver
	if callback then
		callback({ __aiDecide = true })
	end
	return true
end

function QuestionManager.getPending(): Question?
	return pending
end

--=============================================================================
-- VALIDATION
--=============================================================================

--- Returns a cleaned answer, or nil when the value does not satisfy the question.
function QuestionManager.validate(question: Question, value: any): any
	if question.kind == "text" then
		if type(value) ~= "string" then
			return nil
		end
		local trimmed = StringUtil.trim(value)
		if question.required and #trimmed == 0 then
			return nil
		end
		return trimmed
	end

	if question.kind == "number" then
		local numberValue = tonumber(value)
		if numberValue == nil then
			return nil
		end
		return numberValue
	end

	if question.kind == "boolean" or question.kind == "confirm" then
		if type(value) == "boolean" then
			return value
		end
		return nil
	end

	if question.kind == "single" then
		if type(value) ~= "string" then
			return nil
		end
		if value == "__custom__" then
			return { __custom = true }
		end
		for _, option in (question.options or {}) do
			if option.id == value then
				return option.label
			end
		end
		return nil
	end

	if question.kind == "multiple" then
		if type(value) ~= "table" then
			return nil
		end
		local valid = {}
		local allowed: { [string]: boolean } = {}
		for _, option in (question.options or {}) do
			allowed[option.id] = true
		end
		for _, entry in value do
			if type(entry) ~= "string" or not allowed[entry] then
				return nil
			end
			valid[#valid + 1] = entry
		end
		if question.required and #valid == 0 then
			return nil
		end
		return valid
	end

	return nil
end

function QuestionManager.formatAnswer(answer: any): string
	if type(answer) == "boolean" then
		return answer and "Yes" or "No"
	elseif type(answer) == "string" then
		return answer
	elseif type(answer) == "table" then
		if answer.__aiDecide then
			return "(AI decides)"
		end
		if answer.__custom then
			return "(custom answer)"
		end
		local parts = {}
		for _, entry in answer do
			parts[#parts + 1] = tostring(entry)
		end
		return table.concat(parts, ", ")
	end
	return tostring(answer)
end

--=============================================================================
-- RESUME PROMPT
--=============================================================================

--- Builds the message appended to the conversation after an answer arrives, so
--- the model can continue the SAME task rather than start over.
function QuestionManager.resumePrompt(question: Question, answer: any): string
	local parts = { "The user answered your question." }
	parts[#parts + 1] = string.format('Question: "%s"', question.prompt)
	parts[#parts + 1] = string.format("Answer: %s", QuestionManager.formatAnswer(answer))
	if question.context and #question.context > 0 then
		parts[#parts + 1] = string.format("That was needed for: %s", question.context)
	end
	parts[#parts + 1] = "Continue the task from where you stopped. Do not repeat the analysis you already did."
	return table.concat(parts, "\n")
end

return QuestionManager
]]></string>
