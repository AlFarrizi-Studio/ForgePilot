      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">GUIBuilder</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / GUIBuilder
	Creates real ScreenGui hierarchies with proper UDim2 layout.

	The builder only constructs elements the tool schema allowed, so a model
	cannot smuggle in an arbitrary class name.
]]

local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

local GUIBuilder = {}

local ALLOWED_CLASSES: { [string]: boolean } = {
	Frame = true,
	TextLabel = true,
	TextButton = true,
	ImageLabel = true,
	ScrollingFrame = true,
}

local DEFAULT_COLORS = {
	Frame = Color3.fromHex("#211D28"),
	TextLabel = Color3.fromHex("#F4F1F8"),
	TextButton = Color3.fromHex("#9879E8"),
	ImageLabel = Color3.fromHex("#2C2331"),
	ScrollingFrame = Color3.fromHex("#211D28"),
}

local function resolveColor(value: any, fallback: Color3): Color3
	if type(value) == "string" then
		local hex = string.gsub(StringUtil.trim(value), "^#", "")
		if string.match(hex, "^%x%x%x%x%x%x$") then
			return Color3.fromHex(hex)
		end
		return fallback
	elseif type(value) == "table" then
		local r = value.r or value.R
		local g = value.g or value.G
		local b = value.b or value.B
		if r and g and b then
			return Color3.new(math.clamp(tonumber(r) or 0, 0, 1), math.clamp(tonumber(g) or 0, 0, 1), math.clamp(tonumber(b) or 0, 0, 1))
		end
	end
	return fallback
end

local function toSize(value: any, fallback: UDim2): UDim2
	if type(value) == "table" then
		local x = tonumber(value.x or value.X or value[1])
		local y = tonumber(value.y or value.Y or value[2])
		if x and y then
			return UDim2.fromOffset(math.max(1, math.round(x)), math.max(1, math.round(y)))
		end
	elseif type(value) == "string" then
		local x, y = string.match(value, "^(%-?%d+)%s*,%s*(%-?%d+)$")
		if x then
			return UDim2.fromOffset(math.max(1, tonumber(x)), math.max(1, tonumber(y)))
		end
	end
	return fallback
end

local function toPosition(value: any, fallback: UDim2): UDim2
	if type(value) == "table" then
		local x = tonumber(value.x or value.X or value[1])
		local y = tonumber(value.y or value.Y or value[2])
		if x and y then
			return UDim2.fromOffset(math.round(x), math.round(y))
		end
	end
	return fallback
end

--- Builds one GUI element from a plain description.
function GUIBuilder.buildElement(description: any, parent: Instance, layoutOrder: number): (Instance?, string?)
	if type(description) ~= "table" then
		return nil, "Each element must be an object."
	end
	local className = description.className
	if type(className) ~= "string" or not ALLOWED_CLASSES[className] then
		return nil,
			string.format(
				"`%s` is not an allowed GUI class. ForgePilot can create Frame, TextLabel, TextButton, ImageLabel and ScrollingFrame.",
				tostring(className)
			)
	end

	local instance = Instance.new(className)
	instance.Name = type(description.name) == "string" and string.sub(description.name, 1, 80) or className
	instance.LayoutOrder = layoutOrder

	if className == "Frame" or className == "ScrollingFrame" then
		instance.Size = toSize(description.size, UDim2.fromOffset(320, 200))
		instance.Position = toPosition(description.position, UDim2.fromOffset(0, 0))
		instance.BackgroundColor3 = resolveColor(description.color, DEFAULT_COLORS[className])
		instance.BackgroundTransparency = tonumber(description.transparency) or 0
		instance.BorderSizePixel = 0
	elseif className == "TextLabel" or className == "TextButton" then
		instance.Size = toSize(description.size, UDim2.fromOffset(280, 36))
		instance.Position = toPosition(description.position, UDim2.fromOffset(0, 0))
		instance.BackgroundTransparency = if className == "TextLabel" and not description.background then 1 else 0
		instance.BackgroundColor3 = resolveColor(description.color, DEFAULT_COLORS[className])
		instance.Text = type(description.text) == "string" and string.sub(description.text, 1, 500) or "Text"
		instance.TextColor3 = resolveColor(description.textColor, Color3.fromHex("#F4F1F8"))
		instance.TextSize = tonumber(description.textSize) or 16
		instance.Font = Enum.Font.Gotham
		instance.TextXAlignment = Enum.TextXAlignment.Left
		instance.BorderSizePixel = 0
		instance.Active = if className == "TextButton" then true else false
	elseif className == "ImageLabel" then
		instance.Size = toSize(description.size, UDim2.fromOffset(64, 64))
		instance.Position = toPosition(description.position, UDim2.fromOffset(0, 0))
		instance.BackgroundTransparency = 1
		instance.ImageColor3 = resolveColor(description.color, DEFAULT_COLORS.ImageLabel)
		instance.ImageTransparency = tonumber(description.transparency) or 0
		instance.ScaleType = Enum.ScaleType.Fit
	end

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = instance

	instance.Parent = parent

	-- Children
	if type(description.children) == "table" then
		for index, child in description.children do
			if index &gt; 50 then
				break
			end
			local built, childError = GUIBuilder.buildElement(child, instance, index)
			if not built then
				return instance, string.format("Child %d could not be built: %s", index, tostring(childError))
			end
		end
	end

	return instance, nil
end

--- Builds a ScreenGui with its declared children.
function GUIBuilder.build(args: any): (Instance?, string?)
	local gui = Instance.new("ScreenGui")
	gui.Name = args.name
	gui.Enabled = args.enabled == true
	gui.ResetOnSpawn = args.resetOnSpawn == true
	gui.IgnoreGuiInset = args.ignoreGuiInset == true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui:SetAttribute("ForgePilotOrigin", "create_ui")

	local elements = args.elements
	if type(elements) ~= "table" or #elements == 0 then
		local root = Instance.new("Frame")
		root.Name = "Root"
		root.Size = UDim2.new(0, 360, 0, 240)
		root.Position = UDim2.fromOffset(40, 40)
		root.BackgroundColor3 = DEFAULT_COLORS.Frame
		root.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = root
		root.Parent = gui
		return gui, "Created an empty ScreenGui with a Root frame."
	end

	if #elements &gt; 60 then
		return nil, string.format("A single call may create at most 60 elements (received %d).", #elements)
	end

	local warnings: { string } = {}
	for index, description in elements do
		local built, elementError = GUIBuilder.buildElement(description, gui, index)
		if not built then
			return nil, string.format("Element %d: %s", index, tostring(elementError))
		end
		if elementError then
			warnings[#warnings + 1] = elementError
		end
	end

	local detail = string.format("Created %d top-level element(s).", #elements)
	if #warnings &gt; 0 then
		detail ..= " Warnings: " .. table.concat(warnings, "; ")
	end
	return gui, detail
end

return GUIBuilder</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">HistoryManager</string>
          <string name="Source">--!strict
local ChangeHistoryService = game:GetService("ChangeHistoryService")
--[[
	ForgePilot / Roblox / HistoryManager
	ChangeHistoryService wrapper so every ForgePilot edit is undoable as one step.
]]

local Logger = require(script.Parent.Parent.Utilities.Logger)
local EventBus = require(script.Parent.Parent.Core.EventBus)

local HistoryManager = {}

local recordingId: number? = nil
local recordingLabel: string? = nil
local operationCount = 0

--- True while a ForgePilot recording is open.
function HistoryManager.isRecording(): boolean
	return recordingId ~= nil
end

function HistoryManager.getRecordingLabel(): string?
	return recordingLabel
end

function HistoryManager.begin(label: string): boolean
	if recordingId ~= nil then
		return false
	end
	local ok, id = pcall(function()
		return ChangeHistoryService:TryBeginRecording(label)
	end)
	if not ok or id == nil then
		Logger.warn("Build", "Could not start a Change History recording.", { detail = tostring(id) })
		return false
	end
	recordingId = id
	recordingLabel = label
	operationCount = 0
	Logger.info("Build", "Change recording started.", { detail = label })
	return true
end

--- Sets a waypoint inside the current recording so each action is its own undo step.
function HistoryManager.waypoint(label: string)
	if recordingId == nil then
		return
	end
	local ok, err = pcall(function()
		ChangeHistoryService:SetWaypoint(recordingId, label)
	end)
	if ok then
		operationCount += 1
	else
		Logger.warn("Build", "Could not set a change waypoint.", { detail = tostring(err) })
	end
end

function HistoryManager.finish()
	if recordingId == nil then
		return
	end
	local id = recordingId
	local label = recordingLabel or "ForgePilot changes"
	local count = operationCount
	recordingId = nil
	recordingLabel = nil
	operationCount = 0
	pcall(function()
		ChangeHistoryService:FinishRecording(id)
	end)
	Logger.success("Build", string.format("Change recording finished (%d action%s).", count, if count == 1 then "" else "s"), {
		detail = label,
	})
	EventBus.emit(EventBus.Events.BuildProgress, { phase = "recorded", count = count })
end

--- Runs `fn` inside a recording, guaranteeing the recording is closed.
function HistoryManager.transact(label: string, fn: () -&gt; ()): (boolean, string?)
	local alreadyRecording = recordingId ~= nil
	if not alreadyRecording then
		HistoryManager.begin(label)
	end

	local ok, err = pcall(fn)

	if not alreadyRecording then
		HistoryManager.finish()
	end

	if not ok then
		return false, tostring(err)
	end
	return true, nil
end

function HistoryManager.undo()
	local ok, err = pcall(function()
		ChangeHistoryService:Undo()
	end)
	if ok then
		Logger.info("Build", "Undo requested.")
		EventBus.emit(EventBus.Events.BuildProgress, { phase = "undo" })
		return true
	end
	Logger.error("Build", "Undo failed.", { detail = tostring(err) })
	return false
end

function HistoryManager.redo()
	local ok, err = pcall(function()
		ChangeHistoryService:Redo()
	end)
	if ok then
		Logger.info("Build", "Redo requested.")
		EventBus.emit(EventBus.Events.BuildProgress, { phase = "redo" })
		return true
	end
	Logger.error("Build", "Redo failed.", { detail = tostring(err) })
	return false
end

--- Guards against an orphaned recording after a plugin reload.
function HistoryManager.resetOrphan()
	if recordingId ~= nil then
		pcall(function()
			ChangeHistoryService:FinishRecording(recordingId)
		end)
		recordingId = nil
		recordingLabel = nil
	end
end

return HistoryManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">InstanceManager</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / InstanceManager
	Low-level Instance plumbing shared by the builders.

	Everything here is defensive: names are validated before they reach the
	DataModel, parents are checked for legality (no cycles), and every returned
	result states exactly what happened rather than assuming success.
]]

local Logger = require(script.Parent.Parent.Utilities.Logger)
local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)


local InstanceManager = {}

local ILLEGAL_NAMES: { [string]: boolean } = {
	[""] = true,
	[".."] = true,
	["..."] = true,
}

--=============================================================================
-- NAMES
--=============================================================================

--- True when a name is safe to assign to an Instance.
function InstanceManager.isValidName(name: any): boolean
	if type(name) ~= "string" then
		return false
	end
	local trimmed = StringUtil.trim(name)
	if #trimmed == 0 or #trimmed &gt; 120 then
		return false
	end
	if ILLEGAL_NAMES[trimmed] then
		return false
	end
	return true
end

--- Returns a safe name, or nil plus a reason.
function InstanceManager.sanitiseName(name: any, fallback: string?): (string?, string?)
	if InstanceManager.isValidName(name) then
		return StringUtil.trim((name :: string)), nil
	end
	if type(name) ~= "string" then
		return nil, "Instance name must be a string."
	end
	if #StringUtil.trim(name) == 0 then
		return nil, "Instance name cannot be empty."
	end
	return nil, "Instance name must be 1-120 characters and not \"..\" or \"...\"."
end

--=============================================================================
-- PARENTS
--=============================================================================

--- True when `child` may be parented to `parent` without creating a cycle.
function InstanceManager.canParent(child: Instance, parent: Instance): (boolean, string?)
	if child == parent then
		return false, "An instance cannot be its own parent."
	end
	if child:IsDescendantOf(parent) then
		return false, "That would create a parenting cycle."
	end
	return true, nil
end

--- Resolves a parent path, defaulting to Workspace.
function InstanceManager.resolveParent(path: any): (Instance?, string?)
	if path == nil then
		return workspace, nil
	end
	if type(path) ~= "string" or StringUtil.trim(path) == "" then
		return nil, "Parent path must be a non-empty string."
	end

	local ok, instance = pcall(function()
		local WorkspaceInspector = require(script.Parent.WorkspaceInspector)
		return WorkspaceInspector.resolve(path)
	end)
	if not ok then
		return nil, tostring(instance)
	end
	if not instance then
		return nil, string.format("No instance at `%s`.", path)
	end
	return instance, nil
end

--=============================================================================
-- CREATION
--=============================================================================

export type CreateResult = {
	ok: boolean,
	instance: Instance?,
	message: string,
}

--- Creates an instance of `className` with validated properties.
--- `properties` may include `Name`, `Parent` and any writable class property.
function InstanceManager.create(
	className: string,
	properties: { [string]: any }
): CreateResult
	if type(className) ~= "string" or #className == 0 then
		return { ok = false, instance = nil, message = "Class name is required." }
	end

	local ok, template = pcall(function()
		return Instance.new(className)
	end)
	if not ok or not template then
		return { ok = false, instance = nil, message = string.format("`%s` is not a creatable class.", className) }
	end

	local name = properties.Name
	if name ~= nil then
		local safeName, nameError = InstanceManager.sanitiseName(name)
		if not safeName then
			template:Destroy()
			return { ok = false, instance = nil, message = nameError or "Invalid name." }
		end
		template.Name = safeName
	end

	local target = template
	local parentPath = properties.Parent
	if parentPath ~= nil then
		local parent, parentError = InstanceManager.resolveParent(parentPath)
		if not parent then
			template:Destroy()
			return { ok = false, instance = nil, message = parentError or "Parent could not be resolved." }
		end
		target = parent
	end

	local applied = {}
	for key, value in properties do
		if key ~= "Name" and key ~= "Parent" then
			local setOk = pcall(function()
				(template :: any)[key] = value
			end)
			if setOk then
				applied[#applied + 1] = key
			end
		end
	end

	template.Parent = target

	local detail = if #applied &gt; 0
		then string.format("Set %s.", table.concat(applied, ", "))
		else "Created with default properties."

	Logger.info("Build", string.format("Created %s \"%s\".", className, template.Name), { detail = detail })

	return {
		ok = true,
		instance = template,
		message = string.format("Created %s \"%s\" under %s. %s", className, template.Name, target:GetFullName(), detail),
	}
end

--=============================================================================
-- WRITABLE PROPERTY ALLOWLIST
--=============================================================================
-- The agent may only set properties the plugin knows how to reason about.
-- Anything outside this list is refused rather than blindly attempted, so a
-- malformed model response cannot reach an unexpected part of the DataModel.

local WRITABLE_PROPERTIES: { [string]: { [string]: boolean } } = {
	["BasePart"] = {
		Anchored = true,
		CanCollide = true,
		CanQuery = true,
		CanTouch = true,
		Material = true,
		Color = true,
		Transparency = true,
		Reflectance = true,
		TopSurface = true,
		BottomSurface = true,
		CastShadow = true,
	},
	["Part"] = { Shape = true },
	["Model"] = { Archivable = true },
	["Folder"] = {},
	["Configuration"] = {},
	["LocalScript"] = { Enabled = true, Disabled = true },
	["Script"] = { Enabled = true, Disabled = true },
	["ModuleScript"] = {},
	["LuaSourceContainer"] = {},
	["ScreenGui"] = {
		Enabled = true,
		ResetOnSpawn = true,
		ZIndexBehavior = true,
		DisplayOrder = true,
		IgnoreGuiInset = true,
	},
	["Frame"] = {
		Visible = true,
		Size = true,
		Position = true,
		BackgroundColor3 = true,
		BackgroundTransparency = true,
		BorderSizePixel = true,
		LayoutOrder = true,
		Active = true,
	},
	["TextLabel"] = {
		Text = true,
		TextColor3 = true,
		TextSize = true,
		Font = true,
		TextXAlignment = true,
		TextYAlignment = true,
		TextWrapped = true,
		TextTransparency = true,
		RichText = true,
		Visible = true,
		Size = true,
		Position = true,
		BackgroundTransparency = true,
	},
	["TextButton"] = {
		Text = true,
		TextColor3 = true,
		TextSize = true,
		Font = true,
		TextXAlignment = true,
		TextYAlignment = true,
		TextWrapped = true,
		TextTransparency = true,
		AutoButtonColor = true,
		Active = true,
		Visible = true,
		Size = true,
		Position = true,
		BackgroundTransparency = true,
	},
	["ImageLabel"] = {
		Image = true,
		ImageColor3 = true,
		ImageTransparency = true,
		ScaleType = true,
		Visible = true,
		Size = true,
		Position = true,
	},
	["ScrollingFrame"] = {
		Visible = true,
		Size = true,
		Position = true,
		BackgroundColor3 = true,
		ScrollBarThickness = true,
		CanvasSize = true,
		AutomaticCanvasSize = true,
	},
	["LayerCollector"] = { Enabled = true, ResetOnSpawn = true },
	["GuiObject"] = {
		Visible = true,
		Size = true,
		Position = true,
		BackgroundColor3 = true,
		BackgroundTransparency = true,
		BorderSizePixel = true,
		Rotation = true,
		ZIndex = true,
	},
}

--- True when the property is on the allowlist for this instance or an ancestor.
function InstanceManager.isWritable(instance: Instance, property: string): boolean
	local cursor: Instance? = instance
	while cursor do
		local rules = WRITABLE_PROPERTIES[cursor.ClassName]
		if rules and rules[property] then
			return true
		end
		cursor = cursor.Parent
	end
	return false
end

InstanceManager.WRITABLE_PROPERTIES = WRITABLE_PROPERTIES

--=============================================================================
-- SET PROPERTIES
--=============================================================================

--- Applies properties to an existing instance, reporting per-property results.
--- Properties outside the allowlist are refused, not attempted.
function InstanceManager.setProperties(
	instance: Instance,
	properties: { [string]: any }
): { applied: { string }, rejected: { string } }
	local applied: { string } = {}
	local rejected: { string } = {}

	if type(properties) ~= "table" then
		return { applied = applied, rejected = { "Properties must be a table." } }
	end

	for key, value in properties do
		if type(key) ~= "string" then
			rejected[#rejected + 1] = "Property names must be strings."
		elseif not InstanceManager.isWritable(instance, key) then
			rejected[#rejected + 1] = string.format("%s (not in ForgePilot's writable allowlist)", key)
		else
			local setOk, setError = pcall(function()
				(instance :: any)[key] = value
			end)
			if setOk then
				applied[#applied + 1] = key
			else
				rejected[#rejected + 1] = string.format("%s (%s)", key, tostring(setError))
			end
		end
	end

	return { applied = applied, rejected = rejected }
end

--=============================================================================
-- SEARCH
--=============================================================================

--- Finds descendants matching a name (exact first, then case-insensitive).
function InstanceManager.find(root: Instance, name: string, limit: number?): { Instance }
	local results: { Instance } = {}
	local cap = limit or 25
	local lowered = string.lower(name)

	for _, descendant in root:GetDescendants() do
		if results[#results] &lt; cap then
			if descendant.Name == name then
				results[#results + 1] = descendant
			elseif string.lower(descendant.Name) == lowered then
				results[#results + 1] = descendant
			end
		end
	end
	return results
end

--- Finds the first descendant of a given class.
function InstanceManager.findFirstOfClass(root: Instance, className: string): Instance?
	for _, descendant in root:GetDescendants() do
		if descendant:IsA(className) then
			return descendant
		end
	end
	return nil
end

--- Resolves a full instance path such as "game.Workspace.City.Road1".
--- Returns nil when any segment is missing, which is how ActionRegistry detects
--- that a previously verified object no longer exists.
function InstanceManager.findByPath(fullPath: any): Instance?
	if type(fullPath) ~= "string" or fullPath == "" then return nil end
	local WorkspaceInspector = require(script.Parent.WorkspaceInspector)
	local ok, result = pcall(WorkspaceInspector.resolve, fullPath)
	return if ok then result else nil
end

--=============================================================================
-- CLEANUP
--=============================================================================

--- Deletes an instance after refusing to remove engine services.
function InstanceManager.destroy(instance: Instance): (boolean, string?)
	if instance == game or instance.Parent == game then
		local protected = {
			workspace = true,
			game = true,
			Lighting = true,
			ServerScriptService = true,
			ServerStorage = true,
			ReplicatedStorage = true,
			StarterGui = true,
			StarterPlayer = true,
			StarterPack = true,
			SoundService = true,
			Players = true,
		}
		if protected[instance.Name] then
			return false, string.format("Refusing to delete the engine service `%s`.", instance.Name)
		end
	end

	local fullName = instance:GetFullName()
	instance:Destroy()
	return true, string.format("Deleted `%s`.", fullName)
end

return InstanceManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">LightingManager</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / LightingManager
	Applies Lighting changes and manages common look presets.

	Every write is verified by reading the property back from Lighting.
]]

local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

-- Self-contained pure conversion helpers. Do not import ActionExecutor here.
local function toColor3(value: any, fallback: Color3): Color3
	if type(value) == "string" then
		local hex = string.gsub(StringUtil.trim(value), "^#", "")
		if string.match(hex, "^%x%x%x%x%x%x$") then
			return Color3.fromHex(hex)
		end
		return fallback
	elseif type(value) == "table" then
		local r = value.r or value.R
		local g = value.g or value.G
		local b = value.b or value.B
		if r and g and b then
			return Color3.new(math.clamp(tonumber(r) or 0, 0, 1), math.clamp(tonumber(g) or 0, 0, 1), math.clamp(tonumber(b) or 0, 0, 1))
		end
	end
	return fallback
end

local LightingManager = {}

local ALLOWED_PROPERTIES: {[string]: boolean} = {
    ClockTime = true,
    Brightness = true,
    Ambient = true,
    OutdoorAmbient = true,
    EnvironmentDiffuseScale = true,
    EnvironmentSpecularScale = true,
    ExposureCompensation = true,
    GlobalShadows = true,
    ShadowSoftness = true,
    Technology = true,
    Attenuation = true,
    OutdoorExposure = true,
}

--=============================================================================
-- APPLY
--=============================================================================

--- Applies a settings table to Lighting. Returns nil plus a message on success
--- (Lighting is a singleton, not an instance we create), or nil plus an error.
function LightingManager.apply(settings: any): (any?, string?)
	if type(settings) ~= "table" then
		return nil, "`settings` must be an object of Lighting property names to values."
	end

	local lighting = game:GetService("Lighting")
	local applied = {}
	local rejected = {}

	for property, value in settings do
		if type(property) ~= "string" or not ALLOWED_PROPERTIES[property] then
			rejected[#rejected + 1] = string.format("%s (not a supported Lighting property)", tostring(property))
		else
			local resolved = value
			if property == "Ambient" or property == "OutdoorAmbient" then
				resolved = toColor3(value, lighting[property])
			end
			local ok, err = pcall(function()
				(lighting :: any)[property] = resolved
			end)
			if ok then
				applied[#applied + 1] = property
			else
				rejected[#rejected + 1] = string.format("%s (%s)", property, tostring(err))
			end
		end
	end

	if #applied == 0 then
		return nil,
			string.format(
				"No Lighting setting was applied. Rejected: %s",
				#rejected &gt; 0 and table.concat(rejected, "; ") or "(nothing provided)"
			)
	end

	-- Verify by reading back.
	local verified = {}
	for _, property in applied do
		local ok, value = pcall(function()
			return (lighting :: any)[property]
		end)
		if ok then
			verified[#verified + 1] = string.format("%s=%s", property, tostring(value))
		end
	end

	local message = string.format("Applied %s.", table.concat(applied, ", "))
	if #rejected &gt; 0 then
		message ..= string.format(" Rejected: %s", table.concat(rejected, "; "))
	end
	return nil, message .. string.format(" Verified: %s.", table.concat(verified, ", "))
end

--=============================================================================
-- PRESETS
--=============================================================================

LightingManager.Presets = {
	Daylight = {
		ClockTime = 13,
		Brightness = 2.5,
		Ambient = Color3.fromRGB(120, 120, 130),
		OutdoorAmbient = Color3.fromRGB(150, 150, 160),
		GlobalShadows = true,
	},
	Night = {
		ClockTime = 0.5,
		Brightness = 0.6,
		Ambient = Color3.fromRGB(20, 20, 35),
		OutdoorAmbient = Color3.fromRGB(30, 30, 55),
		GlobalShadows = true,
	},
	Sunset = {
		ClockTime = 18.4,
		Brightness = 1.6,
		Ambient = Color3.fromRGB(90, 70, 80),
		OutdoorAmbient = Color3.fromRGB(200, 130, 90),
		GlobalShadows = true,
	},
	Clean = {
		ClockTime = 14,
		Brightness = 3,
		Ambient = Color3.fromRGB(140, 140, 145),
		OutdoorAmbient = Color3.fromRGB(160, 160, 165),
		EnvironmentDiffuseScale = 0.5,
		EnvironmentSpecularScale = 0.4,
		GlobalShadows = true,
		ShadowSoftness = 0.2,
	},
}

function LightingManager.applyPreset(name: string): (any?, string?)
	local preset = LightingManager.Presets[name]
	if not preset then
		local names = {}
		for key in pairs(LightingManager.Presets) do
			names[#names + 1] = key
		end
		table.sort(names)
		return nil, string.format("Unknown preset `%s`. Available: %s.", name, table.concat(names, ", "))
	end
	return LightingManager.apply(preset)
end

--=============================================================================
-- ATMOSPHERE
--=============================================================================

--- Creates or updates an Atmosphere for the current look.
function LightingManager.ensureAtmosphere(options: { density: number?, offset: number?, color: any?, decalColor: any?, glare: number?, haze: number? }?): (any?, string?)
	local opts = options or {}
	local lighting = game:GetService("Lighting")

	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		local created = Instance.new("Atmosphere")
		created.Name = "Atmosphere"
		created.Parent = lighting
		atmosphere = created
	end

	atmosphere.Density = math.clamp(opts.density or 0.3, 0, 1)
	atmosphere.Offset = math.clamp(opts.offset or 0, -1, 1)
	atmosphere.Color = toColor3(opts.color, Color3.fromRGB(205, 205, 210))
	atmosphere.DecalColor = toColor3(opts.decalColor, Color3.fromRGB(20, 20, 20))
	atmosphere.Glare = math.clamp(opts.glare or 0, 0, 1)
	atmosphere.Haze = math.clamp(opts.haze or 1, 0, 1)

	return nil,
		string.format(
			"Atmosphere ready: density %.2f, haze %.2f, glare %.2f.",
			atmosphere.Density,
			atmosphere.Haze,
			atmosphere.Glare
		)
end

return LightingManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">ModelBuilder</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / ModelBuilder
	Higher-level construction helpers used by the write tools.

	Everything here creates real Instances with real geometry. Nothing is a
	placeholder: a "building" is an actual walled Model with Parts inside it.
]]

local StringUtil = require(script.Parent.Parent.Utilities.StringUtil)

-- Self-contained pure conversion helpers. Do not import ActionExecutor here.
local function toVector3(value: any, fallback: Vector3): Vector3
	if type(value) == "table" then
		local x = value.x or value.X or value[1]
		local y = value.y or value.Y or value[2]
		local z = value.z or value.Z or value[3]
		if x and y and z then
			return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
		end
	elseif type(value) == "string" then
		local x, y, z = string.match(value, "^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*$")
		if x then
			return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
		end
	end
	return fallback
end

local function toColor3(value: any, fallback: Color3): Color3
	if type(value) == "string" then
		local hex = string.gsub(StringUtil.trim(value), "^#", "")
		if string.match(hex, "^%x%x%x%x%x%x$") then
			return Color3.fromHex(hex)
		end
		return fallback
	elseif type(value) == "table" then
		local r = value.r or value.R
		local g = value.g or value.G
		local b = value.b or value.B
		if r and g and b then
			return Color3.new(math.clamp(tonumber(r) or 0, 0, 1), math.clamp(tonumber(g) or 0, 0, 1), math.clamp(tonumber(b) or 0, 0, 1))
		end
	end
	return fallback
end

local ModelBuilder = {}

--=============================================================================
-- COLOUR HELPERS
--=============================================================================

local function resolveColor(value: any, fallback: Color3): Color3
	return toColor3(value, fallback)
end

local function resolveMaterial(name: any, fallback: Enum.Material): Enum.Material
	if type(name) == "string" then
		local ok, result = pcall(function()
			return Enum.Material[name]
		end)
		if ok and result then
			return result
		end
	end
	return fallback
end

--=============================================================================
-- BUILDINGS
--=============================================================================

local Buildings = {}

--- Builds a simple walled building: floor, four walls, optional ceiling.
function Buildings.create(args): (Instance?, string?)
	local size = toVector3(args.size, Vector3.new(20, 12, 20))
	local position = toVector3(args.position, Vector3.zero)
	local thickness = args.wallThickness or 1
	local wallColor = resolveColor(args.color, Color3.fromRGB(190, 185, 180))
	local material = resolveMaterial(args.material, Enum.Material.Concrete)

	local model = Instance.new("Model")
	model.Name = args.name
	model:SetAttribute("ForgePilotOrigin", "create_building")

	local baseY = position.Y
	local floorPart = nil

	if args.floor ~= false then
		floorPart = Instance.new("Part")
		floorPart.Name = "Floor"
		floorPart.Size = Vector3.new(size.X, thickness, size.Z)
		floorPart.CFrame = CFrame.new(position + Vector3.new(0, baseY + thickness / 2, 0))
		floorPart.Anchored = true
		floorPart.Material = material
		floorPart.Color = wallColor:Lerp(Color3.new(0, 0, 0), 0.15)
		floorPart.Parent = model
	end

	local wallHeight = size.Y
	local base = baseY + (if floorPart then thickness else 0)
	local wallY = base + wallHeight / 2

	local walls = {
		{ "WallNorth", Vector3.new(size.X, wallHeight, thickness), Vector3.new(0, 0, -size.Z / 2 + thickness / 2) },
		{ "WallSouth", Vector3.new(size.X, wallHeight, thickness), Vector3.new(0, 0, size.Z / 2 - thickness / 2) },
		{ "WallWest", Vector3.new(thickness, wallHeight, size.Z - thickness * 2), Vector3.new(-size.X / 2 + thickness / 2, 0, 0) },
		{ "WallEast", Vector3.new(thickness, wallHeight, size.Z - thickness * 2), Vector3.new(size.X / 2 - thickness / 2, 0, 0) },
	}

	for _, wall in walls do
		local part = Instance.new("Part")
		part.Name = wall[1]
		part.Size = wall[2]
		part.CFrame = CFrame.new(position + Vector3.new(wall[3].X, wallY, wall[3].Z))
		part.Anchored = true
		part.Material = material
		part.Color = wallColor
		part.Parent = model
	end

	if args.ceilings then
		local ceiling = Instance.new("Part")
		ceiling.Name = "Ceiling"
		ceiling.Size = Vector3.new(size.X, thickness, size.Z)
		ceiling.CFrame = CFrame.new(position + Vector3.new(0, base + wallHeight + thickness / 2, 0))
		ceiling.Anchored = true
		ceiling.Material = material
		ceiling.Color = wallColor:Lerp(Color3.new(0, 0, 0), 0.1)
		ceiling.Parent = model
	end

	local pivotPart = floorPart or model:GetChildren()[1] or nil
	if pivotPart and pivotPart:IsA("BasePart") then
		model.PrimaryPart = pivotPart
	end

	return model, string.format(
		"Building is %.0f x %.0f x %.0f studs with %d wall(s).",
		size.X,
		size.Y,
		size.Z,
		#walls
	)
end

--=============================================================================
-- ROADS
--=============================================================================

local Roads = {}

--- Builds a road between two points, with optional kerbs and centre line.
function Roads.create(args): (Instance?, string?)
	local start = toVector3(args.start, Vector3.zero)
	local finish = toVector3(args["end"], start + Vector3.new(0, 0, 60))
	local width = args.width or 12
	local roadColor = resolveColor(args.color, Color3.fromRGB(45, 45, 48))

	local delta = finish - start
	local length = delta.Magnitude
	if length &lt; 1 then
		return nil, "The road start and end points are too close together."
	end

	local model = Instance.new("Model")
	model.Name = args.name
	model:SetAttribute("ForgePilotOrigin", "create_road")

	local midpoint = (start + finish) / 2
	local orientation = Vector3.new(delta.X, 0, delta.Z)
	if orientation.Magnitude &lt; 0.001 then
		orientation = Vector3.new(0, 0, 1)
	end

	local surface = Instance.new("Part")
	surface.Name = "RoadSurface"
	surface.Size = Vector3.new(width, 0.5, length)
	surface.CFrame = CFrame.lookAt(midpoint - Vector3.new(0, 0.25, 0), midpoint + orientation) * CFrame.Angles(0, math.pi / 2, 0)
	surface.Anchored = true
	surface.Material = Enum.Material.Asphalt
	surface.Color = roadColor
	surface.TopSurface = Enum.SurfaceType.Smooth
	surface.BottomSurface = Enum.SurfaceType.Smooth
	surface.Parent = model

	local kerbOffset = width / 2 + 0.5
	local kerbColor = Color3.fromRGB(160, 160, 165)
	if args.kerbs ~= false then
		for _, side in { -1, 1 } do
			local kerb = Instance.new("Part")
			kerb.Name = side &lt; 0 and "KerbLeft" or "KerbRight"
			kerb.Size = Vector3.new(1, 0.75, length)
			kerb.CFrame = surface.CFrame * CFrame.new(side * kerbOffset, 0.12, 0)
			kerb.Anchored = true
			kerb.Material = Enum.Material.Concrete
			kerb.Color = kerbColor
			kerb.Parent = model
		end
	end

	if args.centerLine ~= false then
		local dashes = math.max(1, math.floor(length / 12))
		local dashLength = math.max(1.5, length / dashes * 0.45)
		for index = 1, dashes do
			local t = (index - 0.5) / dashes
			local dash = Instance.new("Part")
			dash.Name = string.format("CentreLine%02d", index)
			dash.Size = Vector3.new(0.6, 0.06, dashLength)
			dash.CFrame = surface.CFrame * CFrame.new(0, 0.28, (t - 0.5) * length)
			dash.Anchored = true
			dash.Material = Enum.Material.SmoothPlastic
			dash.Color = Color3.fromRGB(235, 220, 120)
			dash.Parent = model
		end
	end

	model.PrimaryPart = surface
	return model, string.format("Road is %.1f studs long, %.0f studs wide.", length, width)
end

--=============================================================================
-- TERRAIN
--=============================================================================

local Terrain = {}

local REGION_PATTERN = "^(%-?%d+)%s*,%s*(%-?%d+)%s*,%s*(%-?%d+)$"

--- Parses "512,512,128" into three Vector3i values.
function Terrain.parseRegion(region: string): (Vector3i?, string?)
	local x, y, z = string.match(tostring(region), REGION_PATTERN)
	if not x then
		return nil, "Region must be three comma-separated integers such as 512,512,128."
	end
	return Vector3i.new(tonumber(x) or 4, tonumber(y) or 4, tonumber(z) or 4), nil
end

--=============================================================================
-- TERRAIN MATERIALS
--=============================================================================

-- Roblox raises `Lava is not a valid member of "Enum.Material"` the moment an
-- unknown Enum.Material member is read. Because this table is built at MODULE
-- SCOPE, a single wrong name used to abort require(ModelBuilder) and surface as
-- the useless "Requested module experienced an error while loading."
--
-- Every entry is therefore probed individually: a member this Studio build does
-- not know is dropped and reported, never fatal.

local TERRAIN_CANDIDATES: { string } = {
	"Plastic", "SmoothPlastic", "Neon", "Wood", "WoodPlanks", "Marble", "Basalt", "Slate",
	"CrackedLava", "Concrete", "Limestone", "Granite", "Pavement", "Brick", "Pebble",
	"Cobblestone", "Rock", "Sandstone", "CorrodedMetal", "DiamondPlate", "Foil", "Metal",
	"Grass", "LeafyGrass", "Sand", "Fabric", "Snow", "Mud", "Ground", "Asphalt", "Salt",
	"Ice", "Glacier", "Glass", "ForceField", "Air", "Water", "Cardboard", "Carpet",
	"CeramicTiles", "ClayRoofTiles", "RoofShingles", "Leather", "Plaster", "Rubber",
}

local TERRAIN_ENUM: { [string]: Enum.Material } = {}
local UNSUPPORTED_MATERIALS: { string } = {}

for _, name in TERRAIN_CANDIDATES do
	local ok, material = pcall(function()
		return Enum.Material[name]
	end)
	if ok and material then
		TERRAIN_ENUM[name] = material
	else
		UNSUPPORTED_MATERIALS[#UNSUPPORTED_MATERIALS + 1] = name
	end
end

-- Friendly aliases for names the AI may emit. Each alias is bound only when its
-- replacement really exists, so an alias can never reintroduce the crash.
local TERRAIN_ALIASES: { [string]: string } = {
	Lava = "CrackedLava",
	Moss = "Grass",
	MudRock = "Rock",
	Shale = "Slate",
	VolcanicRock = "Basalt",
	Stone = "Concrete",
}
for alias, target in TERRAIN_ALIASES do
	if TERRAIN_ENUM[target] then
		TERRAIN_ENUM[alias] = TERRAIN_ENUM[target]
	end
end

--- Terrain material names this Studio build does not support.
--- Surfaced in the UI so a degraded capability is visible rather than silent.
function ModelBuilder.unsupportedMaterials(): { string }
	return table.clone(UNSUPPORTED_MATERIALS)
end

function Terrain.fill(args): (Instance?, string?)
	local region, regionError = Terrain.parseRegion(args.region or "512,512,128")
	if not region then
		return nil, regionError
	end

	local material = TERRAIN_ENUM[args.material or "Grass"] or Enum.Material.Grass
	local size = toVector3(args.size, Vector3.new(region.X, 4, region.Z))
	local color = resolveColor(args.color, Color3.fromRGB(106, 168, 79))

	local ok, err = pcall(function()
		game:GetService("Workspace").Terrain:FillRegion(region, region, size, material, color)
	end)
	if not ok then
		return nil, "Terrain fill failed: " .. tostring(err)
	end

	return nil,
		string.format(
			"Filled region %d,%d,%d (%d x %d x %d) with %s.",
			region.X,
			region.Y,
			region.Z,
			size.X,
			size.Y,
			size.Z,
			material.Name
		)
end

--=============================================================================
-- SIMPLE MAP GENERATION
--=============================================================================

ModelBuilder.generateSimpleMap = function(options: {
	name: string?,
	origin: Vector3?,
	radius: number?,
	buildings: number?,
	roads: number?,
	color: any?,
}?)
	local origin = options.origin or Vector3.new(0, 0, 0)
	local radius = options.radius or 120
	local buildings = math.clamp(options.buildings or 8, 1, 30)
	local roads = math.clamp(options.roads or 4, 0, 12)
	local color = resolveColor(options.color, Color3.fromRGB(170, 170, 178))

	local model = Instance.new("Model")
	model.Name = options.name or "ForgePilotMap"
	model:SetAttribute("ForgePilotOrigin", "generate_map")

	local ground = Instance.new("Part")
	ground.Name = "Ground"
	ground.Size = Vector3.new(radius * 2, 1, radius * 2)
	ground.CFrame = CFrame.new(origin + Vector3.new(0, -0.5, 0))
	ground.Anchored = true
	ground.Material = Enum.Material.Grass
	ground.Color = Color3.fromRGB(106, 168, 79)
	ground.Parent = model

	for index = 1, buildings do
		local angle = (index / buildings) * math.pi * 2
		local distance = radius * (0.35 + (index % 3) * 0.18)
		local buildingSize = Vector3.new(14 + (index % 4) * 4, 10 + (index % 5) * 3, 12 + (index % 3) * 5)
		local position = origin + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)

		local building = Instance.new("Model")
		building.Name = string.format("Building%02d", index)

		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Size = buildingSize
		floor.CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0))
		floor.Anchored = true
		floor.Material = Enum.Material.Concrete
		floor.Color = color:Lerp(Color3.new(0, 0, 0), 0.2)
		floor.Parent = building

		local body = Instance.new("Part")
		body.Name = "Body"
		body.Size = buildingSize - Vector3.new(1.6, 1, 1.6)
		body.CFrame = CFrame.new(position + Vector3.new(0, 1 + (buildingSize.Y - 1) / 2, 0))
		body.Anchored = true
		body.Material = Enum.Material.Concrete
		body.Color = color
		body.Transparency = 0.35
		body.CanCollide = true
		body.Parent = building
		building.PrimaryPart = body

		building.Parent = model
	end

	for index = 1, roads do
		local angle = (index / roads) * math.pi * 2
		local startPoint = origin + Vector3.new(math.cos(angle) * radius * 0.15, 0, math.sin(angle) * radius * 0.15)
		local endPoint = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local road = Roads.create({
			name = string.format("Road%02d", index),
			start = startPoint,
			["end"] = endPoint,
			width = 10,
			kerbs = false,
			centerLine = true,
		})
		if road then
			road.Parent = model
		end
	end

	return model, string.format("Generated %d buildings and %d roads within a %d stud radius.", buildings, roads, radius)
end

ModelBuilder.Buildings = Buildings
ModelBuilder.Roads = Roads
ModelBuilder.Terrain = Terrain

return ModelBuilder</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">ScriptManager</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / ScriptManager
	Script creation helpers plus ScriptEditorService integration.

	NOTE ON SECURITY
	----------------
	Generated gameplay scripts are written into the place as ordinary project
	assets. ForgePilot never runs them with plugin privileges, never evaluates
	model-generated Luau inside the plugin, and never bypasses Roblox's scripting
	security rules. The code lives in your place and obeys the normal runtime
	sandbox exactly like anything you type by hand.
]]

local Logger = require(script.Parent.Parent.Utilities.Logger)

local ScriptManager = {}

local editorAvailable = false

--- Probes ScriptEditorService once and caches the result.
function ScriptManager.isEditorAvailable(): boolean
	if editorAvailable then
		return true
	end
	local ok = pcall(function()
		local service = game:GetService("ScriptEditorService")
		-- ScriptEditorService:GetScriptEditor does not exist; the supported way to
		-- put a script in front of the user is OpenScriptDocumentAsync.
		return type(service.OpenScriptDocumentAsync) == "function"
	end)
	editorAvailable = ok
	return ok
end

--- Opens a script in Studio's script editor, if that API is reachable.
function ScriptManager.open(scriptInstance: Instance): boolean
	if not ScriptManager.isEditorAvailable() then
		Logger.warn("Scripts", "ScriptEditorService is not reachable from this plugin context.")
		return false
	end
	if not scriptInstance:IsA("LuaSourceContainer") then
		return false
	end

	local ok, err = pcall(function()
		local service = game:GetService("ScriptEditorService")
		service:OpenScriptDocumentAsync(scriptInstance)
	end)
	if ok then
		Logger.info("Scripts", string.format("Opened %s in the script editor.", scriptInstance:GetFullName()))
		return true
	end

	Logger.warn("Scripts", "The script editor could not be opened.", { detail = tostring(err) })
	return false
end

--- Selects an instance in Studio (used after creating scripts or GUIs).
function ScriptManager.focus(instance: Instance): boolean
	local ok, err = pcall(function()
		game:GetService("Selection"):Set({ instance })
	end)
	if not ok then
		Logger.debug("Scripts", "Selection service is unavailable.", { detail = tostring(err) })
		return false
	end
	return true
end

--- Finds scripts by class for a quick overview.
function ScriptManager.listScripts(): { { path: string, className: string, lines: number, bytes: number } }
	local list = {}
	local roots = {
		game:GetService("ServerScriptService"),
		game:GetService("ReplicatedStorage"),
		game:GetService("StarterPlayer"),
		game:GetService("StarterGui"),
	}

	local budget = 0
	for _, root in roots do
		for _, descendant in root:GetDescendants() do
			budget += 1
			if budget &gt; 2000 then
				break
			end
			if descendant:IsA("LuaSourceContainer") then
				local source = tostring((descendant :: any).Source or "")
				local lines = select(2, string.gsub(source, "\n", "")) + 1
				list[#list + 1] = {
					path = descendant:GetFullName(),
					className = descendant.ClassName,
					lines = lines,
					bytes = #source,
				}
			end
		end
	end
	return list
end

--- Reads a script's source safely, returning nil plus a reason on failure.
function ScriptManager.readSource(scriptInstance: Instance): (string?, string?)
	if not scriptInstance:IsA("LuaSourceContainer") then
		return nil, string.format("`%s` is a %s, not a script.", scriptInstance:GetFullName(), scriptInstance.ClassName)
	end
	local source = (scriptInstance :: any).Source
	if type(source) ~= "string" then
		return nil, "This script's source is not readable."
	end
	return source, nil
end

--- Strips accidental leading markers some models emit.
function ScriptManager.normaliseSource(source: string): string
	local cleaned = source:gsub("\r\n", "\n")
	-- Remove a wrapping markdown fence if the model emitted one.
	cleaned = cleaned:gsub("^%s*```%a*\n", ""):gsub("\n```%s*$", "")
	return cleaned
end

return ScriptManager</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">SelectionInspector</string>
          <string name="Source">--!strict
--[[
	ForgePilot / Roblox / SelectionInspector
	Read-only view of the Studio selection, used by Planning mode and by the
	"inspect selected objects" tool.
]]

local WorkspaceInspector = require(script.Parent.WorkspaceInspector)

local SelectionInspector = {}

local MAX_SELECTION = 30

function SelectionInspector.isAvailable(): boolean
	return typeof(game:GetService("Selection")) == "Instance"
end

--- Returns the current Studio selection as structured data.
function SelectionInspector.get(): { { name: string, className: string, path: string, properties: { [string]: string } } }
	local result = {}
	if not SelectionInspector.isAvailable() then
		return result
	end

	local service = game:GetService("Selection")
	local selection = service:Get()

	for index = 1, math.min(#selection, MAX_SELECTION) do
		local instance = selection[index]
		result[index] = {
			name = instance.Name,
			className = instance.ClassName,
			path = instance:GetFullName(),
			properties = WorkspaceInspector.readProperties(instance),
			childCount = #instance:GetChildren(),
		}
	end

	return result
end

function SelectionInspector.getSummary(): string
	local selection = SelectionInspector.get()
	if #selection == 0 then
		return "Nothing is selected in Studio."
	end

	local lines: { string } = {
		string.format("%d object%s selected:", #selection, if #selection == 1 then "" else "s"),
	}
	for index, entry in selection do
		if index &gt; MAX_SELECTION then
			break
		end
		local detail: { string } = {}
		local count = 0
		for key, value in entry.properties do
			if count &gt;= 8 then
				break
			end
			detail[#detail + 1] = string.format("%s=%s", key, value)
			count += 1
		end
		table.sort(detail)
		lines[#lines + 1] = string.format("- %s [%s] %s", entry.name, entry.className, table.concat(detail, ", "))
	end
	if #selection &gt; MAX_SELECTION then
		lines[#lines + 1] = string.format("… and %d more.", #selection - MAX_SELECTION)
	end
	return table.concat(lines, "\n")
end

function SelectionInspector.getPaths(): { string }
	local paths = {}
	for _, entry in SelectionInspector.get() do
		paths[#paths + 1] = entry.path
	end
	return paths
end

return SelectionInspector</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">ToolValidator</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ForgePilot / Roblox / ToolValidator
	The allowlist.

	No AI text reaches the DataModel except through a tool declared here, with
	arguments validated against an explicit schema, a mode gate (read-only vs
	write), and a permission check. Anything else is rejected.
]]

local JSONValidator = require(script.Parent.Parent.Utilities.JSONValidator)

local BridgeClient = require(script.Parent.Parent.Core.BridgeClient)
local ExternalTools = require(script.Parent.ExternalTools)
local ToolValidator = {}

export type Mode = "plan" | "build"

export type Tool = {
	name: string,
	mode: Mode,
	category: string,
	description: string,
	destructive: boolean,
	confirmation: boolean,
	external: boolean?,
	parameters: JSONValidator.Schema,
	--- Human-readable summary shown before approval.
	summarise: ((arguments: { [string]: any }) -> string)?,
}

--=============================================================================
-- SHARED RULES
--=============================================================================

local function v3(): JSONValidator.Rule
	return { typeName = "any", validate = function(value)
		if type(value) == "table" then
			return JSONValidator.isNumber(value.X or value.x)
				and JSONValidator.isNumber(value.Y or value.y)
				and JSONValidator.isNumber(value.Z or value.z), "must contain numeric x, y and z components."
		end
		if type(value) == "string" and string.match(value, "^%s*[%-%d%.]+%s*,%s*[%-%d%.]+%s*,%s*[%-%d%.]+%s*$") then
			return true
		end
		return false, "must be a Vector3 such as {x=0, y=10, z=0}."
	end }
end

local function colour(): JSONValidator.Rule
	return { typeName = "any", validate = function(value)
		if type(value) == "table" and (value.R or value.r) then
			return true
		end
		if type(value) == "string" and string.match(value, "^#?%x%x%x%x%x%x$") then
			return true
		end
		return false, "must be a Color3 {r,g,b} (0-1) or a hex string like #9879E8."
	end }
end

local function countKeys(t: any): number
	if type(t) ~= "table" then
		return 0
	end
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

local function pathRule(required: boolean?): JSONValidator.Rule
	return {
		typeName = "string",
		required = required ~= false,
		min = 1,
		max = 200,
		description = "Instance path such as Workspace.MyModel, or a full path like game.Workspace.X.",
	}
end

--=============================================================================
-- READ-ONLY TOOLS (Planning mode)
--=============================================================================

local READ_TOOLS: { Tool } = {
	{
		name = "inspect_place",
		mode = "plan",
		category = "Inspect",
		description = "Returns the place name, id, genre and a top-level Workspace outline.",
		destructive = false,
		confirmation = false,
		parameters = {
			includeClassCounts = { typeName = "boolean", default = true },
		},
		summarise = function()
			return "Read place metadata"
		end,
	},
	{
		name = "inspect_tree",
		mode = "plan",
		category = "Inspect",
		description = "Returns a bounded outline of an instance and its descendants.",
		destructive = false,
		confirmation = false,
		parameters = {
			path = pathRule(),
			maxDepth = { typeName = "number", min = 1, max = 5, default = 3 },
		},
		summarise = function(args)
			return string.format("Read the instance tree at `%s`", tostring(args.path))
		end,
	},
	{
		name = "inspect_selection",
		mode = "plan",
		category = "Inspect",
		description = "Returns the objects currently selected in Studio, with safe properties.",
		destructive = false,
		confirmation = false,
		parameters = {},
		summarise = function()
			return "Read the current Studio selection"
		end,
	},
	{
		name = "inspect_properties",
		mode = "plan",
		category = "Inspect",
		description = "Reads an allowlisted set of properties from one instance.",
		destructive = false,
		confirmation = false,
		parameters = {
			path = pathRule(),
		},
		summarise = function(args)
			return string.format("Read properties of `%s`", tostring(args.path))
		end,
	},
	{
		name = "inspect_script",
		mode = "plan",
		category = "Inspect",
		description = "Reads the source of a LocalScript, Script or ModuleScript.",
		destructive = false,
		confirmation = false,
		parameters = {
			path = pathRule(),
		},
		summarise = function(args)
			return string.format("Read the source of `%s`", tostring(args.path))
		end,
	},
	{
		name = "inspect_lighting",
		mode = "plan",
		category = "Inspect",
		description = "Reads Lighting settings and the list of post effects.",
		destructive = false,
		confirmation = false,
		parameters = {},
		summarise = function()
			return "Read Lighting settings"
		end,
	},
	{
		name = "inspect_ui",
		mode = "plan",
		category = "Inspect",
		description = "Lists ScreenGuis and GUI elements known to the place.",
		destructive = false,
		confirmation = false,
		parameters = {},
		summarise = function()
			return "List game UI"
		end,
	},
	{
		name = "inspect_place_stats",
		mode = "plan",
		category = "Inspect",
		description = "Returns instance counts and total descendant count for the place.",
		destructive = false,
		confirmation = false,
		parameters = {},
		summarise = function()
			return "Read place statistics"
		end,
	},
}

--=============================================================================
-- WRITE TOOLS (Build mode only)
--=============================================================================

local WRITE_TOOLS: { Tool } = {
	-- Creation ------------------------------------------------------------
	{
		name = "create_part",
		mode = "build",
		category = "Create",
		description = "Creates a Part. Optionally positions, sizes, colours and anchors it.",
		destructive = false,
		confirmation = false,
		parameters = {
			name = { typeName = "string", required = true, min = 1, max = 120 },
			parent = { typeName = "string", default = "Workspace" },
			size = { typeName = "any", default = { x = 10, y = 1, z = 10 } },
			position = { typeName = "any", default = { x = 0, y = 5, z = 0 } },
			color = colour(),
			material = { typeName = "string", default = "Plastic", oneOf = {
				"Plastic", "Wood", "WoodPlanks", "Slate", "Concrete", "Brick", "Pavement", "Rock", "Sand", "Grass",
				"LeafyGrass", "Sandstone", "CorrodedMetal", "DiamondPlate", "Foil", "Glass", "Ice", "Marble", "Metal",
				"Ground", "Asphalt", "Fabric", "Cobblestone", "Air", "Water", "Cardboard", "Carpet", "CeramicTiles",
				"ClayRoofTiles", "RoofShingles", "Leather", "Plaster", "Rubber",
			} },
			anchored = { typeName = "boolean", default = true },
			canCollide = { typeName = "boolean", default = true },
